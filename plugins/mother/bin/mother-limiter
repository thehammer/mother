#!/usr/bin/env python3
"""mother-limiter — I/O shell around lib/limiter_core.py (observe-only, L1).

  mother-limiter tick     --root R     gather inputs, run the control law, write limiter/state.json,
                                       append limiter/decisions.jsonl, print job annotations (JSON line)
  mother-limiter status   --json --root R
  mother-limiter estimate --root R --job <job.json>   MC-38 expected-burn object
  mother-limiter classify --work-dir D --repo NAME    company | personal

Observe only: nothing here changes what the runner dispatches. Stdlib only.
"""

import argparse
import json
import math
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))
import limiter_core as core  # noqa: E402

KNOBS = {  # env name -> (cfg key, default, int?)
    "MOTHER_LIMITER_RESERVE_PCT": ("reserve_pct", 15, False),
    "MOTHER_LIMITER_BURN_WINDOW_S": ("burn_window_s", 600, False),
    "MOTHER_LIMITER_DEFAULT_BURN_USD_PER_MIN": ("default_burn_usd_per_min", 0.5, False),
    "MOTHER_LIMITER_HISTORY_N": ("history_n", 20, True),
    "MOTHER_LIMITER_HISTORY_MIN": ("history_min", 3, True),
    "MOTHER_LIMITER_CALM_S": ("calm_s", 900, False),
    "MOTHER_LIMITER_COALESCE_S": ("coalesce_s", 120, False),
    "MOTHER_LIMITER_RAMP_START": ("ramp_start", 2, True),
    "MOTHER_LIMITER_RAMP_STEP_S": ("ramp_step_s", 300, False),
    "MOTHER_LIMITER_INTERACTIVE_PCT_H": ("interactive_pct_h", 10, False),
    "MOTHER_LIMITER_INTERACTIVE_SUSTAIN_S": ("interactive_sustain_s", 600, False),
    "MOTHER_LIMITER_K_MIN_SAMPLES": ("k_min_samples", 12, True),
}
TERMINAL = ("succeeded", "failed", "cancelled")


def warn(msg):
    print("mother-limiter: " + msg, file=sys.stderr)


# ---------- config: env, then config.env, then default ----------

def _config_env(root):
    out = {}
    try:
        with open(os.path.join(root, "config.env")) as fh:
            for line in fh:
                line = line.rstrip("\n")
                if not re.match(r"^MOTHER_[A-Z0-9_]*=", line):
                    continue
                k, v = line.split("=", 1)
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                out[k] = v
    except OSError:
        pass
    return out


def setting(root, name, default=None):
    if name in os.environ:
        return os.environ[name]
    return _config_env(root).get(name, default)


def num_setting(root, name, default, as_int=False):
    raw = setting(root, name, None)
    if raw is None or raw == "":
        return default
    try:
        v = float(raw)
        if math.isnan(v) or math.isinf(v) or v < 0:
            raise ValueError
    except ValueError:
        warn("%s=%r is not a non-negative number; using %s" % (name, raw, default))
        return default
    return int(v) if as_int else v


def load_cfg(root):
    cfg = core.make_cfg()
    for env, (key, default, as_int) in KNOBS.items():
        cfg[key] = num_setting(root, env, default, as_int)
    ceil = num_setting(root, "MOTHER_CONCURRENCY", 2, True)
    cfg["ceiling"] = max(1, ceil)
    return cfg


def resolve_mode(root):
    """env off wins; mode.json 'off' next; everything else (incl. enforce, L3) is observe."""
    env = os.environ.get("MOTHER_LIMITER_MODE", "")
    if env == "off":
        return "off"
    if env and env != "observe":
        warn("MOTHER_LIMITER_MODE=%r is not available in this slice; running observe-only" % env)
    try:
        with open(os.path.join(root, "limiter", "mode.json")) as fh:
            m = json.load(fh).get("mode")
    except (OSError, ValueError, AttributeError):
        m = None
    return "off" if m == "off" else "observe"


# ---------- small helpers ----------

def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return None


def write_json_atomic(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, ensure_ascii=False, separators=(",", ":"))
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def sweep_stale_tmp(ldir):
    """Remove limiter/*.tmp.<pid> files whose writer is dead (a killed tick leaves them behind)."""
    try:
        names = os.listdir(ldir)
    except OSError:
        return
    for name in names:
        m = re.search(r"\.tmp\.(\d+)$", name)
        if not m:
            continue
        pid = int(m.group(1))
        if pid == os.getpid():
            continue
        try:
            os.kill(pid, 0)
            continue  # writer still alive
        except ProcessLookupError:
            pass
        except OSError:
            continue
        try:
            os.unlink(os.path.join(ldir, name))
        except OSError:
            pass


def iso(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    if not isinstance(s, str) or not s:
        return None
    m = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?(Z|[+-]\d\d:\d\d)?$", s)
    if not m:
        return None
    try:
        dt = datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)
    except ValueError:
        return None
    return dt.timestamp()


def is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


# ---------- budget feed (mirrors lib/state.sh _quota_feed_json / _quota_gate_read) ----------

def _normalize(path, kind):
    d = read_json(path)
    if not isinstance(d, dict):
        return None
    if kind == "bishop" and d.get("stale_input") is True:
        return None
    out = {}
    for key in ("five_hour", "seven_day"):
        w = d.get(key)
        if not isinstance(w, dict):
            return None
        used = w.get("used_pct")
        if used is None or used is False:
            used = w.get("used_percentage")
        if not is_num(used):
            return None
        at = w.get("resets_at")
        out[key] = {"used_pct": used, "resets_at": int(math.floor(at)) if is_num(at) else 0}
        for extra in ("pace", "pace_smoothed", "elapsed_pct"):
            if is_num(w.get(extra)):
                out[key][extra] = w[extra]
    ov = d.get("overage")
    out["overage_enabled"] = bool(isinstance(ov, dict) and ov.get("enabled"))
    return out


def read_feed(root, now):
    maxage = num_setting(root, "MOTHER_QUOTA_FEED_MAX_AGE_S", 1800, True)
    paths = [("bishop", setting(root, "MOTHER_BISHOP_POSTURE_FILE", os.path.join(os.path.expanduser("~"), ".claude", "budget-posture.json"))),
             ("cache", setting(root, "MOTHER_RATE_LIMIT_CACHE", os.path.join(root, "rate-limits.json")))]
    src, age, win, best_age = "none", None, None, None
    for kind, f in paths:
        try:
            mtime = int(os.stat(f).st_mtime)
        except OSError:
            continue
        a = int(now) - mtime
        if a < 0:
            continue
        w = _normalize(f, kind)
        if w is None:
            continue
        if best_age is None or a < best_age:
            best_age = a
        if a <= maxage:
            src, age, win = kind, a, w
            break
    if win is None:
        win = {"five_hour": {"used_pct": 0, "resets_at": 0}, "seven_day": {"used_pct": 0, "resets_at": 0},
               "overage_enabled": False}
    if age is None:
        age = best_age
    for key in ("five_hour", "seven_day"):
        w = win[key]
        if w["resets_at"] > 0 and now > w["resets_at"]:
            w["used_pct"] = 0
    return {"source": src, "feed_age_s": age, "stale": src == "none",
            "five_hour": win["five_hour"], "seven_day": win["seven_day"],
            "overage_enabled": win["overage_enabled"]}


def read_gate(root, now):
    d = read_json(os.path.join(root, "quota-gate.json"))
    if isinstance(d, dict) and d.get("state") == "off":
        return "off"
    if isinstance(d, dict) and d.get("state") == "off_until_reset":
        u = d.get("until")
        return "off_until_reset" if not is_num(u) or now < u else "on"
    return "on"


# ---------- data class (MC-38) ----------

def _list_setting(root, name, default=""):
    raw = setting(root, name, None)
    return (default if raw is None else raw).split()


def origin_owner(url):
    m = re.search(r"[:/]([^/:]+)/[^/]+?(?:\.git)?/?$", (url or "").strip())
    return m.group(1).lower() if m else None


def origin_url(work_dir):
    """The repo's origin URL ('' if none): part of the class cache key so a changed origin is re-read."""
    try:
        if work_dir and os.path.isdir(work_dir):
            r = subprocess.run(["git", "-C", work_dir, "remote", "get-url", "origin"],
                               capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                return r.stdout.strip()
    except Exception:
        pass
    return ""


def crew_phi_sensitive(work_dir):
    """True when the repo's .mother/crew.yml (working copy) declares phi_sensitive: true. Best effort."""
    try:
        if not (work_dir and os.path.isdir(work_dir)):
            return False
        path = os.path.join(work_dir, ".mother", "crew.yml")
        if not os.path.isfile(path):
            return False
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                if re.match(r"^\s*phi_sensitive\s*:\s*true\s*(#.*)?$", line, re.I):
                    return True
    except Exception:
        pass
    return False


def classify(root, work_dir, repo):
    try:
        if repo in _list_setting(root, "MOTHER_PHI_REPOS", "admin-portal referral-monitor"):
            return "company"
        if repo in _list_setting(root, "MOTHER_COMPANY_REPOS", ""):
            return "company"
        if crew_phi_sensitive(work_dir):
            return "company"
        if origin_owner(origin_url(work_dir)) == "carefeed":
            return "company"
    except Exception:
        pass
    return "personal"


# ---------- burn history (MC-38) ----------

def iter_job_files(root):
    jobs = os.path.join(root, "jobs")
    if os.path.isdir(jobs):
        for name in sorted(os.listdir(jobs)):
            if name.endswith(".json"):
                d = read_json(os.path.join(jobs, name))
                if isinstance(d, dict):
                    yield d, False
    arch = os.path.join(root, "archive")
    if os.path.isdir(arch):
        for month in sorted(os.listdir(arch)):
            md = os.path.join(arch, month)
            if not os.path.isdir(md):
                continue
            for name in sorted(os.listdir(md)):
                if name.endswith(".json") and not name.endswith(".events.jsonl"):
                    d = read_json(os.path.join(md, name))
                    if isinstance(d, dict):
                        yield d, True


def events_path(root, job, archived):
    jid = job.get("id")
    if archived:
        return os.path.join(root, "archive", (job.get("finished_at") or "")[:7] or "unknown", "%s.events.jsonl" % jid)
    return os.path.join(root, "events", "%s.jsonl" % jid)


def read_jsonl(path, start=0):
    out = []
    try:
        with open(path, "rb") as fh:
            fh.seek(start)
            for line in fh.read().splitlines():
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return out


def actor_of(job):
    return "pipeline" if job.get("kind") == "pipeline" else "cody"


def active_minutes(root, job, archived):
    """Wall time minus queue wait, quota pauses and human waits (as `mother-usage retro` does)."""
    created, finished, started = (parse_iso(job.get(k)) for k in ("created_at", "finished_at", "started_at"))
    if created is None or finished is None:
        return None
    total = finished - created
    queue = (started - created) if started else 0.0
    quota = human = 0.0
    qp = hp = None
    for e in read_jsonl(events_path(root, job, archived)):
        ts, kind = parse_iso(e.get("ts")), e.get("kind")
        if kind == "paused_for_quota":
            qp = ts
        elif kind == "awaiting_input":
            hp = ts
        elif kind in ("resumed", "auto_resumed") and ts:
            if qp:
                quota += ts - qp
                qp = None
            if hp:
                human += ts - hp
                hp = None
    return max(total - queue - quota - human, 0.0) / 60.0


def finished_burns(root):
    rows = []
    for job, archived in iter_job_files(root):
        if job.get("state") not in ("succeeded", "failed"):
            continue
        cost = job.get("actual_cost_usd")
        if not is_num(cost) or cost <= 0:
            continue
        mins = active_minutes(root, job, archived)
        if not mins or mins < 1.0:
            continue
        rows.append({"repo": job.get("repo") or "unknown", "actor": actor_of(job),
                     "usd_per_min": cost / mins, "finished_at": job.get("finished_at") or ""})
    return rows


def burn_table(root, cfg, now, max_age_s=3600):
    path = os.path.join(root, "limiter", "burn-history.json")
    cached = read_json(path)
    if isinstance(cached, dict) and now - (cached.get("computed_ts") or 0) < max_age_s \
            and isinstance(cached.get("rows"), list):
        return cached["rows"]
    rows = finished_burns(root)
    try:
        write_json_atomic(path, {"computed_ts": now, "rows": rows})
    except OSError:
        pass
    return rows


# ---------- tick ----------

def job_cost(job):
    c = job.get("actual_cost_usd")
    c = c if is_num(c) else 0.0
    live = job.get("live_cost_usd")
    if job.get("state") == "running" and is_num(live):
        c += live
    return c


def tail_events(path, offset):
    """New complete lines of a file since offset (None = start at the end). -> (events, new_offset)."""
    try:
        size = os.path.getsize(path)
    except OSError:
        return [], offset
    if offset is None:
        return [], size
    if size < offset:
        offset = 0
    out = []
    try:
        with open(path, "rb") as fh:
            fh.seek(offset)
            data = fh.read()
    except OSError:
        return [], offset
    end = data.rfind(b"\n")
    if end < 0:
        return [], offset
    for line in data[:end].splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out, offset + end + 1


def cmd_tick(args):
    root = os.path.abspath(args.root)
    mode = resolve_mode(root)
    if mode == "off":
        return 0
    now = int(time.time())
    cfg = load_cfg(root)
    ldir = os.path.join(root, "limiter")
    sweep_stale_tmp(ldir)
    prev = read_json(os.path.join(ldir, "state.json")) or {}
    if not isinstance(prev, dict) or prev.get("v") != 1:
        prev = {}

    feed = read_feed(root, now)
    gate = read_gate(root, now)
    burns = burn_table(root, cfg, now)

    # jobs
    running, ready, costs, annotations, active = [], [], {}, [], []
    class_cache = dict(prev.get("class_cache") or {})

    def class_of(j):
        key = "%s|%s|%s" % (j.get("repo") or "", j.get("repo_path") or "", origin_url(j.get("repo_path")))
        if (j.get("crew") or {}).get("phi_sensitive") is True:
            return "company"
        if key not in class_cache:
            class_cache[key] = classify(root, j.get("repo_path"), j.get("repo") or "")
        return class_cache[key]

    dl = read_json(os.path.join(root, "runner", "dispatch-last.json")) or {}
    dl_ts = dl.get("ts") if is_num(dl.get("ts")) else 0
    spawned_hint = set()
    if dl_ts > (prev.get("dispatch_ts") or 0) and isinstance(dl.get("spawned"), list):
        spawned_hint.update(x for x in dl["spawned"] if isinstance(x, str))
    jobs_dir = os.path.join(root, "jobs")
    for name in sorted(os.listdir(jobs_dir)) if os.path.isdir(jobs_dir) else []:
        if not name.endswith(".json"):
            continue
        j = read_json(os.path.join(jobs_dir, name))
        if not isinstance(j, dict) or not j.get("id"):
            continue
        costs[j["id"]] = job_cost(j)
        state = j.get("state")
        if state in TERMINAL:
            continue
        active.append(j)
        lim = j.get("limiter") if isinstance(j.get("limiter"), dict) else {}
        est = lim.get("estimate") if isinstance(lim.get("estimate"), dict) else None
        dclass = j.get("data_class")
        changed = {}
        if state in ("ready", "queued"):
            if dclass not in ("company", "personal"):
                dclass = class_of(j)
                changed["data_class"] = dclass
            age = now - (parse_iso(est.get("computed_at")) or 0) if est else None
            if est is None or age >= 3600:
                est = core.estimate_burn(j.get("repo") or "unknown", actor_of(j), burns, cfg, iso(now))
                changed["estimate"] = est
        elif dclass not in ("company", "personal"):
            dclass = class_of(j)
        info = {"id": j["id"], "data_class": dclass, "priority_adjust": j.get("priority_adjust"),
                "created_at": j.get("created_at") or "", "started_at": j.get("started_at"),
                "force_start": j.get("force_start") is True,
                "usd_per_min": est.get("usd_per_min") if est else None,
                "_changed": changed, "_lim": lim, "_state": state}
        if state == "running":
            # a job the runner started since the last tick is judged as it was before dispatch
            (ready if j["id"] in spawned_hint else running).append(info)
        elif state == "ready":
            nb = j.get("not_before")
            if not (is_num(nb) and nb > now):
                ready.append(info)
        if changed or state == "ready":
            annotations.append(info)

    # cumulative Mother spend
    delta, seen = core.advance_cumulative(prev.get("job_costs") or {}, costs)
    cum = float(prev.get("mother_cum_usd") or 0.0) + delta

    # distress scan: new bytes of each live job's log, plus failure_routed events (a
    # rate-limited job is back in `ready`, so events are read for every non-terminal job).
    # A running job's log first seen after the first tick is read from its run's start; an events
    # file (and everything on the very first tick) is seeded at its end so old history is not replayed.
    offsets = dict(prev.get("offsets") or {})
    events, overage_in_use, live = [], False, set()
    for j in active:
        jid = j["id"]
        for kind, path in (("log", os.path.join(root, "logs", "%s.log" % jid)),
                           ("ev", os.path.join(root, "events", "%s.jsonl" % jid))):
            if kind == "log" and j.get("state") != "running":
                continue
            key = "%s:%s" % (kind, jid)
            live.add(key)
            off = offsets.get(key)
            if off is None and prev and kind == "log":
                cur = (j.get("current_run") or {}).get("log_offset")
                off = cur if isinstance(cur, int) else 0
            # An events file a job is new to the active set with is seeded at its end (off stays
            # None): a retried/resumed job's offset was pruned when it went terminal, and re-reading
            # from byte 0 would replay an old rate_limited/api_overloaded event as fresh distress.
            new, offsets[key] = tail_events(path, off)
            for ev in new:
                d = core.classify_log_event(ev) if kind == "log" else core.classify_mother_event(ev)
                if d:
                    d["job_id"] = jid
                    events.append(d)
                rl = ev.get("rate_limit_info") if isinstance(ev, dict) else None
                if isinstance(rl, dict) and (rl.get("isUsingOverage") or rl.get("overageInUse")):
                    overage_in_use = True
    offsets = {k: v for k, v in offsets.items() if k in live}
    if feed["five_hour"]["used_pct"] >= 100 and feed["overage_enabled"]:
        overage_in_use = True

    inp = {"feed": feed, "gate": gate, "ceiling": cfg["ceiling"], "overage_in_use": overage_in_use,
           "running": [{k: v for k, v in r.items() if not k.startswith("_")} for r in running],
           "ready": [{k: v for k, v in r.items() if not k.startswith("_")} for r in ready],
           "mother_cum_usd": cum, "distress": events}
    st = core.tick(inp, prev, now, cfg)
    st.update(mode=mode, offsets=offsets, job_costs=seen, mother_cum_usd=cum, class_cache=class_cache,
              dispatch_ts=max(dl_ts, prev.get("dispatch_ts") or 0))
    st["budget"].update(source=feed["source"], feed_age_s=feed["feed_age_s"])

    # annotations: only what changed, and only for jobs nothing else is writing
    by_ready = {r["id"]: r for r in st["ready"]}
    out_ann = []
    for a in annotations:
        ann = {"id": a["id"]}
        ann.update(a["_changed"])
        r = by_ready.get(a["id"])
        if r and a["_state"] == "ready":
            w = {"code": r["code"], "reason": r["reason"], "advisory": r["advisory"]}
            cur = a["_lim"].get("would") if isinstance(a["_lim"].get("would"), dict) else {}
            if any(cur.get(k) != w[k] for k in ("code", "advisory")):  # reason text carries a number: not a change
                w["at"] = iso(now)
                ann["would"] = w
        if len(ann) > 1:
            out_ann.append(ann)

    write_json_atomic(os.path.join(ldir, "state.json"), st)
    write_decision(root, ldir, st, dl, spawned_hint, now)
    print(json.dumps({"annotations": out_ann}, separators=(",", ":")))
    return 0


def write_decision(root, ldir, st, dl, spawned_hint, now):
    would = core.would_summary(st)
    actual = {"spawned": sorted(spawned_hint), "skipped": dl.get("skipped") or [],
              "ratelimit_paused": bool(dl.get("ratelimit_paused")), "quota_over_cap": bool(dl.get("quota_over_cap")),
              "low_disk": bool(dl.get("low_disk")), "running": dl.get("running")}
    div = []
    held = {h["id"]: h["code"] for h in would["hold"]}
    for jid in sorted(spawned_hint):
        if jid in held:
            div.append({"id": jid, "kind": "would_hold_but_spawned", "code": held[jid]})
    for r in st["running"]:
        if r["would_hold"]:
            div.append({"id": r["id"], "kind": "would_hold_running_but_running"})
    line = {"ts": iso(now), "mode": "observe", "allowed": st["allowed"], "running": len(st["running"]),
            "would": would, "actual": actual, "divergence": div}
    sig = json.dumps([would, div, st["allowed"]], sort_keys=True)
    sig_path = os.path.join(ldir, "decisions.sig")
    last = read_json(sig_path) or {}
    if last.get("sig") == sig and now - (last.get("at") or 0) < 300:
        return
    path = os.path.join(ldir, "decisions.jsonl")
    max_mb = num_setting(root, "MOTHER_LIMITER_DECISIONS_MAX_MB", 20)
    try:
        if os.path.getsize(path) > max_mb * 1024 * 1024:
            os.replace(path, path + ".1")
    except OSError:
        pass
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(line, separators=(",", ":")) + "\n")
    write_json_atomic(sig_path, {"sig": sig, "at": now})


# ---------- other subcommands ----------

def cmd_status(args):
    root = os.path.abspath(args.root)
    mode = resolve_mode(root)
    p = os.path.join(root, "limiter", "state.json")
    st = read_json(p)
    if not isinstance(st, dict):
        print(json.dumps({"mode": mode, "state": None}))
        return 0
    try:
        age = max(0, int(time.time() - os.stat(p).st_mtime))
    except OSError:
        age = None
    print(json.dumps({"mode": mode, "age_s": age, "state": st}, separators=(",", ":")))
    return 0


def cmd_estimate(args):
    root = os.path.abspath(args.root)
    job = read_json(args.job)
    if not isinstance(job, dict):
        print("mother-limiter: cannot read job file", file=sys.stderr)
        return 1
    cfg = load_cfg(root)
    est = core.estimate_burn(job.get("repo") or "unknown", actor_of(job), burn_table(root, cfg, int(time.time())), cfg, iso(int(time.time())))
    print(json.dumps(est, separators=(",", ":")))
    return 0


def cmd_classify(args):
    root = os.environ.get("MOTHER_ROOT") or os.environ.get("MOTHER_LIVE_ROOT") or os.path.join(os.path.expanduser("~"), ".mother")
    print(classify(root, args.work_dir, args.repo))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="mother-limiter")
    sub = ap.add_subparsers(dest="cmd", required=True)
    t = sub.add_parser("tick"); t.add_argument("--root", required=True); t.set_defaults(fn=cmd_tick)
    s = sub.add_parser("status"); s.add_argument("--json", action="store_true"); s.add_argument("--root", required=True)
    s.set_defaults(fn=cmd_status)
    e = sub.add_parser("estimate"); e.add_argument("--root", required=True); e.add_argument("--job", required=True)
    e.set_defaults(fn=cmd_estimate)
    c = sub.add_parser("classify"); c.add_argument("--work-dir", default=""); c.add_argument("--repo", required=True)
    c.set_defaults(fn=cmd_classify)
    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
