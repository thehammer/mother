#!/usr/bin/env python3
"""mother-limiter — I/O shell around lib/limiter_core.py (observe-only, L1).

  mother-limiter tick     --root R     gather inputs, run the control law, write limiter/state.json,
                                       append limiter/decisions.jsonl, print job annotations (JSON line)
  mother-limiter status   --json [--raw] --root R   the limiter block (L2); --raw = the old {mode, age_s, state}
  mother-limiter signals  --json --root R           raw window/pace/burn/reserve/distress values (L2)
  mother-limiter report   [--since 24h|ISO] [--json] --root R   would vs actual, distress rate, verdicts (L2)
  mother-limiter estimate --root R --job <job.json>   MC-38 expected-burn object
  mother-limiter classify --work-dir D --repo NAME    company | personal

Observe only: nothing here changes what the runner dispatches. Stdlib only.
"""

import argparse
import json
import math
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))
import limiter_core as core  # noqa: E402

KNOBS = {  # env name -> (cfg key, default, int?)
    "MOTHER_LIMITER_RESERVE_PCT": ("reserve_pct", 15, False),
    "MOTHER_LIMITER_BURN_WINDOW_S": ("burn_window_s", 600, False),
    "MOTHER_LIMITER_DEFAULT_BURN_USD_PER_MIN": ("default_burn_usd_per_min", 0.5, False),
    "MOTHER_LIMITER_HISTORY_N": ("history_n", 20, True),
    "MOTHER_LIMITER_HISTORY_MIN": ("history_min", 3, True),
    "MOTHER_LIMITER_CALM_S": ("calm_s", 900, False),
    "MOTHER_LIMITER_COALESCE_S": ("coalesce_s", 120, False),
    "MOTHER_LIMITER_RAMP_START": ("ramp_start", 2, True),
    "MOTHER_LIMITER_RAMP_STEP_S": ("ramp_step_s", 300, False),
    "MOTHER_LIMITER_INTERACTIVE_PCT_H": ("interactive_pct_h", 10, False),
    "MOTHER_LIMITER_INTERACTIVE_SUSTAIN_S": ("interactive_sustain_s", 600, False),
    "MOTHER_LIMITER_K_MIN_SAMPLES": ("k_min_samples", 12, True),
}
TERMINAL = ("succeeded", "failed", "cancelled")


def warn(msg):
    print("mother-limiter: " + msg, file=sys.stderr)


# ---------- config: env, then config.env, then default ----------

def _config_env(root):
    out = {}
    try:
        with open(os.path.join(root, "config.env")) as fh:
            for line in fh:
                line = line.rstrip("\n")
                if not re.match(r"^MOTHER_[A-Z0-9_]*=", line):
                    continue
                k, v = line.split("=", 1)
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                out[k] = v
    except OSError:
        pass
    return out


def setting(root, name, default=None):
    if name in os.environ:
        return os.environ[name]
    return _config_env(root).get(name, default)


def num_setting(root, name, default, as_int=False):
    raw = setting(root, name, None)
    if raw is None or raw == "":
        return default
    try:
        v = float(raw)
        if math.isnan(v) or math.isinf(v) or v < 0:
            raise ValueError
    except ValueError:
        warn("%s=%r is not a non-negative number; using %s" % (name, raw, default))
        return default
    return int(v) if as_int else v


def load_cfg(root):
    cfg = core.make_cfg()
    for env, (key, default, as_int) in KNOBS.items():
        cfg[key] = num_setting(root, env, default, as_int)
    ceil = num_setting(root, "MOTHER_CONCURRENCY", 2, True)
    cfg["ceiling"] = max(1, ceil)
    return cfg


def resolve_mode(root):
    """env off wins; then mode.json (observe|enforce|off); default observe. Env `enforce` is never
    honoured: enforcement is switched on by a human with `mother limiter mode enforce`."""
    env = os.environ.get("MOTHER_LIMITER_MODE", "")
    if env == "off":
        return "off"
    if env and env != "observe":
        warn("MOTHER_LIMITER_MODE=%r is not honoured (only off); use `mother limiter mode`" % env)
    try:
        with open(os.path.join(root, "limiter", "mode.json")) as fh:
            m = json.load(fh).get("mode")
    except (OSError, ValueError, AttributeError):
        m = None
    return m if m in ("off", "enforce") else "observe"


# ---------- small helpers ----------

def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception:
        return None


def write_json_atomic(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.tmp.%d" % (path, os.getpid())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, ensure_ascii=False, separators=(",", ":"))
            fh.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def sweep_stale_tmp(ldir):
    """Remove limiter/*.tmp.<pid> files whose writer is dead (a killed tick leaves them behind)."""
    try:
        names = os.listdir(ldir)
    except OSError:
        return
    for name in names:
        m = re.search(r"\.tmp\.(\d+)$", name)
        if not m:
            continue
        pid = int(m.group(1))
        if pid == os.getpid():
            continue
        try:
            os.kill(pid, 0)
            continue  # writer still alive
        except ProcessLookupError:
            pass
        except OSError:
            continue
        try:
            os.unlink(os.path.join(ldir, name))
        except OSError:
            pass


def iso(ts):
    return datetime.fromtimestamp(ts, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_iso(s):
    if not isinstance(s, str) or not s:
        return None
    m = re.match(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?(Z|[+-]\d\d:\d\d)?$", s)
    if not m:
        return None
    try:
        dt = datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc)
    except ValueError:
        return None
    return dt.timestamp()


def is_num(v):
    return isinstance(v, (int, float)) and not isinstance(v, bool)


# ---------- budget feed (mirrors lib/state.sh _quota_feed_json / _quota_gate_read) ----------

def _normalize(path, kind):
    d = read_json(path)
    if not isinstance(d, dict):
        return None
    if kind == "bishop" and d.get("stale_input") is True:
        return None
    out = {}
    for key in ("five_hour", "seven_day"):
        w = d.get(key)
        if not isinstance(w, dict):
            return None
        used = w.get("used_pct")
        if used is None or used is False:
            used = w.get("used_percentage")
        if not is_num(used):
            return None
        at = w.get("resets_at")
        out[key] = {"used_pct": used, "resets_at": int(math.floor(at)) if is_num(at) else 0}
        for extra in ("pace", "pace_smoothed", "elapsed_pct"):
            if is_num(w.get(extra)):
                out[key][extra] = w[extra]
    ov = d.get("overage")
    out["overage_enabled"] = bool(isinstance(ov, dict) and ov.get("enabled"))
    return out


def read_feed(root, now):
    maxage = num_setting(root, "MOTHER_QUOTA_FEED_MAX_AGE_S", 1800, True)
    paths = [("bishop", setting(root, "MOTHER_BISHOP_POSTURE_FILE", os.path.join(os.path.expanduser("~"), ".claude", "budget-posture.json"))),
             ("cache", setting(root, "MOTHER_RATE_LIMIT_CACHE", os.path.join(root, "rate-limits.json")))]
    src, age, win, best_age = "none", None, None, None
    for kind, f in paths:
        try:
            mtime = int(os.stat(f).st_mtime)
        except OSError:
            continue
        a = int(now) - mtime
        if a < 0:
            continue
        w = _normalize(f, kind)
        if w is None:
            continue
        if best_age is None or a < best_age:
            best_age = a
        if a <= maxage:
            src, age, win = kind, a, w
            break
    if win is None:
        win = {"five_hour": {"used_pct": 0, "resets_at": 0}, "seven_day": {"used_pct": 0, "resets_at": 0},
               "overage_enabled": False}
    if age is None:
        age = best_age
    for key in ("five_hour", "seven_day"):
        w = win[key]
        if w["resets_at"] > 0 and now > w["resets_at"]:
            w["used_pct"] = 0
    return {"source": src, "feed_age_s": age, "stale": src == "none",
            "five_hour": win["five_hour"], "seven_day": win["seven_day"],
            "overage_enabled": win["overage_enabled"]}


def read_gate(root, now):
    d = read_json(os.path.join(root, "quota-gate.json"))
    if isinstance(d, dict) and d.get("state") == "off":
        return "off"
    if isinstance(d, dict) and d.get("state") == "off_until_reset":
        u = d.get("until")
        return "off_until_reset" if not is_num(u) or now < u else "on"
    return "on"


# ---------- data class (MC-38) ----------

def _list_setting(root, name, default=""):
    raw = setting(root, name, None)
    return (default if raw is None else raw).split()


def origin_owner(url):
    m = re.search(r"[:/]([^/:]+)/[^/]+?(?:\.git)?/?$", (url or "").strip())
    return m.group(1).lower() if m else None


def origin_url(work_dir):
    """The repo's origin URL ('' if none): part of the class cache key so a changed origin is re-read."""
    try:
        if work_dir and os.path.isdir(work_dir):
            r = subprocess.run(["git", "-C", work_dir, "remote", "get-url", "origin"],
                               capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                return r.stdout.strip()
    except Exception:
        pass
    return ""


def crew_phi_sensitive(work_dir):
    """True when the repo's .mother/crew.yml (working copy) declares phi_sensitive: true. Best effort."""
    try:
        if not (work_dir and os.path.isdir(work_dir)):
            return False
        path = os.path.join(work_dir, ".mother", "crew.yml")
        if not os.path.isfile(path):
            return False
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                if re.match(r"^\s*phi_sensitive\s*:\s*true\s*(#.*)?$", line, re.I):
                    return True
    except Exception:
        pass
    return False


def classify(root, work_dir, repo):
    try:
        if repo in _list_setting(root, "MOTHER_PHI_REPOS", "admin-portal referral-monitor"):
            return "company"
        if repo in _list_setting(root, "MOTHER_COMPANY_REPOS", ""):
            return "company"
        if crew_phi_sensitive(work_dir):
            return "company"
        if origin_owner(origin_url(work_dir)) == "carefeed":
            return "company"
    except Exception:
        pass
    return "personal"


# ---------- burn history (MC-38) ----------

def iter_job_files(root):
    jobs = os.path.join(root, "jobs")
    if os.path.isdir(jobs):
        for name in sorted(os.listdir(jobs)):
            if name.endswith(".json"):
                d = read_json(os.path.join(jobs, name))
                if isinstance(d, dict):
                    yield d, False
    arch = os.path.join(root, "archive")
    if os.path.isdir(arch):
        for month in sorted(os.listdir(arch)):
            md = os.path.join(arch, month)
            if not os.path.isdir(md):
                continue
            for name in sorted(os.listdir(md)):
                if name.endswith(".json") and not name.endswith(".events.jsonl"):
                    d = read_json(os.path.join(md, name))
                    if isinstance(d, dict):
                        yield d, True


def events_path(root, job, archived):
    jid = job.get("id")
    if archived:
        return os.path.join(root, "archive", (job.get("finished_at") or "")[:7] or "unknown", "%s.events.jsonl" % jid)
    return os.path.join(root, "events", "%s.jsonl" % jid)


def read_jsonl(path, start=0):
    out = []
    try:
        with open(path, "rb") as fh:
            fh.seek(start)
            for line in fh.read().splitlines():
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return out


def actor_of(job):
    return "pipeline" if job.get("kind") == "pipeline" else "cody"


def active_minutes(root, job, archived):
    """Wall time minus queue wait, quota pauses and human waits (as `mother-usage retro` does)."""
    created, finished, started = (parse_iso(job.get(k)) for k in ("created_at", "finished_at", "started_at"))
    if created is None or finished is None:
        return None
    total = finished - created
    queue = (started - created) if started else 0.0
    quota = human = 0.0
    qp = hp = None
    for e in read_jsonl(events_path(root, job, archived)):
        ts, kind = parse_iso(e.get("ts")), e.get("kind")
        if kind == "paused_for_quota":
            qp = ts
        elif kind == "awaiting_input":
            hp = ts
        elif kind in ("resumed", "auto_resumed") and ts:
            if qp:
                quota += ts - qp
                qp = None
            if hp:
                human += ts - hp
                hp = None
    return max(total - queue - quota - human, 0.0) / 60.0


def finished_burns(root):
    rows = []
    for job, archived in iter_job_files(root):
        if job.get("state") not in ("succeeded", "failed"):
            continue
        cost = job.get("actual_cost_usd")
        if not is_num(cost) or cost <= 0:
            continue
        mins = active_minutes(root, job, archived)
        if not mins or mins < 1.0:
            continue
        rows.append({"repo": job.get("repo") or "unknown", "actor": actor_of(job),
                     "usd_per_min": cost / mins, "finished_at": job.get("finished_at") or ""})
    return rows


def burn_table(root, cfg, now, max_age_s=3600):
    path = os.path.join(root, "limiter", "burn-history.json")
    cached = read_json(path)
    if isinstance(cached, dict) and now - (cached.get("computed_ts") or 0) < max_age_s \
            and isinstance(cached.get("rows"), list):
        return cached["rows"]
    rows = finished_burns(root)
    try:
        write_json_atomic(path, {"computed_ts": now, "rows": rows})
    except OSError:
        pass
    return rows


# ---------- tick ----------

def job_cost(job):
    c = job.get("actual_cost_usd")
    c = c if is_num(c) else 0.0
    live = job.get("live_cost_usd")
    if job.get("state") == "running" and is_num(live):
        c += live
    return c


def tail_events(path, offset):
    """New complete lines of a file since offset (None = start at the end). -> (events, new_offset)."""
    try:
        size = os.path.getsize(path)
    except OSError:
        return [], offset
    if offset is None:
        return [], size
    if size < offset:
        offset = 0
    out = []
    try:
        with open(path, "rb") as fh:
            fh.seek(offset)
            data = fh.read()
    except OSError:
        return [], offset
    end = data.rfind(b"\n")
    if end < 0:
        return [], offset
    for line in data[:end].splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    return out, offset + end + 1


def _cap_pct(root, name):
    raw = str(setting(root, name, "90") or "90").strip().rstrip("%")
    try:
        return float(raw)
    except ValueError:
        return 90.0


def _fmt_pct(v):
    return ("%g" % round(float(v), 1))


def _fmt_wait(left):
    left = int(left)
    return "%ds" % left if left < 60 else "%dm" % ((left + 59) // 60)


def actual_wait(job, now, dl, feed, cfg, n_running, root, enforce=False):
    """(code, reason): what actually holds a ready/queued job today, in dispatch's own order (MC-39).
    Under enforce the fixed rate-limit pause is gone (the limiter's backoff replaces it) and a slot or
    budget hold is the limiter's: the caller overlays it."""
    dw = job.get("dep_wait") if isinstance(job.get("dep_wait"), dict) else None
    if job.get("state") == "queued":
        reason = (dw or {}).get("reason") or "waiting on dependencies"
        return "dep_wait", str(reason)
    nb = job.get("not_before")
    if is_num(nb) and nb > now:
        return "backoff", "rate-limit backoff, starts in %s" % _fmt_wait(nb - now)
    if dl.get("ratelimit_paused") and not enforce:
        return "ratelimit_paused", "rate-limit pause: nothing new starts"
    if dl.get("quota_over_cap") and job.get("force_start") is not True:
        for label, key, env in (("5h", "five_hour", "MOTHER_QUOTA_CAP_5H_PCT"), ("7d", "seven_day", "MOTHER_QUOTA_CAP_7D_PCT")):
            cap, used = _cap_pct(root, env), feed[key]["used_pct"]
            if used >= cap:
                return "quota_over_cap", "quota gate: %s at %s%% \u2265 cap %s%%" % (label, _fmt_pct(used), _fmt_pct(cap))
        return "quota_over_cap", "quota gate: over cap"
    if dl.get("low_disk"):
        return "low_disk", "low disk: dispatch paused"
    if n_running >= cfg["ceiling"]:
        return "concurrency_full", "%d of %d running" % (n_running, cfg["ceiling"])
    return "next", "next to start"


def cmd_tick(args):
    root = os.path.abspath(args.root)
    mode = resolve_mode(root)
    if mode == "off":
        return 0
    enforcing = mode == "enforce"
    now = int(time.time())
    cfg = load_cfg(root)
    ldir = os.path.join(root, "limiter")
    sweep_stale_tmp(ldir)
    prev = read_json(os.path.join(ldir, "state.json")) or {}
    if not isinstance(prev, dict) or prev.get("v") != 1:
        prev = {}

    feed = read_feed(root, now)
    gate = read_gate(root, now)
    burns = burn_table(root, cfg, now)

    # jobs
    running, ready, costs, annotations, active = [], [], {}, [], []
    n_running_jobs = 0
    class_cache = dict(prev.get("class_cache") or {})

    def class_of(j):
        key = "%s|%s|%s" % (j.get("repo") or "", j.get("repo_path") or "", origin_url(j.get("repo_path")))
        if (j.get("crew") or {}).get("phi_sensitive") is True:
            return "company"
        if key not in class_cache:
            class_cache[key] = classify(root, j.get("repo_path"), j.get("repo") or "")
        return class_cache[key]

    dl = read_json(os.path.join(root, "runner", "dispatch-last.json")) or {}
    dl_ts = dl.get("ts") if is_num(dl.get("ts")) else 0
    spawned_hint = set()
    if dl_ts > (prev.get("dispatch_ts") or 0) and isinstance(dl.get("spawned"), list):
        spawned_hint.update(x for x in dl["spawned"] if isinstance(x, str))
    jobs_dir = os.path.join(root, "jobs")
    for name in sorted(os.listdir(jobs_dir)) if os.path.isdir(jobs_dir) else []:
        if not name.endswith(".json"):
            continue
        j = read_json(os.path.join(jobs_dir, name))
        if not isinstance(j, dict) or not j.get("id"):
            continue
        costs[j["id"]] = job_cost(j)
        state = j.get("state")
        if state == "running":
            n_running_jobs += 1
        if state in TERMINAL:
            continue
        active.append(j)
        lim = j.get("limiter") if isinstance(j.get("limiter"), dict) else {}
        est = lim.get("estimate") if isinstance(lim.get("estimate"), dict) else None
        dclass = j.get("data_class")
        changed = {}
        if state in ("ready", "queued"):
            if dclass not in ("company", "personal"):
                dclass = class_of(j)
                changed["data_class"] = dclass
            age = now - (parse_iso(est.get("computed_at")) or 0) if est else None
            if est is None or age >= 3600:
                est = core.estimate_burn(j.get("repo") or "unknown", actor_of(j), burns, cfg, iso(now))
                changed["estimate"] = est
        elif dclass not in ("company", "personal"):
            dclass = class_of(j)
        info = {"id": j["id"], "data_class": dclass, "priority_adjust": j.get("priority_adjust"),
                "created_at": j.get("created_at") or "", "started_at": j.get("started_at"),
                "force_start": j.get("force_start") is True,
                "usd_per_min": est.get("usd_per_min") if est else None,
                "_changed": changed, "_lim": lim, "_state": state}
        if state == "running":
            # a job the runner started since the last tick is judged as it was before dispatch
            (ready if j["id"] in spawned_hint else running).append(info)
        elif state == "ready":
            nb = j.get("not_before")
            if not (is_num(nb) and nb > now):
                ready.append(info)
        if changed or state in ("ready", "queued"):
            info["_job"] = j
            annotations.append(info)

    # cumulative Mother spend
    delta, seen = core.advance_cumulative(prev.get("job_costs") or {}, costs)
    cum = float(prev.get("mother_cum_usd") or 0.0) + delta

    # distress scan: new bytes of each live job's log, plus failure_routed events (a
    # rate-limited job is back in `ready`, so events are read for every non-terminal job).
    # A running job's log first seen after the first tick is read from its run's start; an events
    # file (and everything on the very first tick) is seeded at its end so old history is not replayed.
    offsets = dict(prev.get("offsets") or {})
    events, overage_in_use, live = [], False, set()
    for j in active:
        jid = j["id"]
        for kind, path in (("log", os.path.join(root, "logs", "%s.log" % jid)),
                           ("ev", os.path.join(root, "events", "%s.jsonl" % jid))):
            if kind == "log" and j.get("state") != "running":
                continue
            key = "%s:%s" % (kind, jid)
            live.add(key)
            off = offsets.get(key)
            if off is None and prev and kind == "log":
                cur = (j.get("current_run") or {}).get("log_offset")
                off = cur if isinstance(cur, int) else 0
            # An events file a job is new to the active set with is seeded at its end (off stays
            # None): a retried/resumed job's offset was pruned when it went terminal, and re-reading
            # from byte 0 would replay an old rate_limited/api_overloaded event as fresh distress.
            new, offsets[key] = tail_events(path, off)
            for ev in new:
                d = core.classify_log_event(ev) if kind == "log" else core.classify_mother_event(ev)
                if d:
                    d["job_id"] = jid
                    events.append(d)
                rl = ev.get("rate_limit_info") if isinstance(ev, dict) else None
                if isinstance(rl, dict) and (rl.get("isUsingOverage") or rl.get("overageInUse")):
                    overage_in_use = True
    offsets = {k: v for k, v in offsets.items() if k in live}
    if feed["five_hour"]["used_pct"] >= 100 and feed["overage_enabled"]:
        overage_in_use = True

    inp = {"feed": feed, "gate": gate, "ceiling": cfg["ceiling"], "overage_in_use": overage_in_use,
           "running": [{k: v for k, v in r.items() if not k.startswith("_")} for r in running],
           "ready": [{k: v for k, v in r.items() if not k.startswith("_")} for r in ready],
           "mother_cum_usd": cum, "distress": events}
    st = core.tick(inp, prev, now, cfg)
    if events:
        try:
            with open(os.path.join(ldir, "distress.jsonl"), "a", encoding="utf-8") as fh:
                for e in events:
                    fh.write(json.dumps({"ts": iso(now), "job_id": e.get("job_id"), "kind": e.get("kind"),
                                         "status": e.get("status")}, separators=(",", ":")) + "\n")
        except OSError:
            pass
    # A job dispatch started since the last tick is judged as it was before dispatch (so it counts against
    # `allowed` and keeps divergence honest) but is no longer startable: drop it from the admit list.
    st["admit"] = [i for i in st.get("admit", []) if i not in spawned_hint]
    st.update(mode=mode, offsets=offsets, job_costs=seen, mother_cum_usd=cum, class_cache=class_cache,
              dispatch_ts=max(dl_ts, prev.get("dispatch_ts") or 0))
    st["budget"].update(source=feed["source"], feed_age_s=feed["feed_age_s"])

    # annotations: only what changed, and only for jobs nothing else is writing
    by_ready = {r["id"]: r for r in st["ready"]}
    out_ann, waiting = [], []
    for a in annotations:
        ann = {"id": a["id"]}
        ann.update(a["_changed"])
        r = by_ready.get(a["id"])
        if r and a["_state"] == "ready":
            w = {"code": r["code"], "reason": r["reason"], "advisory": r["advisory"]}
            cur = a["_lim"].get("would") if isinstance(a["_lim"].get("would"), dict) else {}
            if any(cur.get(k) != w[k] for k in ("code", "advisory")):  # reason text carries a number: not a change
                w["at"] = iso(now)
                ann["would"] = w
        if a["_state"] in ("ready", "queued"):
            code, reason = actual_wait(a["_job"], now, dl, feed, cfg, n_running_jobs, root, enforce=enforcing)
            source, w_advisory = "dispatch", False
            if enforcing and r and a["_state"] == "ready" and code in ("concurrency_full", "next") \
                    and (r["decision"] == "hold" or r["advisory"]):
                # enforcement: the limiter's own hold (slots, backoff, ramp, budget terms) is what
                # keeps this job waiting; an advisory budget term (bet B3) is shown but admitted.
                code, reason, source, w_advisory = r["code"], r["reason"], "limiter", bool(r["advisory"])
            would = None
            if r and r["decision"] == "hold" and r["code"] != code:
                would = {"code": r["code"], "reason": r["reason"]}
            old_w = a["_lim"].get("wait") if isinstance(a["_lim"].get("wait"), dict) else {}
            same = old_w.get("code") == code and old_w.get("source") == source \
                and bool(old_w.get("advisory")) == w_advisory and isinstance(old_w.get("since"), str)
            since = old_w["since"] if same else iso(now)
            waiting.append({"id": a["id"], "code": code, "reason": reason, "source": source,
                            "advisory": w_advisory, "would": would, "since": since,
                            "_created": a["created_at"]})
            if not same:  # rewritten only when the code changes
                ann["wait"] = {"code": code, "reason": reason, "source": source, "advisory": w_advisory,
                               "would": would, "since": since}
        if len(ann) > 1:
            out_ann.append(ann)
    waiting.sort(key=lambda w: (w["_created"], w["id"]))
    st["waiting"] = [{k: v for k, v in w.items() if k != "_created"} for w in waiting]

    write_json_atomic(os.path.join(ldir, "state.json"), st)
    write_decision(root, ldir, st, dl, spawned_hint, now)
    print(json.dumps({"annotations": out_ann}, separators=(",", ":")))
    return 0


def write_decision(root, ldir, st, dl, spawned_hint, now):
    would = core.would_summary(st)
    actual = {"spawned": sorted(spawned_hint), "skipped": dl.get("skipped") or [],
              "ratelimit_paused": bool(dl.get("ratelimit_paused")), "quota_over_cap": bool(dl.get("quota_over_cap")),
              "low_disk": bool(dl.get("low_disk")), "running": dl.get("running"), "ceiling": dl.get("ceiling")}
    div = []
    held = {h["id"]: h["code"] for h in would["hold"]}
    for jid in sorted(spawned_hint):
        if jid in held:
            div.append({"id": jid, "kind": "would_hold_but_spawned", "code": held[jid]})
    # Holding a RUNNING job is L4: under enforce this slice does not act on it, so it is not a divergence.
    for r in st["running"]:
        if r["would_hold"] and st.get("mode") != "enforce":
            div.append({"id": r["id"], "kind": "would_hold_running_but_running"})
    line = {"ts": iso(now), "mode": st.get("mode") or "observe", "allowed": st["allowed"], "running": len(st["running"]),
            "would": would, "actual": actual, "divergence": div,
            "window": {"used_pct_5h": st["budget"]["five_hour"].get("used_pct"), "gate": st["budget"].get("gate")}}
    sig = json.dumps([would, div, st["allowed"], actual["spawned"]], sort_keys=True)
    sig_path = os.path.join(ldir, "decisions.sig")
    last = read_json(sig_path) or {}
    if last.get("sig") == sig and now - (last.get("at") or 0) < 300:
        return
    path = os.path.join(ldir, "decisions.jsonl")
    max_mb = num_setting(root, "MOTHER_LIMITER_DECISIONS_MAX_MB", 20)
    try:
        if os.path.getsize(path) > max_mb * 1024 * 1024:
            os.replace(path, path + ".1")
    except OSError:
        pass
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(line, separators=(",", ":")) + "\n")
    write_json_atomic(sig_path, {"sig": sig, "at": now})


# ---------- other subcommands ----------

def _finite(v, nd=None):
    if not is_num(v) or math.isnan(v) or math.isinf(v):
        return None
    return round(v, nd) if nd is not None else v


def _num(v):
    """Whole floats print as ints (15.0 -> 15) so the block reads naturally."""
    return int(v) if is_num(v) and float(v).is_integer() else v


def _ago_text(secs):
    secs = max(0, int(secs))
    if secs < 60:
        return "%ds" % secs
    if secs < 3600:
        return "%dm" % (secs // 60)
    return "%dh" % (secs // 3600) if secs < 86400 else "%dd" % (secs // 86400)


def _in_text(secs):
    """A countdown, rounded up so '+1 in 9m' does not flicker to 8m a second later."""
    secs = max(0, int(secs))
    return "%ds" % secs if secs < 60 else "%dm" % ((secs + 59) // 60)


def _concurrency_state(st, cfg, now):
    comp = st.get("components") or {}
    ceiling = st.get("ceiling") or cfg["ceiling"]
    bo_lv = comp.get("backoff_level", ceiling)
    bo = st.get("backoff") or {}
    ld = comp.get("last_distress") or {}
    if bo_lv < ceiling:
        cut = comp.get("last_cut_at")
        base = max(bo.get("last_distress_at") or 0, bo.get("last_raise_at") or 0)
        left = max(0, cfg["calm_s"] - (now - base)) if base else cfg["calm_s"]
        bits = []
        if cut:
            bits.append("cut %s ago" % _ago_text(now - cut) + (" after %s" % ld["status"] if ld.get("status") else ""))
        bits.append("+1 in %s" % _in_text(left))
        return "backoff", "; ".join(bits)
    rp = st.get("ramp") or {}
    if comp.get("ramp_active"):
        left = max(0, cfg["ramp_step_s"] - (now - (rp.get("last_step_at") or now)))
        return "ramp", "ramp-up after window reset (level %s of %s); +1 in %s" % (rp.get("level"), ceiling, _in_text(left))
    b5 = ((st.get("budget") or {}).get("five_hour") or {})
    if not b5.get("calibrated"):
        return "uncalibrated", "k not calibrated (%s of %s samples)" % (b5.get("k_samples", 0), int(cfg["k_min_samples"]))
    return "steady", ""


def build_block(root, now=None):
    """The limiter block (contract: tests/fixtures/limiter_block.json). Built from state.json, the
    runner's fault file and the quota gate; nothing is recomputed."""
    now = int(time.time()) if now is None else now
    mode = resolve_mode(root)
    if mode == "off":
        return {"v": 1, "mode": "off"}
    cfg = load_cfg(root)
    p = os.path.join(root, "limiter", "state.json")
    st = read_json(p)
    if not isinstance(st, dict) or st.get("v") != 1:
        st = None
    try:
        age = max(0, int(now - os.stat(p).st_mtime))
    except OSError:
        age = None
    interval = num_setting(root, "MOTHER_LIMITER_INTERVAL", 10)
    stale = st is None or age is None or age > 3 * interval
    fault = read_json(os.path.join(root, "runner", "limiter-fault.json"))
    block = {"v": 1, "mode": mode, "age_s": age if st is not None else None, "stale": stale,
             "fault": fault if isinstance(fault, dict) else None}
    if st is None:
        block.update(concurrency=None, burn=None, reserve=None, interactive=None, overage_in_use=False,
                     gate=read_gate(root, now), last_distress=None, distress_24h=0, waiting=[])
        return block
    bud, comp = st.get("budget") or {}, st.get("components") or {}
    cstate, detail = _concurrency_state(st, cfg, now)
    block["concurrency"] = {"ceiling": st.get("ceiling"), "allowed": st.get("allowed"),
                            "effective": len(st.get("running") or []), "state": cstate, "detail": detail}
    # burn: the tighter window's pace (5h when neither has one)
    wins = {"five_hour": bud.get("five_hour") or {}, "seven_day": bud.get("seven_day") or {}}
    pick = "five_hour"
    p7, p5 = _finite(wins["seven_day"].get("pace")), _finite(wins["five_hour"].get("pace"))
    if p7 is not None and (p5 is None or p7 > p5):
        pick = "seven_day"
    w = wins[pick]
    k, sus = w.get("k"), w.get("sustainable_pct_per_min")
    block["burn"] = {"fleet_usd_per_min": _finite(bud.get("fleet_usd_per_min"), 2),
                     "sustainable_usd_per_min": _finite(sus / k, 2) if is_num(k) and k > 0 and is_num(sus) else None,
                     "pace": _finite(w.get("pace"), 2), "window": pick, "calibrated": bool(w.get("calibrated"))}
    used5 = wins["five_hour"].get("used_pct")
    reserve = bud.get("reserve_pct")
    block["reserve"] = {"pct": _num(reserve),
                        "holding": bool((not bud.get("stale")) and is_num(used5) and is_num(reserve)
                                        and 100.0 - used5 <= reserve),
                        "enforceable": not bud.get("advisory", True)}
    it = st.get("interactive") or {}
    block["interactive"] = {"state": it.get("state") or "unknown", "pct_per_hour": _finite(it.get("pct_per_hour"), 1)}
    block["overage_in_use"] = bool(bud.get("overage_in_use"))
    block["gate"] = bud.get("gate") or "on"
    ld = comp.get("last_distress")
    if isinstance(ld, dict) and is_num(ld.get("at")):
        block["last_distress"] = {"at": iso(ld["at"]), "ago_s": max(0, int(now - ld["at"])), "kind": ld.get("kind"),
                                  "status": ld.get("status"), "job_id": ld.get("job_id")}
    else:
        block["last_distress"] = None
    block["distress_24h"] = len([t for t in (st.get("distress_log") or []) if now - t < 86400])
    block["waiting"] = [w for w in (st.get("waiting") or []) if isinstance(w, dict)]
    return block


def cmd_status(args):
    root = os.path.abspath(args.root)
    if not args.raw:
        print(json.dumps(build_block(root), separators=(",", ":")))
        return 0
    mode = resolve_mode(root)
    p = os.path.join(root, "limiter", "state.json")
    st = read_json(p)
    if not isinstance(st, dict):
        print(json.dumps({"mode": mode, "state": None}))
        return 0
    try:
        age = max(0, int(time.time() - os.stat(p).st_mtime))
    except OSError:
        age = None
    print(json.dumps({"mode": mode, "age_s": age, "state": st}, separators=(",", ":")))
    return 0


def cmd_signals(args):
    """The raw values behind the block, per window (MC-39 'on demand')."""
    root = os.path.abspath(args.root)
    now = int(time.time())
    block = build_block(root, now)
    if block.get("mode") == "off":
        print(json.dumps(block))
        return 0
    st = read_json(os.path.join(root, "limiter", "state.json"))
    st = st if isinstance(st, dict) and st.get("v") == 1 else {}
    bud, inter = st.get("budget") or {}, st.get("interactive") or {}
    out_w = {}
    for key in ("five_hour", "seven_day"):
        w = bud.get(key) or {}
        out_w[key] = {"used_pct": _finite(w.get("used_pct"), 1), "resets_at": w.get("resets_at") or None,
                      "pace": _finite(w.get("pace"), 2),
                      "sustainable_pct_per_min": _finite(w.get("sustainable_pct_per_min"), 4),
                      "projected_pct_per_min": _finite(w.get("projected_pct_per_min"), 4),
                      "k": _num(_finite(w.get("k"), 3)), "k_samples": w.get("k_samples", 0),
                      "calibrated": bool(w.get("calibrated"))}
    log = st.get("distress_log") or []
    out = {"v": 1, "mode": block["mode"], "age_s": block["age_s"], "stale": block["stale"], "fault": block["fault"],
           "feed": {"source": bud.get("source"), "age_s": bud.get("feed_age_s")},
           "windows": out_w, "fleet_usd_per_min": _finite(bud.get("fleet_usd_per_min"), 3),
           "reserve_pct": _num(bud.get("reserve_pct")),
           "reserve_holding": (block.get("reserve") or {}).get("holding", False),
           "interactive": {"state": inter.get("state") or "unknown", "pct_per_hour": _finite(inter.get("pct_per_hour"), 2)},
           "overage_in_use": block["overage_in_use"], "gate": block["gate"],
           "distress": {"h1": len([t for t in log if now - t < 3600]), "h24": len([t for t in log if now - t < 86400])}}
    print(json.dumps(out, separators=(",", ":")))
    return 0


# ---------- report (MC-43 tuning, MC-41 tooling) ----------

TARGET_429_PER_10H = 1.0
MAX_SAMPLE_GAP_S = 900   # decisions are written at least every 300s while the limiter runs; a longer gap is an outage


def parse_since(raw, now):
    m = re.match(r"^(\d+)([mhd])$", raw or "")
    if m:
        return now - int(m.group(1)) * {"m": 60, "h": 3600, "d": 86400}[m.group(2)]
    t = parse_iso(raw)
    if t is None:
        raise ValueError("--since must be like 24h, 90m, 3d or an ISO timestamp (got %r)" % raw)
    return t


def _top(counter):
    return [{"code": c, "count": n} for c, n in sorted(counter.items(), key=lambda kv: (-kv[1], kv[0]))]


def build_report(root, since_ts, now):
    ldir = os.path.join(root, "limiter")
    rows = []
    for name in ("decisions.jsonl.1", "decisions.jsonl"):
        for r in read_jsonl(os.path.join(ldir, name)):
            t = parse_iso(r.get("ts")) if isinstance(r, dict) else None
            if t is not None and since_ts <= t <= now:
                r["_t"] = t
                rows.append(r)
    rows.sort(key=lambda r: r["_t"])

    # divergences
    kinds = {"would_hold_but_spawned": {}, "would_admit_but_waited": {}}
    for r in rows:
        for d in r.get("divergence") or []:
            kinds.setdefault(d.get("kind") or "unknown", {})
            c = d.get("code") or "-"
            kinds[d.get("kind") or "unknown"][c] = kinds[d.get("kind") or "unknown"].get(c, 0) + 1
        act = r.get("actual") or {}
        admit = (r.get("would") or {}).get("admit") or []
        if not admit:
            continue
        spawned = set(act.get("spawned") or [])
        if act.get("ratelimit_paused"):
            code = "ratelimit_paused"
        elif act.get("quota_over_cap"):
            code = "quota_over_cap"
        elif act.get("low_disk"):
            code = "low_disk"
        elif is_num(act.get("running")) and is_num(act.get("ceiling")) and act["running"] >= act["ceiling"]:
            code = "concurrency_full"
        else:
            continue
        for jid in admit:
            if jid not in spawned:
                kinds["would_admit_but_waited"][code] = kinds["would_admit_but_waited"].get(code, 0) + 1
    divergences = {k: {"count": sum(v.values()), "top_codes": _top(v)} for k, v in kinds.items()}

    # job-hours: each sample's running count holds until the next sample (gaps capped)
    job_s = 0.0
    last_run = None
    for a, b in zip(rows, rows[1:]):
        run = (a.get("actual") or {}).get("running")
        run = run if is_num(run) else last_run
        if is_num(run):
            last_run = run
            job_s += run * min(b["_t"] - a["_t"], MAX_SAMPLE_GAP_S)
    job_hours = job_s / 3600.0

    # distress
    dpath = os.path.join(ldir, "distress.jsonl")
    d_count, d_codes = 0, {}
    if os.path.exists(dpath):
        for e in read_jsonl(dpath):
            t = parse_iso(e.get("ts")) if isinstance(e, dict) else None
            if t is not None and since_ts <= t <= now:
                d_count += 1
                key = str(e.get("status") or e.get("kind") or "-")
                d_codes[key] = d_codes.get(key, 0) + 1
    else:  # a soak that predates distress.jsonl: fall back to the routed failures in job events
        for job, archived in iter_job_files(root):
            for e in read_jsonl(events_path(root, job, archived)):
                t = parse_iso(e.get("ts")) if isinstance(e, dict) else None
                dist = core.classify_mother_event(e)
                if dist and t is not None and since_ts <= t <= now:
                    d_count += 1
                    d_codes[str(dist["status"])] = d_codes.get(str(dist["status"]), 0) + 1
    rate = (d_count / job_hours * 10.0) if job_hours > 0 else None

    # 5h window exhausted while admitting: a run of samples at 100% with the gate on, with a spawn in it
    exhaust, in_run, spawned_in_run = 0, False, False
    for r in rows:
        w = r.get("window") or {}
        hot = is_num(w.get("used_pct_5h")) and w["used_pct_5h"] >= 100 and w.get("gate") == "on"
        if hot:
            in_run = True
            spawned_in_run = spawned_in_run or bool((r.get("actual") or {}).get("spawned"))
        else:
            if in_run and spawned_in_run:
                exhaust += 1
            in_run = spawned_in_run = False
    if in_run and spawned_in_run:
        exhaust += 1

    # calibration
    st = read_json(os.path.join(ldir, "state.json"))
    bud = (st or {}).get("budget") or {}
    cfg = load_cfg(root)
    calib = {}
    for key in ("five_hour", "seven_day"):
        w = bud.get(key) or {}
        calib[key] = {"k": _finite(w.get("k"), 3), "samples": w.get("k_samples", 0),
                      "min_samples": int(cfg["k_min_samples"]), "calibrated": bool(w.get("calibrated"))}

    verdicts = [
        {"name": "429 rate per 10 job-hours", "value": _finite(rate, 2), "target": "< %g" % TARGET_429_PER_10H,
         "result": "N/A" if rate is None else ("PASS" if rate < TARGET_429_PER_10H else "FAIL")},
        {"name": "5h exhausted while admitting", "value": exhaust, "target": "0",
         "result": "PASS" if exhaust == 0 else "FAIL"},
        {"name": "5h k calibrated", "value": calib["five_hour"]["calibrated"], "target": "true",
         "result": "PASS" if calib["five_hour"]["calibrated"] else "FAIL"},
    ]
    return {"v": 1, "since": iso(since_ts), "until": iso(now), "decisions": len(rows), "divergences": divergences,
            "distress": {"count": d_count, "by_status": d_codes, "job_hours": round(job_hours, 3),
                         "per_10_job_hours": _finite(rate, 2)},
            "exhaustion_while_admitting": {"count": exhaust}, "calibration": calib, "verdicts": verdicts}


def render_report(rep):
    lines = ["report: %s \u2192 %s (%d decision samples)" % (rep["since"], rep["until"], rep["decisions"]), ""]
    lines.append("divergences (would vs actual):")
    for kind, d in sorted(rep["divergences"].items()):
        top = ", ".join("%s \u00d7%d" % (t["code"], t["count"]) for t in d["top_codes"][:3]) or "-"
        lines.append("  %-26s %d   top codes: %s" % (kind, d["count"], top))
    di = rep["distress"]
    lines += ["", "distress: %d event(s) over %.2f job-hours%s" % (
        di["count"], di["job_hours"], "" if di["per_10_job_hours"] is None else " = %.2f per 10 job-hours" % di["per_10_job_hours"])]
    lines.append("5h exhausted while admitting: %d" % rep["exhaustion_while_admitting"]["count"])
    lines += ["", "calibration:"]
    for key, c in rep["calibration"].items():
        lines.append("  %-9s k=%s  samples %d/%d  %s" % (key, "n/a" if c["k"] is None else c["k"], c["samples"],
                                                         c["min_samples"], "calibrated" if c["calibrated"] else "uncalibrated"))
    lines += ["", "verdicts:"]
    for v in rep["verdicts"]:
        if v["name"].startswith("429"):
            val = "n/a (no job-hours in range)" if v["value"] is None else "%.1f per 10 job-hours" % v["value"]
            lines.append("  429 rate: %s (target %s) %s" % (val, v["target"], v["result"]))
        elif v["name"].startswith("5h exhausted"):
            lines.append("  5h exhausted while admitting: %s (target %s) %s" % (v["value"], v["target"], v["result"]))
        else:
            lines.append("  %s: %s (target %s) %s" % (v["name"], "yes" if v["value"] else "no", v["target"], v["result"]))
    return "\n".join(lines)


def cmd_report(args):
    root = os.path.abspath(args.root)
    now = int(time.time())
    try:
        since = parse_since(args.since, now)
    except ValueError as exc:
        print("mother-limiter: %s" % exc, file=sys.stderr)
        return 1
    rep = build_report(root, since, now)
    print(json.dumps(rep, separators=(",", ":")) if args.json else render_report(rep))
    return 0


def cmd_estimate(args):
    root = os.path.abspath(args.root)
    job = read_json(args.job)
    if not isinstance(job, dict):
        print("mother-limiter: cannot read job file", file=sys.stderr)
        return 1
    cfg = load_cfg(root)
    est = core.estimate_burn(job.get("repo") or "unknown", actor_of(job), burn_table(root, cfg, int(time.time())), cfg, iso(int(time.time())))
    print(json.dumps(est, separators=(",", ":")))
    return 0


def cmd_classify(args):
    root = os.environ.get("MOTHER_ROOT") or os.environ.get("MOTHER_LIVE_ROOT") or os.path.join(os.path.expanduser("~"), ".mother")
    print(classify(root, args.work_dir, args.repo))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="mother-limiter")
    sub = ap.add_subparsers(dest="cmd", required=True)
    t = sub.add_parser("tick"); t.add_argument("--root", required=True); t.set_defaults(fn=cmd_tick)
    s = sub.add_parser("status"); s.add_argument("--json", action="store_true"); s.add_argument("--raw", action="store_true")
    s.add_argument("--root", required=True); s.set_defaults(fn=cmd_status)
    g = sub.add_parser("signals"); g.add_argument("--json", action="store_true"); g.add_argument("--root", required=True)
    g.set_defaults(fn=cmd_signals)
    r = sub.add_parser("report"); r.add_argument("--since", default="24h"); r.add_argument("--json", action="store_true")
    r.add_argument("--root", required=True); r.set_defaults(fn=cmd_report)
    e = sub.add_parser("estimate"); e.add_argument("--root", required=True); e.add_argument("--job", required=True)
    e.set_defaults(fn=cmd_estimate)
    c = sub.add_parser("classify"); c.add_argument("--work-dir", default=""); c.add_argument("--repo", required=True)
    c.set_defaults(fn=cmd_classify)
    args = ap.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    sys.exit(main())
