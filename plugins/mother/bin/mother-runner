#!/usr/bin/env bash

# --- mother plugin path resolver (prepended during port) ---
# Resolves symlinks so the plugin works when installed via `ln -s` into a bin dir.
_MOTHER_RAW="${BASH_SOURCE[0]}"
while [ -L "$_MOTHER_RAW" ]; do
    _link="$(readlink "$_MOTHER_RAW")"
    case "$_link" in
        /*) _MOTHER_RAW="$_link" ;;
        *)  _MOTHER_RAW="$(dirname "$_MOTHER_RAW")/$_link" ;;
    esac
done
_MOTHER_SELF="$(cd "$(dirname "$_MOTHER_RAW")" && pwd -P)"
: "${MOTHER_BIN_DIR:=$_MOTHER_SELF}"
: "${MOTHER_LIB_DIR:=$_MOTHER_SELF/../lib}"
# -----------------------------------------------------------

# mother-runner — long-lived daemon for the Claude Code background queue.
#
# Polls ${MOTHER_ROOT:-$HOME/.mother}/jobs every MOTHER_POLL_INTERVAL seconds. Promotes
# queued → ready when dependencies are satisfied, and forks `mother-run-job`
# children up to MOTHER_CONCURRENCY in parallel. Reaps exited children each
# tick. On SIGTERM/SIGINT, stops accepting new work and waits up to
# MOTHER_SHUTDOWN_GRACE seconds for in-flight jobs before exiting.
#
# On startup, any jobs in `running` state whose worker pid is gone are marked
# failed with reason=runner_died (crash recovery). Jobs whose worker is still
# alive are left alone (no re-adoption). Legacy records without `worker_pid`
# fall back to matching a recorded `tmux_window` against live tmux windows.
#
# Starts typically via `mother daemon start`. See also `mother daemon stop|status`.

set -u

# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/state.sh"

# W1–W3 substrate libs — sourced if present so the pipeline driver has
# findings helpers in-process. Guarded so runner builds even before W1–W3
# are merged (set -u safe: each var is read, not assigned).
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/findings.sh" ]      && source "$MOTHER_LIB_DIR/findings.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/request-types.sh" ] && source "$MOTHER_LIB_DIR/request-types.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/phase-prompt.sh" ]  && source "$MOTHER_LIB_DIR/phase-prompt.sh"

MOTHER_CONCURRENCY="${MOTHER_CONCURRENCY:-2}"
MOTHER_POLL_INTERVAL="${MOTHER_POLL_INTERVAL:-2}"
MOTHER_SHUTDOWN_GRACE="${MOTHER_SHUTDOWN_GRACE:-30}"
MOTHER_ARCHIVE_INTERVAL="${MOTHER_ARCHIVE_INTERVAL:-3600}"   # seconds between retention sweeps
MOTHER_ARCHIVE_OLDER_THAN="${MOTHER_ARCHIVE_OLDER_THAN:-30}" # days
MOTHER_ARCHIVE_TIMEOUT="${MOTHER_ARCHIVE_TIMEOUT:-300}"      # seconds before a stuck sweep is killed

# Kill switches: set to 0 to disable without redeploying.
MOTHER_ESCALATION_ENABLED="${MOTHER_ESCALATION_ENABLED:-1}"
MOTHER_ADHERENCE_ENABLED="${MOTHER_ADHERENCE_ENABLED:-1}"
MOTHER_BROKER_ENABLED="${MOTHER_BROKER_ENABLED:-1}"
MOTHER_PIPELINE_ENABLED="${MOTHER_PIPELINE_ENABLED:-1}"
MOTHER_PIPELINE_CYCLE_CAP="${MOTHER_PIPELINE_CYCLE_CAP:-3}"

PIDFILE="$RUNNER_DIR/runner.pid"
CHILDREN_DIR="$RUNNER_DIR/children"
BROKER_PIDFILE="$RUNNER_DIR/broker.pid"
mkdir -p "$CHILDREN_DIR"

# Broker restart backoff state (seconds). Reset to 1 whenever the broker is
# observed alive; doubled (capped) on each restart attempt.
_BROKER_BACKOFF=1
_BROKER_NEXT_RESTART=0

SHUTDOWN=0

# ---------- primitives ----------

_log() {
    printf '[%s] %s\n' "$(_iso_now)" "$*" >&2
}

_write_pidfile() {
    local tmp="$PIDFILE.tmp.$$"
    echo $$ > "$tmp" && mv "$tmp" "$PIDFILE"
}

_remove_pidfile() {
    # Only remove the pidfile if it still names us. Otherwise a second
    # instance shutting down (e.g. one that lost the singleton race, or was
    # killed directly) would delete the pidfile out from under whichever
    # instance is still legitimately running, breaking `mother daemon
    # status`/`stop` and defeating _singleton_guard for the next start.
    # (Observed live: killing an orphaned duplicate runner deleted the
    # supervised instance's pidfile even though that instance kept running.)
    local current_pid
    current_pid=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ "$current_pid" = "$$" ]; then
        rm -f "$PIDFILE"
    fi
}

# Refuse to start a second runner against the same MOTHER_ROOT. Without this,
# a stray manual invocation (or a launchd reload racing a leftover foreground
# run) silently coexists with the supervised instance: both poll the same
# jobs/ directory, both dispatch up to MOTHER_CONCURRENCY workers, and they
# race on the same job state files (observed as spurious `jq: could not open
# file <job>.json` errors in the log when one runner archives/moves a job
# out from under the other mid-tick). A dead pid's stale pidfile is reclaimed
# rather than treated as a lock.
_singleton_guard() {
    [ -f "$PIDFILE" ] || return 0
    local existing_pid
    existing_pid=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
        _log "refusing to start: mother-runner already running as pid $existing_pid ($PIDFILE). Stop it first (mother daemon stop) or remove the pidfile if it's stale."
        exit 1
    fi
    [ -n "$existing_pid" ] && _log "reclaiming stale pidfile for dead pid $existing_pid"
}

_on_signal() {
    SHUTDOWN=1
    _log "signal received — draining"
}

# ---------- child tracking ----------

_track_child() {
    local pid="$1" job_id="$2"
    jq -nc --argjson pid "$pid" --arg job_id "$job_id" --arg started "$(_iso_now)" \
        '{pid: $pid, job_id: $job_id, started_at: $started}' \
        > "$CHILDREN_DIR/$pid.json"
}

_reap_children() {
    # For each tracked child, remove its file if the pid is dead.
    local f pid
    for f in "$CHILDREN_DIR"/*.json; do
        [ -f "$f" ] || continue
        pid=$(basename "$f" .json)
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$f"
        fi
    done
}

_count_running_children() {
    find "$CHILDREN_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | wc -l | tr -d ' '
}

# Supervisor liveness check, used by the reaper to avoid racing the
# in-process supervisor's terminal transition. CHILDREN_DIR tracks the
# mother-run-job (supervisor) PIDs along with the job_id they own; the
# job json's `worker_pid` is a different process — the wrapper bash that
# runs claude. The wrapper exits when claude exits (natural completion),
# leaving the supervisor in a post-exit window: it has to wake from its
# 2s poll-loop sleep, read the marker file, scan for pr_url, and write
# the terminal transition. Reaping based on `worker_pid` alone fires
# during that window and clobbers the supervisor's pending succeeded
# write — sometimes leaving the job stuck in `failed: runner_died`
# despite the work being committed.
_supervisor_alive_for_job() {
    local job_id="$1" f pid jid
    for f in "$CHILDREN_DIR"/*.json; do
        [ -f "$f" ] || continue
        pid="$(basename "$f" .json)"
        jid="$(jq -r '.job_id // empty' "$f" 2>/dev/null)"
        if [ "$jid" = "$job_id" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

# ---------- broker supervision (B9) ----------
#
# The IPC broker is a long-lived Go sidecar that fans out state/activity/
# await/quota/current_activity events to connected clients and routes
# answer/cancel/retry commands back through the `mother` CLI. The daemon
# supervises it: started when the daemon starts, SIGTERM'd on drain, and
# restarted with bounded backoff if it dies. Everything is gated behind
# MOTHER_BROKER_ENABLED (default 1) so the daemon runs identically to before
# when the broker is disabled.

_broker_pid() {
    [ -f "$BROKER_PIDFILE" ] && cat "$BROKER_PIDFILE" 2>/dev/null || echo ""
}

_broker_alive() {
    local p; p=$(_broker_pid)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

_start_broker() {
    [ "$MOTHER_BROKER_ENABLED" = "1" ] || return 0
    _broker_alive && return 0
    # Detach like the job workers: nohup + background + disown so daemon
    # signals don't cascade. The broker tees its own diagnostics to
    # logs/broker.log.
    nohup "$MOTHER_BIN_DIR/mother-broker" </dev/null >>"$LOGS_DIR/broker.log" 2>&1 &
    local pid=$!
    disown 2>/dev/null || true
    echo "$pid" > "$BROKER_PIDFILE"
    _log "started broker (pid $pid)"
}

_stop_broker() {
    local p; p=$(_broker_pid)
    [ -n "$p" ] || return 0
    if kill -0 "$p" 2>/dev/null; then
        kill -TERM "$p" 2>/dev/null || true
        _log "stopped broker (pid $p)"
    fi
    rm -f "$BROKER_PIDFILE"
}

# _reap_broker: if the broker is enabled but not alive, restart it once the
# backoff window has elapsed. Called each loop tick.
_reap_broker() {
    [ "$MOTHER_BROKER_ENABLED" = "1" ] || return 0
    if _broker_alive; then
        _BROKER_BACKOFF=1
        return 0
    fi
    local now; now=$(date +%s)
    [ "$now" -ge "$_BROKER_NEXT_RESTART" ] || return 0
    _log "broker not running — restarting (backoff=${_BROKER_BACKOFF}s)"
    _start_broker
    _BROKER_NEXT_RESTART=$((now + _BROKER_BACKOFF))
    _BROKER_BACKOFF=$((_BROKER_BACKOFF * 2))
    [ "$_BROKER_BACKOFF" -gt 30 ] && _BROKER_BACKOFF=30
}

# ---------- ready-job selection ----------

_pick_next_ready() {
    find "$JOBS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | while read -r f; do
        jq -r 'select(.state == "ready") | .created_at + "\t" + .id' "$f"
    done | sort | head -1 | cut -f2
}

_pick_next_forced_ready() {
    find "$JOBS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | while read -r f; do
        jq -r 'select(.state == "ready" and (.force_start == true)) | .created_at + "\t" + .id' "$f"
    done | sort | head -1 | cut -f2
}

# ---------- spawning ----------

_spawn_job() {
    local job_id="$1"

    # Pre-transition ready → running so the next poll tick doesn't re-pick
    # this job. mother-run-job tolerates both ready and running as starting
    # states. If the fork fails, the job stays `running` with no tmux window;
    # the next daemon restart's orphan recovery will mark it failed.
    _job_transition "$job_id" running '{"spawned_by":"daemon"}'

    # Detach via nohup + background + stdin/out/err redirection. mother-run-job
    # tees its own log. macOS has no setsid, and nohup + disown is sufficient:
    # signals to the daemon will not cascade once we disown the child.
    nohup "$MOTHER_BIN_DIR/mother-run-job" "$job_id" </dev/null >/dev/null 2>&1 &
    local pid=$!
    disown 2>/dev/null || true
    _track_child "$pid" "$job_id"
    _log "spawned job $job_id as pid $pid"
}

# ---------- crash recovery ----------

_recover_stale_locks() {
    # The adherence-review and pipeline-driver locks are plain mkdir-based
    # mutexes with no owner-pid or TTL recorded in them. They exist only to
    # serialize work within a single running daemon instance across ticks of
    # _loop; nothing else in the codebase acquires them. _singleton_guard has
    # already established that we are the only mother-runner process alive
    # (any prior instance is confirmed dead), so any lockdir found here was
    # left behind by a previous instance that died between mkdir and rmdir
    # (crash, kill -9, machine sleep/reboot) and can never self-heal — mkdir
    # will keep failing on every subsequent tick forever. Clear them
    # unconditionally on startup.
    #
    # (Bug: from 2026-05-20 until this fix, a leaked adherence-review.lockdir
    # silently disabled all automatic adherence review for three months;
    # jobs were only ever reviewed when someone ran `mother adherence-review
    # <id>` by hand. See .claude/bug-reports/.)
    local lock
    for lock in "$RUNNER_DIR/adherence-review.lockdir" "$RUNNER_DIR/pipeline-driver.lockdir"; do
        if [ -d "$lock" ]; then
            _log "clearing stale lock left by a previous instance: $lock"
            rmdir "$lock" 2>/dev/null || rm -rf "$lock"
        fi
    done
}

_recover_orphans() {
    # Primary check: `worker_pid` + `kill -0`. Falls back to a tmux-window
    # match for legacy job records (created before the headless-worker
    # migration) that recorded `tmux_window` instead of `worker_pid`.
    #
    # $1: grace_seconds (default 0). For jobs with no `worker_pid`, only
    # act if `started_at` is older than this threshold — prevents racing
    # with a live mother-run-job that hasn't persisted worker_pid yet.
    # Startup passes 0 (aggressive); periodic calls from the loop pass a
    # non-zero grace so healthy in-flight supervisors are left alone.
    #
    # Honors `cancel_requested`: when a zombie is reaped and the user had
    # asked to cancel, transition to `cancelled` instead of `failed` so
    # `mother cancel` is effective even when the supervisor is dead.
    local grace="${1:-0}"
    local windows=""
    if command -v tmux >/dev/null 2>&1; then
        windows=$(tmux list-windows -a -F '#W' 2>/dev/null || echo "")
    fi

    local now_epoch; now_epoch=$(date +%s)
    local f state pid window id started_at started_at_sec started_epoch cancel_req
    local terminal_state terminal_reason
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state' "$f" 2>/dev/null) || continue
        [ "$state" = "running" ] || continue
        id=$(jq -r '.id' "$f")
        pid=$(jq -r '.worker_pid // empty' "$f")
        window=$(jq -r '.tmux_window // ""' "$f")
        cancel_req=$(jq -r '.cancel_requested // false' "$f")

        # Resolve the terminal state we'd transition to. If the user asked
        # to cancel and the supervisor can't honor it (dead/absent pid),
        # 'cancelled' is more truthful than 'failed: runner_died'.
        if [ "$cancel_req" = "true" ]; then
            terminal_state="cancelled"
            terminal_reason='{"reason":"user"}'
        else
            terminal_state="failed"
            terminal_reason='{"reason":"runner_died"}'
        fi

        if [ -n "$pid" ]; then
            if ! kill -0 "$pid" 2>/dev/null; then
                # Worker is gone, but the supervisor (mother-run-job) may
                # still be in its post-exit window. Reaping here would
                # race the supervisor's terminal transition — see comment
                # on _supervisor_alive_for_job. Defer when supervisor is
                # still alive; only reap when the whole supervision tree
                # is gone.
                if _supervisor_alive_for_job "$id"; then
                    continue
                fi
                _log "marking $id $terminal_state (pid $pid gone; cancel_requested=$cancel_req)"
                _job_transition "$id" "$terminal_state" "$terminal_reason"
            fi
        elif [ -n "$window" ]; then
            # Legacy path: jobs recorded before the headless-worker migration.
            if [ -z "$windows" ]; then
                _log "skipping $id (legacy tmux_window record, no tmux available)"
                continue
            fi
            if ! grep -Fxq "$window" <<< "$windows"; then
                _log "marking $id $terminal_state (window $window gone; cancel_requested=$cancel_req)"
                _job_transition "$id" "$terminal_state" "$terminal_reason"
            fi
        else
            # No worker_pid AND no tmux_window. Supervisor either died before
            # persisting worker_pid, or we're racing a fresh spawn. Apply the
            # grace window: startup reaps immediately (grace=0), the periodic
            # loop waits until started_at is older than grace_seconds.
            if [ "$grace" -gt 0 ]; then
                started_at=$(jq -r '.started_at // empty' "$f")
                [ -n "$started_at" ] || continue
                # Strip fractional seconds — started_at may be either
                # `...SSZ` (from mother-run-job's iso_now) or `...SS.NNNNNNZ`
                # (from state.sh's _iso_now), and date(1) only accepts the
                # former with %S.
                started_at_sec="${started_at%%.*}"
                case "$started_at_sec" in *Z) ;; *) started_at_sec="${started_at_sec}Z" ;; esac
                # ISO8601 → epoch (macOS date needs -j -f; GNU date needs -d).
                started_epoch=$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$started_at_sec" +%s 2>/dev/null \
                    || date -u -d "$started_at_sec" +%s 2>/dev/null || echo 0)
                [ "$started_epoch" -eq 0 ] && continue
                [ $((now_epoch - started_epoch)) -ge "$grace" ] || continue
            fi
            # Past the grace window, this branch used to reap unconditionally —
            # but a slow-to-persist supervisor (e.g. worktree creation + env
            # setup contending with other concurrent jobs for disk/CPU) can
            # easily outlast a fixed 60s grace under load. Unlike the `pid`
            # branch above, this one never checked whether the supervisor
            # (mother-run-job) was actually still alive before reaping — so a
            # merely-slow spawn got misdiagnosed as `failed: runner_died`,
            # auto-escalated, and re-spawned into the *same* worktree while
            # the original, still-live supervisor kept working there too.
            # Apply the same liveness guard the `pid` branch already uses.
            if _supervisor_alive_for_job "$id"; then
                continue
            fi
            _log "marking $id $terminal_state (no worker_pid or tmux_window; cancel_requested=$cancel_req)"
            _job_transition "$id" "$terminal_state" "$terminal_reason"
        fi
    done
}

# Grace (seconds) before the periodic reaper treats a `running` job with no
# worker_pid as a zombie. Long enough to outlast any reasonable spawn path
# (plan read + lock acquire + wrapper write + nohup fork), short enough that
# users don't stare at a dead job for long.
MOTHER_ORPHAN_GRACE="${MOTHER_ORPHAN_GRACE:-60}"

# ---------- main loop ----------

_maybe_archive() {
    # Run retention at most once per MOTHER_ARCHIVE_INTERVAL seconds, keyed off
    # a timestamp file so it survives restarts.
    local marker="$RUNNER_DIR/last-archive.ts"
    local now last
    now=$(date +%s)
    last=0
    [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
    if [ $((now - last)) -ge "$MOTHER_ARCHIVE_INTERVAL" ]; then
        _log "running archive sweep (older-than=${MOTHER_ARCHIVE_OLDER_THAN}d)"
        # Write the marker BEFORE running, not after. `_loop` is single-threaded
        # and every tick after this one is blocked on this call returning, so a
        # sweep that hangs (gh/docker/git wedged, TCC prompt with no UI session
        # to answer it, whatever) must not also get retried every tick once the
        # watchdog below frees the loop — see the 2026-08-12 bug report on this
        # function for the incident that motivated the timeout.
        echo "$now" > "$marker"
        # Bound the sweep with a watchdog instead of trusting it to return: a
        # wedged `mother archive` (gh/docker/git stuck, a TCC prompt with no
        # UI session to answer it, whatever) used to block this loop — and
        # therefore all job dispatch — forever, silently, since the daemon's
        # stderr is discarded. The pipe into the logging loop is still here,
        # just run in the background so it can be raced against a timer.
        # Caveat: killing $sweep_pid frees the loop but does not reach any
        # grandchild (a stuck `gh`/`docker`/`git` call) it may have spawned —
        # bash without job control puts pipeline members in the script's own
        # process group, so there is no safe "kill the whole tree" short of
        # enabling monitor mode daemon-wide. That's an acceptable trade for
        # now: the daemon staying responsive matters more than reaping an
        # orphaned, already-wedged grandchild. See the 2026-08-12 bug report
        # for the incident that motivated this.
        local timeout_flag="$RUNNER_DIR/archive-sweep-timed-out.flag"
        rm -f "$timeout_flag"
        (
            "$MOTHER_BIN_DIR/mother" archive --older-than "$MOTHER_ARCHIVE_OLDER_THAN" 2>&1 | while read -r line; do _log "archive: $line"; done
        ) &
        local sweep_pid=$!
        (
            sleep "$MOTHER_ARCHIVE_TIMEOUT"
            kill -9 "$sweep_pid" 2>/dev/null && : > "$timeout_flag"
        ) &
        local watchdog_pid=$!
        wait "$sweep_pid" 2>/dev/null
        # Sweep is done either way (finished or killed) — the race is over,
        # so reap the watchdog too instead of leaving it to fire uselessly.
        kill "$watchdog_pid" 2>/dev/null
        wait "$watchdog_pid" 2>/dev/null
        if [ -f "$timeout_flag" ]; then
            _log "archive: sweep exceeded ${MOTHER_ARCHIVE_TIMEOUT}s, killed pid $sweep_pid — dispatch resumes; it will retry next interval"
            rm -f "$timeout_flag"
        fi
    fi
}

# ---------- quota-aware dispatch ----------
#
# `_quota_check` (in lib/state.sh) returns 1 when either rolling window
# (5h or 7d) is at or over its operator-set cap. The daemon uses it to:
#
#   1. Auto-resume awaiting jobs whose blocking window has reset
#      (system pauses set `paused_reason: "quota_*"` and `auto_resume_at`;
#      we promote those back to `ready` once both the timestamp has passed
#      and the cache shows quota under cap).
#   2. Refuse to spawn new jobs while over cap (pre-dispatch gate). Jobs
#      stay in `ready` and get retried each tick.
#   3. Pause running jobs that are mid-flight when the cap trips, so
#      headroom returns to the operator's interactive sessions instead of
#      being eaten by background work.
#
# Mid-flight pause exemptions (do NOT pause):
#   - The job already emitted its final `result` event — winding down anyway.
#   - The job is already `awaiting` (paused for some other reason).
#   - The job has `cancel_requested` — operator wants it gone, not preserved.

_auto_resume_check() {
    local now; now=$(date +%s)
    local f state reason resume_at id merged
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        [ "$state" = "awaiting" ] || continue
        reason=$(jq -r '.paused_reason // ""' "$f" 2>/dev/null)
        case "$reason" in quota_*) ;; *) continue ;; esac
        resume_at=$(jq -r '.auto_resume_at // 0' "$f" 2>/dev/null)
        case "$resume_at" in ''|null) resume_at=0 ;; esac
        # Strip fractional seconds defensively.
        resume_at="${resume_at%.*}"
        [ "$resume_at" -gt 0 ] || continue
        [ "$now" -ge "$resume_at" ] || continue
        # Only resume if quota is now actually under cap. The window may
        # have reset on the clock but if we're already pushing the next
        # window (back-to-back heavy use) we should keep waiting.
        if ! _quota_check; then continue; fi
        id=$(jq -r '.id' "$f")
        _log "auto-resuming $id (paused_reason=$reason; resume window has passed)"
        merged=$(jq --arg ts "$(_iso_now)" '
            .state = "ready"
            | .pending_answer = "Quota window has reset — continue from where you left off."
            | .resumed_at = $ts
            | .resume_count = ((.resume_count // 0) + 1)
            | .auto_resume_at = null
            | .paused_reason = null
            | .pause_requested = null
        ' "$f") && _atomic_write "$f" "$merged"
        _append_event "$id" "auto_resumed" \
            "$(jq -nc --arg r "$reason" '{from_paused_reason: $r}')"
    done
}

_maybe_pause_running() {
    # Caller has already verified quota is over cap. Walk currently-tracked
    # children, find their job json, set `pause_requested` + paused_reason
    # + auto_resume_at on the eligible ones. mother-run-job's poll loop
    # picks up `pause_requested` on its next tick and handles the rest
    # (terminate worker, transition state to `awaiting`).
    local reason resume_at
    reason=$(_quota_offending_window)
    [ -n "$reason" ] || return 0
    resume_at=$(_quota_resume_at_for "$reason")
    [ "${resume_at:-0}" -gt 0 ] || return 0

    local f pid job_id job_file fr ar cr pr merged
    for f in "$CHILDREN_DIR"/*.json; do
        [ -f "$f" ] || continue
        pid=$(basename "$f" .json)
        job_id=$(jq -r '.job_id // empty' "$f" 2>/dev/null)
        [ -n "$job_id" ] || continue
        job_file="$JOBS_DIR/$job_id.json"
        [ -f "$job_file" ] || continue
        # Exemptions.
        fr=$(jq -r '.final_result_at // ""' "$job_file" 2>/dev/null)
        [ -n "$fr" ] && continue   # already winding down
        ar=$(jq -r '.state // ""'             "$job_file" 2>/dev/null)
        [ "$ar" = "awaiting" ] && continue
        cr=$(jq -r '.cancel_requested // false' "$job_file" 2>/dev/null)
        [ "$cr" = "true" ] && continue
        pr=$(jq -r '.pause_requested // false'  "$job_file" 2>/dev/null)
        [ "$pr" = "true" ] && continue   # already requested
        fs=$(jq -r '.force_start // false' "$job_file" 2>/dev/null)
        [ "$fs" = "true" ] && continue   # forced — never pause for quota

        merged=$(jq --arg r "$reason" --argjson ts "$resume_at" '
            .pause_requested = true
            | .paused_reason = $r
            | .auto_resume_at = $ts
        ' "$job_file") && _atomic_write "$job_file" "$merged"
        _log "requested pause of $job_id (reason=$reason, resume_at=$resume_at)"
        _append_event "$job_id" "pause_requested" \
            "$(jq -nc --arg r "$reason" --argjson ts "$resume_at" \
                '{paused_reason: $r, auto_resume_at: $ts}')"
    done
}

# ---------- auto-escalation ----------

# After a job transitions to `failed`, auto-escalate it if escalation is
# enabled and the escalation cap hasn't been reached.
_auto_escalate_failed() {
    [ "$MOTHER_ESCALATION_ENABLED" = "1" ] || return 0
    local f state esc_count id
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        [ "$state" = "failed" ] || continue
        esc_count=$(jq -r '.escalation_count // 0' "$f" 2>/dev/null)
        [ "$esc_count" -lt 2 ] || continue
        # Only auto-escalate jobs that haven't been manually cancelled/archived.
        id=$(jq -r '.id' "$f")
        _log "auto-escalating $id (escalation_count=$esc_count)"
        "$MOTHER_BIN_DIR/mother" escalate "$id" 2>&1 | while read -r line; do _log "escalate: $line"; done
    done
}

# ---------- adherence loop ----------

_ADHERENCE_LOCK="$RUNNER_DIR/adherence-review.lockdir"

_run_adherence_pending() {
    [ "$MOTHER_ADHERENCE_ENABLED" = "1" ] || return 0

    # Mark jobs that just succeeded with a PR url as adherence-pending.
    local f state pr adherence_pending adherence_attempts id
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        [ "$state" = "succeeded" ] || continue
        pr=$(jq -r '.pr_url // empty' "$f" 2>/dev/null)
        [ -n "$pr" ] || continue
        adherence_pending=$(jq -r '.adherence_pending // empty' "$f" 2>/dev/null)
        adherence_attempts=$(jq -r '.adherence_attempts // 0' "$f" 2>/dev/null)
        adherence_status=$(jq -r '.adherence_status // empty' "$f" 2>/dev/null)
        # Skip if already reviewed or blocked.
        case "$adherence_status" in
            passed|blocked_for_human) continue ;;
        esac
        # Mark as pending if not already.
        if [ "$adherence_pending" != "true" ]; then
            merged=$(jq '.adherence_pending = true' "$f") && _atomic_write "$f" "$merged"
            id=$(jq -r '.id' "$f")
            _log "marked $id adherence_pending=true"
        fi
    done

    # Run one adherence review per tick, serialized by lock.
    if mkdir "$_ADHERENCE_LOCK" 2>/dev/null; then
        for f in "$JOBS_DIR"/*.json; do
            [ -f "$f" ] || continue
            adherence_pending=$(jq -r '.adherence_pending // false' "$f" 2>/dev/null)
            [ "$adherence_pending" = "true" ] || continue
            adherence_attempts=$(jq -r '.adherence_attempts // 0' "$f" 2>/dev/null)
            [ "$adherence_attempts" -lt 2 ] || continue
            state=$(jq -r '.state // ""' "$f" 2>/dev/null)
            # Only review jobs that just succeeded (re-queued rework jobs go through
            # succeeded again on their second pass, so this covers both passes).
            case "$state" in succeeded) ;; *) continue ;; esac
            id=$(jq -r '.id' "$f")

            # A human can merge a PR before this automatic loop ever reviews
            # it — the loop only runs once per tick, serialized by lock, so a
            # fast human merge routinely wins the race. If the PR is already
            # merged, running adherence review and (on failure) re-queuing
            # Cody for rework onto the branch is worse than a no-op: the
            # branch is dead, so a rework push either fails outright or
            # opens a stale duplicate PR — exactly what happened to
            # admin-portal#60 and admin-portal#4398/U4. Best-effort check;
            # fails open (runs the review as before) if `gh` is unavailable
            # or the job has no pr_url — this is a guard, not a new hard
            # dependency, matching this file's existing never-hard-fail
            # posture.
            local adherence_pr_url adherence_pr_state
            adherence_pr_url=$(jq -r '.pr_url // empty' "$f" 2>/dev/null) || adherence_pr_url=""
            adherence_pr_state=""
            if [ -n "$adherence_pr_url" ] && command -v gh >/dev/null 2>&1; then
                adherence_pr_state=$(gh pr view "$adherence_pr_url" --json state -q .state 2>/dev/null) \
                    || adherence_pr_state=""
            fi
            if [ "$adherence_pr_state" = "MERGED" ]; then
                _log "pipeline: $id: PR already merged ($adherence_pr_url) — skipping adherence review, not re-queuing rework onto a dead branch"
                local skipped
                skipped=$(jq \
                    '.adherence_pending = false
                    | .adherence_status = "skipped_pr_merged"' \
                    "$f") && _atomic_write "$f" "$skipped"
                _append_event "$id" "adherence_skipped" \
                    "$(jq -nc --arg pr_url "$adherence_pr_url" \
                        '{reason: "pr_already_merged", pr_url: $pr_url}')"
                break  # one review-or-skip decision per tick, same as the review path
            fi

            _log "running adherence review for $id (attempt=$adherence_attempts)"
            # NOTE: without `pipefail`, `if cmd | while read ...; then` tests the
            # exit status of the `while read` loop (the last command in the
            # pipeline), not `mother adherence-review`'s — and the loop's body
            # (_log) virtually always succeeds, so the `if` would almost always
            # take the pass branch regardless of the real verdict, silently
            # skipping the failed_first requeue below. Use PIPESTATUS instead of
            # relying on the pipeline's own exit status (bash 3.2-compatible;
            # macOS ships 3.2.57 per repo convention).
            "$MOTHER_BIN_DIR/mother" adherence-review "$id" 2>&1 | while read -r line; do _log "adherence: $line"; done
            if [ "${PIPESTATUS[0]}" -eq 0 ]; then
                _log "adherence review passed for $id"
            else
                local post_status; post_status=$(jq -r '.adherence_status // ""' "$JOBS_DIR/$id.json" 2>/dev/null)
                case "$post_status" in
                    failed_first)
                        # Re-queue for a fresh Cody run. pending_answer already set by
                        # cmd_adherence_review. Mark activity=cody_rework so the list
                        # view shows it's a second attempt.
                        merged=$(jq '
                            .state = "ready"
                            | .activity = "cody_rework"
                            | .finished_at = null
                            | .worker_pid = null
                            | .actual_cost_usd = null
                            | .cancel_requested = null
                            | .pause_requested = null
                            | .final_result_at = null
                            | .force_start = null
                        ' "$JOBS_DIR/$id.json") && _atomic_write "$JOBS_DIR/$id.json" "$merged"
                        _append_event "$id" "adherence_rework_kicked" \
                            "$(jq -nc --arg id "$id" '{id: $id, note: "adherence failed first attempt; re-queuing with activity=cody_rework"}')"
                        _log "adherence failed for $id (first attempt) — re-queuing (activity=cody_rework)"
                        ;;
                    blocked_for_human)
                        # cmd_adherence_review already transitioned to awaiting+adherence_blocked.
                        _log "adherence failed for $id (second attempt) — job is now awaiting (adherence_blocked)"
                        ;;
                esac
            fi
            break  # one review per tick
        done
        rmdir "$_ADHERENCE_LOCK" 2>/dev/null || true
    fi
}

# ---------- pipeline driver ----------
#
# W4: orchestrates pipeline jobs (kind="pipeline") through the multi-phase
# SDLC loop. Advances build phases (redd→cody→marty), runs concurrent reviews
# (Ada + Archie + Perri), and applies the B4 loop-exit truth table (ship /
# block_human / cap-hit / continue) on every review cycle.
#
# Gated by MOTHER_PIPELINE_ENABLED (default 1).

_PIPELINE_DRIVER_LOCK="$RUNNER_DIR/pipeline-driver.lockdir"

# _pipeline_next_build_phase <current> [pending_agents_newline_separated]
# Returns the next eligible phase after <current> in forward order
# (redd → cody → marty), restricted to agents in <pending_agents> when
# non-empty. Prints nothing if we have reached the end.
_pipeline_next_build_phase() {
    local current="$1" pending="${2:-}"
    local found=0 p
    for p in redd cody marty; do
        if [ "$found" -eq 1 ]; then
            if [ -z "$pending" ] || printf '%s\n' "$pending" | grep -qxF "$p"; then
                printf '%s\n' "$p"
                return 0
            fi
        fi
        [ "$p" = "$current" ] && found=1
    done
    return 0
}

# _pipeline_first_pending_agent <pending_agents_newline_separated>
# Returns the first agent in forward order that appears in pending_agents.
# Fallback to "cody" if empty (should not happen).
_pipeline_first_pending_agent() {
    local pending="${1:-}"
    local p
    for p in redd cody marty; do
        printf '%s\n' "$pending" | grep -qxF "$p" && { printf '%s\n' "$p"; return 0; }
    done
    printf 'cody\n'
}

# _run_pipeline_review <id> <job_file>
# Run the concurrent review phase for a pipeline job at phase=review.
# Must be called while the pipeline driver lock is held.
_run_pipeline_review() {
    local id="$1" job_file="$2"

    # Read reviewer list (newline-separated agent names).
    local reviewers
    reviewers=$(jq -r '.pipeline.reviewers // [] | .[]' "$job_file" 2>/dev/null) || reviewers=""

    # Empty reviewer list is a misconfiguration — block for human.
    if [ -z "$reviewers" ]; then
        _log "pipeline: $id: empty reviewer list — blocking (pipeline_error)"
        local now; now=$(_iso_now)
        _job_update "$id" \
            ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
        _append_event "$id" "pipeline_error" \
            "$(jq -nc '{note: "empty reviewer list — pipeline blocked for human"}')"
        return 0
    fi

    local review_cycle reviewers_json
    review_cycle=$(jq -r '.pipeline.review_cycle // 0' "$job_file" 2>/dev/null) || review_cycle=0
    reviewers_json=$(jq -c '.pipeline.reviewers // []' "$job_file" 2>/dev/null) || reviewers_json="[]"

    _log "pipeline: $id: concurrent review started (cycle=${review_cycle:-0})"
    _job_update "$id" '.activity = "pipeline_review"'
    _append_event "$id" "pipeline_review_started" \
        "$(jq -nc --argjson cycle "${review_cycle:-0}" '{review_cycle: $cycle}')"
    # W5 lifecycle event: review cycle start (additive alongside pipeline_review_started).
    _append_event "$id" "review_cycle_started" \
        "$(jq -nc \
            --argjson cycle "${review_cycle:-0}" \
            --argjson reviewers "${reviewers_json:-[]}" \
            '{cycle: $cycle, reviewers: $reviewers}')"

    # Spawn all reviewers in parallel — each writes to its own
    # .pipeline.reviewer_findings.<reviewer> slot (W3 per-slot writes are
    # isolated, so concurrent writers cannot clobber each other).
    local review_log pids r
    review_log="$LOGS_DIR/$id.pipeline-review.log"
    pids=""
    for r in $reviewers; do
        _log "pipeline: $id: spawning reviewer $r"
        "$MOTHER_BIN_DIR/mother" review-phase "$id" --reviewer "$r" \
            >>"$review_log" 2>&1 &
        pids="$pids $!"
    done

    # Wait for all reviewers. A reviewer returning 2 (parse error per W3) is
    # tolerated: logged, treated as no findings for that slot, review continues.
    local p
    for p in $pids; do
        wait "$p" 2>/dev/null \
            || _log "pipeline: $id: a reviewer returned non-zero (tolerated — treated as no findings)"
    done

    # Merge all per-reviewer findings slots into a single re-id'd array.
    local merged_findings
    merged_findings=$("$MOTHER_BIN_DIR/mother" merge-findings "$id" 2>/dev/null) || merged_findings="[]"
    [ -z "$merged_findings" ] && merged_findings="[]"

    # Reload from disk (reviewers mutated the file; our local $job_file is stale).
    local jf; jf=$(_job_path "$id")

    # Snapshot current .pipeline.findings into history, then write merged set.
    local old_findings history_entry merged_jf
    old_findings=$(jq -c '.pipeline.findings // []' "$jf" 2>/dev/null) || old_findings="[]"
    history_entry=$(jq -nc \
        --argjson cycle "${review_cycle:-0}" \
        --argjson findings "$old_findings" \
        '{cycle: $cycle, findings: $findings}')
    merged_jf=$(jq \
        --argjson findings "$merged_findings" \
        --argjson history_entry "$history_entry" \
        '.pipeline.findings = $findings | .pipeline.findings_history += [$history_entry]' \
        "$jf") && _atomic_write "$jf" "$merged_jf"

    # Re-read for B4 decision (in case the above write raced with a reviewer).
    jf=$(_job_path "$id")

    # Resolve cycle cap: per-job value beats env default.
    local cap
    cap=$(jq -r ".pipeline.cycle_cap // ${MOTHER_PIPELINE_CYCLE_CAP:-3}" "$jf" 2>/dev/null) \
        || cap="${MOTHER_PIPELINE_CYCLE_CAP:-3}"
    [ -z "$cap" ] || [ "$cap" = "null" ] && cap="${MOTHER_PIPELINE_CYCLE_CAP:-3}"

    # B4 exit truth table.
    local decision
    decision=$(findings_exit_decision "$merged_findings" 2>/dev/null) || decision="ship"

    # W5 lifecycle event: review cycle completed (emitted before the B4 branch
    # so the timestamp precedes any state transitions caused by the decision).
    local findings_count_ev
    findings_count_ev=$(printf '%s' "$merged_findings" | jq 'length' 2>/dev/null) || findings_count_ev=0
    _append_event "$id" "review_cycle_completed" \
        "$(jq -nc \
            --argjson cycle "${review_cycle:-0}" \
            --arg decision "$decision" \
            --argjson findings_count "${findings_count_ev:-0}" \
            '{cycle: $cycle, decision: $decision, findings_count: $findings_count}')"

    local now; now=$(_iso_now)
    case "$decision" in

        block_human)
            # Short-circuit: human-blocking finding — stop immediately.
            _log "pipeline: $id: human-blocking finding — blocking job (pipeline_blocked)"
            _job_update "$id" \
                ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
            _append_event "$id" "pipeline_blocked" \
                "$(jq -nc --argjson findings "$merged_findings" \
                    '{reason: "human_blocking_finding", findings: $findings}')"
            ;;

        ship)
            # No agent-actionable findings — ship.
            _log "pipeline: $id: zero agent-actionable findings — shipping (pipeline_shipped)"
            local advisories adv_count
            advisories=$(findings_by_target "$merged_findings" "human" 2>/dev/null) || advisories="[]"
            adv_count=$(printf '%s' "$advisories" | jq 'length' 2>/dev/null) || adv_count=0
            local shipped
            shipped=$(jq \
                --argjson advisories "$advisories" \
                --arg now "$now" \
                '.state = "succeeded"
                | .activity = null
                | .pipeline.phase = "done"
                | .pipeline_reviewed = true
                | .pipeline.advisories = $advisories
                | .finished_at = $now' \
                "$jf") && _atomic_write "$jf" "$shipped"
            _append_event "$id" "pipeline_shipped" \
                "$(jq -nc --argjson advisories "$advisories" '{advisories: $advisories}')"
            # Best-effort: post advisory findings as a PR comment so the human
            # sees them on the shipped PR. Non-fatal if gh is unavailable.
            if [ "${adv_count:-0}" -gt 0 ]; then
                local pr_url
                pr_url=$(jq -r '.pr_url // empty' "$jf" 2>/dev/null) || pr_url=""
                if [ -n "${pr_url:-}" ]; then
                    local adv_body
                    adv_body=$(printf '%s' "$advisories" \
                        | jq -r '.[] | "- [\(.severity)] \(.summary)"' 2>/dev/null) || adv_body=""
                    gh pr comment "$pr_url" \
                        --body "$(printf '## Pipeline Advisory Findings\n\n%s' "$adv_body")" \
                        2>/dev/null \
                        || _log "pipeline: $id: advisory PR comment failed (best-effort, ignored)"
                fi
            fi
            ;;

        continue)
            # Agent-actionable findings remain — but if a human has already
            # merged this job's PR out-of-band (they don't wait for the
            # pipeline to say "ship"), dispatching another build cycle onto
            # a dead branch is pointless: it produces a second PR racing an
            # already-closed one, which GitHub opens fresh since the first
            # is no longer accepting pushes as open. Confirmed by a real
            # case: infrastructure#60, a stale duplicate of already-merged
            # infrastructure#59, containing nothing that wasn't already on
            # main. Check merge state before continuing; best-effort, and
            # fails open (proceeds with the cycle) if `gh` is unavailable —
            # this check is a guard, not a new hard dependency.
            local pr_url_check pr_state
            pr_url_check=$(jq -r '.pr_url // empty' "$jf" 2>/dev/null) || pr_url_check=""
            pr_state=""
            if [ -n "$pr_url_check" ] && command -v gh >/dev/null 2>&1; then
                pr_state=$(gh pr view "$pr_url_check" --json state -q .state 2>/dev/null) \
                    || pr_state=""
            fi
            if [ "$pr_state" = "MERGED" ]; then
                _log "pipeline: $id: PR already merged ($pr_url_check) — not continuing cycle, blocking for human"
                _job_update "$id" \
                    ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
                _append_event "$id" "pipeline_blocked" \
                    "$(jq -nc --arg pr_url "$pr_url_check" --argjson findings "$merged_findings" \
                        '{reason: "pr_already_merged", pr_url: $pr_url, findings: $findings}')"
                return 0
            fi

            # Check cap.
            local next_cycle
            next_cycle=$(( ${review_cycle:-0} + 1 ))
            if [ "$next_cycle" -gt "${cap:-3}" ]; then
                _log "pipeline: $id: cycle cap hit (review_cycle=${review_cycle:-0}, cap=${cap:-3}) — blocking"
                _job_update "$id" \
                    ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
                _append_event "$id" "pipeline_cap_hit" \
                    "$(jq -nc \
                        --argjson cycle "${review_cycle:-0}" \
                        --argjson cap "${cap:-3}" \
                        --argjson findings "$merged_findings" \
                        '{review_cycle: $cycle, cap: $cap, outstanding: $findings}')"
            else
                # Continue: increment cycle, compute pending_agents (B5), re-ready.
                _log "pipeline: $id: agent findings found — continuing (cycle ${review_cycle:-0} -> $next_cycle)"
                local pending_json pending_agents first_agent
                pending_json=$(printf '%s' "$merged_findings" | jq -c \
                    '[.[] | select(.target == "redd" or .target == "cody" or .target == "marty") | .target] | unique' \
                    2>/dev/null) || pending_json="[]"
                pending_agents=$(printf '%s' "$pending_json" | jq -r '.[]' 2>/dev/null) \
                    || pending_agents=""
                first_agent=$(_pipeline_first_pending_agent "$pending_agents")
                local continued
                continued=$(jq \
                    --arg phase "$first_agent" \
                    --argjson pending_agents "$pending_json" \
                    --argjson next_cycle "$next_cycle" \
                    '.pipeline.phase = $phase
                    | .pipeline.pending_agents = $pending_agents
                    | .pipeline.review_cycle = $next_cycle
                    | .state = "ready"
                    | .activity = "pipeline_phase"
                    | .finished_at = null
                    | .started_at = null
                    | .worker_pid = null
                    | .actual_cost_usd = null
                    | .cancel_requested = null
                    | .pause_requested = null
                    | .final_result_at = null' \
                    "$jf") && _atomic_write "$jf" "$continued"
                _append_event "$id" "pipeline_cycle_continued" \
                    "$(jq -nc \
                        --argjson cycle "$next_cycle" \
                        --argjson pending_agents "$pending_json" \
                        '{review_cycle: $cycle, pending_agents: $pending_agents}')"
                # W5 lifecycle event: start the first build phase of the new cycle.
                _append_event "$id" "phase_started" \
                    "$(jq -nc \
                        --argjson cycle "$next_cycle" \
                        --arg agent "$first_agent" \
                        --arg rt "$(_agent_request_type "$first_agent")" \
                        '{cycle: $cycle, agent: $agent, request_type: $rt}')"
            fi
            ;;
    esac
}

# _run_pipeline_job — per-tick pipeline orchestrator.
# Finds the first pipeline job that is actionable this tick and advances it
# one step: build-phase succeeded → advance phase; review phase reached →
# run concurrent review + B4 exit decision. Serialized by a mkdir lock;
# one pipeline step per tick.
_run_pipeline_job() {
    [ "${MOTHER_PIPELINE_ENABLED:-1}" = "1" ] || return 0

    if ! mkdir "$_PIPELINE_DRIVER_LOCK" 2>/dev/null; then
        return 0  # another tick's driver run still holds the lock
    fi

    local f state kind pipeline_phase id
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        kind=$(jq -r '.kind // ""' "$f" 2>/dev/null) || continue
        [ "$kind" = "pipeline" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        [ "$state" = "succeeded" ] || continue
        pipeline_phase=$(jq -r '.pipeline.phase // ""' "$f" 2>/dev/null) || continue
        # done/blocked are terminal pipeline phases; skip.
        case "$pipeline_phase" in done|blocked|"") continue ;; esac
        id=$(jq -r '.id' "$f")

        case "$pipeline_phase" in

            redd|cody|marty)
                # Build phase just succeeded. Advance to the next eligible agent
                # (B5 skip: only agents in pending_agents are eligible on re-runs).
                local pending_agents next_phase review_cycle
                pending_agents=$(jq -r '.pipeline.pending_agents // [] | .[]' "$f" 2>/dev/null) \
                    || pending_agents=""
                review_cycle=$(jq -r '.pipeline.review_cycle // 0' "$f" 2>/dev/null) \
                    || review_cycle=0
                next_phase=$(_pipeline_next_build_phase "$pipeline_phase" "$pending_agents")

                if [ -n "$next_phase" ]; then
                    _log "pipeline: $id: phase=$pipeline_phase succeeded — advancing to $next_phase"
                    local advanced
                    advanced=$(jq --arg phase "$next_phase" \
                        '.pipeline.phase = $phase
                        | .state = "ready"
                        | .activity = "pipeline_phase"
                        | .finished_at = null
                        | .started_at = null
                        | .worker_pid = null
                        | .actual_cost_usd = null
                        | .cancel_requested = null
                        | .pause_requested = null
                        | .final_result_at = null' \
                        "$f") && _atomic_write "$f" "$advanced"
                    _append_event "$id" "pipeline_phase_advance" \
                        "$(jq -nc --arg from "$pipeline_phase" --arg to "$next_phase" \
                            '{from: $from, to: $to}')"
                    # W5 lifecycle events: complete the old phase, start the new one.
                    _append_event "$id" "phase_completed" \
                        "$(jq -nc \
                            --argjson cycle "${review_cycle:-0}" \
                            --arg agent "$pipeline_phase" \
                            --arg rt "$(_agent_request_type "$pipeline_phase")" \
                            '{cycle: $cycle, agent: $agent, request_type: $rt}')"
                    _append_event "$id" "phase_started" \
                        "$(jq -nc \
                            --argjson cycle "${review_cycle:-0}" \
                            --arg agent "$next_phase" \
                            --arg rt "$(_agent_request_type "$next_phase")" \
                            '{cycle: $cycle, agent: $agent, request_type: $rt}')"
                else
                    # No more eligible build agents — move to review phase.
                    # Keep state=succeeded so the driver picks it up next tick.
                    # B6: do NOT touch current_tier or escalation_count.
                    _log "pipeline: $id: phase=$pipeline_phase succeeded — all build phases done, moving to review"
                    _job_update "$id" \
                        ".pipeline.phase = \"review\" | .activity = \"pipeline_review\""
                    _append_event "$id" "pipeline_phase_advance" \
                        "$(jq -nc --arg from "$pipeline_phase" --arg to "review" '{from: $from, to: $to}')"
                    # W5 lifecycle event: complete the last build phase.
                    _append_event "$id" "phase_completed" \
                        "$(jq -nc \
                            --argjson cycle "${review_cycle:-0}" \
                            --arg agent "$pipeline_phase" \
                            --arg rt "$(_agent_request_type "$pipeline_phase")" \
                            '{cycle: $cycle, agent: $agent, request_type: $rt}')"
                fi
                break
                ;;

            review)
                # All build phases done. Run concurrent review + B4.
                _run_pipeline_review "$id" "$f"
                break
                ;;

        esac
    done

    rmdir "$_PIPELINE_DRIVER_LOCK" 2>/dev/null || true
}

_loop() {
    while [ "$SHUTDOWN" -eq 0 ]; do
        _reap_children
        _reap_broker
        _recover_orphans "$MOTHER_ORPHAN_GRACE"
        # Auto-resume system-paused jobs whose window has rolled over
        # BEFORE _promote_ready, so resumed jobs are eligible for the
        # current tick's spawn budget.
        _auto_resume_check
        # Auto-escalate failed jobs (before promote_ready so escalated jobs
        # land in ready and are eligible this tick).
        _auto_escalate_failed
        _promote_ready
        # Process adherence-pending jobs (after reaping so fresh succeeded
        # state is visible).
        _run_adherence_pending
        # Advance pipeline jobs one step per tick (build-phase transitions,
        # concurrent review, B4 exit decision). After adherence so build-phase
        # succeeded state is fully settled before the driver sees it.
        [ "${MOTHER_PIPELINE_ENABLED:-1}" = "1" ] && _run_pipeline_job

        if _quota_check; then
            # Under cap — normal dispatch.
            while [ "$(_count_running_children)" -lt "$MOTHER_CONCURRENCY" ]; do
                local next
                next=$(_pick_next_ready)
                [ -n "$next" ] || break
                _spawn_job "$next"
            done
        else
            # Over cap — only forced ready jobs may dispatch; pause the rest.
            while [ "$(_count_running_children)" -lt "$MOTHER_CONCURRENCY" ]; do
                local next
                next=$(_pick_next_forced_ready)
                [ -n "$next" ] || break
                _spawn_job "$next"
            done
            _maybe_pause_running
        fi

        _maybe_archive
        # Sleep in short slices so signal handling is responsive.
        local slept=0
        while [ "$slept" -lt "$MOTHER_POLL_INTERVAL" ] && [ "$SHUTDOWN" -eq 0 ]; do
            sleep 1
            slept=$((slept + 1))
        done
    done
}

_drain() {
    _stop_broker
    _log "drain: waiting up to ${MOTHER_SHUTDOWN_GRACE}s for ${MOTHER_CONCURRENCY} slots to clear"
    local elapsed=0
    while [ "$elapsed" -lt "$MOTHER_SHUTDOWN_GRACE" ]; do
        _reap_children
        local running; running=$(_count_running_children)
        [ "$running" -eq 0 ] && { _log "drain complete"; return 0; }
        sleep 1
        elapsed=$((elapsed + 1))
    done
    _reap_children
    local remaining; remaining=$(_count_running_children)
    if [ "$remaining" -gt 0 ]; then
        _log "drain grace expired — $remaining child(ren) still running; exiting anyway (jobs continue as detached worker processes)"
    fi
}

# ---------- entrypoint ----------

main() {
    _singleton_guard
    _write_pidfile
    trap '_on_signal' TERM INT
    _log "mother-runner started (pid $$, concurrency=$MOTHER_CONCURRENCY, poll=${MOTHER_POLL_INTERVAL}s)"
    _recover_stale_locks
    _recover_orphans
    _start_broker
    _loop
    _drain
    _remove_pidfile
    _log "mother-runner exited"
    exit 0
}

# Test entry point: run one pipeline driver tick and exit without starting
# the daemon loop. Used by pipeline_driver.bats.
# Usage: mother-runner --driver-tick
case "${1:-}" in
    --driver-tick)
        _run_pipeline_job
        exit 0
        ;;
    --recover-orphans-tick)
        # Test entry point: run one _recover_orphans pass (with the real
        # grace window, or an override via $2) and exit without starting the
        # daemon loop. Used by orphan_recovery.bats.
        # Usage: mother-runner --recover-orphans-tick [grace_seconds]
        _recover_orphans "${2:-$MOTHER_ORPHAN_GRACE}"
        exit 0
        ;;
    --archive-tick)
        # Test entry point: run one _maybe_archive pass and exit without
        # starting the daemon loop. Callers control whether the interval gate
        # actually fires via MOTHER_ARCHIVE_INTERVAL / the last-archive.ts
        # marker. Used by archive_watchdog.bats.
        # Usage: mother-runner --archive-tick
        _maybe_archive
        exit 0
        ;;
    --adherence-tick)
        # Test entry point: run one _run_adherence_pending pass and exit
        # without starting the daemon loop. Used by adherence.bats to cover
        # the mark-pending / run-one-review / requeue-on-fail behavior that
        # cmd_adherence_review alone (invoked directly) never exercises.
        # Usage: mother-runner --adherence-tick
        _run_adherence_pending
        exit 0
        ;;
    --recover-stale-locks-tick)
        # Test entry point: run one _recover_stale_locks pass and exit
        # without starting the daemon loop. Used by adherence.bats to cover
        # the leaked-lockdir regression (a lockdir left behind by a killed
        # instance previously disabled all automatic adherence review
        # forever, since mkdir-based locks have no owner/TTL and nothing
        # else ever cleared them).
        # Usage: mother-runner --recover-stale-locks-tick
        _recover_stale_locks
        exit 0
        ;;
esac

main "$@"
