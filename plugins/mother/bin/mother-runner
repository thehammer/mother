#!/usr/bin/env bash

# --- mother plugin path resolver (prepended during port) ---
# Resolves symlinks so the plugin works when installed via `ln -s` into a bin dir.
_MOTHER_RAW="${BASH_SOURCE[0]}"
while [ -L "$_MOTHER_RAW" ]; do
    _link="$(readlink "$_MOTHER_RAW")"
    case "$_link" in
        /*) _MOTHER_RAW="$_link" ;;
        *)  _MOTHER_RAW="$(dirname "$_MOTHER_RAW")/$_link" ;;
    esac
done
_MOTHER_SELF="$(cd "$(dirname "$_MOTHER_RAW")" && pwd -P)"
: "${MOTHER_BIN_DIR:=$_MOTHER_SELF}"
: "${MOTHER_LIB_DIR:=$_MOTHER_SELF/../lib}"
# -----------------------------------------------------------

# mother-runner — long-lived daemon for the Claude Code background queue.
#
# Polls ${MOTHER_ROOT:-${MOTHER_LIVE_ROOT:-$HOME/.mother}}/jobs every MOTHER_POLL_INTERVAL seconds. Promotes
# queued → ready when dependencies are satisfied, and forks `mother-run-job`
# children up to MOTHER_CONCURRENCY in parallel. Reaps exited children each
# tick. On SIGTERM/SIGINT, stops accepting new work and waits up to
# MOTHER_SHUTDOWN_GRACE seconds for in-flight jobs before exiting.
#
# On startup, any jobs in `running` state whose worker pid is gone are marked
# failed with reason=runner_died (crash recovery). Jobs whose worker is still
# alive are left alone (no re-adoption). Legacy records without `worker_pid`
# fall back to matching a recorded `tmux_window` against live tmux windows.
#
# Starts typically via `mother daemon start`. See also `mother daemon stop|status`.

set -u

# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/state.sh"

# W1–W3 substrate libs — sourced if present so the pipeline driver has
# findings helpers in-process. Guarded so runner builds even before W1–W3
# are merged (set -u safe: each var is read, not assigned).
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/findings.sh" ]      && source "$MOTHER_LIB_DIR/findings.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/backoff.sh" ]       && source "$MOTHER_LIB_DIR/backoff.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/limiter.sh" ]      && source "$MOTHER_LIB_DIR/limiter.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/request-types.sh" ] && source "$MOTHER_LIB_DIR/request-types.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/phase-prompt.sh" ]  && source "$MOTHER_LIB_DIR/phase-prompt.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/usage.sh" ]         && source "$MOTHER_LIB_DIR/usage.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/attention.sh" ]     && source "$MOTHER_LIB_DIR/attention.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/notify.sh" ]        && source "$MOTHER_LIB_DIR/notify.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/autostash.sh" ]     && source "$MOTHER_LIB_DIR/autostash.sh"
[ -r "$MOTHER_LIB_DIR/rwx.sh" ]           && source "$MOTHER_LIB_DIR/rwx.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/preview.sh" ]       && source "$MOTHER_LIB_DIR/preview.sh"

# Durable operator settings (${MOTHER_ROOT}/config.env) fill in anything the
# environment doesn't set, so they survive `mother daemon install` re-rendering
# the launchd plist. Must run before the defaults below.
# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/config.sh"
mother_config_load
MOTHER_CONCURRENCY_SOURCE=$(mother_config_source MOTHER_CONCURRENCY)
MOTHER_MIN_FREE_GB_SOURCE=$(mother_config_source MOTHER_MIN_FREE_GB)
MOTHER_DISPATCH_MODE_SOURCE=$(mother_config_source MOTHER_DISPATCH_MODE)

# Dispatch mode (cluster P1-5): `legacy` forks mother-run-job as it always has; `worker` leases jobs to the local
# worker through the coordinator. Anything else is legacy plus one stderr line (control characters stripped).
case "${MOTHER_DISPATCH_MODE:-legacy}" in
    legacy|worker) ;;
    *)
        printf 'mother-runner: unrecognized MOTHER_DISPATCH_MODE "%s"; using legacy\n' \
            "$(printf '%s' "$MOTHER_DISPATCH_MODE" | LC_ALL=C tr -d '\000-\037\177' | cut -c1-40)" >&2
        MOTHER_DISPATCH_MODE=legacy ;;
esac
MOTHER_DISPATCH_MODE="${MOTHER_DISPATCH_MODE:-legacy}"

MOTHER_CONCURRENCY="${MOTHER_CONCURRENCY:-2}"
MOTHER_POLL_INTERVAL="${MOTHER_POLL_INTERVAL:-2}"
MOTHER_SHUTDOWN_GRACE="${MOTHER_SHUTDOWN_GRACE:-30}"
MOTHER_ARCHIVE_INTERVAL="${MOTHER_ARCHIVE_INTERVAL:-3600}"   # seconds between retention sweeps
MOTHER_ARCHIVE_OLDER_THAN="${MOTHER_ARCHIVE_OLDER_THAN:-30}" # days
MOTHER_ARCHIVE_TIMEOUT="${MOTHER_ARCHIVE_TIMEOUT:-300}"      # seconds before a stuck sweep is killed
MOTHER_BACKUP_ENABLED="${MOTHER_BACKUP_ENABLED:-1}"           # back up the state tree on a timer (0 to disable)
MOTHER_BACKUP_INTERVAL="${MOTHER_BACKUP_INTERVAL:-3600}"      # seconds between state-tree backup attempts (skipped when unchanged)
MOTHER_BACKUP_TIMEOUT="${MOTHER_BACKUP_TIMEOUT:-300}"         # seconds before a stuck backup is killed
MOTHER_ATTENTION_INTERVAL="${MOTHER_ATTENTION_INTERVAL:-60}" # seconds between attention.json refreshes
MOTHER_PROGRESS_INTERVAL="${MOTHER_PROGRESS_INTERVAL:-30}"   # seconds between progress ticks
MOTHER_PROGRESS_CALIBRATE_INTERVAL="${MOTHER_PROGRESS_CALIBRATE_INTERVAL:-$MOTHER_ARCHIVE_INTERVAL}" # seconds between progress calibrations
MOTHER_PROGRESS_TIMEOUT="${MOTHER_PROGRESS_TIMEOUT:-60}"     # seconds before a stuck progress tick/calibration is killed
MOTHER_LIMITER_INTERVAL="${MOTHER_LIMITER_INTERVAL:-10}"     # seconds between backpressure-limiter ticks (observe-only)
MOTHER_LIMITER_TIMEOUT="${MOTHER_LIMITER_TIMEOUT:-20}"       # seconds before a stuck limiter tick is killed
MOTHER_MIN_FREE_GB="${MOTHER_MIN_FREE_GB:-20}"               # pause dispatch below this much free disk (0 disables)
MOTHER_SNAPSHOT_THIN_BELOW_GB="${MOTHER_SNAPSHOT_THIN_BELOW_GB:-40}" # thin Time Machine local snapshots below this much free disk (0 disables)
MOTHER_SNAPSHOT_THIN_INTERVAL="${MOTHER_SNAPSHOT_THIN_INTERVAL:-1800}" # min seconds between snapshot-thin attempts
MOTHER_SNAPSHOT_THIN_TIMEOUT="${MOTHER_SNAPSHOT_THIN_TIMEOUT:-120}"  # seconds before a stuck tmutil thin is killed
MOTHER_LOWDISK_GC_INTERVAL="${MOTHER_LOWDISK_GC_INTERVAL:-600}" # min seconds between low-disk-triggered `mother gc` sweeps
MOTHER_GC_ENABLED="${MOTHER_GC_ENABLED:-1}"                   # run `mother gc` hourly and on low disk (0 to disable)
MOTHER_GC_TIMEOUT="${MOTHER_GC_TIMEOUT:-300}"                 # seconds before a stuck `mother gc` is killed
MOTHER_NOTIFY_ENABLED="${MOTHER_NOTIFY_ENABLED:-1}"           # push when a job enters `awaiting` (0 to disable)
MOTHER_NOTIFY_SCAN_INTERVAL="${MOTHER_NOTIFY_SCAN_INTERVAL:-60}" # seconds between awaiting scans
MOTHER_AWAITING_REMIND_HOURS="${MOTHER_AWAITING_REMIND_HOURS:-24}" # reminder cadence for a job left awaiting

# Kill switches: set to 0 to disable without redeploying.
MOTHER_ESCALATION_ENABLED="${MOTHER_ESCALATION_ENABLED:-1}"
MOTHER_RECONCILE_ENABLED="${MOTHER_RECONCILE_ENABLED:-1}"
MOTHER_ADHERENCE_ENABLED="${MOTHER_ADHERENCE_ENABLED:-1}"
# Max adherence review spawns per job per PR head SHA before the runner stops
# and raises a needs-attention item instead (loop guard; see _run_adherence_pending).
MOTHER_ADHERENCE_MAX_RUNS_PER_SHA="${MOTHER_ADHERENCE_MAX_RUNS_PER_SHA:-3}"
MOTHER_BROKER_ENABLED="${MOTHER_BROKER_ENABLED:-1}"
MOTHER_PIPELINE_ENABLED="${MOTHER_PIPELINE_ENABLED:-1}"
MOTHER_PIPELINE_CYCLE_CAP="${MOTHER_PIPELINE_CYCLE_CAP:-3}"
export MOTHER_RETENTION_SWEEP_ENABLED="${MOTHER_RETENTION_SWEEP_ENABLED:-1}"
export MOTHER_TEMP_ORPHAN_MINUTES="${MOTHER_TEMP_ORPHAN_MINUTES:-60}"

PIDFILE="$RUNNER_DIR/runner.pid"
CHILDREN_DIR="$RUNNER_DIR/children"
BROKER_PIDFILE="$RUNNER_DIR/broker.pid"
COORD_PIDFILE="$RUNNER_DIR/coord.pid"
WORKER_PIDFILE="$RUNNER_DIR/worker-local.pid"
DISPATCH_DIR="$RUNNER_DIR/dispatch"
# Exists while a not-yet-finished `dispatch_via: worker` job may exist; `mother add --via-worker` touches it, the runner
# removes it (after a grace period) once no such job is live, so a legacy tick after worker use does no grep (see
# _worker_path_needed).
WORKER_JOBS_MARKER="$RUNNER_DIR/worker-jobs"
LEASES_DIR="$RUNNER_DIR/leases"
# Only live leases are scanned each tick: leases/active/<job> exists from dispatch until the job leaves `running`
# (terminal lease files are never read again, so tick cost does not grow with history).
ACTIVE_DIR="$LEASES_DIR/active"
COORD_SOCK="$RUNNER_DIR/coord/worker.sock"
COORD_REG_FIFO="$RUNNER_DIR/coord-reg.fifo"
WORKER_SECRET_FILE="$RUNNER_DIR/coord/worker-local.secret"
mkdir -p "$CHILDREN_DIR"

# Broker restart backoff state (seconds). Reset to 1 whenever the broker is
# observed alive; doubled (capped) on each restart attempt.
_BROKER_BACKOFF=1
_BROKER_NEXT_RESTART=0
# Same state for the coordinator and the local worker (cluster P1-5).
_COORD_BACKOFF=1
_COORD_NEXT_RESTART=0
_WORKER_BACKOFF=1
_WORKER_NEXT_RESTART=0

SHUTDOWN=0

# ---------- primitives ----------

_log() {
    printf '[%s] %s\n' "$(_iso_now)" "$*" >&2
}

_write_pidfile() {
    local tmp="$PIDFILE.tmp.$$"
    echo $$ > "$tmp" && mv "$tmp" "$PIDFILE"
}

# Publish the absolute path of the CLI this daemon runs from to
# $RUNNER_DIR/cli-path. The UserPromptSubmit hook prefers it over the plugin
# cache's copy: the events on disk are written by THIS code, so the reader has
# to be the same code — a months-stale cached CLI once replayed ancient
# archived-job events into unrelated sessions. Written atomically.
_publish_cli_path() {
    local cli="$MOTHER_BIN_DIR/mother" dir
    dir=$(cd "$(dirname "$cli")" 2>/dev/null && pwd -P) || return 0
    _atomic_write "$RUNNER_DIR/cli-path" "$dir/$(basename "$cli")"
}

# Publish the effective concurrency and where it came from (env | config file |
# default) to $RUNNER_DIR/effective-config.json for `mother status`. Written
# atomically at startup.
_publish_effective_config() {
    _atomic_write "$RUNNER_DIR/effective-config.json" "$(jq -nc \
        --argjson pid "$$" --arg at "$(_iso_now)" \
        --arg c "$MOTHER_CONCURRENCY" --arg src "$MOTHER_CONCURRENCY_SOURCE" \
        --arg mf "$MOTHER_MIN_FREE_GB" --arg mfsrc "$MOTHER_MIN_FREE_GB_SOURCE" \
        --arg dm "$MOTHER_DISPATCH_MODE" --arg dmsrc "$MOTHER_DISPATCH_MODE_SOURCE" \
        '{pid: $pid, started_at: $at, concurrency: ($c | tonumber? // $c), concurrency_source: $src,
          min_free_gb: ($mf | tonumber? // $mf), min_free_gb_source: $mfsrc,
          dispatch_mode: $dm, dispatch_mode_source: $dmsrc}')"
}

_remove_pidfile() {
    # Only remove the pidfile if it still names us. Otherwise a second
    # instance shutting down (e.g. one that lost the singleton race, or was
    # killed directly) would delete the pidfile out from under whichever
    # instance is still legitimately running, breaking `mother daemon
    # status`/`stop` and defeating _singleton_guard for the next start.
    # (Observed live: killing an orphaned duplicate runner deleted the
    # supervised instance's pidfile even though that instance kept running.)
    local current_pid
    current_pid=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ "$current_pid" = "$$" ]; then
        rm -f "$PIDFILE"
    fi
}

# Refuse to start a second runner against the same MOTHER_ROOT. Without this,
# a stray manual invocation (or a launchd reload racing a leftover foreground
# run) silently coexists with the supervised instance: both poll the same
# jobs/ directory, both dispatch up to MOTHER_CONCURRENCY workers, and they
# race on the same job state files (observed as spurious `jq: could not open
# file <job>.json` errors in the log when one runner archives/moves a job
# out from under the other mid-tick). A dead pid's stale pidfile is reclaimed
# rather than treated as a lock.
_singleton_guard() {
    [ -f "$PIDFILE" ] || return 0
    local existing_pid
    existing_pid=$(cat "$PIDFILE" 2>/dev/null || true)
    if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
        _log "refusing to start: mother-runner already running as pid $existing_pid ($PIDFILE). Stop it first (mother daemon stop) or remove the pidfile if it's stale."
        exit 1
    fi
    [ -n "$existing_pid" ] && _log "reclaiming stale pidfile for dead pid $existing_pid"
}

_on_signal() {
    SHUTDOWN=1
    _log "signal received — draining"
}

# ---------- child tracking ----------

_track_child() {
    local pid="$1" job_id="$2"
    jq -nc --argjson pid "$pid" --arg job_id "$job_id" --arg started "$(_iso_now)" \
        '{pid: $pid, job_id: $job_id, started_at: $started}' \
        > "$CHILDREN_DIR/$pid.json"
}

_reap_children() {
    # For each tracked child, remove its file if the pid is dead.
    local f pid
    for f in "$CHILDREN_DIR"/*.json; do
        [ -f "$f" ] || continue
        pid=$(basename "$f" .json)
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$f"
        fi
    done
}

# Supervisors this daemon forked itself (legacy dispatch). _drain waits on these only.
_count_forked_children() {
    find "$CHILDREN_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | wc -l | tr -d ' '
}

# Slots in use: forked supervisors plus leased jobs (see _leased_job_ids).
_count_running_children() {
    if _worker_path_possible; then
        echo $(( $(_count_forked_children) + $(_leased_job_ids | wc -l | tr -d ' ') ))
    else
        _count_forked_children
    fi
}

# _worker_path_possible: one stat. False (the legacy default) means nothing below forks or reads a file.
_worker_path_possible() {
    [ "$MOTHER_DISPATCH_MODE" = "worker" ] || [ -d "$LEASES_DIR" ] || [ -d "$DISPATCH_DIR" ]
}

# _active_ids: one job id per line for every job in the active-lease index.
_active_ids() {
    local f
    for f in "$ACTIVE_DIR"/*; do
        [ -e "$f" ] && printf '%s\n' "${f##*/}"
    done
}

# _leased_job_ids: one job id per line for every job a worker holds or is about to hold: a dispatch request the
# coordinator has not turned into a lease yet, or an indexed lease in `offered` or `active`. The coordinator owns
# their liveness, so they occupy a slot exactly like a forked supervisor does.
_leased_job_ids() {
    local f id
    _worker_path_possible || return 0
    for f in "$DISPATCH_DIR"/*.json; do
        [ -f "$f" ] || continue
        id="${f##*/}"; printf '%s\n' "${id%.json}"
    done
    for f in "$ACTIVE_DIR"/*; do
        [ -e "$f" ] || continue
        id="${f##*/}"
        [ -f "$DISPATCH_DIR/$id.json" ] && continue
        case "$(jq -r '.state // empty' "$LEASES_DIR/$id.json" 2>/dev/null)" in
            offered|active) printf '%s\n' "$id" ;;
        esac
    done
}

_job_is_leased() {
    [ -f "$DISPATCH_DIR/$1.json" ] && return 0
    [ -e "$ACTIVE_DIR/$1" ] || return 1
    case "$(jq -r '.state // empty' "$LEASES_DIR/$1.json" 2>/dev/null)" in
        offered|active) return 0 ;;
    esac
    return 1
}

# Supervisor liveness check, used by the reaper to avoid racing the
# in-process supervisor's terminal transition. CHILDREN_DIR tracks the
# mother-run-job (supervisor) PIDs along with the job_id they own; the
# job json's `worker_pid` is a different process — the wrapper bash that
# runs claude. The wrapper exits when claude exits (natural completion),
# leaving the supervisor in a post-exit window: it has to wake from its
# 2s poll-loop sleep, read the marker file, scan for pr_url, and write
# the terminal transition. Reaping based on `worker_pid` alone fires
# during that window and clobbers the supervisor's pending succeeded
# write — sometimes leaving the job stuck in `failed: runner_died`
# despite the work being committed.
_supervisor_alive_for_job() {
    _job_is_leased "$1" && return 0
    _supervisor_pid_for_job "$1" >/dev/null
}

# _supervisor_pid_for_job <job_id>: print the pid of a live supervisor entry for
# the job and return 0; return 1 when there is none. An entry whose file is older
# than MOTHER_SUPERVISOR_STALE_S (default 900) and whose pid is no longer a
# `mother-run-job` process is a reused pid: the entry is cleared and not counted.
# When `ps` cannot say what the pid is, the entry is trusted (alive).
_supervisor_pid_for_job() {
    local job_id="$1" f pid jid cmd tok age is_run
    for f in "$CHILDREN_DIR"/*.json; do
        [ -f "$f" ] || continue
        pid="$(basename "$f" .json)"
        jid="$(jq -r '.job_id // empty' "$f" 2>/dev/null)"
        [ "$jid" = "$job_id" ] || continue
        kill -0 "$pid" 2>/dev/null || continue
        age=$(( $(date +%s) - $(_file_mtime "$f") ))
        if [ "$age" -gt "${MOTHER_SUPERVISOR_STALE_S:-900}" ] && cmd=$(ps -o command= -p "$pid" 2>/dev/null) && [ -n "$cmd" ]; then
            is_run=0
            set -f; for tok in $cmd; do [ "${tok##*/}" = "mother-run-job" ] && is_run=1; done; set +f
            if [ "$is_run" -eq 0 ]; then
                _log "clearing supervisor entry $pid for $job_id: pid reused by another process (entry ${age}s old)"
                rm -f "$f"
                continue
            fi
        fi
        echo "$pid"
        return 0
    done
    return 1
}

# _note_waiting_on_supervisor <job_id>: a job is being held back by a supervisor
# entry that is still alive. Say so in the job's events, at most once per
# MOTHER_SUPERVISOR_WAIT_NOTE_S (default 600) per job, so a hung supervisor is
# visible without a line per tick.
_note_waiting_on_supervisor() {
    local id="$1" pid mark now last
    pid=$(_supervisor_pid_for_job "$id") || return 0
    mark="$RUNNER_DIR/supervisor-wait/$id"
    now=$(date +%s)
    last=$(_file_mtime "$mark")
    [ $((now - last)) -ge "${MOTHER_SUPERVISOR_WAIT_NOTE_S:-600}" ] || return 0
    mkdir -p "$RUNNER_DIR/supervisor-wait" && : > "$mark"
    _log "$id: waiting on supervisor pid $pid before it can be started again"
    _append_event "$id" "quota_release_waiting_on_supervisor" "$(jq -nc --argjson p "$pid" '{supervisor_pid: $p}')"
}

# ---------- broker supervision (B9) ----------
#
# The IPC broker is a long-lived Go sidecar that fans out state/activity/
# await/quota/current_activity events to connected clients and routes
# answer/cancel/retry commands back through the `mother` CLI. The daemon
# supervises it: started when the daemon starts, SIGTERM'd on drain, and
# restarted with bounded backoff if it dies. Everything is gated behind
# MOTHER_BROKER_ENABLED (default 1) so the daemon runs identically to before
# when the broker is disabled.

_broker_pid() {
    [ -f "$BROKER_PIDFILE" ] && cat "$BROKER_PIDFILE" 2>/dev/null || echo ""
}

_broker_alive() {
    local p; p=$(_broker_pid)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

_start_broker() {
    [ "$MOTHER_BROKER_ENABLED" = "1" ] || return 0
    _broker_alive && return 0
    # Detach like the job workers: nohup + background + disown. NOTE: nohup +
    # disown does NOT create a new process group or session — `disown` only
    # drops the job from this shell's job table so we won't SIGHUP it, and
    # neither call touches setpgid/setsid. The broker keeps the daemon's PGID.
    # Surviving a daemon restart depends on the launchd agent's
    # AbandonProcessGroup=true key (see launchd/com.thehammer.mother.plist),
    # not on anything here. The broker tees its own diagnostics to
    # logs/broker.log.
    nohup "$MOTHER_BIN_DIR/mother-broker" </dev/null >>"$LOGS_DIR/broker.log" 2>&1 &
    local pid=$!
    disown 2>/dev/null || true
    echo "$pid" > "$BROKER_PIDFILE"
    _log "started broker (pid $pid)"
}

_stop_broker() {
    local p; p=$(_broker_pid)
    [ -n "$p" ] || return 0
    if kill -0 "$p" 2>/dev/null; then
        kill -TERM "$p" 2>/dev/null || true
        _log "stopped broker (pid $p)"
    fi
    rm -f "$BROKER_PIDFILE"
}

# _reap_broker: if the broker is enabled but not alive, restart it once the
# backoff window has elapsed. Called each loop tick.
_reap_broker() {
    [ "$MOTHER_BROKER_ENABLED" = "1" ] || return 0
    if _broker_alive; then
        _BROKER_BACKOFF=1
        return 0
    fi
    local now; now=$(date +%s)
    [ "$now" -ge "$_BROKER_NEXT_RESTART" ] || return 0
    _log "broker not running — restarting (backoff=${_BROKER_BACKOFF}s)"
    _start_broker
    _BROKER_NEXT_RESTART=$((now + _BROKER_BACKOFF))
    _BROKER_BACKOFF=$((_BROKER_BACKOFF * 2))
    [ "$_BROKER_BACKOFF" -gt 30 ] && _BROKER_BACKOFF=30
}

# ---------- coordinator + local worker supervision (cluster P1-5) ----------
#
# With MOTHER_DISPATCH_MODE=worker (or for a job with dispatch_via "worker") jobs do not get a forked
# mother-run-job: the runner writes runner/dispatch/<job>.json and the coordinator (mother-coord) leases the job
# to the laptop's own worker (mother-worker --id local), which runs the supervisor in worker mode and ships
# everything back (docs/worker-protocol.md). Both daemons are supervised like the broker: nohup, pidfile,
# doubling restart backoff. They start only when something needs them (worker mode, a worker-path job, or a
# lease/dispatch request still in flight, so flipping the switch back never strands a running job).
#
# The coordinator only accepts workers registered over its --secrets-fd: a fifo this runner owns (fresh on every
# coordinator start, so no registration outlives its coordinator) carries `local=<worker pid>=<secret>`. The
# secret is random per worker start and lives in runner/coord/ (0700) as a 0600 file, so a restarted runner can
# re-register a worker that outlived it (MC-16); it is never in an environment variable or argv.
#
# _drain stops the coordinator like the broker but NOT the worker: jobs keep running through a runner restart.

_coord_pid() { { cat "$COORD_PIDFILE" 2>/dev/null || true; } | tr -dc '0-9'; }

_coord_alive() {
    local p; p=$(_coord_pid)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null
}

_worker_pid() { { cat "$WORKER_PIDFILE" 2>/dev/null || true; } | tr -dc '0-9'; }

# The pid we trust is the one this runner's launcher obtained (`$!`), recorded with the process's start time
# (runner/worker-local.start). Nothing under the worker's own root is ever read for it: an agent running below the
# worker can write there. The start time is verified once per pid (a recycled pid has another start time and a
# different command), then `kill -0` is enough.
_proc_start() { ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' | sed 's/^ //'; }

_WORKER_VERIFIED_PID=""
_worker_alive() {
    local p; p=$(_worker_pid)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null || return 1
    [ "$p" = "$_WORKER_VERIFIED_PID" ] && return 0
    local want have
    want=$(cat "$WORKER_PIDFILE.start" 2>/dev/null || true)
    have=$(_proc_start "$p")
    [ -n "$want" ] && [ "$want" = "$have" ] || return 1
    case "$(ps -o command= -p "$p" 2>/dev/null)" in *mother-worker*) ;; *) return 1 ;; esac
    _WORKER_VERIFIED_PID="$p"
}

# The worker is gone (or is not the process we started): its secret must not outlive it.
_forget_local_worker() {
    rm -f "$WORKER_SECRET_FILE" "$WORKER_PIDFILE" "$WORKER_PIDFILE.start"
    _WORKER_VERIFIED_PID=""
}

_worker_root() { printf '%s/local' "${MOTHER_WORKER_ROOT:-$HOME/.mother-worker}"; }

# _job_uses_worker <job_id>: the per-job override wins over the mode. Legacy with no worker path in play: no fork.
_job_uses_worker() {
    _worker_path_possible || return 1
    case "$(jq -r '.dispatch_via // empty' "$JOBS_DIR/$1.json" 2>/dev/null)" in
        worker) return 0 ;;
        legacy) return 1 ;;
    esac
    [ "$MOTHER_DISPATCH_MODE" = "worker" ]
}

# _worker_path_needed: should the coordinator and the local worker be running? (Callers check
# _worker_path_possible first; `mother add --via-worker` creates runner/dispatch so a worker-path job is seen.)
_worker_path_needed() {
    [ "$MOTHER_DISPATCH_MODE" = "worker" ] && return 0
    [ -n "$(_leased_job_ids)" ] && return 0
    [ -d "$ACTIVE_DIR" ] && [ -n "$(_active_ids)" ] && return 0
    # No marker: no worker-path job can be waiting, so there is nothing to grep for (the legacy steady state).
    [ -e "$WORKER_JOBS_MARKER" ] || return 1
    local f
    for f in $(grep -lE '"dispatch_via"[[:space:]]*:[[:space:]]*"worker"' "$JOBS_DIR"/*.json 2>/dev/null); do
        case "$(jq -r '.state // empty' "$f" 2>/dev/null)" in
            succeeded|failed|cancelled|'') ;;
            *) return 0 ;;
        esac
    done
    # None live. Drop the marker once it is older than a minute (`mother add` touches it just before it writes the
    # job file, so a brand-new marker may precede its job).
    [ -n "$(find "$WORKER_JOBS_MARKER" -mmin +1 2>/dev/null)" ] && rm -f "$WORKER_JOBS_MARKER"
    return 1
}

# _register_local_worker: tell a running coordinator the worker's real pid and secret. Idempotent; the fifo is
# opened read-write so the write never blocks, and the coordinator reads it for its whole life.
_register_local_worker() {
    _coord_alive || return 0
    local wpid secret
    wpid=$(_worker_pid)
    secret=$(cat "$WORKER_SECRET_FILE" 2>/dev/null || true)
    [ -n "$wpid" ] && [ -n "$secret" ] && [ -p "$COORD_REG_FIFO" ] || return 0
    printf 'local=%s=%s\n' "$wpid" "$secret" 1<>"$COORD_REG_FIFO" 2>/dev/null || true
}

_start_coord() {
    _coord_alive && return 0
    mkdir -p "$RUNNER_DIR/coord" "$DISPATCH_DIR" && chmod 700 "$RUNNER_DIR/coord" 2>/dev/null
    rm -f "$COORD_REG_FIFO"
    mkfifo -m 600 "$COORD_REG_FIFO" 2>/dev/null || { _log "cannot create $COORD_REG_FIFO; coordinator not started"; return 1; }
    # Same detach as the broker: nohup + background + disown; the process group survives the runner through
    # AbandonProcessGroup. fd 4 is the registration fifo (read-write, so the open never blocks).
    nohup "$MOTHER_BIN_DIR/mother-coord" --secrets-fd 4 </dev/null >>"$LOGS_DIR/coord.log" 2>&1 4<>"$COORD_REG_FIFO" &
    local pid=$!
    disown 2>/dev/null || true
    echo "$pid" > "$COORD_PIDFILE"
    _log "started coordinator (pid $pid)"
    _register_local_worker
}

_stop_coord() {
    local p; p=$(_coord_pid)
    [ -n "$p" ] || return 0
    if kill -0 "$p" 2>/dev/null; then
        kill -TERM "$p" 2>/dev/null || true
        local i=0
        while kill -0 "$p" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
        _log "stopped coordinator (pid $p)"
    fi
    rm -f "$COORD_PIDFILE"
}

_reap_coord() {
    _worker_path_possible || return 0
    _worker_path_needed || return 0
    if _coord_alive; then
        _COORD_BACKOFF=1
        return 0
    fi
    local now; now=$(date +%s)
    [ "$now" -ge "$_COORD_NEXT_RESTART" ] || return 0
    _log "coordinator not running — starting (backoff=${_COORD_BACKOFF}s)"
    _start_coord
    _COORD_NEXT_RESTART=$((now + _COORD_BACKOFF))
    _COORD_BACKOFF=$((_COORD_BACKOFF * 2))
    [ "$_COORD_BACKOFF" -gt 30 ] && _COORD_BACKOFF=30
    return 0
}

_start_local_worker() {
    _worker_alive && return 0
    local root secret
    root=$(_worker_root)
    mkdir -p "$root" "$RUNNER_DIR/coord" && chmod 700 "$RUNNER_DIR/coord" 2>/dev/null
    secret=$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')
    ( umask 077; printf '%s\n' "$secret" > "$WORKER_SECRET_FILE" ) || { _log "cannot write the worker secret; worker not started"; return 1; }
    # The worker takes MOTHER_ROOT from --root (it scrubs the rest of the environment for its children).
    nohup env -u MOTHER_ROOT -u MOTHER_LIVE_ROOT -u JOBS_DIR -u EVENTS_DIR -u LOGS_DIR -u DRAFTS_DIR -u CURSORS_DIR \
        -u RUNNER_DIR -u ARCHIVE_DIR -u TEARDOWN_DIR MOTHER_ROOT="$root" \
        "$MOTHER_BIN_DIR/mother-worker" --id local --root "$root" --coord-sock "$COORD_SOCK" \
        --slots "$MOTHER_CONCURRENCY" --secret-fd 4 \
        4< <(printf '%s\n' "$secret") </dev/null >>"$LOGS_DIR/worker-local.log" 2>&1 &
    local pid=$!
    disown 2>/dev/null || true
    echo "$pid" > "$WORKER_PIDFILE"
    _proc_start "$pid" > "$WORKER_PIDFILE.start"
    _WORKER_VERIFIED_PID="$pid"
    _log "started local worker (pid $pid, root $root)"
    _register_local_worker
}

_reap_local_worker() {
    _worker_path_possible || return 0
    _worker_path_needed || return 0
    if _worker_alive; then
        _WORKER_BACKOFF=1
        return 0
    fi
    _forget_local_worker
    local now; now=$(date +%s)
    [ "$now" -ge "$_WORKER_NEXT_RESTART" ] || return 0
    _log "local worker not running — starting (backoff=${_WORKER_BACKOFF}s)"
    _start_local_worker
    _WORKER_NEXT_RESTART=$((now + _WORKER_BACKOFF))
    _WORKER_BACKOFF=$((_WORKER_BACKOFF * 2))
    [ "$_WORKER_BACKOFF" -gt 30 ] && _WORKER_BACKOFF=30
    return 0
}

# _worker_connected: does the coordinator report the local worker connected? One `mother-coord --status-json`
# call, cached for the current dispatch pass (_WORKER_CONN_PASS is reset at the top of each pass).
_WORKER_CONN_PASS=""
_worker_connected() {
    if [ -z "$_WORKER_CONN_PASS" ]; then
        if "$MOTHER_BIN_DIR/mother-coord" --status-json 2>/dev/null \
            | jq -e '[.workers[]? | select(.connected == true)] | length > 0' >/dev/null 2>&1; then
            _WORKER_CONN_PASS=yes
        else
            _WORKER_CONN_PASS=no
        fi
    fi
    [ "$_WORKER_CONN_PASS" = "yes" ]
}

# _flag_worker_unavailable <job_id>: a worker-path job stays `ready` while no worker is connected; the operator
# sees why (needs-attention item `worker_unavailable`). Written once, cleared when the job is dispatched.
_flag_worker_unavailable() {
    [ "$(jq -r '.needs_attention.reason // empty' "$JOBS_DIR/$1.json" 2>/dev/null)" = "worker_unavailable" ] && return 0
    _log "not dispatching $1: no worker is connected to the coordinator"
    _job_update "$1" ".needs_attention = $(jq -nc --arg since "$(_iso_now)" \
        '{reason: "worker_unavailable", note: "no worker is connected to the coordinator (is mother-worker starting? see logs/worker-local.log); the job stays ready and starts when one connects", since: $since}')"
}

# _write_dispatch_request <job_id>: hand a job to the coordinator (atomic).
_write_dispatch_request() {
    mkdir -p "$DISPATCH_DIR"
    mkdir -p "$ACTIVE_DIR"
    : > "$ACTIVE_DIR/$1"
    _atomic_write "$DISPATCH_DIR/$1.json" "$(jq -nc --arg j "$1" --arg at "$(_iso_now)" '{job: $j, requested_at: $at}')"
}

# _lease_state <job_id>: the lease file's state ("" when none).
_lease_state() { jq -r '.state // empty' "$LEASES_DIR/$1.json" 2>/dev/null; }

# _lease_awaits_finalize <job_id>: the worker released the lease as succeeded; the coordinator still has to
# derive the canonical success.
_lease_awaits_finalize() {
    [ -e "$ACTIVE_DIR/$1" ] || return 1
    [ "$(jq -r '[.state // "", .end_reason // ""] | join("/")' "$LEASES_DIR/$1.json" 2>/dev/null)" = "released/succeeded" ]
}

# _lease_lost_unhandled <job_id>: the lease is `lost` (or carries a `.lost` marker and is not live) and
# _recover_lost_leases has not yet recorded it. The orphan reaper must leave such a job alone, otherwise it fails
# it `runner_died` and the `worker_lost` event never appears. One stat for a non-indexed (legacy) job.
_lease_lost_unhandled() {
    [ -e "$ACTIVE_DIR/$1" ] || return 1
    local lf="$LEASES_DIR/$1.json" st lease_id
    st=$(jq -r '.state // empty' "$lf" 2>/dev/null)
    if [ "$st" != "lost" ]; then
        [ -f "$LEASES_DIR/$1.lost" ] || return 1
        case "$st" in offered|active|released) return 1 ;; esac
    fi
    lease_id=$(jq -r '.lease_id // empty' "$lf" 2>/dev/null)
    [ "$(cat "$LEASES_DIR/$1.lost-handled" 2>/dev/null)" != "$lease_id" ]
}

# _rebuild_active_index: once at startup (a runner upgraded from before the index existed, or restarted with
# leases in flight): index every lease whose job is still `running`. This is the only pass over all lease files.
_rebuild_active_index() {
    local f id
    [ -d "$LEASES_DIR" ] || return 0
    for f in "$LEASES_DIR"/*.json; do
        [ -f "$f" ] || continue
        id="${f##*/}"; id="${id%.json}"
        [ "$id" = "audit" ] && continue
        [ "$(jq -r '.state // empty' "$JOBS_DIR/$id.json" 2>/dev/null)" = "running" ] || continue
        mkdir -p "$ACTIVE_DIR"
        : > "$ACTIVE_DIR/$id"
    done
}

# _prune_active: an indexed job that left `running` (finished, failed, cancelled, paused) drops out of the index,
# and a dispatch request nobody will consume for it is removed. Index only: the lease file itself stays as history.
_prune_active() {
    local id
    for id in $(_active_ids); do
        [ "$(jq -r '.state // empty' "$JOBS_DIR/$id.json" 2>/dev/null)" = "running" ] && continue
        rm -f "$ACTIVE_DIR/$id" "$DISPATCH_DIR/$id.json"
    done
}

# _finalize_one <job> <root>: body of the background finalize (see _finalize_released_leases).
_finalize_one() {
    local id="$1" root="$2" rc=0
    bash "$MOTHER_LIB_DIR/coord_apply.sh" --finalize "$root" "$id" >/dev/null 2>&1 || rc=$?
    case "$rc" in
        0) _log "$id: success verified" ;;
        3) _log "$id: success refused (unpushed_commit)" ;;
        4) _log "$id: cancelled (cancel was requested before the success was derived)" ;;
    esac
    rm -f "$LEASES_DIR/$id.finalizing"
}

# _finalize_released_leases: the coordinator derives `succeeded` (a worker can never write it). A lease the
# worker released as succeeded while the canonical job is still `running` is verified against the remote by
# `coord_apply.sh --finalize` (succeeded, failed unpushed_commit, or cancelled when a cancel was requested).
# The check can take a minute against a slow remote, so each runs in the background, one per job (the
# pid file is the lock); the loop never waits on it.
_finalize_released_leases() {
    local id root fp
    root="${MOTHER_ROOT:-${MOTHER_LIVE_ROOT:-$HOME/.mother}}"
    for id in $(_active_ids); do
        _lease_awaits_finalize "$id" || continue
        [ "$(jq -r '.state // empty' "$JOBS_DIR/$id.json" 2>/dev/null)" = "running" ] || continue
        fp=""
        read -r fp 2>/dev/null < "$LEASES_DIR/$id.finalizing" || true
        [ -n "$fp" ] && kill -0 "$fp" 2>/dev/null && continue
        _log "finalizing $id (lease released as succeeded)"
        ( _finalize_one "$id" "$root" ) </dev/null >/dev/null 2>&1 &
        echo "$!" > "$LEASES_DIR/$id.finalizing"
        disown 2>/dev/null || true
    done
}

# _recover_lost_leases: a lease the coordinator declared lost (TTL expired) on a job that is still `running`.
# Interim behaviour until P1-6 resumes it: record the usage row of the dead run, fail the job `worker_lost`
# and let failure routing take it from there. Handled once per lease (marker keyed by lease id).
_recover_lost_leases() {
    local f id lease_id st jf lost=0
    for id in $(_active_ids); do
        f="$LEASES_DIR/$id.json"
        [ -f "$f" ] || continue
        jf="$JOBS_DIR/$id.json"
        [ -f "$jf" ] || continue
        st=$(jq -r '.state // empty' "$f" 2>/dev/null)
        lost=0
        [ "$st" = "lost" ] && lost=1
        if [ "$lost" -eq 0 ] && [ -f "$LEASES_DIR/$id.lost" ]; then
            case "$st" in offered|active|released) ;; *) lost=1 ;; esac
        fi
        [ "$lost" -eq 1 ] || continue
        [ "$(jq -r '.state // empty' "$jf" 2>/dev/null)" = "running" ] || continue
        lease_id=$(jq -r '.lease_id // empty' "$f" 2>/dev/null)
        [ "$(cat "$LEASES_DIR/$id.lost-handled" 2>/dev/null)" = "$lease_id" ] && continue
        _orphan_lost_lease "$id" "$jf" "$f" "$lease_id"
    done
}

# _lost_run_log_offset <job> <job-file> <lease-file>: where the dead run's log segment starts. The canonical job
# has it once the worker's `current_run` op was replayed; under load that may not have happened, so the worker's
# own mirror (same machine, written before the op is shipped) is the second source. With neither, a job that has
# never been charged anything has no earlier run, so its segment starts at 0.
_lost_run_log_offset() {
    local id="$1" jf="$2" lf="$3" off wid mirror
    off=$(jq -r '.current_run.log_offset // empty' "$jf" 2>/dev/null)
    if [ -z "$off" ]; then
        wid=$(jq -r '.worker_id // empty' "$lf" 2>/dev/null)
        case "$wid" in ''|*[!A-Za-z0-9._-]*|*..*) wid="" ;; esac
        mirror="${MOTHER_WORKER_ROOT:-$HOME/.mother-worker}/$wid/jobs/$id.json"
        [ -z "$wid" ] || off=$(jq -r '.current_run.log_offset // empty' "$mirror" 2>/dev/null)
    fi
    if [ -z "$off" ] && [ "$(jq -r '(.actual_cost_usd // 0) == 0 and (.actual_tokens // 0) == 0' "$jf" 2>/dev/null)" = "true" ]; then
        off=0
    fi
    case "$off" in ''|*[!0-9]*) return 1 ;; esac
    printf '%s' "$off"
}

_orphan_lost_lease() {
    local id="$1" jf="$2" lf="$3" lease_id="$4" terminal detail offset ophase ostage outcome=failed
    if [ "$(jq -r '.cancel_requested // false' "$jf" 2>/dev/null)" = "true" ]; then
        terminal=cancelled; outcome=cancelled; detail='{"reason":"user"}'
    else
        terminal=failed
        detail=$(jq -nc --arg w "$(jq -r '.worker_id // empty' "$lf")" \
            --argjson e "$(jq -c '.epoch // null' "$lf")" --arg hb "$(jq -r '.last_hb // empty' "$lf")" \
            '{reason: "worker_lost", worker: $w, lease_epoch: $e, last_heartbeat_at: $hb}')
    fi
    _log "marking $id $terminal (lease $lease_id lost)"
    if type mother_record_run_usage >/dev/null 2>&1; then
        if offset=$(_lost_run_log_offset "$id" "$jf" "$lf"); then
            ophase=$(jq -r '.pipeline.phase // empty' "$jf" 2>/dev/null)
            ostage="${ophase:-cody}"
            mother_record_run_usage "$id" "$outcome" "$LOGS_DIR/$id.log" "$offset" "" "$ostage" "${ostage}-main" "worker" \
                "$(jq -nc '{failure_reason: "worker_lost"}')"
        else
            _log "$id: no log offset for the lost run; its usage row could not be recorded"
        fi
    fi
    _job_transition "$id" "$terminal" "$detail"
    _job_update "$id" 'if .activity == "gating" or .activity == "gate_fix" then .activity = null else . end'
    printf '%s\n' "$lease_id" > "$LEASES_DIR/$id.lost-handled"
}

# _worker_path_tick: the per-tick worker-path work. Legacy default (no leases/dispatch dir): one stat and out.
# Otherwise it scans only the indexed (live) leases, never the lease history.
_worker_path_tick() {
    _worker_path_possible || return 0
    if [ -d "$ACTIVE_DIR" ]; then
        _recover_lost_leases
        _finalize_released_leases
        _prune_active
    fi
    _reap_coord
    _reap_local_worker
}

# ---------- ready-job selection ----------

# A `ready` job backed off for a rate limit carries `.not_before` (epoch
# seconds); it is not eligible until that time has passed (lib/backoff.sh).
# A not_before further out than the backoff horizon is bogus and ignored.
_pick_next_ready() {
    local now hz; now=$(date +%s); hz=$(mother_backoff_horizon_s)
    find "$JOBS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | while read -r f; do
        jq -r --argjson now "$now" --argjson hz "$hz" \
            --arg skip " ${_DISPATCH_SKIP:-} " \
            'select(.state == "ready" and (.id as $jid | ($skip | contains(" " + $jid + " ")) | not) and (((.not_before // 0) | tonumber? // 0) as $nb | $nb <= $now or $nb > $now + $hz)) | .created_at + "\t" + .id' "$f"
    done | sort | head -1 | cut -f2
}

_pick_next_forced_ready() {
    local now hz; now=$(date +%s); hz=$(mother_backoff_horizon_s)
    find "$JOBS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | while read -r f; do
        jq -r --argjson now "$now" --argjson hz "$hz" \
            --arg skip " ${_DISPATCH_SKIP:-} " \
            'select(.state == "ready" and (.force_start == true) and (.id as $jid | ($skip | contains(" " + $jid + " ")) | not) and (((.not_before // 0) | tonumber? // 0) as $nb | $nb <= $now or $nb > $now + $hz)) | .created_at + "\t" + .id' "$f"
    done | sort | head -1 | cut -f2
}

# Enforced admission (limiter mode `enforce`, L3): the next job is the first id in the limiter's
# ordered admit list (state.json `admit`) that is still `ready`, not skipped this pass and past its
# `not_before`. `_LIMITER_ADMIT` holds the list for one dispatch pass. With an argument ("forced"),
# only force_start jobs qualify (the quota-gate cap backstop).
_pick_next_limiter_ready() {
    local only_forced="${1:-}" now hz id f; now=$(date +%s); hz=$(mother_backoff_horizon_s)
    while read -r id; do
        [ -n "$id" ] || continue
        case " ${_DISPATCH_SKIP:-} " in *" $id "*) continue ;; esac
        f=$(_job_path "$id")
        [ -f "$f" ] || continue
        if jq -e --argjson now "$now" --argjson hz "$hz" --arg forced "$only_forced" '
            .state == "ready"
            and ($forced == "" or .force_start == true)
            and (((.not_before // 0) | tonumber? // 0) as $nb | $nb <= $now or $nb > $now + $hz)' "$f" >/dev/null 2>&1; then
            echo "$id"
            return 0
        fi
    done <<EOF_ADMIT
${_LIMITER_ADMIT:-}
EOF_ADMIT
    return 0
}

_pick_next_limiter_forced_ready() { _pick_next_limiter_ready forced; }

# ---------- low-disk dispatch guard ----------

# _free_kb_for <path> — available KB on the volume holding <path> (nearest
# existing parent when the path is gone; $MOTHER_ROOT as a last resort). Echoes
# nothing and returns 1 when df can't tell us.
_free_kb_for() {
    local p="$1" kb
    while [ -n "$p" ] && [ ! -d "$p" ] && [ "$p" != "/" ]; do p=$(dirname "$p"); done
    [ -d "$p" ] || p="$MOTHER_ROOT"
    kb=$(df -kP "$p" 2>/dev/null | tail -1 | awk '{print $4}')
    case "${kb:-}" in ''|*[!0-9]*) return 1 ;; esac
    echo "$kb"
}

# _run_gc_bounded — run `mother gc` under a watchdog (same pattern as
# _maybe_archive: `_loop` is single-threaded, a wedged sweep must not stall it).
_run_gc_bounded() {
    [ "${MOTHER_GC_ENABLED:-1}" = "1" ] || return 0
    local flag="$RUNNER_DIR/gc-timed-out.flag"
    rm -f "$flag"
    (
        "$MOTHER_BIN_DIR/mother" gc 2>&1 | while read -r line; do _log "gc: $line"; done
    ) &
    local gc_pid=$!
    (
        sleep "$MOTHER_GC_TIMEOUT"
        kill -9 "$gc_pid" 2>/dev/null && : > "$flag"
    ) &
    local watchdog_pid=$!
    wait "$gc_pid" 2>/dev/null
    kill "$watchdog_pid" 2>/dev/null
    wait "$watchdog_pid" 2>/dev/null
    if [ -f "$flag" ]; then
        _log "gc: sweep exceeded ${MOTHER_GC_TIMEOUT}s, killed pid $gc_pid"
        rm -f "$flag"
    fi
}

# Hygiene sweep triggered by low disk: at most once per MOTHER_LOWDISK_GC_INTERVAL.
_lowdisk_gc() {
    [ "${MOTHER_GC_ENABLED:-1}" = "1" ] || return 0
    local marker="$RUNNER_DIR/last-lowdisk-gc.ts" now last=0
    now=$(date +%s)
    [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    if [ $((now - last)) -ge "${MOTHER_LOWDISK_GC_INTERVAL:-600}" ]; then
        echo "$now" > "$marker"
        _log "low disk: running hygiene sweep (mother gc)"
        _run_gc_bounded
    fi
}

# _snapshot_thin_run <free_kb_before> <repo_path> — runs (backgrounded by the
# caller) `tmutil thinlocalsnapshots / 999999999999 4` under a watchdog and records
# the outcome in $RUNNER_DIR/snapshot-thin.json (read by `mother status`).
# Thin only: never deletelocalsnapshots.
_snapshot_thin_run() {
    local before_kb="$1" repo_path="$2" out="$RUNNER_DIR/snapshot-thin.out.$$"
    local n_before n_after tm_pid wd_pid rc=0 after_kb freed_gb
    n_before=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c . || true)
    tmutil thinlocalsnapshots / 999999999999 4 >"$out" 2>&1 &
    tm_pid=$!
    ( trap 'kill "$sp" 2>/dev/null; exit 0' TERM
      sleep "$MOTHER_SNAPSHOT_THIN_TIMEOUT" & sp=$!
      wait "$sp"; kill -9 "$tm_pid" 2>/dev/null ) >/dev/null 2>&1 3>&- &
    wd_pid=$!
    wait "$tm_pid" 2>/dev/null || rc=$?
    kill "$wd_pid" 2>/dev/null; wait "$wd_pid" 2>/dev/null
    n_after=$(tmutil listlocalsnapshots / 2>/dev/null | grep -c . || true)
    after_kb=$(_free_kb_for "$repo_path") || after_kb="$before_kb"
    freed_gb=$(( (after_kb - before_kb) / 1048576 ))
    [ "$freed_gb" -ge 0 ] || freed_gb=0
    local thinned=$(( n_before - n_after ))
    [ "$thinned" -ge 0 ] || thinned=0
    if [ "$rc" -ne 0 ]; then
        _log "snapshot thin: tmutil failed (exit $rc): $(head -c 200 "$out" 2>/dev/null | tr '\n' ' ') — backing off ${MOTHER_SNAPSHOT_THIN_INTERVAL}s"
    else
        _log "snapshot thin: free $((before_kb / 1048576)) GB -> $((after_kb / 1048576)) GB, thinned $thinned snapshot(s)"
    fi
    rm -f "$out"
    _atomic_write "$RUNNER_DIR/snapshot-thin.json" "$(jq -nc --arg at "$(_iso_now)" \
        --argjson b "$((before_kb / 1048576))" --argjson a "$((after_kb / 1048576))" \
        --argjson f "$freed_gb" --argjson t "$thinned" --argjson rc "$rc" \
        '{at: $at, free_before_gb: $b, free_after_gb: $a, freed_gb: $f, thinned: $t, exit: $rc}')"
}

# _maybe_snapshot_thin <free_kb> <repo_path> — below MOTHER_SNAPSHOT_THIN_BELOW_GB
# (earlier than the dispatch pause), at most once per MOTHER_SNAPSHOT_THIN_INTERVAL,
# start a bounded background thin. Returns at once; never blocks dispatch.
_maybe_snapshot_thin() {
    local kb="$1" repo_path="$2"
    local thr="${MOTHER_SNAPSHOT_THIN_BELOW_GB:-40}" interval="${MOTHER_SNAPSHOT_THIN_INTERVAL:-1800}"
    case "$thr" in ''|*[!0-9]*) thr=40 ;; esac
    case "$interval" in ''|*[!0-9]*) interval=1800 ;; esac
    [ "$thr" -gt 0 ] || return 0
    [ -n "$kb" ] || return 0
    [ "$kb" -lt $((thr * 1048576)) ] || return 0
    command -v tmutil >/dev/null 2>&1 || return 0
    local marker="$RUNNER_DIR/last-snapshot-thin.ts" now last=0
    now=$(date +%s)
    [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ $((now - last)) -ge "$interval" ] || return 0
    echo "$now" > "$marker"
    _log "snapshot thin: $((kb / 1048576)) GB free (< ${thr} GB) — thinning Time Machine local snapshots in background"
    ( _snapshot_thin_run "$kb" "$repo_path" ) >/dev/null 2>&1 </dev/null &
    disown 2>/dev/null || true
    return 0
}

# _disk_check <repo_path> -> 0 dispatch OK, 1 low disk (dispatch paused).
# Maintains $RUNNER_DIR/low-disk.json (read by lib/attention.sh): written while
# low, removed when space recovers. Only dispatch is gated — nothing here ever
# touches a running job. Fails open when free space can't be read.
_disk_check() {
    local repo_path="$1"
    local state="$RUNNER_DIR/low-disk.json"
    local min_gb="${MOTHER_MIN_FREE_GB:-20}"
    case "$min_gb" in ''|*[!0-9]*) min_gb=20 ;; esac

    local kb=""
    if [ "$min_gb" -gt 0 ] || [ "${MOTHER_SNAPSHOT_THIN_BELOW_GB:-40}" != "0" ]; then
        kb=$(_free_kb_for "$repo_path") || kb=""
    fi
    _maybe_snapshot_thin "$kb" "$repo_path"
    [ "$min_gb" -gt 0 ] || kb=""
    if [ -z "$kb" ] || [ "$kb" -ge $((min_gb * 1048576)) ]; then
        if [ -f "$state" ]; then
            rm -f "$state"
            _log "low disk: cleared — dispatch resumed"
            type mother_attention_write >/dev/null 2>&1 && mother_attention_write 2>/dev/null
        fi
        return 0
    fi

    local free_gb=$((kb / 1048576)) since="" announce=0
    if [ -f "$state" ]; then
        since=$(jq -r '.since // ""' "$state" 2>/dev/null)
    else
        announce=1
    fi
    [ -n "$since" ] || since=$(_iso_now)
    # Rust build-dir figures from the last `mother gc` pass (no du here).
    local cargo_json="{}" cargo_note="" cache="$RUNNER_DIR/cargo-targets.json"
    if [ -f "$cache" ]; then
        cargo_json=$(jq -c 'select(type == "object" and (.total_kb | type) == "number")
            | {cargo_targets_kb: .total_kb, cargo_in_use_kb: (.in_use_kb // 0), cargo_checked_at: (.checked_at // "")}' \
            "$cache" 2>/dev/null) || cargo_json=""
        [ -n "$cargo_json" ] || cargo_json="{}"
        cargo_note=$(printf '%s' "$cargo_json" | jq -r 'select(.cargo_targets_kb != null)
            | def gb: (. / 1048576 * 10 | round) as $t | "\(($t / 10 | floor)).\($t % 10)";
              "; Rust build dirs \(.cargo_targets_kb | gb) GB (\(.cargo_in_use_kb | gb) GB in running jobs)"' 2>/dev/null) || cargo_note=""
    fi
    _atomic_write "$state" "$(jq -nc --argjson free "$free_gb" --argjson thr "$min_gb" \
        --arg path "$repo_path" --arg since "$since" --arg now "$(_iso_now)" --argjson cargo "$cargo_json" \
        '{free_gb: $free, threshold_gb: $thr, path: $path, repo_path: $path, since: $since, checked_at: $now} + $cargo')"
    if [ "$announce" -eq 1 ]; then
        _log "low disk: ${free_gb} GB free (< ${min_gb} GB) — dispatch paused; running jobs untouched${cargo_note}"
        type mother_attention_write >/dev/null 2>&1 && mother_attention_write 2>/dev/null
    fi
    _lowdisk_gc
    return 1
}

# _disk_dispatch_ok <job_id> — the guard for one about-to-be-spawned job.
_disk_dispatch_ok() {
    local repo_path
    repo_path=$(jq -r '.repo_path // ""' "$JOBS_DIR/$1.json" 2>/dev/null)
    _disk_check "$repo_path"
}

# With nothing ready to dispatch, still re-check a standing low-disk pause so
# the attention item clears once space recovers.
_disk_recheck_idle() {
    local state="$RUNNER_DIR/low-disk.json"
    [ -f "$state" ] || return 0
    _disk_check "$(jq -r '.repo_path // ""' "$state" 2>/dev/null)" || true
}

# ---------- spawning ----------

_spawn_job() {
    local job_id="$1"

    # Never start a second supervisor while the previous one for this job is
    # still alive (it may still be winding down a pause, or running
    # continuation handling): both would share the worktree.
    if _supervisor_alive_for_job "$job_id"; then
        _log "not spawning $job_id: a previous supervisor is still alive"
        return 1
    fi

    # Pre-transition ready → running so the next poll tick doesn't re-pick
    # this job. mother-run-job tolerates both ready and running as starting
    # states. If the fork fails, the job stays `running` with no tmux window;
    # the next daemon restart's orphan recovery will mark it failed.
    _job_transition "$job_id" running '{"spawned_by":"daemon"}'

    # Worker path (cluster P1-5): same transition and events as above, then hand the job to the coordinator
    # instead of forking a supervisor. The coordinator leases it to the local worker and owns its liveness.
    if _job_uses_worker "$job_id"; then
        [ "$(jq -r '.needs_attention.reason // empty' "$JOBS_DIR/$job_id.json" 2>/dev/null)" != "worker_unavailable" ] \
            || _job_update "$job_id" '.needs_attention = null'
        _write_dispatch_request "$job_id"
        _log "dispatched job $job_id to the worker path"
        return 0
    fi

    # Detach via nohup + background + stdin/out/err redirection. mother-run-job
    # tees its own log. NOTE: nohup + disown does NOT create a new process
    # group or session — `disown` only drops the job from this shell's job
    # table so we won't SIGHUP it, and neither call touches setpgid/setsid.
    # The child keeps the daemon's PGID. Surviving a daemon restart depends on
    # the launchd agent's AbandonProcessGroup=true key (see
    # launchd/com.thehammer.mother.plist), not on anything here.
    nohup "$MOTHER_BIN_DIR/mother-run-job" "$job_id" </dev/null >/dev/null 2>&1 &
    local pid=$!
    disown 2>/dev/null || true
    _track_child "$pid" "$job_id"
    _log "spawned job $job_id as pid $pid"
}

# ---------- crash recovery ----------

_recover_stale_locks() {
    # The adherence-review and pipeline-driver locks are plain mkdir-based
    # mutexes with no owner-pid or TTL recorded in them. They exist only to
    # serialize work within a single running daemon instance across ticks of
    # _loop; nothing else in the codebase acquires them. _singleton_guard has
    # already established that we are the only mother-runner process alive
    # (any prior instance is confirmed dead), so any lockdir found here was
    # left behind by a previous instance that died between mkdir and rmdir
    # (crash, kill -9, machine sleep/reboot) and can never self-heal — mkdir
    # will keep failing on every subsequent tick forever. Clear them
    # unconditionally on startup.
    #
    # (Bug: from 2026-05-20 until this fix, a leaked adherence-review.lockdir
    # silently disabled all automatic adherence review for three months;
    # jobs were only ever reviewed when someone ran `mother adherence-review
    # <id>` by hand. See .claude/bug-reports/.)
    local lock
    for lock in "$RUNNER_DIR/adherence-review.lockdir" "$RUNNER_DIR/pipeline-driver.lockdir"; do
        if [ -d "$lock" ]; then
            _log "clearing stale lock left by a previous instance: $lock"
            rmdir "$lock" 2>/dev/null || safe_rm_tree "$lock"
        fi
    done
}

_recover_orphans() {
    # Primary check: `worker_pid` + `kill -0`. Falls back to a tmux-window
    # match for legacy job records (created before the headless-worker
    # migration) that recorded `tmux_window` instead of `worker_pid`.
    #
    # $1: grace_seconds (default 0). For jobs with no `worker_pid`, only
    # act if `started_at` is older than this threshold — prevents racing
    # with a live mother-run-job that hasn't persisted worker_pid yet.
    # Startup passes 0 (aggressive); periodic calls from the loop pass a
    # non-zero grace so healthy in-flight supervisors are left alone.
    #
    # Honors `cancel_requested`: when a zombie is reaped and the user had
    # asked to cancel, transition to `cancelled` instead of `failed` so
    # `mother cancel` is effective even when the supervisor is dead.
    local grace="${1:-0}"
    local windows=""
    if command -v tmux >/dev/null 2>&1; then
        windows=$(tmux list-windows -a -F '#W' 2>/dev/null || echo "")
    fi

    local now_epoch; now_epoch=$(date +%s)
    # Seconds this tick has spent stopping orphan preview stacks (capped by
    # MOTHER_PREVIEW_SWEEP_BUDGET so a slow `down` can't stall the runner).
    local _pv_spent=0 _pv_budget="${MOTHER_PREVIEW_SWEEP_BUDGET:-60}"
    local f state pid window id started_at started_at_sec started_epoch cancel_req
    local terminal_state terminal_reason

    # Record a usage row for the dead run before transitioning it, using
    # .current_run.log_offset (recorded at spawn time — see mother-run-job)
    # as the slice start. Skipped entirely for legacy job records that
    # predate .current_run — no offset means no safe slice to parse.
    _orphan_record_usage_row() {
        local _oid="$1" _ojf="$2" _oterminal="$3"
        type mother_record_run_usage >/dev/null 2>&1 || return 0
        local _ooffset; _ooffset=$(jq -r '.current_run.log_offset // empty' "$_ojf" 2>/dev/null)
        [ -n "$_ooffset" ] || return 0
        local _olog="$LOGS_DIR/$_oid.log"
        local _ooutcome="failed"
        [ "$_oterminal" = "cancelled" ] && _ooutcome="cancelled"
        local _ophase; _ophase=$(jq -r '.pipeline.phase // empty' "$_ojf" 2>/dev/null)
        local _ostage="${_ophase:-cody}"
        mother_record_run_usage "$_oid" "$_ooutcome" "$_olog" "$_ooffset" "" "$_ostage" "${_ostage}-main" "worker" \
            "$(jq -nc '{failure_reason: "runner_died"}')"
    }

    # Another RUNNING main-dir job already occupying <_repo> (other than
    # <_skip_id> itself) — its live workspace must not be touched by an
    # orphan's stash-restore. Echoes that job's id (empty if none). One jq
    # call per candidate file (id/state/isolation/repo_path as a single
    # @tsv row) instead of four, since this runs once per job file in the
    # sibling-conflict check below.
    _find_conflicting_main_dir_job() {
        local _skip_id="$1" _repo="$2" _f _fields _fid _fstate _fiso _frepo
        for _f in "$JOBS_DIR"/*.json; do
            [ -f "$_f" ] || continue
            _fields=$(jq -r '[.id, (.state // ""), (.isolation // ""), (.repo_path // "")] | @tsv' "$_f" 2>/dev/null) || continue
            IFS=$'\t' read -r _fid _fstate _fiso _frepo <<<"$_fields"
            [ "$_fid" != "$_skip_id" ] || continue
            [ "$_fstate" = "running" ] || continue
            [ "$_fiso" = "main-dir" ] || continue
            [ "$_frepo" = "$_repo" ] || continue
            echo "$_fid"
            return 0
        done
    }

    # A dead supervisor never ran its EXIT trap (SIGKILL, host crash), so a
    # main-dir job's auto-stash is still sitting in the operator's stash list.
    # Put it back — but only when no OTHER main-dir job is running against the
    # same repo: the dead supervisor never released the workspace lock, so while
    # no sibling runs nobody else is in that checkout, whereas popping into a
    # sibling's live workspace would dump the operator's changes into its tree.
    _orphan_restore_autostash() {
        local _rid="$1" _rjf="$2" _riso _rrepo _rmarker _rconf _rres _routcome _rmsg _rout _rkind _rdetail
        _riso=$(jq -r '.isolation // empty' "$_rjf" 2>/dev/null)
        [ "$_riso" = "main-dir" ] || return 0
        _rmarker="$RUNNER_DIR/$_rid.stash"
        [ -f "$_rmarker" ] || return 0
        _rrepo=$(jq -r '.repo_path // empty' "$_rjf" 2>/dev/null)
        [ -n "$_rrepo" ] || return 0

        _rconf=$(_find_conflicting_main_dir_job "$_rid" "$_rrepo")
        _rmsg=$(sed -n '1p' "$_rmarker" 2>/dev/null)
        if [ -n "$_rconf" ]; then
            _append_event "$_rid" "auto_stash_restore_deferred" \
                "$(jq -nc --arg m "$_rmsg" --arg c "$_rconf" '{stash_message: $m, conflicting_job_id: $c}')"
            _log "deferred auto-stash restore for $_rid (main-dir job $_rconf running in the same repo)"
            return 0
        fi

        _rres=$(mother_autostash_restore "$_rrepo" "$_rmarker" 2>/dev/null) || return 0
        _routcome=$(printf '%s' "$_rres" | jq -r '.outcome // "none"' 2>/dev/null)
        _rout=$(mother_autostash_event_detail "$_rres") && {
            _rkind="${_rout%%$'\t'*}"
            _rdetail="${_rout#*$'\t'}"
            _append_event "$_rid" "$_rkind" "$_rdetail"
        }
        _log "auto-stash restore for orphaned $_rid: $_routcome"
    }

    # A SIGKILLed supervisor never ran _rwx_post_exit, so its RWX sandbox keeps
    # billing until the sandbox's own inactivity timeout. Stop it best-effort.
    # Worktree jobs only: the stop is cwd+branch-keyed, and a main-dir checkout
    # may be on the operator's branch by now.
    _orphan_rwx_stop() {
        local _sid="$1" _sjf="$2" _swd _sres
        declare -F mother_rwx_sandbox >/dev/null || return 0
        [ "$(jq -r '.isolation // empty' "$_sjf" 2>/dev/null)" = "worktree" ] || return 0
        _swd=$(jq -r '.work_dir // empty' "$_sjf" 2>/dev/null)
        [ -d "$_swd" ] && mother_rwx_gate "$_swd" >/dev/null || return 0
        _sres=$(mother_rwx_sandbox stop "$_swd" 2>/dev/null) || return 0
        printf '%s' "$_sres" | jq -e 'type == "object"' >/dev/null 2>&1 || return 0
        _append_event "$_sid" "rwx_sandbox_stop" "$(printf '%s' "$_sres" | jq -c '. + {reason: "orphan"}')"
    }

    # A SIGKILLed supervisor never ran _preview_post_exit, so a preview stack
    # the worker launched is still up (it idles out after 10 minutes, but stop
    # it now). Every isolation: a stack stop isn't keyed to a working directory
    # and reads only the job record.
    _orphan_preview_stop() {
        local _pid="$1" _pjf="$2" _pt0=$SECONDS
        declare -F mother_preview_stop >/dev/null || return 0
        _orphan_has_live_preview "$_pjf" || return 0
        mother_preview_stop "$_pid" orphan 2>/dev/null || true
        _pv_spent=$((_pv_spent + SECONDS - _pt0))
    }

    _orphan_has_live_preview() {
        [ -n "$(jq -r 'select(.preview != null and .preview.status != "stopped") | .id' "$1" 2>/dev/null)" ]
    }

    # True (and logged) when this tick's stop budget is spent and the job still
    # has a live stack. The caller skips the job entirely: it stays `running`,
    # so the next tick reaps it and stops its stack then.
    _orphan_preview_defer() {
        declare -F mother_preview_stop >/dev/null || return 1
        [ "$_pv_spent" -ge "$_pv_budget" ] || return 1
        _orphan_has_live_preview "$2" || return 1
        _log "preview sweep budget (${_pv_budget}s) spent; leaving orphan $1 for the next tick"
        return 0
    }

    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state' "$f" 2>/dev/null) || continue
        [ "$state" = "running" ] || continue
        id=$(jq -r '.id' "$f")
        # The coordinator owns the liveness of a leased job (offered/active lease, a pending dispatch request,
        # or a released lease awaiting its success derivation); _recover_lost_leases handles a lost one.
        if _job_is_leased "$id" || _lease_awaits_finalize "$id" || _lease_lost_unhandled "$id"; then
            continue
        fi
        pid=$(jq -r '.worker_pid // empty' "$f")
        window=$(jq -r '.tmux_window // ""' "$f")
        cancel_req=$(jq -r '.cancel_requested // false' "$f")

        # Resolve the terminal state we'd transition to. If the user asked
        # to cancel and the supervisor can't honor it (dead/absent pid),
        # 'cancelled' is more truthful than 'failed: runner_died'.
        if [ "$cancel_req" = "true" ]; then
            terminal_state="cancelled"
            terminal_reason='{"reason":"user"}'
        else
            terminal_state="failed"
            terminal_reason='{"reason":"runner_died"}'
        fi

        if [ -n "$pid" ]; then
            if ! kill -0 "$pid" 2>/dev/null; then
                # Worker is gone, but the supervisor (mother-run-job) may
                # still be in its post-exit window. Reaping here would
                # race the supervisor's terminal transition — see comment
                # on _supervisor_alive_for_job. Defer when supervisor is
                # still alive; only reap when the whole supervision tree
                # is gone.
                if _supervisor_alive_for_job "$id"; then
                    continue
                fi
                if _orphan_preview_defer "$id" "$f"; then continue; fi
                _log "marking $id $terminal_state (pid $pid gone; cancel_requested=$cancel_req)"
                _orphan_record_usage_row "$id" "$f" "$terminal_state"
                _job_transition "$id" "$terminal_state" "$terminal_reason"
                _job_update "$id" 'if .activity == "gating" or .activity == "gate_fix" then .activity = null else . end'
                _orphan_restore_autostash "$id" "$f"
                _orphan_rwx_stop "$id" "$f"
                _orphan_preview_stop "$id" "$f"
            fi
        elif [ -n "$window" ]; then
            # Legacy path: jobs recorded before the headless-worker migration.
            if [ -z "$windows" ]; then
                _log "skipping $id (legacy tmux_window record, no tmux available)"
                continue
            fi
            if ! grep -Fxq "$window" <<< "$windows"; then
                if _orphan_preview_defer "$id" "$f"; then continue; fi
                _log "marking $id $terminal_state (window $window gone; cancel_requested=$cancel_req)"
                _orphan_record_usage_row "$id" "$f" "$terminal_state"
                _job_transition "$id" "$terminal_state" "$terminal_reason"
                _orphan_restore_autostash "$id" "$f"
                _orphan_rwx_stop "$id" "$f"
                _orphan_preview_stop "$id" "$f"
            fi
        else
            # No worker_pid AND no tmux_window. Supervisor either died before
            # persisting worker_pid, or we're racing a fresh spawn. Apply the
            # grace window: startup reaps immediately (grace=0), the periodic
            # loop waits until started_at is older than grace_seconds.
            if [ "$grace" -gt 0 ]; then
                started_at=$(jq -r '.started_at // empty' "$f")
                [ -n "$started_at" ] || continue
                # Strip fractional seconds — started_at may be either
                # `...SSZ` (from mother-run-job's iso_now) or `...SS.NNNNNNZ`
                # (from state.sh's _iso_now), and date(1) only accepts the
                # former with %S.
                started_at_sec="${started_at%%.*}"
                case "$started_at_sec" in *Z) ;; *) started_at_sec="${started_at_sec}Z" ;; esac
                # ISO8601 → epoch (macOS date needs -j -f; GNU date needs -d).
                started_epoch=$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$started_at_sec" +%s 2>/dev/null \
                    || date -u -d "$started_at_sec" +%s 2>/dev/null || echo 0)
                [ "$started_epoch" -eq 0 ] && continue
                [ $((now_epoch - started_epoch)) -ge "$grace" ] || continue
            fi
            # Past the grace window, this branch used to reap unconditionally —
            # but a slow-to-persist supervisor (e.g. worktree creation + env
            # setup contending with other concurrent jobs for disk/CPU) can
            # easily outlast a fixed 60s grace under load. Unlike the `pid`
            # branch above, this one never checked whether the supervisor
            # (mother-run-job) was actually still alive before reaping — so a
            # merely-slow spawn got misdiagnosed as `failed: runner_died`,
            # auto-escalated, and re-spawned into the *same* worktree while
            # the original, still-live supervisor kept working there too.
            # Apply the same liveness guard the `pid` branch already uses.
            if _supervisor_alive_for_job "$id"; then
                continue
            fi
            if _orphan_preview_defer "$id" "$f"; then continue; fi
            _log "marking $id $terminal_state (no worker_pid or tmux_window; cancel_requested=$cancel_req)"
            _orphan_record_usage_row "$id" "$f" "$terminal_state"
            _job_transition "$id" "$terminal_state" "$terminal_reason"
            _orphan_restore_autostash "$id" "$f"
            _orphan_rwx_stop "$id" "$f"
            _orphan_preview_stop "$id" "$f"
        fi
    done
}

# Grace (seconds) before the periodic reaper treats a `running` job with no
# worker_pid as a zombie. Long enough to outlast any reasonable spawn path
# (plan read + lock acquire + wrapper write + nohup fork), short enough that
# users don't stare at a dead job for long.
MOTHER_ORPHAN_GRACE="${MOTHER_ORPHAN_GRACE:-60}"

# ---------- main loop ----------

# Sweep orphaned atomic-write temp files once at daemon startup, in addition
# to the hourly ride-along in `mother archive` (see _maybe_archive below).
# Together these cover a daemon that runs for weeks (hourly sweep) as well as
# one that restarts often (startup sweep). No watchdog needed here, unlike
# the archive sweep: this has no gh/docker/git dependency to wedge on.
_prune_temps_startup() {
    "$MOTHER_BIN_DIR/mother" prune-temps 2>&1 | while read -r line; do _log "prune-temps: $line"; done
}

_maybe_archive() {
    # Run retention at most once per MOTHER_ARCHIVE_INTERVAL seconds, keyed off
    # a timestamp file so it survives restarts.
    local marker="$RUNNER_DIR/last-archive.ts"
    local now last
    now=$(date +%s)
    last=0
    [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
    if [ $((now - last)) -ge "$MOTHER_ARCHIVE_INTERVAL" ]; then
        _log "running archive sweep (older-than=${MOTHER_ARCHIVE_OLDER_THAN}d)"
        # Write the marker BEFORE running, not after. `_loop` is single-threaded
        # and every tick after this one is blocked on this call returning, so a
        # sweep that hangs (gh/docker/git wedged, TCC prompt with no UI session
        # to answer it, whatever) must not also get retried every tick once the
        # watchdog below frees the loop — see the 2026-08-12 bug report on this
        # function for the incident that motivated the timeout.
        echo "$now" > "$marker"
        # Bound the sweep with a watchdog instead of trusting it to return: a
        # wedged `mother archive` (gh/docker/git stuck, a TCC prompt with no
        # UI session to answer it, whatever) used to block this loop — and
        # therefore all job dispatch — forever, silently, since the daemon's
        # stderr is discarded. The pipe into the logging loop is still here,
        # just run in the background so it can be raced against a timer.
        # Caveat: killing $sweep_pid frees the loop but does not reach any
        # grandchild (a stuck `gh`/`docker`/`git` call) it may have spawned —
        # bash without job control puts pipeline members in the script's own
        # process group, so there is no safe "kill the whole tree" short of
        # enabling monitor mode daemon-wide. That's an acceptable trade for
        # now: the daemon staying responsive matters more than reaping an
        # orphaned, already-wedged grandchild. See the 2026-08-12 bug report
        # for the incident that motivated this.
        local timeout_flag="$RUNNER_DIR/archive-sweep-timed-out.flag"
        rm -f "$timeout_flag"
        (
            "$MOTHER_BIN_DIR/mother" archive --older-than "$MOTHER_ARCHIVE_OLDER_THAN" 2>&1 | while read -r line; do _log "archive: $line"; done
        ) &
        local sweep_pid=$!
        (
            sleep "$MOTHER_ARCHIVE_TIMEOUT"
            kill -9 "$sweep_pid" 2>/dev/null && : > "$timeout_flag"
        ) &
        local watchdog_pid=$!
        wait "$sweep_pid" 2>/dev/null
        # Sweep is done either way (finished or killed) — the race is over,
        # so reap the watchdog too instead of leaving it to fire uselessly.
        kill "$watchdog_pid" 2>/dev/null
        wait "$watchdog_pid" 2>/dev/null
        if [ -f "$timeout_flag" ]; then
            _log "archive: sweep exceeded ${MOTHER_ARCHIVE_TIMEOUT}s, killed pid $sweep_pid — dispatch resumes; it will retry next interval"
            rm -f "$timeout_flag"
        else
            # Disk hygiene rides along with the retention sweep (own watchdog).
            # Skipped after a wedged archive: something is already stuck.
            _run_gc_bounded
        fi
    fi
}

# _maybe_backup: back up the state tree (`mother backup now --auto`, lib/backup.sh;
# it skips the state tarball when nothing changed) at
# most once per MOTHER_BACKUP_INTERVAL seconds, keyed off a timestamp file so it
# survives restarts. Same shape as _maybe_archive: the marker is written BEFORE
# the run, and a watchdog bounds it so a slow tar can't block dispatch.
_maybe_backup() {
    [ "${MOTHER_BACKUP_ENABLED:-1}" = "1" ] || return 0
    local marker="$RUNNER_DIR/last-backup.ts" now last=0
    now=$(date +%s)
    [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ $((now - last)) -ge "$MOTHER_BACKUP_INTERVAL" ] || return 0
    echo "$now" > "$marker"
    local timeout_flag="$RUNNER_DIR/backup-timed-out.flag"
    rm -f "$timeout_flag"
    (
        "$MOTHER_BIN_DIR/mother" backup now --auto 2>&1 | while read -r line; do _log "backup: $line"; done
    ) &
    local backup_pid=$!
    # The watchdog owns its `sleep` and kills it when told to stand down (TERM),
    # so a finished backup never leaves a sleeping orphan holding the runner's
    # stdout/stderr pipe open for MOTHER_BACKUP_TIMEOUT seconds.
    (
        sleep "$MOTHER_BACKUP_TIMEOUT" &
        sleep_pid=$!
        trap 'kill "$sleep_pid" 2>/dev/null; exit 0' TERM
        wait "$sleep_pid" && kill -9 "$backup_pid" 2>/dev/null && : > "$timeout_flag"
    ) &
    local watchdog_pid=$!
    wait "$backup_pid" 2>/dev/null
    kill "$watchdog_pid" 2>/dev/null
    wait "$watchdog_pid" 2>/dev/null
    if [ -f "$timeout_flag" ]; then
        _log "backup: exceeded ${MOTHER_BACKUP_TIMEOUT}s, killed pid $backup_pid — will retry next interval"
        rm -f "$timeout_flag"
    fi
    return 0
}

# Refresh $MOTHER_ROOT/attention.json (the needs-attention list the statusline
# and `mother list` footer read) at most once per MOTHER_ATTENTION_INTERVAL
# seconds, so the statusline stays fresh without anyone running `mother
# status`. Same marker-file gating as _maybe_archive. mother_attention_items
# only reads local state (never gh), so this is cheap and safe on the loop.
_maybe_refresh_attention() {
    type mother_attention_write >/dev/null 2>&1 || return 0
    local marker="$RUNNER_DIR/last-attention.ts"
    local now last=0
    now=$(date +%s)
    [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    if [ $((now - last)) -ge "${MOTHER_ATTENTION_INTERVAL:-60}" ]; then
        echo "$now" > "$marker"
        mother_attention_write 2>/dev/null || _log "attention: refresh failed"
    fi
}

# Progress indicator (HC-09). Observer only: `mother-usage progress-tick` writes
# $MOTHER_ROOT/progress/<id>.json (+ rate-bounded progress_* events) and never
# touches job JSON. Every MOTHER_PROGRESS_INTERVAL seconds; `calibrate` refits
# the stage statistics when the calibration file is missing or older than
# MOTHER_PROGRESS_CALIBRATE_INTERVAL. Both run under a watchdog (same pattern as
# _maybe_archive): `_loop` is single-threaded, so a wedged python must not stall
# dispatch. MOTHER_PROGRESS_ENABLED=0 skips everything.
_run_progress_bounded() {
    local what="$1"; shift
    local flag="$RUNNER_DIR/progress-timed-out.flag"
    rm -f "$flag"
    (
        "$MOTHER_BIN_DIR/mother-usage" "$what" --root "$MOTHER_ROOT" 2>&1 | while read -r line; do _log "progress: $line"; done
    ) &
    local run_pid=$!
    (
        sleep "$MOTHER_PROGRESS_TIMEOUT"
        kill -9 "$run_pid" 2>/dev/null && : > "$flag"
    ) &
    local watchdog_pid=$!
    wait "$run_pid" 2>/dev/null
    kill "$watchdog_pid" 2>/dev/null
    wait "$watchdog_pid" 2>/dev/null
    if [ -f "$flag" ]; then
        _log "progress: $what exceeded ${MOTHER_PROGRESS_TIMEOUT}s, killed pid $run_pid"
        rm -f "$flag"
    fi
}

# _read_epoch_marker <file> — print the epoch stored in a marker file, 0 when
# the file is missing or holds anything non-numeric.
_read_epoch_marker() {
    local v=0
    [ -f "$1" ] && v=$(cat "$1" 2>/dev/null || echo 0)
    case "$v" in ''|*[!0-9]*) v=0 ;; esac
    echo "$v"
}

_maybe_progress_tick() {
    [ "${MOTHER_PROGRESS_ENABLED:-1}" = "0" ] && return 0
    local now last
    now=$(date +%s)
    local marker="$RUNNER_DIR/last-progress.ts"
    last=$(_read_epoch_marker "$marker")
    [ $((now - last)) -ge "$MOTHER_PROGRESS_INTERVAL" ] || return 0
    echo "$now" > "$marker"

    local cal_marker="$RUNNER_DIR/last-progress-calibrate.ts" cal_last
    cal_last=$(_read_epoch_marker "$cal_marker")
    if [ ! -f "$RUNNER_DIR/progress-calibration.json" ] \
        || [ $((now - cal_last)) -ge "$MOTHER_PROGRESS_CALIBRATE_INTERVAL" ]; then
        echo "$now" > "$cal_marker"
        _run_progress_bounded calibrate
    fi
    _run_progress_bounded progress-tick
}

# ---------- backpressure limiter (observe-only) ----------

# _limiter_fault <why> — record that a limiter tick failed; dispatch carries on regardless.
_limiter_fault() {
    _log "limiter: $1"
    jq -nc --argjson at "$(date +%s)" --arg why "$1" '{at: $at, why: $why}' \
        > "$RUNNER_DIR/limiter-fault.json.tmp.$$" 2>/dev/null \
        && mv "$RUNNER_DIR/limiter-fault.json.tmp.$$" "$RUNNER_DIR/limiter-fault.json" \
        || rm -f "$RUNNER_DIR/limiter-fault.json.tmp.$$"
    _limiter_backoff_arm
}

# After a fault, skip the next limiter ticks: MOTHER_LIMITER_BACKOFF_BASE_S (20) doubling per
# consecutive fault up to MOTHER_LIMITER_BACKOFF_MAX_S (600). A clean tick resets it. Keeps a
# wedged limiter from costing the single-threaded loop a full watchdog timeout every interval.
_limiter_backoff_arm() {
    local file="$RUNNER_DIR/limiter-backoff.json" n=0 delay base cap now
    n=$(jq -r '.faults // 0' "$file" 2>/dev/null); case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    base="${MOTHER_LIMITER_BACKOFF_BASE_S:-20}"; cap="${MOTHER_LIMITER_BACKOFF_MAX_S:-600}"
    case "$base" in ''|*[!0-9]*) base=20 ;; esac
    case "$cap" in ''|*[!0-9]*) cap=600 ;; esac
    delay=$base; local i=1
    while [ "$i" -lt "$n" ] && [ "$delay" -lt "$cap" ]; do delay=$((delay * 2)); i=$((i + 1)); done
    [ "$delay" -gt "$cap" ] && delay=$cap
    now=$(date +%s)
    jq -nc --argjson f "$n" --argjson u "$((now + delay))" '{faults: $f, skip_until: $u}' \
        > "$file.tmp.$$" 2>/dev/null && mv "$file.tmp.$$" "$file" || rm -f "$file.tmp.$$"
    _log "limiter: backing off ${delay}s after $n consecutive fault(s)"
}

# _limiter_apply <annotations json> — write the limiter's job annotations. Each one was already
# diffed against the job file by mother-limiter, so a job is only rewritten when a value changed.
# Only data_class, limiter.estimate, limiter.would and limiter.wait are ever set: nothing dispatch reads.
_limiter_apply() {
    local ann id
    printf '%s' "$1" | jq -c '.annotations[]?' 2>/dev/null | while read -r ann; do
        id=$(printf '%s' "$ann" | jq -r '.id')
        [ -n "$id" ] || continue
        _switch_with_lock "$(_job_path "$id").lockdir" "job" 200 _limiter_apply_one "$id" "$ann" 2>/dev/null || true
    done
}

# One annotation, under the job-file lock. Observe-only must never change a job's state, so the
# write happens only if the job is still ready/queued when the lock is held (a `cancel`/`retry`
# that landed since the tick wins); otherwise nothing is written.
_limiter_apply_one() {
    local id="$1" ann="$2" file merged
    file=$(_job_path "$id")
    [ -f "$file" ] || return 0
    merged=$(jq --argjson a "$ann" '
        select(.state == "ready" or .state == "queued")
        | (if $a.data_class then .data_class = $a.data_class else . end)
        | (if $a.estimate then .limiter.estimate = $a.estimate else . end)
        | (if $a.would then .limiter.would = $a.would else . end)
        | (if $a.wait then .limiter.wait = $a.wait else . end)' "$file" 2>/dev/null) || return 0
    [ -n "$merged" ] || return 0
    _atomic_write "$file" "$merged"
}

# One limiter tick under a watchdog (the loop is single-threaded; a wedged python must not stall
# it). Failure or timeout writes limiter-fault.json and never affects dispatch (bet B6).
_run_limiter_bounded() {
    local out="$RUNNER_DIR/limiter-out.json" flag="$RUNNER_DIR/limiter-timed-out.flag" rc=0
    rm -f "$out" "$flag"
    "$MOTHER_BIN_DIR/mother-limiter" tick --root "$MOTHER_ROOT" >"$out" 2>>"$RUNNER_DIR/limiter.err" </dev/null &
    local run_pid=$!
    ( sleep "$MOTHER_LIMITER_TIMEOUT"; kill -9 "$run_pid" 2>/dev/null && : > "$flag" ) >/dev/null 2>&1 3>&- &
    local watchdog_pid=$!
    wait "$run_pid" 2>/dev/null || rc=$?
    kill "$watchdog_pid" 2>/dev/null
    wait "$watchdog_pid" 2>/dev/null
    if [ -f "$flag" ]; then
        rm -f "$flag"
        _limiter_fault "tick exceeded ${MOTHER_LIMITER_TIMEOUT}s, killed pid $run_pid"
    elif [ "$rc" -ne 0 ]; then
        _limiter_fault "tick exited $rc"
    else
        rm -f "$RUNNER_DIR/limiter-fault.json" "$RUNNER_DIR/limiter-backoff.json"
        _limiter_apply "$(cat "$out" 2>/dev/null)"
    fi
    rm -f "$out"
}

_maybe_limiter_tick() {
    [ "${MOTHER_LIMITER_MODE:-observe}" = "off" ] && return 0
    local now last marker="$RUNNER_DIR/last-limiter.ts"
    now=$(date +%s)
    last=$(_read_epoch_marker "$marker")
    [ $((now - last)) -ge "$MOTHER_LIMITER_INTERVAL" ] || return 0
    local skip_until
    skip_until=$(jq -r '.skip_until // 0' "$RUNNER_DIR/limiter-backoff.json" 2>/dev/null)
    case "$skip_until" in ''|*[!0-9]*) skip_until=0 ;; esac
    [ "$now" -ge "$skip_until" ] || return 0
    echo "$now" > "$marker"
    _run_limiter_bounded
}

# ---------- awaiting notifications ----------

# _notify_send <id> <kind> <count> <ok> — record the outcome of one push as an
# awaiting_notified event. (The job-field write happens in _notify_awaiting.)
_notify_event() {
    local id="$1" kind="$2" count="$3" ok="$4"
    _append_event "$id" "awaiting_notified" \
        "$(jq -nc --arg k "$kind" --argjson c "$count" --arg t "${MOTHER_NOTIFY_LAST_TRANSPORT:-unknown}" \
            --argjson ok "$ok" '{kind: $k, count: $c, transport: $t, ok: $ok}')"
}

# _notify_client_connected — true when a Nostromo-style broker client is
# subscribed to the `await` category right now, so a macOS push would only
# duplicate what that client already shows. Reads $RUNNER_DIR/broker-clients.json
# (written by the broker, refreshed every ping tick). Fails closed: a missing,
# unparseable or stale file (older than 3 x MOTHER_BROKER_PING_SEC), a dead
# broker pid, or zero await subscribers all mean "no client" -> push as usual,
# so a crashed broker can never silence notifications.
_notify_client_connected() {
    [ "${MOTHER_NOTIFY_SUPPRESS_WHEN_CLIENT:-0}" = "1" ] || return 1
    local f="$RUNNER_DIR/broker-clients.json" pid updated subs
    [ -f "$f" ] || return 1
    read -r pid updated subs < <(jq -r '[(.pid // 0), (.updated_at // ""), (.await_subscribers // 0)]
        | map(tostring) | join(" ")' "$f" 2>/dev/null) || return 1
    case "$pid" in ''|*[!0-9]*|0) return 1 ;; esac
    case "$subs" in ''|*[!0-9]*|0) return 1 ;; esac
    local up_epoch now max
    up_epoch=$(_iso_to_epoch "$updated")
    [ "${up_epoch:-0}" -gt 0 ] || return 1
    now=$(date +%s)
    max=$((3 * ${MOTHER_BROKER_PING_SEC:-15}))
    [ $((now - up_epoch)) -le "$max" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

# _notify_awaiting — one scan over $JOBS_DIR that pushes a notification to the
# operator when a job is waiting on them.
#
# PERMANENT OPERATOR-ONLY BOUNDARY (not a temporary limitation): this function
# may write exactly two things — the job's `.awaiting_notify` bookkeeping
# field, and `awaiting_notified` events. It must NEVER change `state`,
# `activity`, `pending_answer`, `question`, `paused_reason` or
# `auto_resume_at`, and must never call cancel, resume, retry, escalate or
# reconcile. Cancelling, resuming, answering or reworking an unanswered
# `awaiting` job is the operator's decision, forever; Mother only tells them
# it is waiting. (The one daemon-side resume that exists — _auto_resume_check —
# is limited to quota_* system pauses and is untouched by this.)
#
# Eligible: state == awaiting and paused_reason NOT quota_* / limiter_hold (both are
# system pauses _auto_resume_check clears on its own). Episode key: paused_at
# (fallback: awaiting_notify.first_seen_at, stamped the first time it is seen).
#   * new episode      -> INITIAL push
#   * >= MOTHER_AWAITING_REMIND_HOURS since last push -> REMINDER (open-ended:
#     first at 24h, then one every 24h)
#   * left `awaiting`  -> awaiting_notify cleared, no push
#   * more than 3 pushes due in one scan -> ONE coalesced summary push
# last_notified_at advances even when the transport fails, so a broken
# notifier can't become a push storm (the failure shows as ok:false).
_notify_awaiting() {
    [ "${MOTHER_NOTIFY_ENABLED:-1}" = "1" ] || return 0
    type mother_notify >/dev/null 2>&1 || return 0

    local marker="$RUNNER_DIR/last-notify-scan.ts" now last=0
    now=$(date +%s)
    [ -f "$marker" ] && last=$(cat "$marker" 2>/dev/null || echo 0)
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ $((now - last)) -ge "${MOTHER_NOTIFY_SCAN_INTERVAL:-60}" ] || return 0
    echo "$now" > "$marker"

    local remind_secs
    remind_secs=$(awk -v h="${MOTHER_AWAITING_REMIND_HOURS:-24}" 'BEGIN { printf "%d", h * 3600 }')
    local now_iso; now_iso=$(_iso_now)
    local us; us=$(printf '\037')

    # Pass 1: classify. `due` holds one "id<US>kind<US>episode<US>first_seen<US>count<US>age_secs<US>title<US>question"
    # record per line; jobs no longer eligible get their bookkeeping cleared.
    local due="" due_n=0 f
    local id state reason paused_at title question has_an an_episode an_first an_count an_last
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        IFS="$us" read -r id state reason paused_at title question has_an an_episode an_first an_count an_last < <(
            jq -r --arg us "$us" '[.id, .state, (.paused_reason // ""), (.paused_at // ""),
                (.title // ""), ((.question // "") | .[0:150]),
                (if .awaiting_notify != null then "1" else "0" end),
                (.awaiting_notify.episode // ""), (.awaiting_notify.first_seen_at // ""),
                ((.awaiting_notify.count // 0) | tostring), (.awaiting_notify.last_notified_at // "")]
                | map(tostring | gsub("[\n\r\t]"; " ")) | join($us)' "$f" 2>/dev/null) || continue
        [ -n "$id" ] || continue

        local eligible=1
        [ "$state" = "awaiting" ] || eligible=0
        case "$reason" in quota_*|limiter_hold) eligible=0 ;; esac
        if [ "$eligible" -eq 0 ]; then
            [ "$has_an" = "1" ] && _job_update "$id" 'del(.awaiting_notify)'
            continue
        fi

        local key="$paused_at" first_seen="$an_first" kind=""
        if [ -z "$key" ]; then
            [ -n "$an_first" ] && key="$an_first" || key="$now_iso"
        fi
        [ -n "$first_seen" ] || first_seen="$key"
        local count="${an_count:-0}"
        case "$count" in ''|*[!0-9]*) count=0 ;; esac
        if [ "$has_an" != "1" ] || [ "$an_episode" != "$key" ]; then
            kind="initial"; count=0; first_seen="$key"
        else
            local last_epoch; last_epoch=$(_iso_to_epoch "$an_last")
            [ $((now - last_epoch)) -ge "$remind_secs" ] && kind="reminder"
        fi
        [ -n "$kind" ] || continue

        local since_epoch age_secs
        since_epoch=$(_iso_to_epoch "$first_seen")
        [ "$since_epoch" -gt 0 ] && age_secs=$((now - since_epoch)) || age_secs=0
        [ -n "$paused_at" ] && { since_epoch=$(_iso_to_epoch "$paused_at"); [ "$since_epoch" -gt 0 ] && age_secs=$((now - since_epoch)); }
        due="${due}${id}${us}${kind}${us}${key}${us}${first_seen}${us}${count}${us}${age_secs}${us}${title}${us}${question}
"
        due_n=$((due_n + 1))
    done
    [ "$due_n" -gt 0 ] || return 0

    # Pass 2: send. More than 3 due -> one summary push covering all of them.
    # With a subscribed broker client connected the transport is skipped, but
    # the bookkeeping below runs exactly as for a delivered push (so the 24h
    # reminder cadence continues); it is recorded as transport suppressed_client.
    local summary_ok="" line suppress=0
    _notify_client_connected && suppress=1
    if [ "$suppress" -eq 1 ]; then
        MOTHER_NOTIFY_LAST_TRANSPORT="suppressed_client"
        [ "$due_n" -gt 3 ] && summary_ok=true
    elif [ "$due_n" -gt 3 ]; then
        if mother_notify "Mother: $due_n jobs waiting for you" \
            "$due_n Mother jobs are waiting for you — mother status" ""; then
            summary_ok=true
        else
            summary_ok=false
        fi
    fi

    local kind key first_seen count age_secs ok body ptitle
    while IFS="$us" read -r id kind key first_seen count age_secs title question; do
        [ -n "$id" ] || continue
        if [ -n "$summary_ok" ]; then
            ok="$summary_ok"
        elif [ "$suppress" -eq 1 ]; then
            ok=true
        else
            if [ "$kind" = "initial" ]; then
                ptitle="Mother: job needs your answer"
            else
                ptitle="Mother: job still waiting ($((age_secs / 3600))h)"
            fi
            body="${title:-$id}"
            [ "$kind" = "reminder" ] && body="$body (waiting $((age_secs / 3600))h)"
            [ -n "$question" ] && body="$body — $question"
            body="$body
mother resume $id \"…\""
            local pr_url; pr_url=$(jq -r '.pr_url // ""' "$JOBS_DIR/$id.json" 2>/dev/null || true)
            if mother_notify "$ptitle" "$body" "$id" "$pr_url"; then ok=true; else ok=false; fi
        fi
        count=$((count + 1))
        # Only touch our own field, and only while the job is still awaiting.
        _job_update "$id" "if .state == \"awaiting\" then .awaiting_notify = $(jq -nc \
            --arg e "$key" --arg fs "$first_seen" --argjson c "$count" --arg ts "$(_iso_now)" \
            '{episode: $e, first_seen_at: $fs, count: $c, last_notified_at: $ts}') else . end"
        _notify_event "$id" "$kind" "$count" "$ok"
    done <<EOF
$due
EOF
}

# ---------- quota-aware dispatch ----------
#
# `_quota_check` (in lib/state.sh) returns 1 when either rolling window
# (5h or 7d) is at or over its operator-set cap. The daemon uses it to:
#
#   1. Auto-resume awaiting jobs whose blocking window has reset
#      (system pauses set `paused_reason: "quota_*"` and `auto_resume_at`;
#      we promote those back to `ready` once both the timestamp has passed
#      and the cache shows quota under cap).
#   2. Refuse to spawn new jobs while over cap (pre-dispatch gate). Jobs
#      stay in `ready` and get retried each tick.
#   3. Pause running jobs that are mid-flight when the cap trips, so
#      headroom returns to the operator's interactive sessions instead of
#      being eaten by background work.
#
# Mid-flight pause exemptions (do NOT pause):
#   - The job already emitted its final `result` event — winding down anyway.
#   - The job is already `awaiting` (paused for some other reason).
#   - The job has `cancel_requested` — operator wants it gone, not preserved.

# _withdraw_quota_pause <job_file>: runs under the job lock (the supervisor and
# other writers take it too), re-reading the file so a change made since the
# caller looked is not overwritten. Returns 1 when there was nothing to withdraw.
# Covers both forms of the request: `pause_requested` (kill path) and, under an
# enforcing limiter, a quota_* `.hold` flag (boundary-hold path, L4).
_withdraw_quota_pause() {
    local f="$1" merged id hold
    [ "$(jq -r '.state // ""' "$f" 2>/dev/null)" = "running" ] || return 1
    case "$(jq -r '.paused_reason // ""' "$f" 2>/dev/null)" in
        quota_*)
            [ "$(jq -r '.pause_requested // false' "$f" 2>/dev/null)" = "true" ] || return 1
            merged=$(jq '.pause_requested = null | .paused_reason = null | .auto_resume_at = null' "$f") \
                && _atomic_write "$f" "$merged"
            return $? ;;
    esac
    id=$(jq -r '.id // ""' "$f" 2>/dev/null)
    hold="$RUNNER_DIR/$id.hold"
    [ -n "$id" ] && [ -f "$hold" ] || return 1
    case "$(jq -r '.code // ""' "$hold" 2>/dev/null)" in quota_*) ;; *) return 1 ;; esac
    rm -f "$hold"
    merged=$(jq '.auto_resume_at = null' "$f") && _atomic_write "$f" "$merged"
}

_auto_resume_check() {
    local now; now=$(date +%s)
    local f state reason resume_at id merged released=0 why hold_resume=0
    # An open gate (switch off, or off_until_reset still in force) releases every
    # quota-parked job on this tick, as an elapsed auto_resume_at would.
    _quota_gate_open && released=1
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        reason=$(jq -r '.paused_reason // ""' "$f" 2>/dev/null)
        # Gate open: withdraw a pause the daemon asked for but the supervisor has
        # not acted on yet, so the worker is never paused after the switch flips.
        # (A running job's pause is either `pause_requested` or a quota_* .hold flag.)
        if [ "$released" -eq 1 ] && [ "$state" = "running" ]; then
            if [ "$(jq -r '.pause_requested // false' "$f" 2>/dev/null)" = "true" ]; then
                case "$reason" in quota_*)
                    if _with_lock "$f" _withdraw_quota_pause "$f"; then
                        _log "withdrew pause request of $(jq -r '.id' "$f") (quota gate is open)"
                    fi ;;
                esac
                continue
            fi
            if [ -n "$(ls "$RUNNER_DIR"/*.hold 2>/dev/null)" ] && _with_lock "$f" _withdraw_quota_pause "$f"; then
                _log "withdrew quota hold of $(jq -r '.id' "$f") (quota gate is open)"
            fi
            continue
        fi
        [ "$state" = "awaiting" ] || continue
        case "$reason" in quota_*|limiter_hold) ;; *) continue ;; esac
        id=$(jq -r '.id' "$f")
        # The pause is marked `awaiting` before the old supervisor has killed its
        # worker (up to 10s): releasing now would start a second supervisor on the
        # same worktree. Wait until the old one is gone.
        if _supervisor_alive_for_job "$id"; then _note_waiting_on_supervisor "$id"; continue; fi
        if [ "$reason" = "limiter_hold" ]; then
            _resume_limiter_hold "$f" "$id" "$reason"
            continue
        fi
        why=window_reset
        if [ "$released" -eq 1 ]; then why=gate_off; fi
        if [ "$released" -eq 0 ]; then
            resume_at=$(_quota_int "$(jq -r '.auto_resume_at // 0' "$f" 2>/dev/null)")
            [ "$resume_at" -gt 0 ] || continue
            [ "$now" -ge "$resume_at" ] || continue
            # Only resume if quota is now actually under cap. The window may
            # have reset on the clock but if we're already pushing the next
            # window (back-to-back heavy use) we should keep waiting.
            if ! _quota_check; then continue; fi
        fi
        _log "auto-resuming $id (paused_reason=$reason; $why)"
        local answer="Quota window has reset — continue from where you left off."
        [ "$why" != gate_off ] || answer="The quota gate was switched off — continue from where you left off."
        merged=$(jq --arg ts "$(_iso_now)" --arg answer "$answer" '
            .state = "ready"
            | .pending_answer = $answer
            | .resumed_at = $ts
            | .resume_count = ((.resume_count // 0) + 1)
            | .auto_resume_at = null
            | .paused_reason = null
            | .pause_requested = null
        ' "$f") && _atomic_write "$f" "$merged"
        _append_event "$id" "auto_resumed" \
            "$(jq -nc --arg r "$reason" --arg why "$why" '{from_paused_reason: $r, reason: $why}')"
    done
}

# _resume_limiter_hold <job_file> <id> <paused_reason> — release a job parked as awaiting/limiter_hold
# (L4) once the limiter admits it (its id is on the admit list), or at once when the limiter is no longer
# enforcing (bet B6: the hold's basis is gone). The job goes to `ready` carrying its session id, so the
# next worker re-enters the same session (`--resume`) with the release note as its prompt. A hand-made
# `mother resume` takes the ordinary answer path instead. The caller has already checked that no
# supervisor of the job is alive.
_resume_limiter_hold() {
    local f="$1" id="$2" reason="$3" why=limiter_admitted
    if mother_limiter_enforcing; then
        mother_limiter_admit_list | grep -qxF -- "$id" || return 0
    else
        why=limiter_not_enforcing
    fi
    _with_lock "$f" _resume_limiter_hold_locked "$f" "$id" "$reason" "$why"
}

# Runs under the job-file lock (so a `mother cancel` taken meanwhile wins): re-checks the state inside it
# and writes nothing unless the job is still awaiting/limiter_hold.
_resume_limiter_hold_locked() {
    local f="$1" id="$2" reason="$3" why="$4" merged
    [ "$(jq -r '.state' "$f" 2>/dev/null)" = "awaiting" ] || return 0
    [ "$(jq -r '.paused_reason // ""' "$f" 2>/dev/null)" = "limiter_hold" ] || return 0
    _log "auto-resuming $id (paused_reason=$reason; $why)"
    merged=$(jq --arg ts "$(_iso_now)" --arg answer "The limiter released this job — continue from where you left off." '
        .state = "ready"
        | .pending_answer = $answer
        | .resume_session_id = (.session_id // null)
        | .resume_kind = "limiter_hold"
        | .resumed_at = $ts
        | .resume_count = ((.resume_count // 0) + 1)
        | .paused_reason = null
        | .pause_requested = null
        | .limiter_hold = null
    ' "$f") && _atomic_write "$f" "$merged" || return 0
    _append_event "$id" "auto_resumed" \
        "$(jq -nc --arg r "$reason" --arg why "$why" '{from_paused_reason: $r, reason: $why}')"
}

# ---------- limiter boundary holds (L4) ----------
#
# Under an enforcing limiter, a running job the limiter wants held gets $RUNNER_DIR/<id>.hold
# ({code, reason, since}). The supervisor (mother-run-job) and the PreToolUse hook
# (hooks/mother-limiter-hold.sh) do the rest at the job's next boundary; the runner never touches
# the worker. Anything that is not enforcing removes every flag within one tick, so held workers
# simply continue (bet B6).

# _hold_flag_code <file> — the code in a .hold flag (empty when unreadable).
_hold_flag_code() { jq -r '.code // ""' "$1" 2>/dev/null; }

# _write_hold_flag <id> <code> <reason> — atomically, and only when code/reason changed.
_write_hold_flag() {
    local id="$1" code="$2" reason="$3" f since cur
    f="$RUNNER_DIR/$id.hold"
    since=$(_iso_now)
    if [ -f "$f" ]; then
        cur=$(jq -c --arg c "$code" --arg r "$reason" 'select(.code == $c and .reason == $r) | .since' "$f" 2>/dev/null)
        [ -z "$cur" ] || return 0
    fi
    _atomic_write "$f" "$(jq -nc --arg c "$code" --arg r "$reason" --arg s "$since" '{code: $c, reason: $r, since: $s}')"
}

# _hold_job_eligible <job_file> — a job a hold may be written for: running, not cancelled, no final result.
_hold_job_eligible() {
    local jf="$1"
    [ -f "$jf" ] || return 1
    [ "$(jq -r '.state // ""' "$jf" 2>/dev/null)" = "running" ] || return 1
    [ "$(jq -r '.cancel_requested // false' "$jf" 2>/dev/null)" != "true" ] || return 1
    [ -z "$(jq -r '.final_result_at // ""' "$jf" 2>/dev/null)" ] || return 1
    return 0
}

# _apply_limiter_holds — enforce only. Hold every running job in the state's would_hold plus the
# non-advisory would_preempt set; remove the flag of running jobs no longer listed (quota_* flags are
# the quota gate's and stay while the quota is still over its cap).
_apply_limiter_holds() {
    local state_file; state_file="$(_limiter_state_file)"
    local us; us=$(printf '\037')
    local wanted="" id code reason jf f fs
    while IFS="$us" read -r id code reason; do
        [ -n "$id" ] || continue
        jf="$JOBS_DIR/$id.json"
        _hold_job_eligible "$jf" || continue
        fs=$(jq -r '.force_start // false' "$jf" 2>/dev/null)
        # force_start is exempt from interactive pre-emption, never from a distress hold.
        [ "$code" = "interactive_personal" ] && [ "$fs" = "true" ] && continue
        wanted="$wanted $id "
        # A quota hold (carries the resume time) is never replaced by a limiter hold.
        if [ -f "$RUNNER_DIR/$id.hold" ]; then
            case "$(_hold_flag_code "$RUNNER_DIR/$id.hold")" in quota_*) continue ;; esac
        fi
        _write_hold_flag "$id" "$code" "$reason"
    done < <(jq -r --arg us "$us" '(.running // [])[]
        | select(.hold != null and (.would_hold or (.would_preempt and (.advisory | not))))
        | [.id, .hold.code, .hold.reason] | join($us)' "$state_file" 2>/dev/null)

    for f in "$RUNNER_DIR"/*.hold; do
        [ -f "$f" ] || continue
        id=$(basename "$f" .hold)
        case "$wanted" in *" $id "*) continue ;; esac
        if _hold_job_eligible "$JOBS_DIR/$id.json"; then
            case "$(_hold_flag_code "$f")" in
                quota_*) _quota_check || continue ;;   # still over cap: keep it
            esac
        fi
        rm -f "$f"
    done
}

# _clear_limiter_holds — not enforcing (mode left enforce, limiter stale or faulted): remove every flag.
_clear_limiter_holds() {
    local f
    for f in "$RUNNER_DIR"/*.hold; do
        [ -f "$f" ] || continue
        rm -f "$f"
        _log "removed limiter hold $(basename "$f") (limiter is not enforcing)"
    done
}

_sync_limiter_holds() {
    if mother_limiter_enforcing; then
        _apply_limiter_holds
    else
        _clear_limiter_holds
    fi
}

_maybe_pause_running() {
    # Caller has already verified quota is over cap. Walk currently-tracked
    # children, find their job json, set `pause_requested` + paused_reason
    # + auto_resume_at on the eligible ones. mother-run-job's poll loop
    # picks up `pause_requested` on its next tick and handles the rest
    # (terminate worker, transition state to `awaiting`).
    #
    # Under an enforcing limiter (L4) nothing is killed mid-request: the job gets a quota_* `.hold`
    # flag and keeps `auto_resume_at`; it stops at its next boundary, and after the grace period the
    # supervisor parks it with paused_reason = that quota_* code, which _auto_resume_check handles.
    local reason resume_at holding=0
    reason=$(_quota_offending_window)
    [ -n "$reason" ] || return 0
    resume_at=$(_quota_resume_at_for "$reason")
    [ "$(_quota_int "${resume_at:-0}")" -gt 0 ] || return 0
    mother_limiter_enforcing && holding=1

    local f pid job_id job_file fr ar cr pr merged
    # Forked supervisors and leased jobs alike (cluster P1-5). For a leased job the canonical writes below
    # (pause_requested, paused_reason, auto_resume_at) and the .hold flag reach the worker through the
    # coordinator's downlink.
    local candidates=""
    for f in "$CHILDREN_DIR"/*.json; do
        [ -f "$f" ] || continue
        candidates="$candidates $(jq -r '.job_id // empty' "$f" 2>/dev/null)"
    done
    ! _worker_path_possible || candidates="$candidates $(_leased_job_ids | tr '\n' ' ')"
    for job_id in $candidates; do
        [ -n "$job_id" ] || continue
        job_file="$JOBS_DIR/$job_id.json"
        [ -f "$job_file" ] || continue
        # Exemptions.
        fr=$(jq -r '.final_result_at // ""' "$job_file" 2>/dev/null)
        [ -n "$fr" ] && continue   # already winding down
        ar=$(jq -r '.state // ""'             "$job_file" 2>/dev/null)
        [ "$ar" = "awaiting" ] && continue
        cr=$(jq -r '.cancel_requested // false' "$job_file" 2>/dev/null)
        [ "$cr" = "true" ] && continue
        pr=$(jq -r '.pause_requested // false'  "$job_file" 2>/dev/null)
        [ "$pr" = "true" ] && continue   # already requested
        fs=$(jq -r '.force_start // false' "$job_file" 2>/dev/null)
        [ "$fs" = "true" ] && continue   # forced — never pause for quota

        # The operator may have flipped the switch since this pass started.
        _quota_gate_open && return 0
        if [ "$holding" -eq 1 ]; then
            # Already holding for this window: nothing to do.
            [ "$(_hold_flag_code "$RUNNER_DIR/$job_id.hold")" = "$reason" ] && continue
            merged=$(jq --argjson ts "$resume_at" '.auto_resume_at = $ts' "$job_file") \
                && _atomic_write "$job_file" "$merged"
            _write_hold_flag "$job_id" "$reason" "quota cap reached ($reason)"
            _log "requested boundary hold of $job_id (reason=$reason, resume_at=$resume_at)"
            continue
        fi
        merged=$(jq --arg r "$reason" --argjson ts "$resume_at" '
            .pause_requested = true
            | .paused_reason = $r
            | .auto_resume_at = $ts
        ' "$job_file") && _atomic_write "$job_file" "$merged"
        _log "requested pause of $job_id (reason=$reason, resume_at=$resume_at)"
        _append_event "$job_id" "pause_requested" \
            "$(jq -nc --arg r "$reason" --argjson ts "$resume_at" \
                '{paused_reason: $r, auto_resume_at: $ts}')"
    done
}

# ---------- auto-escalation ----------

# After a job transitions to `failed`, first try `mother reconcile --auto` —
# the job may in fact have real, shippable work sitting on GitHub already
# (see .claude/bugs/*/2026-06-15-worker-ignores-assigned-branch-name.md), in
# which case escalating would burn a costly re-dispatch to rebuild a PR that
# already exists. Only escalate when reconcile finds nothing to adopt (exit
# 3) or is disabled. Gated independently of MOTHER_ESCALATION_ENABLED by
# MOTHER_RECONCILE_ENABLED so auto-reconciliation can be turned off on its
# own without disabling escalation.
_auto_escalate_failed() {
    local f state esc_count id reconcile_rc failure_reason failure_routed
    local route_rc route_out merged
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        [ "$state" = "failed" ] || continue
        id=$(jq -r '.id' "$f")
        failure_reason=$(jq -r '.failure_reason // empty' "$f" 2>/dev/null)
        failure_routed=$(jq -r '.failure_routed // false' "$f" 2>/dev/null)

        # New-style failures (a persisted .failure_reason) are routed by reason:
        # escalation is only one of the possible responses (see
        # lib/failure-route.sh). Failed jobs that pre-date .failure_reason keep
        # the legacy path below so they don't suddenly flip to awaiting on
        # daemon restart. MOTHER_FAILURE_ROUTING_ENABLED=0 restores the legacy
        # behavior for every job.
        if [ "${MOTHER_FAILURE_ROUTING_ENABLED:-1}" != "0" ] && [ -n "$failure_reason" ]; then
            [ "$failure_routed" = "true" ] && continue
            # Captured directly (not via a `cmd | while read` pipe, whose exit
            # status here would be the while loop's, not route-failure's) so a
            # non-zero exit — e.g. `mother` calling _die on a jq update
            # failure — is actually seen below.
            route_out=$("$MOTHER_BIN_DIR/mother" route-failure "$id" 2>&1)
            route_rc=$?
            [ -n "$route_out" ] && printf '%s\n' "$route_out" | while read -r line; do _log "route-failure: $line"; done
            if [ "$route_rc" -ne 0 ]; then
                # route-failure errored out instead of deliberately leaving the
                # job failed (that path sets failure_routed itself). Mark it
                # routed anyway so the daemon doesn't re-run route-failure —
                # and re-log the same error — on every future poll tick
                # forever; a persistent error becomes visible once, via a
                # distinct event, instead of spamming the daemon log.
                merged=$(jq '.failure_routed = true' "$f" 2>/dev/null) && _atomic_write "$f" "$merged"
                _append_event "$id" "route_error" \
                    "$(jq -nc --arg err "$route_out" --argjson rc "$route_rc" '{error: $err, exit_code: $rc}')"
                _log "route-failure exited $route_rc for $id; marked failure_routed to stop retrying"
            fi
            continue
        fi

        # ---- legacy path (unchanged) ----
        [ "$MOTHER_ESCALATION_ENABLED" = "1" ] || continue
        esc_count=$(jq -r '.escalation_count // 0' "$f" 2>/dev/null)
        [ "$esc_count" -lt 2 ] || continue

        if [ "${MOTHER_RECONCILE_ENABLED:-1}" = "1" ]; then
            "$MOTHER_BIN_DIR/mother" reconcile "$id" --auto >/dev/null 2>&1
            reconcile_rc=$?
            if [ "$reconcile_rc" -eq 0 ]; then
                _log "reconciled $id instead of escalating (mother reconcile --auto found a verified PR)"
                continue
            fi
        fi

        _log "auto-escalating $id (escalation_count=$esc_count)"
        "$MOTHER_BIN_DIR/mother" escalate "$id" 2>&1 | while read -r line; do _log "escalate: $line"; done
    done
}

# ---------- adherence loop ----------

_ADHERENCE_LOCK="$RUNNER_DIR/adherence-review.lockdir"

# _adherence_wave_owned <job-file> — true while the job's review wave is
# running, or after its findings were overridden by the operator. A wave that
# shipped needs no exception: it passed adherence on the head it presented,
# so the per-SHA guard below skips it.
_adherence_wave_owned() {
    case "$(jq -r '.review_wave.status // ""' "$1" 2>/dev/null)" in
        running|overridden) return 0 ;;
    esac
    return 1
}

_run_adherence_pending() {
    [ "$MOTHER_ADHERENCE_ENABLED" = "1" ] || return 0

    # Mark jobs that just succeeded with a PR url as adherence-pending.
    local f state pr adherence_pending adherence_attempts id
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        [ "$state" = "succeeded" ] || continue
        pr=$(jq -r '.pr_url // empty' "$f" 2>/dev/null)
        [ -n "$pr" ] || continue
        adherence_pending=$(jq -r '.adherence_pending // empty' "$f" 2>/dev/null)
        adherence_attempts=$(jq -r '.adherence_attempts // 0' "$f" 2>/dev/null)
        adherence_status=$(jq -r '.adherence_status // empty' "$f" 2>/dev/null)
        # Skip if already reviewed or blocked.
        case "$adherence_status" in
            passed|blocked_for_human) continue ;;
        esac
        # A job the loop guard capped stays out until the operator acts
        # (retry/escalate/reconcile clear the flag); otherwise it would be
        # re-marked pending and re-capped on every tick.
        [ "$(jq -r '((.needs_attention | objects | .reason) // "")' "$f" 2>/dev/null)" = "adherence_loop_capped" ] && continue
        # Gates run before adherence; a job whose blocking gates are red is
        # never reviewed (HC-08; enforce jobs can't reach succeeded red anyway).
        [ "$(jq -r '.gates.status // ""' "$f" 2>/dev/null)" = "failed" ] && continue
        # A review wave (HC-14) runs adherence itself, pre-ready: never start a
        # post-PR review while one is running, or after the operator opened
        # the PR over the wave's findings (override_open).
        _adherence_wave_owned "$f" && continue
        # Mark as pending if not already.
        if [ "$adherence_pending" != "true" ]; then
            merged=$(jq '.adherence_pending = true' "$f") && _atomic_write "$f" "$merged"
            id=$(jq -r '.id' "$f")
            _log "marked $id adherence_pending=true"
        fi
    done

    # Run one adherence review per tick, serialized by lock.
    if mkdir "$_ADHERENCE_LOCK" 2>/dev/null; then
        for f in "$JOBS_DIR"/*.json; do
            [ -f "$f" ] || continue
            adherence_pending=$(jq -r '.adherence_pending // false' "$f" 2>/dev/null)
            [ "$adherence_pending" = "true" ] || continue
            adherence_attempts=$(jq -r '.adherence_attempts // 0' "$f" 2>/dev/null)
            [ "$adherence_attempts" -lt 2 ] || continue
            state=$(jq -r '.state // ""' "$f" 2>/dev/null)
            # Only review jobs that just succeeded (re-queued rework jobs go through
            # succeeded again on their second pass, so this covers both passes).
            case "$state" in succeeded) ;; *) continue ;; esac
            [ "$(jq -r '.gates.status // ""' "$f" 2>/dev/null)" = "failed" ] && continue
            _adherence_wave_owned "$f" && continue
            id=$(jq -r '.id' "$f")

            # A human can merge a PR before this automatic loop ever reviews
            # it — the loop only runs once per tick, serialized by lock, so a
            # fast human merge routinely wins the race. If the PR is already
            # merged, running adherence review and (on failure) re-queuing
            # Cody for rework onto the branch is worse than a no-op: the
            # branch is dead, so a rework push either fails outright or
            # opens a stale duplicate PR — exactly what happened to
            # admin-portal#60 and admin-portal#4398/U4. Best-effort check;
            # fails open (runs the review as before) if `gh` is unavailable
            # or the job has no pr_url — this is a guard, not a new hard
            # dependency, matching this file's existing never-hard-fail
            # posture.
            local adherence_pr_url adherence_pr_state
            adherence_pr_url=$(jq -r '.pr_url // empty' "$f" 2>/dev/null) || adherence_pr_url=""
            adherence_pr_state=""
            if [ -n "$adherence_pr_url" ] && command -v gh >/dev/null 2>&1; then
                adherence_pr_state=$(gh pr view "$adherence_pr_url" --json state -q .state 2>/dev/null) \
                    || adherence_pr_state=""
            fi
            if [ "$adherence_pr_state" = "MERGED" ]; then
                _log "pipeline: $id: PR already merged ($adherence_pr_url) — skipping adherence review, not re-queuing rework onto a dead branch"
                local skipped
                skipped=$(jq \
                    '.adherence_pending = false
                    | .adherence_status = "skipped_pr_merged"' \
                    "$f") && _atomic_write "$f" "$skipped"
                _append_event "$id" "adherence_skipped" \
                    "$(jq -nc --arg pr_url "$adherence_pr_url" \
                        '{reason: "pr_already_merged", pr_url: $pr_url}')"
                break  # one review-or-skip decision per tick, same as the review path
            fi

            # Loop guard. A review is keyed on the PR head SHA: an unchanged head is
            # never re-reviewed once it passed, and any head gets at most
            # MOTHER_ADHERENCE_MAX_RUNS_PER_SHA spawns (verdict-less/erroring
            # reviews used to re-run every tick, forever — 1532 Opus reviews on one
            # job). Past the cap, flag the job for the operator instead of looping.
            # Reviews wait on the shared rate-limit pause too (not counted as a run).
            if mother_backoff_enabled && mother_ratelimit_active; then
                _log "adherence: $id: rate limit pause for $(mother_ratelimit_remaining)s — review deferred"
                break
            fi
            local head_sha reviewed_sha sha_runs adherence_status_now
            head_sha=""
            if [ -n "$adherence_pr_url" ] && command -v gh >/dev/null 2>&1; then
                head_sha=$(gh pr view "$adherence_pr_url" --json headRefOid -q .headRefOid 2>/dev/null) || head_sha=""
            fi
            [ -n "$head_sha" ] || head_sha="unknown"
            reviewed_sha=$(jq -r '.adherence_reviewed_sha // ""' "$f" 2>/dev/null)
            sha_runs=$(jq -r '.adherence_sha_runs // 0' "$f" 2>/dev/null)
            adherence_status_now=$(jq -r '.adherence_status // ""' "$f" 2>/dev/null)

            if [ "$head_sha" != "unknown" ] && [ "$head_sha" = "$reviewed_sha" ] \
                    && [ "$adherence_status_now" = "passed" ]; then
                _job_update "$id" '.adherence_pending = false' || true
                _append_event "$id" "adherence_skipped" \
                    "$(jq -nc --arg sha "$head_sha" '{reason: "head_unchanged", head_sha: $sha}')"
                _log "adherence: $id: head $head_sha already reviewed and passed — not re-reviewing"
                break
            fi

            if [ "$head_sha" = "$reviewed_sha" ]; then
                sha_runs=$((sha_runs + 1))
            else
                sha_runs=1
            fi

            if [ "$sha_runs" -gt "$MOTHER_ADHERENCE_MAX_RUNS_PER_SHA" ]; then
                _job_update "$id" \
                    '.adherence_pending = false
                    | .needs_attention = {reason: "adherence_loop_capped",
                        note: ("adherence review ran " + ($cap | tostring) + " times on head " + $sha + " without settling; not re-running. Review the PR by hand, then `mother retry` or ignore."),
                        since: $now}' \
                    --argjson cap "$MOTHER_ADHERENCE_MAX_RUNS_PER_SHA" --arg sha "$head_sha" --arg now "$(_iso_now)" || true
                _append_event "$id" "adherence_capped" \
                    "$(jq -nc --arg sha "$head_sha" --argjson cap "$MOTHER_ADHERENCE_MAX_RUNS_PER_SHA" \
                        '{head_sha: $sha, cap: $cap}')"
                _log "adherence: $id: hit the cap of $MOTHER_ADHERENCE_MAX_RUNS_PER_SHA reviews on head $head_sha — flagged for attention"
                break
            fi
            _job_update "$id" '.adherence_reviewed_sha = $sha | .adherence_sha_runs = $runs' \
                --arg sha "$head_sha" --argjson runs "$sha_runs" || true

            _log "running adherence review for $id (attempt=$adherence_attempts)"
            # NOTE: without `pipefail`, `if cmd | while read ...; then` tests the
            # exit status of the `while read` loop (the last command in the
            # pipeline), not `mother adherence-review`'s — and the loop's body
            # (_log) virtually always succeeds, so the `if` would almost always
            # take the pass branch regardless of the real verdict, silently
            # skipping the failed_first requeue below. Use PIPESTATUS instead of
            # relying on the pipeline's own exit status (bash 3.2-compatible;
            # macOS ships 3.2.57 per repo convention).
            "$MOTHER_BIN_DIR/mother" adherence-review "$id" 2>&1 | while read -r line; do _log "adherence: $line"; done
            local review_rc=${PIPESTATUS[0]}
            if [ "$review_rc" -eq 0 ]; then
                _log "adherence review passed for $id"
            elif [ "$review_rc" -eq 1 ]; then
                # Only rc 1 is a recorded fail; after rc 2 adherence_status may be stale from a prior review.
                local post_status; post_status=$(jq -r '.adherence_status // ""' "$JOBS_DIR/$id.json" 2>/dev/null)
                case "$post_status" in
                    failed_first)
                        # cmd_adherence_review already re-queued the job itself (a
                        # failed review must never leave it `succeeded`); only
                        # re-queue here if that did not land.
                        if [ "$(jq -r '.state' "$JOBS_DIR/$id.json" 2>/dev/null)" = "ready" ] \
                           && [ "$(jq -r '.activity // ""' "$JOBS_DIR/$id.json" 2>/dev/null)" = "cody_rework" ]; then
                            _append_event "$id" "adherence_rework_kicked" \
                                "$(jq -nc --arg id "$id" '{id: $id, note: "adherence failed first attempt; re-queued with activity=cody_rework"}')"
                            _append_event "$id" "ready" "$(jq -nc '{reason: "adherence_rework"}')"
                            _log "adherence failed for $id (first attempt) — re-queued (activity=cody_rework)"
                            break
                        fi
                        # Re-queue for a fresh Cody run. pending_answer already set by
                        # cmd_adherence_review. Mark activity=cody_rework so the list
                        # view shows it's a second attempt.
                        merged=$(jq '
                            .state = "ready"
                            | .activity = "cody_rework"
                            | .finished_at = null
                            | .worker_pid = null
                            | .cancel_requested = null
                            | .pause_requested = null
                            | .final_result_at = null
                            | .force_start = null
                            | .force_ignore_deps = null
                        ' "$JOBS_DIR/$id.json") && _atomic_write "$JOBS_DIR/$id.json" "$merged"
                        _append_event "$id" "adherence_rework_kicked" \
                            "$(jq -nc --arg id "$id" '{id: $id, note: "adherence failed first attempt; re-queuing with activity=cody_rework"}')"
                        # The job file now says state=ready, but the broker classifies every
                        # `adherence_*` event as activity: clients that follow the event stream
                        # (the Nostromo Mother panel) would keep showing the job as SUCCEEDED while
                        # `mother list` says ready [cody_rework]. Emit the state event too.
                        _append_event "$id" "ready" \
                            "$(jq -nc '{reason: "adherence_rework"}')"
                        _log "adherence failed for $id (first attempt) — re-queuing (activity=cody_rework)"
                        ;;
                    blocked_for_human)
                        # cmd_adherence_review already transitioned to awaiting+adherence_blocked.
                        _log "adherence failed for $id (second attempt) — job is now awaiting (adherence_blocked)"
                        ;;
                esac
            else
                _log "adherence review errored for $id (rc=$review_rc) — leaving it pending for a later tick"
            fi
            break  # one review per tick
        done
        rmdir "$_ADHERENCE_LOCK" 2>/dev/null || true
    fi
}

# ---------- pipeline driver ----------
#
# W4: orchestrates pipeline jobs (kind="pipeline") through the multi-phase
# SDLC loop. Advances build phases (redd→cody→marty), runs concurrent reviews
# (Ada + Archie + Perri), and applies the B4 loop-exit truth table (ship /
# block_human / cap-hit / continue) on every review cycle.
#
# Gated by MOTHER_PIPELINE_ENABLED (default 1).

_PIPELINE_DRIVER_LOCK="$RUNNER_DIR/pipeline-driver.lockdir"

# _pipeline_next_build_phase <current> [pending_agents_newline_separated]
# Returns the next eligible phase after <current> in forward order
# (redd → cody → marty), restricted to agents in <pending_agents> when
# non-empty. Prints nothing if we have reached the end.
_pipeline_next_build_phase() {
    local current="$1" pending="${2:-}"
    local found=0 p
    for p in redd cody marty; do
        if [ "$found" -eq 1 ]; then
            if [ -z "$pending" ] || printf '%s\n' "$pending" | grep -qxF "$p"; then
                printf '%s\n' "$p"
                return 0
            fi
        fi
        [ "$p" = "$current" ] && found=1
    done
    return 0
}

# _pipeline_first_pending_agent <pending_agents_newline_separated>
# Returns the first agent in forward order that appears in pending_agents.
# Fallback to "cody" if empty (should not happen).
_pipeline_first_pending_agent() {
    local pending="${1:-}"
    local p
    for p in redd cody marty; do
        printf '%s\n' "$pending" | grep -qxF "$p" && { printf '%s\n' "$p"; return 0; }
    done
    printf 'cody\n'
}

# _run_pipeline_review <id> <job_file>
# Run the concurrent review phase for a pipeline job at phase=review.
# Must be called while the pipeline driver lock is held.
_run_pipeline_review() {
    local id="$1" job_file="$2"

    # Read reviewer list (newline-separated agent names).
    local reviewers
    reviewers=$(jq -r '.pipeline.reviewers // [] | .[]' "$job_file" 2>/dev/null) || reviewers=""

    # Empty reviewer list is a misconfiguration — block for human.
    if [ -z "$reviewers" ]; then
        _log "pipeline: $id: empty reviewer list — blocking (pipeline_error)"
        local now; now=$(_iso_now)
        _job_update "$id" \
            ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
        _append_event "$id" "pipeline_error" \
            "$(jq -nc '{note: "empty reviewer list — pipeline blocked for human"}')"
        return 0
    fi

    local review_cycle reviewers_json
    review_cycle=$(jq -r '.pipeline.review_cycle // 0' "$job_file" 2>/dev/null) || review_cycle=0
    reviewers_json=$(jq -c '.pipeline.reviewers // []' "$job_file" 2>/dev/null) || reviewers_json="[]"

    _log "pipeline: $id: concurrent review started (cycle=${review_cycle:-0})"
    _job_update "$id" '.activity = "pipeline_review"'
    _append_event "$id" "pipeline_review_started" \
        "$(jq -nc --argjson cycle "${review_cycle:-0}" '{review_cycle: $cycle}')"
    # W5 lifecycle event: review cycle start (additive alongside pipeline_review_started).
    _append_event "$id" "review_cycle_started" \
        "$(jq -nc \
            --argjson cycle "${review_cycle:-0}" \
            --argjson reviewers "${reviewers_json:-[]}" \
            '{cycle: $cycle, reviewers: $reviewers}')"

    # Spawn all reviewers in parallel — each writes to its own
    # .pipeline.reviewer_findings.<reviewer> slot (W3 per-slot writes are
    # isolated, so concurrent writers cannot clobber each other).
    local review_log pids r
    review_log="$LOGS_DIR/$id.pipeline-review.log"
    pids=""
    for r in $reviewers; do
        _log "pipeline: $id: spawning reviewer $r"
        "$MOTHER_BIN_DIR/mother" review-phase "$id" --reviewer "$r" \
            >>"$review_log" 2>&1 &
        pids="$pids $!"
    done

    # Wait for all reviewers. A reviewer returning 2 (parse error per W3) is
    # tolerated: logged, treated as no findings for that slot, review continues.
    local p
    for p in $pids; do
        wait "$p" 2>/dev/null \
            || _log "pipeline: $id: a reviewer returned non-zero (tolerated — treated as no findings)"
    done

    # Merge all per-reviewer findings slots into a single re-id'd array.
    local merged_findings
    merged_findings=$("$MOTHER_BIN_DIR/mother" merge-findings "$id" 2>/dev/null) || merged_findings="[]"
    [ -z "$merged_findings" ] && merged_findings="[]"

    # Reload from disk (reviewers mutated the file; our local $job_file is stale).
    local jf; jf=$(_job_path "$id")

    # Snapshot current .pipeline.findings into history, then write merged set.
    local old_findings history_entry merged_jf
    old_findings=$(jq -c '.pipeline.findings // []' "$jf" 2>/dev/null) || old_findings="[]"
    history_entry=$(jq -nc \
        --argjson cycle "${review_cycle:-0}" \
        --argjson findings "$old_findings" \
        '{cycle: $cycle, findings: $findings}')
    merged_jf=$(jq \
        --argjson findings "$merged_findings" \
        --argjson history_entry "$history_entry" \
        '.pipeline.findings = $findings | .pipeline.findings_history += [$history_entry]' \
        "$jf") && _atomic_write "$jf" "$merged_jf"

    # Re-read for B4 decision (in case the above write raced with a reviewer).
    jf=$(_job_path "$id")

    # Resolve cycle cap: per-job value beats env default.
    local cap
    cap=$(jq -r ".pipeline.cycle_cap // ${MOTHER_PIPELINE_CYCLE_CAP:-3}" "$jf" 2>/dev/null) \
        || cap="${MOTHER_PIPELINE_CYCLE_CAP:-3}"
    [ -z "$cap" ] || [ "$cap" = "null" ] && cap="${MOTHER_PIPELINE_CYCLE_CAP:-3}"

    # B4 exit truth table.
    local decision
    decision=$(findings_exit_decision "$merged_findings" 2>/dev/null) || decision="ship"

    # W5 lifecycle event: review cycle completed (emitted before the B4 branch
    # so the timestamp precedes any state transitions caused by the decision).
    local findings_count_ev
    findings_count_ev=$(printf '%s' "$merged_findings" | jq 'length' 2>/dev/null) || findings_count_ev=0
    _append_event "$id" "review_cycle_completed" \
        "$(jq -nc \
            --argjson cycle "${review_cycle:-0}" \
            --arg decision "$decision" \
            --argjson findings_count "${findings_count_ev:-0}" \
            '{cycle: $cycle, decision: $decision, findings_count: $findings_count}')"

    local now; now=$(_iso_now)
    case "$decision" in

        block_human)
            # Short-circuit: human-blocking finding — stop immediately.
            _log "pipeline: $id: human-blocking finding — blocking job (pipeline_blocked)"
            _job_update "$id" \
                ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
            _append_event "$id" "pipeline_blocked" \
                "$(jq -nc --argjson findings "$merged_findings" \
                    '{reason: "human_blocking_finding", findings: $findings}')"
            ;;

        ship)
            # No agent-actionable findings — ship.
            _log "pipeline: $id: zero agent-actionable findings — shipping (pipeline_shipped)"
            local advisories adv_count
            advisories=$(findings_by_target "$merged_findings" "human" 2>/dev/null) || advisories="[]"
            adv_count=$(printf '%s' "$advisories" | jq 'length' 2>/dev/null) || adv_count=0
            local shipped
            shipped=$(jq \
                --argjson advisories "$advisories" \
                --arg now "$now" \
                '.state = "succeeded"
                | .activity = null
                | .pipeline.phase = "done"
                | .pipeline_reviewed = true
                | .pipeline.advisories = $advisories
                | .finished_at = $now' \
                "$jf") && _atomic_write "$jf" "$shipped"
            _append_event "$id" "pipeline_shipped" \
                "$(jq -nc --argjson advisories "$advisories" '{advisories: $advisories}')"
            # Best-effort: post advisory findings as a PR comment so the human
            # sees them on the shipped PR. Non-fatal if gh is unavailable.
            if [ "${adv_count:-0}" -gt 0 ]; then
                local pr_url
                pr_url=$(jq -r '.pr_url // empty' "$jf" 2>/dev/null) || pr_url=""
                if [ -n "${pr_url:-}" ]; then
                    local adv_body
                    adv_body=$(printf '%s' "$advisories" \
                        | jq -r '.[] | "- [\(.severity)] \(.summary)"' 2>/dev/null) || adv_body=""
                    gh pr comment "$pr_url" \
                        --body "$(printf '## Pipeline Advisory Findings\n\n%s' "$adv_body")" \
                        2>/dev/null \
                        || _log "pipeline: $id: advisory PR comment failed (best-effort, ignored)"
                fi
            fi
            ;;

        continue)
            # Agent-actionable findings remain — but if a human has already
            # merged this job's PR out-of-band (they don't wait for the
            # pipeline to say "ship"), dispatching another build cycle onto
            # a dead branch is pointless: it produces a second PR racing an
            # already-closed one, which GitHub opens fresh since the first
            # is no longer accepting pushes as open. Confirmed by a real
            # case: infrastructure#60, a stale duplicate of already-merged
            # infrastructure#59, containing nothing that wasn't already on
            # main. Check merge state before continuing; best-effort, and
            # fails open (proceeds with the cycle) if `gh` is unavailable —
            # this check is a guard, not a new hard dependency.
            local pr_url_check pr_state
            pr_url_check=$(jq -r '.pr_url // empty' "$jf" 2>/dev/null) || pr_url_check=""
            pr_state=""
            if [ -n "$pr_url_check" ] && command -v gh >/dev/null 2>&1; then
                pr_state=$(gh pr view "$pr_url_check" --json state -q .state 2>/dev/null) \
                    || pr_state=""
            fi
            if [ "$pr_state" = "MERGED" ]; then
                _log "pipeline: $id: PR already merged ($pr_url_check) — not continuing cycle, blocking for human"
                _job_update "$id" \
                    ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
                _append_event "$id" "pipeline_blocked" \
                    "$(jq -nc --arg pr_url "$pr_url_check" --argjson findings "$merged_findings" \
                        '{reason: "pr_already_merged", pr_url: $pr_url, findings: $findings}')"
                return 0
            fi

            # Check cap.
            local next_cycle
            next_cycle=$(( ${review_cycle:-0} + 1 ))
            if [ "$next_cycle" -gt "${cap:-3}" ]; then
                _log "pipeline: $id: cycle cap hit (review_cycle=${review_cycle:-0}, cap=${cap:-3}) — blocking"
                _job_update "$id" \
                    ".state = \"awaiting\" | .activity = \"pipeline_blocked\" | .pipeline.phase = \"blocked\" | .paused_at = \"$now\""
                _append_event "$id" "pipeline_cap_hit" \
                    "$(jq -nc \
                        --argjson cycle "${review_cycle:-0}" \
                        --argjson cap "${cap:-3}" \
                        --argjson findings "$merged_findings" \
                        '{review_cycle: $cycle, cap: $cap, outstanding: $findings}')"
            else
                # Continue: increment cycle, compute pending_agents (B5), re-ready.
                _log "pipeline: $id: agent findings found — continuing (cycle ${review_cycle:-0} -> $next_cycle)"
                local pending_json pending_agents first_agent
                pending_json=$(printf '%s' "$merged_findings" | jq -c \
                    '[.[] | select(.target == "redd" or .target == "cody" or .target == "marty") | .target] | unique' \
                    2>/dev/null) || pending_json="[]"
                pending_agents=$(printf '%s' "$pending_json" | jq -r '.[]' 2>/dev/null) \
                    || pending_agents=""
                first_agent=$(_pipeline_first_pending_agent "$pending_agents")
                local continued
                continued=$(jq \
                    --arg phase "$first_agent" \
                    --argjson pending_agents "$pending_json" \
                    --argjson next_cycle "$next_cycle" \
                    '.pipeline.phase = $phase
                    | .pipeline.pending_agents = $pending_agents
                    | .pipeline.review_cycle = $next_cycle
                    | .state = "ready"
                    | .activity = "pipeline_phase"
                    | .finished_at = null
                    | .started_at = null
                    | .worker_pid = null
                    | .cancel_requested = null
                    | .pause_requested = null
                    | .final_result_at = null' \
                    "$jf") && _atomic_write "$jf" "$continued"
                _append_event "$id" "pipeline_cycle_continued" \
                    "$(jq -nc \
                        --argjson cycle "$next_cycle" \
                        --argjson pending_agents "$pending_json" \
                        '{review_cycle: $cycle, pending_agents: $pending_agents}')"
                # state flipped back to ready above: say so as a STATE event (pipeline_* events are
                # classified as activity, so event-following clients would miss it).
                _append_event "$id" "ready" "$(jq -nc '{reason: "pipeline_cycle_continued"}')"
                # W5 lifecycle event: start the first build phase of the new cycle.
                _append_event "$id" "phase_started" \
                    "$(jq -nc \
                        --argjson cycle "$next_cycle" \
                        --arg agent "$first_agent" \
                        --arg rt "$(_agent_request_type "$first_agent")" \
                        '{cycle: $cycle, agent: $agent, request_type: $rt}')"
            fi
            ;;
    esac
}

# _run_pipeline_job — per-tick pipeline orchestrator.
# Finds the first pipeline job that is actionable this tick and advances it
# one step: build-phase succeeded → advance phase; review phase reached →
# run concurrent review + B4 exit decision. Serialized by a mkdir lock;
# one pipeline step per tick.
_run_pipeline_job() {
    [ "${MOTHER_PIPELINE_ENABLED:-1}" = "1" ] || return 0

    if ! mkdir "$_PIPELINE_DRIVER_LOCK" 2>/dev/null; then
        return 0  # another tick's driver run still holds the lock
    fi

    local f state kind pipeline_phase id
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        kind=$(jq -r '.kind // ""' "$f" 2>/dev/null) || continue
        [ "$kind" = "pipeline" ] || continue
        state=$(jq -r '.state // ""' "$f" 2>/dev/null) || continue
        [ "$state" = "succeeded" ] || continue
        pipeline_phase=$(jq -r '.pipeline.phase // ""' "$f" 2>/dev/null) || continue
        # done/blocked are terminal pipeline phases; skip.
        case "$pipeline_phase" in done|blocked|"") continue ;; esac
        id=$(jq -r '.id' "$f")

        case "$pipeline_phase" in

            redd|cody|marty)
                # Build phase just succeeded. Advance to the next eligible agent
                # (B5 skip: only agents in pending_agents are eligible on re-runs).
                local pending_agents next_phase review_cycle
                pending_agents=$(jq -r '.pipeline.pending_agents // [] | .[]' "$f" 2>/dev/null) \
                    || pending_agents=""
                review_cycle=$(jq -r '.pipeline.review_cycle // 0' "$f" 2>/dev/null) \
                    || review_cycle=0
                next_phase=$(_pipeline_next_build_phase "$pipeline_phase" "$pending_agents")

                if [ -n "$next_phase" ]; then
                    _log "pipeline: $id: phase=$pipeline_phase succeeded — advancing to $next_phase"
                    local advanced
                    advanced=$(jq --arg phase "$next_phase" \
                        '.pipeline.phase = $phase
                        | .state = "ready"
                        | .activity = "pipeline_phase"
                        | .finished_at = null
                        | .started_at = null
                        | .worker_pid = null
                        | .cancel_requested = null
                        | .pause_requested = null
                        | .final_result_at = null' \
                        "$f") && _atomic_write "$f" "$advanced"
                    _append_event "$id" "pipeline_phase_advance" \
                        "$(jq -nc --arg from "$pipeline_phase" --arg to "$next_phase" \
                            '{from: $from, to: $to}')"
                    # state flipped back to ready above: emit the STATE event (pipeline_* is activity).
                    _append_event "$id" "ready" "$(jq -nc '{reason: "pipeline_phase_advance"}')"
                    # W5 lifecycle events: complete the old phase, start the new one.
                    _append_event "$id" "phase_completed" \
                        "$(jq -nc \
                            --argjson cycle "${review_cycle:-0}" \
                            --arg agent "$pipeline_phase" \
                            --arg rt "$(_agent_request_type "$pipeline_phase")" \
                            '{cycle: $cycle, agent: $agent, request_type: $rt}')"
                    _append_event "$id" "phase_started" \
                        "$(jq -nc \
                            --argjson cycle "${review_cycle:-0}" \
                            --arg agent "$next_phase" \
                            --arg rt "$(_agent_request_type "$next_phase")" \
                            '{cycle: $cycle, agent: $agent, request_type: $rt}')"
                else
                    # No more eligible build agents — move to review phase.
                    # Keep state=succeeded so the driver picks it up next tick.
                    # B6: do NOT touch current_tier or escalation_count.
                    _log "pipeline: $id: phase=$pipeline_phase succeeded — all build phases done, moving to review"
                    _job_update "$id" \
                        ".pipeline.phase = \"review\" | .activity = \"pipeline_review\""
                    _append_event "$id" "pipeline_phase_advance" \
                        "$(jq -nc --arg from "$pipeline_phase" --arg to "review" '{from: $from, to: $to}')"
                    # W5 lifecycle event: complete the last build phase.
                    _append_event "$id" "phase_completed" \
                        "$(jq -nc \
                            --argjson cycle "${review_cycle:-0}" \
                            --arg agent "$pipeline_phase" \
                            --arg rt "$(_agent_request_type "$pipeline_phase")" \
                            '{cycle: $cycle, agent: $agent, request_type: $rt}')"
                fi
                break
                ;;

            review)
                # All build phases done. Run concurrent review + B4.
                _run_pipeline_review "$id" "$f"
                break
                ;;

        esac
    done

    rmdir "$_PIPELINE_DRIVER_LOCK" 2>/dev/null || true
}

# One dispatch pass: spawn ready jobs up to MOTHER_CONCURRENCY. Gated by the
# quota cap (over cap: forced jobs only, and running jobs may be paused) and by
# the low-disk guard (low disk: nothing new starts; running jobs are untouched).
_RATELIMIT_ANNOUNCED=0

# _write_dispatch_last <paused> <over_cap> <low_disk> <spawned ids> <skipped ids> [enforcing] — what this
# dispatch pass did, for the limiter's observe-only decision log. Read by mother-limiter only;
# nothing in dispatch reads it.
_write_dispatch_last() {
    local running; running=$(_count_running_children)
    jq -nc --argjson ts "$(date +%s)" --argjson running "${running:-0}" --argjson ceiling "$MOTHER_CONCURRENCY" \
        --argjson paused "$([ "$1" = 1 ] && echo true || echo false)" \
        --argjson over "$([ "$2" = 1 ] && echo true || echo false)" \
        --argjson low "$([ "$3" = 1 ] && echo true || echo false)" \
        --arg spawned "$4" --arg skipped "$5" \
        --argjson enforcing "$([ "${6:-0}" = 1 ] && echo true || echo false)" \
        --argjson drained "$([ "${7:-0}" = 1 ] && echo true || echo false)" \
        '{ts: $ts, running: $running, ceiling: $ceiling, ratelimit_paused: $paused, quota_over_cap: $over,
          low_disk: $low, enforcing: $enforcing, drained: $drained, spawned: ($spawned | split(" ") | map(select(length > 0))),
          skipped: ($skipped | split(" ") | map(select(length > 0)))}' \
        > "$RUNNER_DIR/dispatch-last.json.tmp.$$" 2>/dev/null \
        && mv "$RUNNER_DIR/dispatch-last.json.tmp.$$" "$RUNNER_DIR/dispatch-last.json" \
        || rm -f "$RUNNER_DIR/dispatch-last.json.tmp.$$"
    # Worker path only (cluster P1-5): additive `leased` and `mode`; legacy output is unchanged.
    ! _worker_path_possible || _dispatch_last_worker_fields
}

_dispatch_last_worker_fields() {
    local f="$RUNNER_DIR/dispatch-last.json"
    [ -f "$f" ] || return 0
    jq -c --argjson leased "$(_leased_job_ids | wc -l | tr -d ' ')" --arg mode "$MOTHER_DISPATCH_MODE" \
        '. + {leased: $leased, mode: $mode}' "$f" > "$f.tmp.$$" 2>/dev/null && mv "$f.tmp.$$" "$f" || rm -f "$f.tmp.$$"
}

# _dispatch_drained: maintenance mode (`mother drain`). True while $RUNNER_DIR/drain.json exists; the
# spawn loop then starts nothing (ready, retried, resumed and promoted jobs all wait in place). Only the
# spawn loop is gated: the quota pause of running jobs and dispatch-last.json keep running. Running jobs,
# in-flight reviews, teardown and archive are untouched. One stat, no forks.
_DRAIN_ANNOUNCED=0
_dispatch_drained() {
    [ -f "$RUNNER_DIR/drain.json" ] || { _DRAIN_ANNOUNCED=0; return 1; }
    [ "$_DRAIN_ANNOUNCED" = "1" ] || _log "drain: dispatch is draining; no new job will start (running jobs untouched)"
    _DRAIN_ANNOUNCED=1
    return 0
}

_dispatch_ready_jobs() {
    local picker=_pick_next_ready over_cap=0 next paused=0 low_disk=0 spawned="" skipped="" drained=0
    _dispatch_drained && drained=1
    local limit="$MOTHER_CONCURRENCY" enforcing=0 allowed
    _DISPATCH_SKIP=""
    _LIMITER_ADMIT=""
    _WORKER_CONN_PASS=""
    if mother_limiter_enforcing; then
        # The limiter decides admission (budget pace, reserve, backoff, ramp, interactive demand, priority);
        # its backoff and admissions_paused_until replace the fixed rate-limit pause. Stale/faulted limiter:
        # this branch is skipped and today's path below runs unchanged (the limiter_fault attention item shows).
        enforcing=1
        picker=_pick_next_limiter_ready
        _LIMITER_ADMIT=$(mother_limiter_admit_list)
        allowed=$(mother_limiter_allowed)
        case "${allowed:-}" in ''|*[!0-9]*) ;; *) [ "$allowed" -ge "$limit" ] || limit="$allowed" ;; esac
        _RATELIMIT_ANNOUNCED=0
    elif mother_backoff_enabled && mother_ratelimit_active; then
        # A rate limit is shared by every API caller: start nothing new until
        # it lifts. Running jobs are untouched; ready jobs wait in place.
        paused=1
        [ "$_RATELIMIT_ANNOUNCED" = "1" ] || _log "rate limit: dispatch paused for $(mother_ratelimit_remaining)s (running jobs untouched)"
        _RATELIMIT_ANNOUNCED=1
    else
        _RATELIMIT_ANNOUNCED=0
    fi
    if ! _quota_check; then
        picker=_pick_next_forced_ready
        [ "$enforcing" -eq 0 ] || picker=_pick_next_limiter_forced_ready
        over_cap=1
    fi
    while [ "$paused" -eq 0 ] && [ "$drained" -eq 0 ] && [ "$(_count_running_children)" -lt "$limit" ]; do
        next=$($picker)
        if [ -z "$next" ]; then
            _disk_recheck_idle
            break
        fi
        # A job whose previous supervisor is still alive is skipped for this pass,
        # not allowed to hold back every other ready job behind it.
        if _supervisor_alive_for_job "$next"; then
            _note_waiting_on_supervisor "$next"
            _DISPATCH_SKIP="$_DISPATCH_SKIP $next"
            skipped="$skipped $next"
            continue
        fi
        _disk_dispatch_ok "$next" || { low_disk=1; break; }
        # Worker path: never move a job to `running` unless a worker is connected to hand it to.
        if _job_uses_worker "$next" && ! _worker_connected; then
            _flag_worker_unavailable "$next"
            _DISPATCH_SKIP="$_DISPATCH_SKIP $next"
            skipped="$skipped $next"
            continue
        fi
        _spawn_job "$next" || break
        spawned="$spawned $next"
    done
    _DISPATCH_SKIP=""
    _LIMITER_ADMIT=""
    _write_dispatch_last "$paused" "$over_cap" "$low_disk" "$spawned" "$skipped" "$enforcing" "$drained" || true
    [ "$over_cap" -eq 1 ] && _maybe_pause_running
    return 0
}

_loop() {
    while [ "$SHUTDOWN" -eq 0 ]; do
        _reap_children
        _reap_broker
        _worker_path_tick
        _recover_orphans "$MOTHER_ORPHAN_GRACE"
        # Auto-resume system-paused jobs whose window has rolled over
        # BEFORE _promote_ready, so resumed jobs are eligible for the
        # current tick's spawn budget.
        _auto_resume_check
        # Auto-escalate failed jobs (before promote_ready so escalated jobs
        # land in ready and are eligible this tick).
        _auto_escalate_failed
        _promote_ready
        # Process adherence-pending jobs (after reaping so fresh succeeded
        # state is visible).
        _run_adherence_pending
        # Advance pipeline jobs one step per tick (build-phase transitions,
        # concurrent review, B4 exit decision). After adherence so build-phase
        # succeeded state is fully settled before the driver sees it.
        [ "${MOTHER_PIPELINE_ENABLED:-1}" = "1" ] && _run_pipeline_job

        _dispatch_ready_jobs
        _maybe_limiter_tick
        _sync_limiter_holds

        _maybe_backup
        _maybe_archive
        _maybe_refresh_attention
        _maybe_progress_tick
        _notify_awaiting
        # Sleep in short slices so signal handling is responsive.
        local slept=0
        while [ "$slept" -lt "$MOTHER_POLL_INTERVAL" ] && [ "$SHUTDOWN" -eq 0 ]; do
            sleep 1
            slept=$((slept + 1))
        done
    done
}

_drain() {
    _stop_broker
    # The coordinator stops with the runner; the local worker deliberately does not: its jobs keep running
    # through a restart and the next runner re-registers it (MC-16). Leased jobs are not drained for.
    _stop_coord
    _log "drain: waiting up to ${MOTHER_SHUTDOWN_GRACE}s for ${MOTHER_CONCURRENCY} slots to clear"
    local elapsed=0
    while [ "$elapsed" -lt "$MOTHER_SHUTDOWN_GRACE" ]; do
        _reap_children
        local running; running=$(_count_forked_children)
        [ "$running" -eq 0 ] && { _log "drain complete"; return 0; }
        sleep 1
        elapsed=$((elapsed + 1))
    done
    _reap_children
    local remaining; remaining=$(_count_forked_children)
    if [ "$remaining" -gt 0 ]; then
        _log "drain grace expired — $remaining child(ren) still running; exiting anyway (jobs continue as detached worker processes)"
    fi
}

# ---------- entrypoint ----------

main() {
    _singleton_guard
    _write_pidfile
    mother_ensure_live_marker
    _publish_cli_path
    _publish_effective_config
    trap '_on_signal' TERM INT
    _log "mother-runner started (pid $$, concurrency=$MOTHER_CONCURRENCY [$MOTHER_CONCURRENCY_SOURCE], poll=${MOTHER_POLL_INTERVAL}s)"
    [ ! -f "$RUNNER_DIR/drain.json" ] || _log "drain flag present: dispatch stays DRAINING until \`mother undrain\`"
    _recover_stale_locks
    _prune_temps_startup
    _rebuild_active_index
    # A runner started with worker-path state on disk (or upgraded from before the marker): one grep pass decides.
    if [ -d "$DISPATCH_DIR" ] || [ -d "$LEASES_DIR" ]; then : > "$WORKER_JOBS_MARKER"; fi
    # Lost leases first: _recover_orphans leaves an unhandled lost lease to _recover_lost_leases.
    if _worker_path_possible && [ -d "$ACTIVE_DIR" ]; then _recover_lost_leases; fi
    _recover_orphans
    type mother_publish_rates >/dev/null 2>&1 && mother_publish_rates
    _start_broker
    _loop
    _drain
    _remove_pidfile
    _log "mother-runner exited"
    exit 0
}

# Test entry point: run one pipeline driver tick and exit without starting
# the daemon loop. Used by pipeline_driver.bats.
# Usage: mother-runner --driver-tick
case "${1:-}" in
    --publish-config-tick)
        # Test entry point: publish effective-config.json and exit without
        # starting the daemon loop. Used by config.bats / launchd_plist.bats.
        # Usage: mother-runner --publish-config-tick
        _publish_effective_config
        exit 0
        ;;
    --worker-tick)
        # Test entry point: one _worker_path_tick (coordinator/worker supervision, lost and released leases)
        # and exit. Used by runner_split.bats for the per-tick cost checks.
        # Usage: mother-runner --worker-tick
        _rebuild_active_index
        _worker_path_tick
        wait
        exit 0
        ;;
    --driver-tick)
        _run_pipeline_job
        exit 0
        ;;
    --recover-orphans-tick)
        # Test entry point: run one _recover_orphans pass (with the real
        # grace window, or an override via $2) and exit without starting the
        # daemon loop. Used by orphan_recovery.bats.
        # Usage: mother-runner --recover-orphans-tick [grace_seconds]
        _recover_orphans "${2:-$MOTHER_ORPHAN_GRACE}"
        exit 0
        ;;
    --auto-escalate-tick)
        # Test entry point: run one _auto_escalate_failed pass and exit
        # without starting the daemon loop. Used by escalation.bats to drive
        # the REAL failure-routing/legacy-escalation wiring (which failed job
        # gets routed via `mother route-failure`, which is skipped because
        # failure_routed is already true, and which falls back to the legacy
        # reconcile-then-escalate path when MOTHER_FAILURE_ROUTING_ENABLED=0)
        # behaviorally, instead of grepping this script's source for strings.
        # Usage: mother-runner --auto-escalate-tick
        _auto_escalate_failed
        exit 0
        ;;
    --dispatch-tick)
        # Test entry point: run one _dispatch_ready_jobs pass and exit without
        # starting the daemon loop. Used by low_disk_guard.bats.
        # Usage: mother-runner --dispatch-tick
        _dispatch_ready_jobs
        exit 0
        ;;
    --limiter-tick)
        # Test entry point: run one _maybe_limiter_tick pass and exit. The interval gate is
        # controlled via MOTHER_LIMITER_INTERVAL (0 = always) / $RUNNER_DIR/last-limiter.ts.
        # Usage: mother-runner --limiter-tick
        _maybe_limiter_tick
        exit 0
        ;;
    --holds-tick)
        # Test entry point: run one _sync_limiter_holds pass (write or clear the .hold flags) and exit.
        # Usage: mother-runner --holds-tick
        _sync_limiter_holds
        exit 0
        ;;
    --pause-tick)
        # Test entry point: run one _maybe_pause_running pass and exit.
        # Usage: mother-runner --pause-tick
        _maybe_pause_running
        exit 0
        ;;
    --auto-resume-tick)
        # Test entry point: run one _auto_resume_check pass and exit without
        # starting the daemon loop. Used by quota_gate.bats.
        # Usage: mother-runner --auto-resume-tick
        _auto_resume_check
        exit 0
        ;;
    --archive-tick)
        # Test entry point: run one _maybe_archive pass and exit without
        # starting the daemon loop. Callers control whether the interval gate
        # actually fires via MOTHER_ARCHIVE_INTERVAL / the last-archive.ts
        # marker. Used by archive_watchdog.bats.
        # Usage: mother-runner --archive-tick
        _maybe_archive
        exit 0
        ;;
    --backup-tick)
        # Test entry point: run one _maybe_backup pass and exit without
        # starting the daemon loop. The interval gate is controlled via
        # MOTHER_BACKUP_INTERVAL / the $RUNNER_DIR/last-backup.ts marker.
        # Usage: mother-runner --backup-tick
        _maybe_backup
        exit 0
        ;;
    --adherence-tick)
        # Test entry point: run one _run_adherence_pending pass and exit
        # without starting the daemon loop. Used by adherence.bats to cover
        # the mark-pending / run-one-review / requeue-on-fail behavior that
        # cmd_adherence_review alone (invoked directly) never exercises.
        # Usage: mother-runner --adherence-tick
        _run_adherence_pending
        exit 0
        ;;
    --attention-tick)
        # Test entry point: run one _maybe_refresh_attention pass and exit
        # without starting the daemon loop. Callers control whether the
        # interval gate fires via MOTHER_ATTENTION_INTERVAL (0 = always) /
        # the last-attention.ts marker. Used by attention.bats.
        # Usage: mother-runner --attention-tick
        _maybe_refresh_attention
        exit 0
        ;;
    --progress-tick)
        # Test entry point: run one _maybe_progress_tick pass and exit without
        # starting the daemon loop. Callers control whether the interval gate
        # fires via MOTHER_PROGRESS_INTERVAL (0 = always) / the
        # last-progress.ts marker. Used by progress.bats.
        # Usage: mother-runner --progress-tick
        _maybe_progress_tick
        exit 0
        ;;
    --notify-tick)
        # Test entry point: run one _notify_awaiting pass and exit without
        # starting the daemon loop. Callers control whether the scan gate
        # fires via MOTHER_NOTIFY_SCAN_INTERVAL (0 = always) / the
        # last-notify-scan.ts marker. Used by awaiting_notify.bats.
        # Usage: mother-runner --notify-tick
        _notify_awaiting
        exit 0
        ;;
    --prune-temps-tick)
        # Test entry point: run one _prune_temps_startup pass and exit
        # without starting the daemon loop. Used by temp_sweep.bats to cover
        # the runner's startup wiring (the hourly ride-along in
        # `mother archive` is covered separately, via cmd_archive directly).
        # Usage: mother-runner --prune-temps-tick
        _prune_temps_startup
        exit 0
        ;;
    --recover-stale-locks-tick)
        # Test entry point: run one _recover_stale_locks pass and exit
        # without starting the daemon loop. Used by adherence.bats to cover
        # the leaked-lockdir regression (a lockdir left behind by a killed
        # instance previously disabled all automatic adherence review
        # forever, since mkdir-based locks have no owner/TTL and nothing
        # else ever cleared them).
        # Usage: mother-runner --recover-stale-locks-tick
        _recover_stale_locks
        exit 0
        ;;
esac

main "$@"
