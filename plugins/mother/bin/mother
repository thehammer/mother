#!/usr/bin/env bash

# --- mother plugin path resolver (prepended during port) ---
# Resolves symlinks so the plugin works when installed via `ln -s` into a bin dir.
_MOTHER_RAW="${BASH_SOURCE[0]}"
while [ -L "$_MOTHER_RAW" ]; do
    _link="$(readlink "$_MOTHER_RAW")"
    case "$_link" in
        /*) _MOTHER_RAW="$_link" ;;
        *)  _MOTHER_RAW="$(dirname "$_MOTHER_RAW")/$_link" ;;
    esac
done
_MOTHER_SELF="$(cd "$(dirname "$_MOTHER_RAW")" && pwd -P)"
: "${MOTHER_BIN_DIR:=$_MOTHER_SELF}"
: "${MOTHER_LIB_DIR:=$_MOTHER_SELF/../lib}"
# -----------------------------------------------------------

# mother — background work for Claude Code.
#
# Usage:
#   mother add --plan-file <path> --repo <name> --branch <branch> [options]
#   mother list [--state ...] [--repo ...] [--format json|table]
#   mother status <id>
#   mother logs <id> [--follow]
#   mother peek <id> [--format json|text] [--tail N]
#   mother cancel <id>
#   mother retry <id>
#   mother await [<id>] --question "..."
#   mother resume <id> "<answer>" | --from-file <path> | -
#   mother events [--since-cursor <session-id>] [--since <iso-ts>]
#   mother drafts list|show <id>|rm <id>
#   mother run [--once]
#   mother help
#
# State lives under ${MOTHER_ROOT:-$HOME/.mother}/ (plain JSON files, gitignored).
# See docs/design.md for the design.

set -u

# Shared state constants and primitives (used by both this CLI and mother-runner).
# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/state.sh"

# Pipeline support libs (W1/W2). Guard each with [ -r ] to match the
# optional-source pattern used in mother-run-job.
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/request-types.sh" ] && source "$MOTHER_LIB_DIR/request-types.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/findings.sh" ]      && source "$MOTHER_LIB_DIR/findings.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/phase-prompt.sh" ]  && source "$MOTHER_LIB_DIR/phase-prompt.sh"

# ---------- CLI-only helpers ----------

_gen_id() {
    local ts rand
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    rand=$(od -vAn -N4 -tx1 /dev/urandom | tr -d ' \n')
    [[ "$rand" =~ ^[0-9a-f]{8}$ ]] || _die "internal: _gen_id produced invalid suffix"
    echo "${ts}-${rand}"
}

_die() { echo "mother: $*" >&2; exit 1; }

# ---------- plan metadata parsing ----------

# _validate_sc_entry <sc_json> <agent>
# Validates a single suggested_config entry for <agent>: rationale present
# and ≤ 200 chars; if skip:false, model and effort are present, valid, and
# satisfy the downgrade guardrail. Prints a diagnostic to stdout and returns 1
# on failure; returns 0 on success. Callers decide whether a missing entry is
# an error (required) or silent pass (optional) — this helper is only called
# when the entry is known to be present.
_validate_sc_entry() {
    local sc_json="$1" agent="$2"
    local valid_models="haiku sonnet opus"
    local valid_efforts="low medium high xhigh max"

    local entry
    entry=$(printf '%s\n' "$sc_json" | jq --arg a "$agent" '.[$a]')

    local skip_val
    skip_val=$(printf '%s\n' "$entry" | jq -r '.skip // false')

    local rationale
    rationale=$(printf '%s\n' "$entry" | jq -r '.rationale // empty')
    [ -n "$rationale" ] \
        || { echo "suggested_config.$agent.rationale is required and must be non-empty"; return 1; }
    [ "${#rationale}" -le 200 ] \
        || { echo "suggested_config.$agent.rationale must be ≤ 200 characters (got ${#rationale})"; return 1; }

    [ "$skip_val" = "true" ] && return 0

    local model effort
    model=$(printf '%s\n' "$entry" | jq -r '.model // empty')
    effort=$(printf '%s\n' "$entry" | jq -r '.effort // empty')

    [ -n "$model" ] || { echo "suggested_config.$agent.model is required (haiku|sonnet|opus)"; return 1; }
    [ -n "$effort" ] || { echo "suggested_config.$agent.effort is required (low|medium|high|xhigh|max)"; return 1; }

    local model_ok=0
    for m in $valid_models; do [ "$model" = "$m" ] && model_ok=1; done
    [ "$model_ok" -eq 1 ] \
        || { echo "suggested_config.$agent.model '$model' is invalid (must be one of: haiku sonnet opus)"; return 1; }

    local effort_ok=0
    for e in $valid_efforts; do [ "$effort" = "$e" ] && effort_ok=1; done
    [ "$effort_ok" -eq 1 ] \
        || { echo "suggested_config.$agent.effort '$effort' is invalid (must be one of: low medium high xhigh max)"; return 1; }

    # Downgrade guardrail: haiku or sonnet/low require "downgrade:" in rationale.
    local needs_guardrail=0
    [ "$model" = "haiku" ] && needs_guardrail=1
    [ "$model" = "sonnet" ] && [ "$effort" = "low" ] && needs_guardrail=1
    if [ "$needs_guardrail" -eq 1 ]; then
        case "$rationale" in
            *"downgrade:"*) ;;
            *) { echo "suggested_config.$agent: model=$model/effort=$effort is a downgrade below sonnet/medium; rationale must contain the literal string 'downgrade:' to make the justification explicit"; return 1; } ;;
        esac
    fi
    return 0
}

# _parse_suggested_config <plan_file>
# Extracts the ```yaml ... ``` block containing suggested_config from a plan
# file, validates its structure, and prints the JSON representation of the
# suggested_config object to stdout. Returns 0 on success, 1 with an error
# message (suitable for _die) on failure.
_parse_suggested_config() {
    local plan_file="$1"

    # Extract the first ```yaml ... ``` block that contains suggested_config.
    # Use python3 since it's universally available and handles edge cases.
    local yaml_block
    yaml_block=$(python3 - "$plan_file" <<'PYEOF'
import sys, re

plan_path = sys.argv[1]
with open(plan_path, "r", encoding="utf-8") as f:
    content = f.read()

# Find all ```yaml ... ``` blocks
blocks = re.findall(r'```yaml\n(.*?)```', content, re.DOTALL)
for block in blocks:
    if 'suggested_config' in block:
        print(block.strip())
        sys.exit(0)

print("ERROR: no suggested_config block found", file=sys.stderr)
sys.exit(1)
PYEOF
) 2>/dev/null || { echo "suggested_config block is missing from the plan (add a \`\`\`yaml suggested_config: ... \`\`\` block)"; return 1; }

    # Parse the YAML block into JSON.
    local raw_json
    raw_json=$(printf '%s\n' "$yaml_block" | python3 -c "
import yaml, json, sys
try:
    data = yaml.safe_load(sys.stdin)
    if data is None:
        print('ERROR: empty YAML block', file=sys.stderr)
        sys.exit(1)
    print(json.dumps(data))
except yaml.YAMLError as e:
    print(f'ERROR: YAML parse error: {e}', file=sys.stderr)
    sys.exit(1)
" 2>/dev/null) || { echo "suggested_config block contains invalid YAML"; return 1; }

    # Extract the suggested_config sub-object.
    local sc_json
    sc_json=$(printf '%s\n' "$raw_json" | jq '.suggested_config // empty' 2>/dev/null)
    [ -n "$sc_json" ] && [ "$sc_json" != "null" ] \
        || { echo "suggested_config key not found inside the YAML block"; return 1; }

    # Validate required and optional agent entries.
    local required_agents="cody redd marty perri"
    local optional_agents="ada archie"

    for agent in $required_agents; do
        local entry
        entry=$(printf '%s\n' "$sc_json" | jq --arg a "$agent" '.[$a] // empty')
        [ -n "$entry" ] && [ "$entry" != "null" ] \
            || { echo "suggested_config.$agent is missing (required: cody, redd, marty, perri)"; return 1; }
        local msg
        msg=$(_validate_sc_entry "$sc_json" "$agent") || { echo "$msg"; return 1; }
    done

    # Optional reviewer entries (ada, archie) must be well-formed when present.
    for agent in $optional_agents; do
        local entry
        entry=$(printf '%s\n' "$sc_json" | jq --arg a "$agent" '.[$a] // empty')
        [ -n "$entry" ] && [ "$entry" != "null" ] || continue  # absent = OK
        local msg
        msg=$(_validate_sc_entry "$sc_json" "$agent") || { echo "$msg"; return 1; }
    done

    printf '%s\n' "$sc_json"
}

# _parse_no_pr <plan_file>
# Returns "true" if the plan's YAML block contains `no_pr: true`, else "false".
# The flag opts the job out of the `no_pr_no_push` failure check, for plans
# that explicitly instruct the worker not to push or open a PR.
_parse_no_pr() {
    local plan_file="$1"
    python3 - "$plan_file" <<'PYEOF' 2>/dev/null || echo "false"
import sys, re
try:
    import yaml
except ImportError:
    print("false"); sys.exit(0)

with open(sys.argv[1], "r", encoding="utf-8") as f:
    content = f.read()

blocks = re.findall(r'```yaml\n(.*?)```', content, re.DOTALL)
for block in blocks:
    if 'suggested_config' in block:
        data = yaml.safe_load(block.strip()) or {}
        print("true" if data.get("no_pr", False) is True else "false")
        sys.exit(0)
print("false")
PYEOF
}

# _extract_plan_summary <plan_file>
# Extracts a short prose summary from the plan markdown. Returns the first
# paragraph of a ## Summary section if present, otherwise the first non-heading,
# non-list, non-code-fence, non-blockquote paragraph in the document.
# The result is normalised to single-spaced prose and capped at 500 characters
# on a word boundary with a trailing ellipsis. Prints an empty string (and exits
# 0) when nothing usable is found or the file cannot be parsed.
_extract_plan_summary() {
    local plan_file="$1"
    python3 - "$plan_file" <<'PYEOF' 2>/dev/null || true
import sys, re

try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        content = f.read()
except Exception:
    print(""); sys.exit(0)

lines = content.splitlines()

def first_paragraph(block_lines):
    """Return the first non-empty paragraph (consecutive non-blank lines) from
    a list of lines, joined with a single space. Returns '' if none found."""
    paragraph = []
    for ln in block_lines:
        stripped = ln.strip()
        if stripped:
            paragraph.append(stripped)
        elif paragraph:
            break
    return " ".join(paragraph)

def normalise(text):
    """Collapse whitespace to single spaces and strip."""
    return re.sub(r'\s+', ' ', text).strip()

def cap(text, limit=500):
    """Cap at limit chars on a word boundary, appending '...' if truncated."""
    if len(text) <= limit:
        return text
    # Find last space within limit - 3 chars (room for ellipsis)
    window = text[:limit - 3]
    cut = window.rfind(' ')
    if cut <= 0:
        # No space found; hard-cut
        return text[:limit - 3] + '...'
    return window[:cut] + '...'

# Rule 1: look for a Summary heading (any level, case-insensitive).
summary_idx = None
for i, ln in enumerate(lines):
    if re.match(r'^#{1,6}\s+Summary\s*$', ln, re.IGNORECASE):
        summary_idx = i
        break

if summary_idx is not None:
    # Collect lines after the heading up to the next heading or EOF.
    body = []
    for ln in lines[summary_idx + 1:]:
        if re.match(r'^#{1,6}\s', ln):
            break
        body.append(ln)
    result = first_paragraph(body)
    if result:
        print(cap(normalise(result))); sys.exit(0)

# Rule 2: fallback — find the first suitable prose paragraph in the whole doc.
in_fence = False
paragraph = []
for ln in lines:
    # Track fenced code blocks.
    if re.match(r'^```', ln):
        in_fence = not in_fence
        if paragraph:
            break
        continue
    if in_fence:
        if paragraph:
            break
        continue
    stripped = ln.strip()
    if not stripped:
        if paragraph:
            break
        continue
    # Skip headings, list items, blockquotes.
    if re.match(r'^#{1,6}\s', stripped):
        continue
    if re.match(r'^\s*[-*+]\s', stripped) or re.match(r'^\s*\d+\.\s', stripped):
        continue
    if re.match(r'^\s*>', stripped):
        continue
    paragraph.append(stripped)

if paragraph:
    result = " ".join(paragraph)
    print(cap(normalise(result))); sys.exit(0)

print(""); sys.exit(0)
PYEOF
}

# _parse_pipeline_config <plan_file>
# Returns the pipeline: object from the plan's YAML block as JSON.
# Returns "null" (literal string) if the pipeline: key is absent.
# The caller decides whether pipeline.enabled is true.
_parse_pipeline_config() {
    local plan_file="$1"
    python3 - "$plan_file" <<'PYEOF' 2>/dev/null || echo "null"
import sys, re, json
try:
    import yaml
except ImportError:
    print("null"); sys.exit(0)

with open(sys.argv[1], "r", encoding="utf-8") as f:
    content = f.read()

blocks = re.findall(r'```yaml\n(.*?)```', content, re.DOTALL)
for block in blocks:
    if 'suggested_config' in block:
        data = yaml.safe_load(block.strip()) or {}
        pipeline = data.get("pipeline")
        if pipeline is None:
            print("null")
        else:
            print(json.dumps(pipeline))
        sys.exit(0)
print("null")
PYEOF
}

# ---------- tier ladder ----------

# Tier definitions (sourced by both mother and mother-run-job via lib/state.sh
# additions, but also defined here for CLI use).
# Ladder: tier_0 < tier_1 < tier_2 < tier_3
# Each tier: "model/effort"
TIER_LADDER="tier_0 tier_1 tier_2 tier_3"

_tier_model() {
    case "$1" in
        tier_0) echo "sonnet" ;;
        tier_1) echo "sonnet" ;;
        tier_2) echo "sonnet" ;;
        tier_3) echo "opus"   ;;
        *)      echo "sonnet" ;;
    esac
}

_tier_effort() {
    case "$1" in
        tier_0) echo "medium" ;;
        tier_1) echo "high"   ;;
        tier_2) echo "xhigh"  ;;
        tier_3) echo "high"   ;;
        *)      echo "medium" ;;
    esac
}

_tier_next() {
    case "$1" in
        tier_0) echo "tier_1" ;;
        tier_1) echo "tier_2" ;;
        tier_2) echo "tier_3" ;;
        tier_3) echo ""        ;;  # at cap
        *)      echo "tier_1" ;;
    esac
}

_tier_num() {
    case "$1" in
        tier_0) echo 0 ;;
        tier_1) echo 1 ;;
        tier_2) echo 2 ;;
        tier_3) echo 3 ;;
        *)      echo 0 ;;
    esac
}

# ---------- add ----------

cmd_add() {
    local plan_file="" repo="" repo_path="" branch="" base_ref="origin/main"
    local isolation="worktree" executor="local-tmux" max_cost="" depends_on=""
    local format="text" title=""
    local origin_label="" origin_project_override="" origin_session=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --plan-file)        plan_file="$2"; shift 2 ;;
            --repo)             repo="$2"; shift 2 ;;
            --repo-path)        repo_path="$2"; shift 2 ;;
            --branch)           branch="$2"; shift 2 ;;
            --base)             base_ref="$2"; shift 2 ;;
            --isolation)        isolation="$2"; shift 2 ;;
            --executor)         executor="$2"; shift 2 ;;
            --max-cost)         max_cost="$2"; shift 2 ;;
            --depends-on)       depends_on="$2"; shift 2 ;;
            --title)            title="$2"; shift 2 ;;
            --format)           format="$2"; shift 2 ;;
            --label)            origin_label="$2"; shift 2 ;;
            --origin-project)   origin_project_override="$2"; shift 2 ;;
            --origin-session)   origin_session="$2"; shift 2 ;;
            *) _die "unknown flag for add: $1" ;;
        esac
    done

    [ -n "$plan_file" ] || _die "add: --plan-file required"
    [ -f "$plan_file" ] || _die "add: plan file not found: $plan_file"
    [ -n "$repo" ]      || _die "add: --repo required"
    [ -n "$branch" ]    || _die "add: --branch required"

    case "$isolation" in worktree|main-dir) ;; *) _die "isolation must be worktree or main-dir" ;; esac
    case "$executor"  in local-tmux)        ;; *) _die "executor must be local-tmux (for now)" ;; esac

    [ -z "$repo_path" ] && repo_path="$HOME/Code/$repo"
    [ -d "$repo_path/.git" ] || _die "add: repo path is not a git repo: $repo_path"

    [ -z "$title" ] && title=$(head -1 "$plan_file" | sed -E 's/^#+ *//;s/^[[:space:]]+//;s/[[:space:]]+$//')
    [ -z "$title" ] && title="(untitled)"

    # Parse and validate the suggested_config block from the plan.
    local suggested_config_json
    suggested_config_json=$(_parse_suggested_config "$plan_file") \
        || _die "add: $suggested_config_json"

    # Parse the no_pr flag (opt-out of the no_pr_no_push failure check).
    local no_pr_flag
    no_pr_flag=$(_parse_no_pr "$plan_file")

    # Parse the pipeline config (optional; absent -> non-pipeline job).
    local pipeline_config_json is_pipeline
    pipeline_config_json=$(_parse_pipeline_config "$plan_file")
    is_pipeline=0
    if [ "$pipeline_config_json" != "null" ] && [ -n "$pipeline_config_json" ]; then
        local pipeline_enabled
        pipeline_enabled=$(printf '%s' "$pipeline_config_json" | jq -r '.enabled // false')
        [ "$pipeline_enabled" = "true" ] && is_pipeline=1
    fi

    local cost_model
    cost_model=$(_resolve_cost_model)

    # Compute origin for job provenance.
    local origin_cwd origin_project enqueued_by _gitroot
    origin_cwd="$PWD"
    if [ -n "$origin_project_override" ]; then
        origin_project="$origin_project_override"
    else
        _gitroot=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) || _gitroot=""
        if [ -n "$_gitroot" ]; then
            origin_project=$(basename "$_gitroot")
        else
            origin_project=""
        fi
    fi
    [ -z "$origin_session" ] && origin_session="${MOTHER_ORIGIN_SESSION:-}"
    enqueued_by=$(whoami)

    local id deps_json job_json max_cost_json
    id=$(_gen_id)
    if [ -n "$depends_on" ]; then
        deps_json=$(printf '%s' "$depends_on" | jq -Rc 'split(",") | map(select(length > 0))')
    else
        deps_json='[]'
    fi
    max_cost_json=$([ -n "$max_cost" ] && echo "$max_cost" || echo "null")

    cp "$plan_file" "$(_plan_path "$id")"

    local no_pr_json
    [ "$no_pr_flag" = "true" ] && no_pr_json="true" || no_pr_json="false"

    local plan_summary
    plan_summary=$(_extract_plan_summary "$plan_file" 2>/dev/null || true)

    job_json=$(jq -n \
        --arg id "$id" \
        --arg title "$title" \
        --arg repo "$repo" \
        --arg repo_path "$repo_path" \
        --arg branch "$branch" \
        --arg base_ref "$base_ref" \
        --arg isolation "$isolation" \
        --arg executor "$executor" \
        --argjson deps "$deps_json" \
        --argjson max_cost "$max_cost_json" \
        --arg plan_path "$(_plan_path "$id")" \
        --arg log_path "$(_log_path "$id")" \
        --arg plan_summary "$plan_summary" \
        --arg created_at "$(_iso_now)" \
        --argjson suggested_config "$suggested_config_json" \
        --argjson no_pr "$no_pr_json" \
        --arg cost_model "$cost_model" \
        --arg origin_cwd "$origin_cwd" \
        --arg origin_project "$origin_project" \
        --arg origin_session "$origin_session" \
        --arg enqueued_by "$enqueued_by" \
        --arg origin_label "$origin_label" \
        '{
            id: $id, title: $title, repo: $repo, repo_path: $repo_path,
            branch: $branch, base_ref: $base_ref, isolation: $isolation,
            executor: $executor, depends_on: $deps, max_cost_usd: $max_cost,
            plan_path: $plan_path, log_path: $log_path,
            plan_summary: $plan_summary,
            state: "queued", created_at: $created_at,
            origin: {project: $origin_project, cwd: $origin_cwd, session: $origin_session, enqueued_by: $enqueued_by, label: $origin_label},
            started_at: null, finished_at: null,
            pr_url: null, tmux_window: null, worker_pid: null, actual_cost_usd: null,
            suggested_config: $suggested_config,
            no_pr: $no_pr,
            cost_model: $cost_model,
            current_tier: "tier_0",
            escalation_count: 0,
            adherence_attempts: 0
        }')
    # For pipeline jobs, merge the pipeline object onto the base job JSON.
    # Non-pipeline plans get today's exact shape (no kind, no pipeline key).
    if [ "$is_pipeline" -eq 1 ]; then
        job_json=$(printf '%s' "$job_json" | jq \
            --argjson pc "$pipeline_config_json" \
            '. + {
                kind: "pipeline",
                pipeline: {
                    phase: "redd",
                    review_cycle: 0,
                    cycle_cap: ($pc.cycle_cap // 3),
                    reviewers: ($pc.reviewers // []),
                    findings: [],
                    findings_history: []
                }
            }')
    fi

    _atomic_write "$(_job_path "$id")" "$job_json"
    _append_event "$id" "queued" "$(jq -nc --arg title "$title" '{title: $title}')"

    if [ "$format" = "json" ]; then
        jq -n --arg id "$id" '{id: $id}'
    else
        echo "$id"
    fi
}

# ---------- list ----------

cmd_list() {
    local state_filter="" repo_filter="" format="table" proj_filter="" label_filter=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --state)   state_filter="$2"; shift 2 ;;
            --repo)    repo_filter="$2"; shift 2 ;;
            --format)  format="$2"; shift 2 ;;
            --project) proj_filter="$2"; shift 2 ;;
            --label)   label_filter="$2"; shift 2 ;;
            *) _die "unknown flag for list: $1" ;;
        esac
    done

    local rows
    rows=$(find "$JOBS_DIR" -maxdepth 1 -name '*.json' -type f 2>/dev/null | sort | while read -r f; do
        jq -c '.' "$f"
    done | jq -cs --arg st "$state_filter" --arg repo "$repo_filter" --arg proj "$proj_filter" --arg label "$label_filter" '
        map(select(
            (($st | length == 0) or (.state == $st))
            and (($repo | length == 0) or (.repo == $repo))
            and (($proj | length == 0) or ((.origin.project // "") == $proj))
            and (($label | length == 0) or ((.origin.label // "") == $label))
        ))
        | sort_by(.created_at)
    ')

    if [ "$format" = "json" ]; then
        # For pipeline jobs, attach the derived `cycles` array; standard jobs
        # pass through byte-identical so clients that don't expect `cycles` are
        # unaffected (back-compat AC).
        echo "$rows" | jq -c '.[]' | while IFS= read -r job_json; do
            local kind job_id
            kind=$(printf '%s' "$job_json" | jq -r '.kind // ""' 2>/dev/null) || kind=""
            if [ "${kind:-}" = "pipeline" ]; then
                job_id=$(printf '%s' "$job_json" | jq -r '.id' 2>/dev/null) || job_id=""
                local cycles
                cycles=$(_pipeline_cycles_json "$(_job_path "${job_id:-}")" 2>/dev/null) || cycles=""
                if [ -n "${cycles:-}" ]; then
                    printf '%s' "$job_json" | jq -c --argjson cycles "$cycles" '. + {cycles: $cycles}'
                else
                    printf '%s\n' "$job_json"
                fi
            else
                printf '%s\n' "$job_json"
            fi
        done | jq -cs '.'
    else
        local count
        count=$(echo "$rows" | jq 'length')
        if [ "$count" = "0" ]; then
            echo "(no jobs)"
            return 0
        fi
        printf "%-28s  %-16s  %-18s  %-12s  %-16s  %s\n" "ID" "STATE" "REPO" "ISOLATION" "ORIGIN" "TITLE"
        echo "$rows" | jq -r '.[] |
            [
                .id,
                .state,
                (.activity // ""),
                (.current_tier // ""),
                .repo,
                .isolation,
                ((.origin // {}) | if (.project != null and .project != "") then .project elif (.label != null and .label != "") then .label else "-" end),
                .title,
                (.kind // "")
            ] | @tsv' | \
            while IFS=$'\t' read -r id st activity current_tier repo iso origin title kind; do
                # Compose the state display field with markers.
                local state_display="$st"
                if [ "${kind:-}" = "pipeline" ]; then
                    # Pipeline jobs: replace the activity bracket with a pipeline-aware label.
                    local pl_label
                    pl_label=$(_pipeline_list_label "$(_job_path "$id")" 2>/dev/null) || pl_label=""
                    [ -n "${pl_label:-}" ] && state_display="$st [$pl_label]"
                else
                    [ -n "$activity" ] && state_display="$st [$activity]"
                fi
                case "$current_tier" in
                    tier_1) state_display="$state_display tier:1" ;;
                    tier_2) state_display="$state_display tier:2" ;;
                    tier_3) state_display="$state_display tier:3" ;;
                esac
                printf "%-28s  %-16s  %-18s  %-12s  %-16s  %s\n" "$id" "$state_display" "$repo" "$iso" "$origin" "$title"
            done
    fi
}

# ---------- status ----------

cmd_status() {
    local id="${1:-}" format="text"
    [ -n "$id" ] || _die "status: <id> required"
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --format) format="$2"; shift 2 ;;
            *) _die "unknown flag for status: $1" ;;
        esac
    done
    _job_exists "$id" || _die "no such job: $id"

    if [ "$format" = "json" ]; then
        # For pipeline jobs, attach the derived cycles array to the job object.
        local job_file; job_file=$(_job_path "$id")
        local kind; kind=$(jq -r '.kind // ""' "$job_file" 2>/dev/null) || kind=""
        if [ "${kind:-}" = "pipeline" ]; then
            local cycles
            cycles=$(_pipeline_cycles_json "$job_file" 2>/dev/null) || cycles=""
            if [ -n "${cycles:-}" ]; then
                jq -s --argjson cycles "$cycles" \
                    '{job: (.[0] + {cycles: $cycles}), events: .[1]}' \
                    "$job_file" \
                    <(jq -cs '.' "$(_events_path "$id")" 2>/dev/null || echo '[]')
            else
                jq -s '{job: .[0], events: .[1]}' \
                    "$job_file" \
                    <(jq -cs '.' "$(_events_path "$id")" 2>/dev/null || echo '[]')
            fi
        else
            jq -s '{job: .[0], events: .[1]}' \
                "$job_file" \
                <(jq -cs '.' "$(_events_path "$id")" 2>/dev/null || echo '[]')
        fi
    else
        local job_file; job_file=$(_job_path "$id")
        local activity; activity=$(jq -r '.activity // empty' "$job_file")
        local current_tier; current_tier=$(jq -r '.current_tier // "tier_0"' "$job_file")
        local esc_count; esc_count=$(jq -r '.escalation_count // 0' "$job_file")
        local kind; kind=$(jq -r '.kind // ""' "$job_file" 2>/dev/null) || kind=""

        if [ "$activity" = "adherence_blocked" ]; then
            echo ""
            echo "⚠️  [ADHERENCE-BLOCKED] This job requires human review."
            echo "   Archie reviewed the PR diff twice and flagged adherence issues."
            echo "   Run: mother resume $id \"<your instructions>\""
            echo "   Or:  mother cancel $id  (to abandon the PR)"
            echo "   See .adherence_notes on the job JSON for Archie's findings."
            echo ""
        fi
        if [ "$activity" = "pipeline_blocked" ]; then
            echo ""
            echo "⚠️  [PIPELINE-BLOCKED] This job requires human review."
            echo "   The pipeline review found issues it could not resolve automatically."
            echo "   Outstanding findings:"
            jq -r '.pipeline.findings // [] | .[] |
                "     - [\(.severity)] \(.summary)\(if .location then " (" + .location + ")" else "" end)"' \
                "$job_file"
            echo "   Options:"
            echo "     mother resume $id \"<guidance>\"   — resume with instructions for the agents"
            echo "     mother resume $id \"SHIP\"          — force ship despite findings"
            echo "     mother cancel $id                   — abandon the job"
            echo ""
        fi
        if [ "$current_tier" != "tier_0" ] && [ -n "$current_tier" ]; then
            local model; model=$(_tier_model "$current_tier")
            local effort; effort=$(_tier_effort "$current_tier")
            echo "  Tier: $current_tier (model=$model, effort=$effort, escalations=$esc_count)"
            echo ""
        fi
        local plan_summary
        plan_summary=$(jq -r '.plan_summary // ""' "$job_file")
        if [ -n "$plan_summary" ]; then
            echo "Summary: $plan_summary"
            echo ""
        fi

        # Pipeline section — only for pipeline jobs.
        if [ "${kind:-}" = "pipeline" ]; then
            local pl_phase pl_cycle pl_cap pl_reviewers
            pl_phase=$(jq -r '.pipeline.phase // "unknown"' "$job_file")
            pl_cycle=$(jq -r '.pipeline.review_cycle // 0' "$job_file")
            pl_cap=$(jq -r '.pipeline.cycle_cap // 3' "$job_file")
            pl_reviewers=$(jq -r '(.pipeline.reviewers // []) | join(", ")' "$job_file")

            echo "=== pipeline ==="
            case "${pl_phase:-}" in
                done)    echo "  Phase:     done (shipped)" ;;
                blocked) echo "  Phase:     blocked (cycle ${pl_cycle}/${pl_cap})" ;;
                review)  echo "  Phase:     review (cycle ${pl_cycle}/${pl_cap})" ;;
                *)       echo "  Phase:     ${pl_phase:-unknown} (cycle ${pl_cycle}/${pl_cap})" ;;
            esac
            echo "  Reviewers: ${pl_reviewers:-none}"
            echo ""

            # Per-phase status table from derived cycles.
            local cycles_json
            cycles_json=$(_pipeline_cycles_json "$job_file" 2>/dev/null) || cycles_json="[]"
            if [ -n "${cycles_json:-}" ] && [ "${cycles_json:-[]}" != "[]" ]; then
                local cur_cycle_num
                cur_cycle_num=$(printf '%s' "$cycles_json" | jq -r 'last.cycle // 0')
                echo "  Phase status (cycle ${cur_cycle_num}):"
                printf '%s' "$cycles_json" | jq -r '
                    last | .phases[] |
                    [.agent, .state,
                     (.started_at // ""),
                     (.finished_at // ""),
                     ((.findings // 0) | tostring)] | @tsv
                ' | while IFS=$'\t' read -r agent state t0 t1 fc; do
                    printf "    %-10s  %-12s" "$agent" "$state"
                    [ -n "$t0" ] && printf "  started: %s" "${t0:0:19}"
                    [ -n "$t1" ] && printf "  finished: %s" "${t1:0:19}"
                    if [ "${fc:-0}" != "0" ] && [ -n "$fc" ]; then
                        printf "  (%s findings)" "$fc"
                    fi
                    printf "\n"
                done
                echo ""
            fi

            # Findings per reviewer.
            local rev_summary
            rev_summary=$(jq -r '
                .pipeline.reviewer_findings // {} |
                to_entries |
                if length == 0 then "(none)"
                else map("\(.key): \(.value | length)") | join(", ")
                end
            ' "$job_file")
            echo "  Findings per reviewer: ${rev_summary}"
            echo ""

            # Advisory findings (distinct from agent-actionable findings).
            local adv_count
            adv_count=$(jq -r '.pipeline.advisories // [] | length' "$job_file")
            if [ "${adv_count:-0}" -gt 0 ]; then
                echo "  Advisory findings:"
                jq -r '.pipeline.advisories // [] | .[] |
                    "    [advisory] \(.summary)\(if .reviewer then " (" + .reviewer + ")" else "" end)"' \
                    "$job_file"
            else
                echo "  Advisory findings: (none)"
            fi
            echo ""

            # Review cycle history (prior cycles from findings_history).
            local hist_count
            hist_count=$(jq -r '.pipeline.findings_history // [] | length' "$job_file")
            if [ "${hist_count:-0}" -gt 0 ]; then
                echo "  Review cycle history:"
                jq -r '.pipeline.findings_history // [] | .[] |
                    "    cycle \(.cycle + 1): \(.findings | length) finding(s)"' \
                    "$job_file"
            else
                echo "  Review cycle history: (none)"
            fi
            echo ""
        fi

        echo "=== job ==="
        jq . "$job_file"
        echo
        echo "=== events ==="
        if [ -f "$(_events_path "$id")" ]; then
            jq -c . "$(_events_path "$id")"
        else
            echo "(no events)"
        fi
    fi
}

# ---------- logs ----------

cmd_logs() {
    local id="${1:-}" follow=0 raw=0
    [ -n "$id" ] || _die "logs: <id> required"
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --follow|-f) follow=1; shift ;;
            --raw)       raw=1; shift ;;   # skip the pretty-printer
            *) _die "unknown flag for logs: $1" ;;
        esac
    done
    local lp; lp=$(_log_path "$id")
    [ -f "$lp" ] || _die "no log yet for $id"

    # Resolve the pretty-printer. If missing (older install, broken symlink),
    # fall back to raw output and note it.
    local pretty="$MOTHER_BIN_DIR/mother-stream-pretty"
    [ -x "$pretty" ] || raw=1

    if [ "$follow" -eq 1 ]; then
        # Banner so the user knows how to exit the tail. ANSI-dim so it reads
        # as chrome, not content. Written to stderr so piping the log doesn't
        # pick up the banner.
        {
            printf '\033[2m'
            printf '────────────────────────────────────────────────────────────\n'
            printf '  mother logs — following %s\n' "$id"
            printf '  press Ctrl-C to stop following and return\n'
            printf '────────────────────────────────────────────────────────────\n'
            printf '\033[0m'
        } >&2
        if [ "$raw" -eq 1 ]; then
            tail -f "$lp"
        else
            tail -f "$lp" | "$pretty"
        fi
    else
        if [ "$raw" -eq 1 ]; then
            cat "$lp"
        else
            "$pretty" < "$lp"
        fi
    fi
}

# ---------- peek ----------
#
# Show a live snapshot of what the worker is doing right now by parsing
# Claude's per-session transcript file. Works for running and completed
# jobs alike; for completed jobs it's a retrospective summary. With --watch,
# re-renders the snapshot every ~3s (useful as an fzf preview). See the
# "Queue Worker Live Visibility" draft for the design rationale.

cmd_peek() {
    local id="${1:-}" format="text" tail_count=8 watch=0
    [ -n "$id" ] || _die "peek: <id> required"
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --format) format="$2"; shift 2 ;;
            --tail)   tail_count="$2"; shift 2 ;;
            --watch)  watch=1; shift ;;
            *) _die "unknown flag for peek: $1" ;;
        esac
    done
    _job_exists "$id" || _die "no such job: $id"

    local job_json work_dir state title
    job_json=$(_job_path "$id")
    work_dir=$(jq -r '.work_dir // empty' "$job_json")
    # Fall back to deriving from repo_path/branch/isolation if work_dir
    # wasn't recorded (older records didn't capture it explicitly). main-dir
    # jobs run in the shared checkout, so the work_dir is just repo_path —
    # the worktree-style "${repo_path}-${branch}" path is wrong for them.
    if [ -z "$work_dir" ]; then
        local repo_path branch isolation
        repo_path=$(jq -r '.repo_path // empty' "$job_json")
        branch=$(jq -r '.branch // empty' "$job_json")
        isolation=$(jq -r '.isolation // empty' "$job_json")
        if [ "$isolation" = "main-dir" ] && [ -n "$repo_path" ]; then
            work_dir="$repo_path"
        elif [ -n "$repo_path" ] && [ -n "$branch" ]; then
            work_dir="${repo_path}-$(echo "$branch" | tr '/' '-')"
        fi
    fi
    state=$(jq -r '.state // "?"' "$job_json")
    title=$(jq -r '.title // ""' "$job_json")
    # Surface the operator-relevant fields for awaiting jobs so the popup's
    # peek pane shows the question without a separate `mother status` call.
    local question paused_at
    question=$(jq -r '.question // ""' "$job_json")
    paused_at=$(jq -r '.paused_at // ""' "$job_json")

    [ -n "$work_dir" ] || _die "peek: could not resolve work_dir for $id"

    # Claude slugs a worktree path by replacing '/' AND '.' with '-'
    # (so /Users/x/.foo becomes -Users-x--foo, double-dash at the boundary).
    local slug="${work_dir//\//-}"
    slug="${slug//./-}"
    local project_dir="$HOME/.claude/projects/$slug"
    if [ ! -d "$project_dir" ]; then
        _die "peek: no Claude project dir at $project_dir (worker may not have started yet)"
    fi

    # Prefer the explicit session_id recorded on the job — this is the only
    # way to reliably pick the right transcript when multiple workers (or a
    # user's foreground Claude session) share the same project dir (typical
    # for --isolation main-dir). Legacy jobs without session_id fall back to
    # newest-mtime, which is the best we can do for them.
    local transcript session_id
    session_id=$(jq -r '.session_id // empty' "$job_json")
    if [ -n "$session_id" ]; then
        transcript="$project_dir/$session_id.jsonl"
        [ -f "$transcript" ] \
            || _die "peek: no transcript at $transcript (worker may not have started yet)"
    else
        transcript=$(find "$project_dir" -maxdepth 1 -name '*.jsonl' -print0 2>/dev/null \
            | xargs -0 ls -t 2>/dev/null | head -1)
        [ -n "$transcript" ] && [ -f "$transcript" ] \
            || _die "peek: no transcript file in $project_dir"
    fi

    _peek_render() {
        PEEK_ID="$id" PEEK_STATE="$state" PEEK_TITLE="$title" \
        PEEK_WORK_DIR="$work_dir" PEEK_TRANSCRIPT="$transcript" \
        PEEK_FORMAT="$format" PEEK_TAIL="$tail_count" \
        PEEK_QUESTION="$question" PEEK_PAUSED_AT="$paused_at" \
            python3 - <<'PYEOF'
import json, os, sys, time
from collections import Counter

job_id     = os.environ["PEEK_ID"]
state      = os.environ["PEEK_STATE"]
title      = os.environ["PEEK_TITLE"]
work_dir   = os.environ["PEEK_WORK_DIR"]
path       = os.environ["PEEK_TRANSCRIPT"]
fmt        = os.environ.get("PEEK_FORMAT", "text")
tail_n     = int(os.environ.get("PEEK_TAIL", "8"))
question   = os.environ.get("PEEK_QUESTION", "")
paused_at  = os.environ.get("PEEK_PAUSED_AT", "")

size_bytes = os.path.getsize(path)
mtime      = os.path.getmtime(path)
age_s      = max(0, int(time.time() - mtime))

def fmt_size(n):
    if n < 1024: return f"{n}B"
    if n < 1024*1024: return f"{n/1024:.1f}KB"
    return f"{n/1024/1024:.1f}MB"

def fmt_age(s):
    if s < 60: return f"{s}s ago"
    if s < 3600: return f"{s//60}m{s%60:02d}s ago"
    h, rem = divmod(s, 3600)
    return f"{h}h{rem//60:02d}m ago"

tool_counts = Counter()
todos       = None
tool_trail  = []   # rolling list of (tool_name, preview) — keep last tail_n
last_text   = ""

def brief(tool, inp):
    if not isinstance(inp, dict):
        return ""
    for k in ("file_path", "path", "pattern", "command", "description"):
        if k in inp and inp[k]:
            v = str(inp[k])
            # Collapse newlines, trim.
            v = v.replace("\n", " ⏎ ")
            return v[:110]
    return ""

try:
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            if d.get("type") != "assistant":
                continue
            msg = d.get("message", {})
            for c in msg.get("content", []):
                ctype = c.get("type")
                if ctype == "tool_use":
                    name = c.get("name", "?")
                    tool_counts[name] += 1
                    tool_trail.append((name, brief(name, c.get("input", {}))))
                    if len(tool_trail) > tail_n:
                        tool_trail = tool_trail[-tail_n:]
                    if name == "TodoWrite":
                        todos = c.get("input", {}).get("todos", [])
                elif ctype == "text":
                    t = c.get("text", "").strip()
                    if t:
                        last_text = t
except FileNotFoundError:
    print(f"peek: transcript disappeared at {path}", file=sys.stderr)
    sys.exit(1)

if fmt == "json":
    out = {
        "id":          job_id,
        "state":       state,
        "title":       title,
        "work_dir":    work_dir,
        "transcript":  path,
        "transcript_bytes": size_bytes,
        "transcript_age_seconds": age_s,
        "tool_counts": dict(tool_counts),
        "todos":       todos or [],
        "tool_trail":  [{"tool": n, "brief": b} for n, b in tool_trail],
        "last_text":   last_text,
        "question":    question or None,
        "paused_at":   paused_at or None,
    }
    print(json.dumps(out, indent=2))
else:
    print(f"=== {job_id} ===")
    if title:
        print(f"Title:       {title}")
    print(f"State:       {state}")
    print(f"Work dir:    {work_dir}")
    print(f"Transcript:  {path}")
    print(f"             {fmt_size(size_bytes)}, updated {fmt_age(age_s)}")
    print()
    # Awaiting jobs need the question front-and-center — that's the whole
    # reason the operator opened the popup.
    if state == "awaiting" and question:
        print("┌─ AWAITING INPUT ──────────────────────────────────────────")
        for line in question.splitlines() or [""]:
            print(f"│  {line}")
        if paused_at:
            print(f"│  (paused at {paused_at})")
        print("└───────────────────────────────────────────────────────────")
        print(f"Answer with:  mother resume {job_id} \"<your answer>\"")
        print()
    if todos:
        print("Todos:")
        icons = {"pending": "○", "in_progress": "▶", "completed": "✓", "cancelled": "✗"}
        for t in todos:
            icon = icons.get(t.get("status"), "?")
            content = t.get("content", "")
            print(f"  {icon} {content}")
        print()
    if tool_counts:
        top = ", ".join(f"{n}: {c}" for n, c in tool_counts.most_common(8))
        print(f"Tool counts: {top}")
        print()
    if tool_trail:
        print(f"Recent tool calls (oldest → newest, last {len(tool_trail)}):")
        for n, b in tool_trail:
            label = f"[{n}]".ljust(14)
            print(f"  {label}{b}")
        print()
    if last_text:
        # Truncate very long last-text blocks so the peek stays glanceable.
        snippet = last_text if len(last_text) <= 500 else last_text[:497] + "..."
        print("Latest assistant text:")
        for line in snippet.splitlines():
            print(f"  {line}")
PYEOF
    }

    if [ "$watch" -eq 1 ]; then
        # Stop cleanly if the parent (fzf preview) tears down the process.
        trap 'exit 0' INT TERM
        while :; do
            clear
            _peek_render
            sleep 3
        done
    else
        _peek_render
    fi
}

# ---------- attach ----------

# Opens a new tmux window that tails the job's log. Must be run from inside a
# tmux session (otherwise there's nothing to spawn a window in). This is the
# opt-in replacement for the old per-job tmux window: workers now run
# headless, and attach is how you watch them live.
cmd_attach() {
    local id="${1:-}"
    [ -n "$id" ] || _die "attach: <id> required"
    _job_exists "$id" || _die "no such job: $id"
    command -v tmux >/dev/null 2>&1 || _die "attach: tmux not available"
    [ -n "${TMUX:-}" ] || _die "attach: must be run inside a tmux session"
    local lp; lp=$(_log_path "$id")
    [ -f "$lp" ] || _die "no log yet for $id"
    local short="${id: -8}"
    tmux new-window -n "q-attach:$short" "tail -f '$lp'"
}

# ---------- plan ----------

# Show the plan file for a job. Pages via less when stdout is a tty so long
# plans are navigable; cats otherwise so piping/grep keeps working. Bound to
# ctrl-p in the switcher.
cmd_plan() {
    local id="${1:-}"
    [ -n "$id" ] || _die "plan: <id> required"
    _job_exists "$id" || _die "no such job: $id"
    local plan_file; plan_file=$(_plan_path "$id")
    [ -f "$plan_file" ] || _die "no plan file for $id"
    if [ -t 1 ]; then
        ${PAGER:-less} "$plan_file"
    else
        cat "$plan_file"
    fi
}

# ---------- cancel ----------

cmd_cancel() {
    local id="${1:-}"
    [ -n "$id" ] || _die "cancel: <id> required"
    _job_exists "$id" || _die "no such job: $id"
    local state; state=$(jq -r .state "$(_job_path "$id")")
    case "$state" in
        queued|ready)   _job_transition "$id" cancelled '{"reason":"user"}' ;;
        awaiting)       # No live worker to signal — the job paused itself and
                        # the worker process already exited. Transition direct
                        # to cancelled so it leaves the queue immediately.
                        _job_transition "$id" cancelled '{"reason":"user_cancelled_awaiting"}' ;;
        running)        # Leave a cancel request; runner picks it up
                        _job_update "$id" '.cancel_requested = true'
                        _append_event "$id" "cancel_requested" '{}'
                        echo "cancel requested; runner will stop on next tick"
                        ;;
        *) _die "cannot cancel job in state: $state" ;;
    esac
    echo "$id: $state -> cancelled"
}

# ---------- force-start ----------
#
# Set the force_start flag on a ready or queued job so the runner will dispatch
# it even while over quota cap and without applying conservative posture bias.
# The flag is NOT a state transition — the runner picks it up on its next tick.
# It is cleared on every terminal transition, escalation, and adherence rework.
#
# Usage: mother force-start <id> [--yes]
#   --yes  Skip the interactive confirmation prompt (required in non-interactive
#          contexts such as the broker and tmux popup).

cmd_force_start() {
    local id="" yes=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --yes) yes=1; shift ;;
            --) shift; break ;;
            -*) _die "force-start: unknown flag: $1" ;;
            *) [ -z "$id" ] && id="$1" || _die "force-start: unexpected argument: $1"; shift ;;
        esac
    done

    [ -n "$id" ] || _die "force-start: <id> required"
    _job_exists "$id" || _die "no such job: $id"

    local job_file; job_file=$(_job_path "$id")
    local state; state=$(jq -r .state "$job_file")
    case "$state" in
        ready|queued) ;;
        *) _die "force-start: job must be ready or queued (state=$state)" ;;
    esac

    # Compute context-aware override summary for the confirm prompt.
    local over_cap=0 posture="normal"
    if ! _quota_check 2>/dev/null; then
        over_cap=1
    fi
    # Shell out to bishop to get posture (mirrors _resolve_posture in mother-run-job
    # but without depending on that script's functions being in scope here).
    if command -v bishop >/dev/null 2>&1; then
        posture=$(bishop get posture 2>/dev/null || echo "normal")
        case "$posture" in conservative|normal|elevated|flush) ;; *) posture="normal" ;; esac
    fi

    # Confirmation gate.
    if [ "$yes" -ne 1 ]; then
        # Non-interactive context without --yes: refuse.
        if [ ! -t 0 ]; then
            _die "force-start: refusing to force without --yes in a non-interactive context"
        fi

        # Build a human-readable summary of what force-start will override.
        local summary=""
        if [ "$over_cap" -eq 1 ] && [ "$posture" = "conservative" ]; then
            summary="Quota is over cap AND posture is conservative — forcing will dispatch this job immediately at full configured strength, bypassing both guards."
        elif [ "$over_cap" -eq 1 ]; then
            summary="Quota is over cap — forcing will dispatch this job immediately despite the quota gate."
        elif [ "$posture" = "conservative" ]; then
            summary="Posture is conservative — forcing will bypass the conservative clamp and run at configured tier."
        else
            summary="Quota is under cap and posture is normal — forcing has no effect right now, but the flag will be set."
        fi

        echo "$summary"
        printf 'Force-start job %s? [y/N] ' "$id"
        local answer
        read -r answer </dev/tty || answer=""
        case "${answer:-}" in
            y|Y|yes|YES) ;;
            *) echo "aborted"; return 0 ;;
        esac
    fi

    _job_update "$id" '.force_start = true'
    _append_event "$id" "force_start_requested" \
        "$(jq -nc \
            --argjson oc "$over_cap" \
            --arg p "$posture" \
            '{over_cap: $oc, posture: $p}')"
    echo "$id: force_start set (over_cap=$over_cap, posture=$posture)"
}

# ---------- retry ----------

cmd_retry() {
    local id="${1:-}"
    [ -n "$id" ] || _die "retry: <id> required"
    _job_exists "$id" || _die "no such job: $id"
    local job_file; job_file=$(_job_path "$id")
    local state; state=$(jq -r .state "$job_file")
    case "$state" in failed|cancelled) ;; *) _die "can only retry failed/cancelled jobs (state=$state)" ;; esac

    # In-place retry: reset state on the SAME job_id rather than creating a
    # new one. Three reasons:
    #
    #   - Downstream jobs with `--depends-on $id` automatically unblock
    #     when the retry succeeds. A new job_id would leave them stranded
    #     forever, pinned to the original failed id.
    #   - The retry inherits depends_on naturally — no need to re-derive
    #     it from CLI flags that may not have been preserved.
    #   - The events file becomes a single audit trail of attempts on
    #     this job, separated by `retried` boundaries. `mother status`
    #     keeps the full history together.
    #
    # Worktree state carries forward: any commits from the failed run
    # are still on the branch, and the new run picks up there. Operators
    # who want a clean retry should `mother cancel` and `mother add`
    # afresh instead.
    #
    # State target: `ready` if all dependencies are succeeded, otherwise
    # `queued` so _promote_ready handles them.
    local deps; deps=$(jq -c '.depends_on // []' "$job_file")
    local has_unmet=0 dep dep_state
    for dep in $(echo "$deps" | jq -r '.[]'); do
        dep_state="missing"
        [ -f "$(_job_path "$dep")" ] && dep_state=$(jq -r .state "$(_job_path "$dep")")
        case "$dep_state" in succeeded) ;; *) has_unmet=1; break ;; esac
    done
    local new_state="ready"
    [ "$has_unmet" -eq 1 ] && new_state="queued"

    # Atomic write: reset state + clear ephemeral fields from the prior
    # run, while preserving depends_on, plan_path, repo metadata, and
    # pr_url (operators occasionally retry to re-attempt push of an
    # already-opened PR; clearing pr_url would lose that pointer).
    # Preserve routing fields: suggested_config, current_tier, escalation_count.
    # Reset adherence state since we're doing a fresh run.
    local merged
    merged=$(jq --arg s "$new_state" '
        .state = $s
        | .finished_at = null
        | .worker_pid = null
        | .actual_cost_usd = null
        | .cancel_requested = null
        | .pause_requested = null
        | .final_result_at = null
        | .paused_at = null
        | .paused_reason = null
        | .auto_resume_at = null
        | .pending_answer = null
        | .question = null
        | .resumed_at = null
        | .retry_count = ((.retry_count // 0) + 1)
        | .adherence_pending = null
        | .adherence_status = null
        | .adherence_notes = null
        | .adherence_attempts = 0
    ' "$job_file") || _die "retry: jq update failed"
    _atomic_write "$job_file" "$merged"
    _append_event "$id" "retried" \
        "$(jq -nc --arg from "$state" --arg to "$new_state" \
            '{from_state: $from, to_state: $to}')"
    echo "$id: $state -> $new_state"
}

# ---------- escalate ----------
#
# Escalate a failed job to the next tier on the model/effort ladder. This is
# the manual path; mother-runner also calls it automatically when a child fails
# and escalation_count < 2. Caps at 2 escalations (tier_3) — above the cap,
# returns non-zero with a clear message.
#
# Escalation bumps `current_tier`, increments `escalation_count`, resets
# ephemeral run state (same as retry), and transitions the job back to `ready`.
# `suggested_config` is preserved so routing hints survive escalation.

cmd_escalate() {
    local id="${1:-}"
    [ -n "$id" ] || _die "escalate: <id> required"
    _job_exists "$id" || _die "no such job: $id"
    local job_file; job_file=$(_job_path "$id")
    local state; state=$(jq -r .state "$job_file")
    case "$state" in
        failed) ;;
        *) _die "escalate: can only escalate failed jobs (state=$state)" ;;
    esac

    local esc_count; esc_count=$(jq -r '.escalation_count // 0' "$job_file")
    if [ "$esc_count" -ge 2 ]; then
        echo "mother: escalate: job $id has already been escalated $esc_count times (cap is 2); escalation refused" >&2
        return 1
    fi

    local current_tier; current_tier=$(jq -r '.current_tier // "tier_0"' "$job_file")
    local next_tier; next_tier=$(_tier_next "$current_tier")
    if [ -z "$next_tier" ]; then
        echo "mother: escalate: job $id is already at the top tier ($current_tier); escalation refused" >&2
        return 1
    fi

    # Determine dependency state for the target state.
    local deps; deps=$(jq -c '.depends_on // []' "$job_file")
    local has_unmet=0 dep dep_state
    for dep in $(echo "$deps" | jq -r '.[]'); do
        dep_state="missing"
        [ -f "$(_job_path "$dep")" ] && dep_state=$(jq -r .state "$(_job_path "$dep")")
        case "$dep_state" in succeeded) ;; *) has_unmet=1; break ;; esac
    done
    local new_state="ready"
    [ "$has_unmet" -eq 1 ] && new_state="queued"

    local merged
    merged=$(jq \
        --arg s "$new_state" \
        --arg tier "$next_tier" \
        --argjson esc "$((esc_count + 1))" \
        '
        .state = $s
        | .current_tier = $tier
        | .escalation_count = $esc
        | .finished_at = null
        | .worker_pid = null
        | .actual_cost_usd = null
        | .cancel_requested = null
        | .pause_requested = null
        | .final_result_at = null
        | .paused_at = null
        | .paused_reason = null
        | .auto_resume_at = null
        | .pending_answer = null
        | .question = null
        | .resumed_at = null
        | .adherence_pending = null
        | .adherence_status = null
        | .adherence_notes = null
        | .adherence_attempts = 0
        | .force_start = null
    ' "$job_file") || _die "escalate: jq update failed"
    _atomic_write "$job_file" "$merged"
    _append_event "$id" "escalated" \
        "$(jq -nc \
            --arg from "$current_tier" --arg to "$next_tier" \
            --arg from_state "$state" --arg to_state "$new_state" \
            --argjson esc "$((esc_count + 1))" \
            '{from_tier: $from, to_tier: $to, from_state: $from_state, to_state: $to_state, escalation_count: $esc}')"
    echo "$id: escalated $current_tier -> $next_tier (escalation_count=$((esc_count + 1)))"
}

# ---------- review-phase ----------
#
# Run a single reviewer (ada, archie, or perri) in the `review` request type
# against a job's artifacts. Captures the reviewer's ```findings block,
# validates it, tags each finding with the emitting reviewer, and persists the
# array to .pipeline.reviewer_findings.<reviewer>. Does NOT transition job state
# or merge across reviewers — that is W4's job.
#
# Returns 0 on success, 2 on parse/validation error.
# Usage: cmd_review_phase <id> --reviewer <ada|archie|perri>

cmd_review_phase() {
    local id="" reviewer=""
    # Parse positional + flags.
    while [ $# -gt 0 ]; do
        case "$1" in
            --reviewer)   reviewer="$2"; shift 2 ;;
            --reviewer=*) reviewer="${1#*=}"; shift ;;
            --) shift; break ;;
            -*) _die "review-phase: unknown flag: $1" ;;
            *)
                if [ -z "$id" ]; then id="$1"; shift
                else _die "review-phase: unexpected argument: $1"
                fi ;;
        esac
    done
    [ -n "$id" ]       || _die "review-phase: <id> required"
    [ -n "$reviewer" ] || _die "review-phase: --reviewer required"
    _job_exists "$id"  || _die "no such job: $id"

    # Validate reviewer name.
    case "$reviewer" in
        ada|archie|perri) ;;
        *) _die "review-phase: --reviewer must be one of: ada archie perri" ;;
    esac

    # Defensive: confirm the request type is registered.
    if type rt_exists >/dev/null 2>&1; then
        rt_exists "$reviewer" "review" \
            || _die "review-phase: ($reviewer, review) is not a registered request type"
    fi

    local job_file; job_file=$(_job_path "$id")

    # Resolve plan file: prefer job's plan_path field (set by mother add and
    # mother-run-job), fall back to the event-dir convention used by legacy jobs.
    local plan_file
    plan_file=$(jq -r '.plan_path // empty' "$job_file")
    if [ -z "$plan_file" ] || [ ! -f "$plan_file" ]; then
        plan_file=$(_plan_path "$id")
    fi
    [ -f "$plan_file" ] || _die "review-phase: plan file not found for $id"

    # Resolve PR URL (best-effort — a pipeline job may be reviewed pre-PR).
    local pr_url
    pr_url=$(jq -r '.pr_url // empty' "$job_file")

    # Resolve reviewer model from suggested_config, default to sonnet.
    local reviewer_model
    reviewer_model=$(jq -r --arg r "$reviewer" \
        '.suggested_config[$r].model // "sonnet"' "$job_file" 2>/dev/null || echo "sonnet")
    # Normalize empty/null.
    case "${reviewer_model:-}" in
        ""| "null") reviewer_model="sonnet" ;;
    esac

    # Apply posture bias: conservative clamps to sonnet.
    local review_posture
    review_posture=$(_resolve_posture)
    if [ "$review_posture" = "conservative" ]; then
        reviewer_model="sonnet"
    fi

    # Resolve template files.
    local tmpl_dir="$MOTHER_BIN_DIR/../templates"
    local review_prompt_tmpl="$tmpl_dir/review-prompt.md"
    local checklist_tmpl="$tmpl_dir/review-checklists/${reviewer}.md"
    local findings_tmpl="$tmpl_dir/findings-prompt.md"
    [ -f "$review_prompt_tmpl" ] || _die "review-phase: template not found: $review_prompt_tmpl"
    [ -f "$checklist_tmpl" ]     || _die "review-phase: checklist not found: $checklist_tmpl"
    [ -f "$findings_tmpl" ]      || _die "review-phase: template not found: $findings_tmpl"

    # Build prompt: checklist + review-prompt scaffold + artifact sections + findings format.
    local review_prompt artifacts_section pr_comments_section
    review_prompt=$(printf '%s\n\n%s\n\n' \
        "$(cat "$checklist_tmpl")" \
        "$(cat "$review_prompt_tmpl")")

    # Render artifact sections declared by rt_inputs for this reviewer.
    local inputs_list=""
    if type rt_inputs >/dev/null 2>&1; then
        inputs_list=$(rt_inputs "$reviewer" "review" 2>/dev/null || true)
    fi

    # Determine work_dir and base_ref from job.
    # NOTE: prefer the job's own .work_dir (the actual isolated worktree a
    # worktree-isolated job's Cody/Redd/Marty ran in) over .repo_path (the
    # logical/main-checkout path, which is ALWAYS ~/Code/<repo> regardless of
    # isolation mode). Reading .repo_path here was the root cause of every
    # reviewer (perri, archie via adherence-review) inspecting the wrong repo
    # state: phase_render_input's diff/tests sections AND the reviewer's own
    # ad hoc git/gh exploration (see the cd fix below) both consume this same
    # local var, so getting the source field wrong broke both at once. A
    # main-dir-isolation job has no separate worktree, so it has no .work_dir
    # field — .repo_path is the correct (and only) answer there, hence the
    # fallback.
    local work_dir base_ref prd_path
    work_dir=$(jq -r '.work_dir // .repo_path // empty' "$job_file")
    base_ref=$(jq -r '.base_ref // empty' "$job_file")
    prd_path=$(jq -r '.prd_path // empty' "$job_file")

    # Render each declared input section (plan/prd/tests/diff via phase_render_input;
    # pr_comments gathered inline).
    artifacts_section=""
    if [ -n "$inputs_list" ]; then
        local key
        while IFS= read -r key; do
            [ -z "$key" ] && continue
            if [ "$key" = "pr_comments" ]; then
                # Best-effort gather of PR comments.
                if [ -n "${pr_url:-}" ]; then
                    pr_comments_section=$(gh pr view "$pr_url" --comments 2>/dev/null \
                        || echo "(no PR comments available)")
                else
                    pr_comments_section="(no PR yet)"
                fi
                artifacts_section=$(printf '%s\n## PR Comments\n\n%s\n\n' \
                    "$artifacts_section" "$pr_comments_section")
            elif type phase_render_input >/dev/null 2>&1; then
                local rendered
                rendered=$(phase_render_input "$key" "${work_dir:-}" "$plan_file" \
                    "${prd_path:-}" "${base_ref:-}" "$job_file" "$reviewer" 2>/dev/null || true)
                artifacts_section=$(printf '%s\n%s\n' "$artifacts_section" "$rendered")
            fi
        done <<EOF
$inputs_list
EOF
    fi

    # Append findings-prompt.md as the final instruction.
    review_prompt=$(printf '%s\n%s\n\n%s\n' \
        "$review_prompt" \
        "$artifacts_section" \
        "$(cat "$findings_tmpl")")

    # Emit spawn event.
    _append_event "$id" "review_spawned" \
        "$(jq -nc --arg r "$reviewer" --arg m "$reviewer_model" --arg p "$review_posture" \
            '{reviewer: $r, model: $m, posture: $p}')"

    # Spawn the reviewer. Run from the job's own worktree (work_dir), not
    # whatever directory `mother` itself was invoked from — the reviewer
    # agent (e.g. perri) routinely runs its own ad hoc `git diff`/`git log`/
    # `gh pr diff` to verify findings before flagging them, and without this
    # it inspects the wrong repo state entirely (observed: identical bogus
    # findings across two unrelated jobs, both times reflecting whatever
    # was ambient in the invoking shell's cwd rather than the job's branch).
    # phase_render_input already scopes its own git calls to work_dir; this
    # brings the spawned agent's ambient cwd into line with that.
    local tmpfile
    tmpfile=$(mktemp)
    if [ -n "$work_dir" ] && [ -d "$work_dir" ]; then
        ( cd "$work_dir" && claude --agent "$reviewer" --model "$reviewer_model" -p "$review_prompt" ) \
            > "$tmpfile" 2>/dev/null || true
    else
        claude --agent "$reviewer" --model "$reviewer_model" -p "$review_prompt" \
            > "$tmpfile" 2>/dev/null || true
    fi

    # Extract findings block.
    local raw_findings
    raw_findings=$(findings_extract "$tmpfile" 2>/dev/null || true)
    rm -f "$tmpfile"

    # Handle absent block: treat as empty array (satisfied reviewer).
    if [ -z "$raw_findings" ]; then
        raw_findings="[]"
        _append_event "$id" "review_no_findings_block" \
            "$(jq -nc --arg r "$reviewer" '{reviewer: $r}')"
    fi

    # Validate.
    local validate_err
    if ! validate_err=$(findings_validate "$raw_findings" 2>&1); then
        _append_event "$id" "review_parse_error" \
            "$(jq -nc --arg r "$reviewer" --arg d "$validate_err" \
                '{reviewer: $r, diagnostic: $d}')"
        echo "mother: review-phase: $reviewer emitted invalid findings: $validate_err" >&2
        return 2
    fi

    # Tag each finding with the emitting reviewer.
    local tagged_findings
    tagged_findings=$(printf '%s' "$raw_findings" \
        | jq --arg r "$reviewer" 'map(. + {reviewer: $r})')

    # Compute per-reviewer exit decision (informational for the event).
    local decision
    decision=$(findings_exit_decision "$tagged_findings" 2>/dev/null || echo "ship")

    local finding_count
    finding_count=$(printf '%s' "$tagged_findings" | jq 'length')

    # Persist to .pipeline.reviewer_findings.<reviewer> via atomic write.
    # Guard: ensure .pipeline and .pipeline.reviewer_findings exist as objects
    # before the targeted set, so jq doesn't reject a null intermediate path.
    local merged_job
    merged_job=$(jq --argjson rf "$tagged_findings" --arg r "$reviewer" '
        (.pipeline //= {}) |
        (.pipeline.reviewer_findings //= {}) |
        .pipeline.reviewer_findings[$r] = $rf
    ' "$job_file") \
        || _die "review-phase: jq update for reviewer_findings failed"
    _atomic_write "$job_file" "$merged_job"

    # Emit reviewed event.
    _append_event "$id" "reviewed" \
        "$(jq -nc --arg r "$reviewer" --argjson fc "$finding_count" --arg d "$decision" \
            '{reviewer: $r, finding_count: $fc, decision: $d}')"

    echo "$id: $reviewer review: $finding_count findings ($decision)"
    return 0
}

# ---------- _merge_reviewer_findings ----------
#
# Pure helper: reads .pipeline.reviewer_findings (an object keyed by reviewer
# name) from the given job, concatenates all reviewers' arrays into one flat
# array, and re-assigns stable ids f1..fN across the merged set. Echoes the
# merged JSON array on stdout. No state mutation.
#
# Two reviewers' contradictory findings both survive (no semantic dedup).
# Usage: _merge_reviewer_findings <id>

_merge_reviewer_findings() {
    local id="$1"
    _job_exists "$id" || _die "_merge_reviewer_findings: no such job: $id"
    local job_file; job_file=$(_job_path "$id")

    # Pull the reviewer_findings object; default to empty object if absent.
    local rf_obj
    rf_obj=$(jq -r '.pipeline.reviewer_findings // {}' "$job_file" 2>/dev/null || echo "{}")

    # Concatenate all arrays in a stable key order (sorted alphabetically).
    # Re-assign ids f1..fN across the merged set.
    printf '%s' "$rf_obj" | jq '
        [ to_entries | sort_by(.key) | .[].value[] ]
        | to_entries | map(.value + {id: ("f" + ((.key + 1) | tostring))})
    '
}

# ---------- adherence-review ----------
#
# Spawn Archie to review whether a job's PR diff matches the original plan.
# Reads the plan from events/<id>-plan.md, fetches the PR diff and CI summary,
# constructs a structured prompt, and calls claude --agent archie in headless mode.
# Parses the verdict (pass/fail) and stores it on the job JSON.
# Returns 0 on pass, 1 on fail, 2 on error.

cmd_adherence_review() {
    local id="${1:-}"
    [ -n "$id" ] || _die "adherence-review: <id> required"
    _job_exists "$id" || _die "no such job: $id"
    local job_file; job_file=$(_job_path "$id")
    local state; state=$(jq -r .state "$job_file")
    case "$state" in succeeded) ;; *) _die "adherence-review: job must be in succeeded state (state=$state)" ;; esac

    # Pipeline jobs delegate to the structured findings path.
    local kind; kind=$(jq -r '.kind // ""' "$job_file")
    if [ "$kind" = "pipeline" ]; then
        cmd_review_phase "$id" --reviewer archie
        return $?
    fi

    local pr_url; pr_url=$(jq -r '.pr_url // empty' "$job_file")
    [ -n "$pr_url" ] || _die "adherence-review: job $id has no pr_url"

    # Resolve the plan file.
    local plan_file; plan_file=$(_plan_path "$id")
    [ -f "$plan_file" ] || _die "adherence-review: plan file not found for $id"

    # Resolve the adherence prompt template.
    local template_file="$MOTHER_BIN_DIR/../templates/adherence-prompt.md"
    [ -f "$template_file" ] || _die "adherence-review: template not found at $template_file"

    # Gather artifacts (best-effort).
    local pr_diff pr_checks pr_comments
    pr_diff=$(gh pr diff "$pr_url" 2>/dev/null || echo "(diff unavailable)")
    pr_checks=$(gh pr checks "$pr_url" 2>/dev/null || echo "(CI status unavailable)")
    pr_comments=$(gh pr view "$pr_url" --comments 2>/dev/null || echo "(comments unavailable)")

    # Build the prompt from template + artifacts.
    local review_prompt
    review_prompt=$(cat "$template_file")
    review_prompt=$(printf '%s\n\n## Original Plan\n\n```\n%s\n```\n\n## PR Diff\n\n```diff\n%s\n```\n\n## CI Status\n\n```\n%s\n```\n\n## PR Comments (Perri review)\n\n```\n%s\n```\n' \
        "$review_prompt" \
        "$(cat "$plan_file")" \
        "$pr_diff" \
        "$pr_checks" \
        "$pr_comments")

    # Invoke Archie for the review.
    # Apply posture bias: conservative posture clamps to sonnet; all others
    # keep the default opus (adherence review is a hard reasoning task).
    # MOTHER_POSTURE_ENABLED=0 disables the bias entirely.
    local archie_model="opus"
    local review_posture
    review_posture=$(_resolve_posture)
    if [ "$review_posture" = "conservative" ]; then
        archie_model="sonnet"
    fi
    _append_event "$id" "adherence_review_spawned" \
        "$(jq -nc --arg m "$archie_model" --arg p "$review_posture" \
            '{model: $m, posture: $p}')"
    local raw_verdict
    raw_verdict=$(claude --agent archie --model "$archie_model" -p "$review_prompt" 2>/dev/null || true)

    # Parse the verdict.
    local verdict notes
    verdict=$(printf '%s\n' "$raw_verdict" | grep -Eo 'ADHERENCE:[[:space:]]*(pass|fail)' | head -1 | awk '{print $NF}' || true)
    notes=$(printf '%s\n' "$raw_verdict" | awk '/^NOTES:/{p=1; next} p{print}' || true)

    if [ -z "$verdict" ]; then
        # Could not parse verdict — treat as error, don't mutate job state.
        echo "mother: adherence-review: could not parse ADHERENCE line from Archie's response" >&2
        echo "Raw response preview:" >&2
        printf '%s\n' "$raw_verdict" | head -20 >&2
        return 2
    fi

    local esc_attempts; esc_attempts=$(jq -r '.adherence_attempts // 0' "$job_file")
    local new_attempts=$((esc_attempts + 1))
    local adherence_status

    if [ "$verdict" = "pass" ]; then
        adherence_status="passed"
        _job_update "$id" \
            ".adherence_status = \"$adherence_status\" | .adherence_notes = \"$(printf '%s' "$notes" | sed 's/"/\\"/g')\" | .adherence_pending = false | .adherence_attempts = $new_attempts"
        _append_event "$id" "adherence_reviewed" \
            "$(jq -nc --arg verdict "pass" --arg notes "$notes" --argjson attempts "$new_attempts" \
                '{verdict: $verdict, notes: $notes, attempts: $attempts}')"
        echo "$id: adherence review: PASS"
        return 0
    else
        # fail
        if [ "$esc_attempts" -eq 0 ]; then
            adherence_status="failed_first"
            # Store notes and pending_answer; runner re-queues with activity=cody_rework.
            local notes_escaped; notes_escaped=$(printf '%s' "$notes" | sed 's/"/\\"/g')
            _job_update "$id" \
                ".adherence_status = \"$adherence_status\" | .adherence_notes = \"$notes_escaped\" | .adherence_attempts = $new_attempts | .pending_answer = \"$notes_escaped\""
            _append_event "$id" "adherence_reviewed" \
                "$(jq -nc --arg verdict "fail" --arg notes "$notes" --argjson attempts "$new_attempts" --arg status "$adherence_status" \
                    '{verdict: $verdict, notes: $notes, attempts: $attempts, status: $status}')"
            echo "$id: adherence review: FAIL (first attempt) — re-queuing for cody_rework"
            return 1
        else
            adherence_status="blocked_for_human"
            # Transition to awaiting so the operator sees it in the statusline ?-count.
            local notes_escaped; notes_escaped=$(printf '%s' "$notes" | sed 's/"/\\"/g')
            _job_update "$id" \
                ".adherence_status = \"$adherence_status\" | .adherence_notes = \"$notes_escaped\" | .adherence_attempts = $new_attempts | .adherence_pending = false | .activity = \"adherence_blocked\" | .state = \"awaiting\" | .paused_at = \"$(_iso_now)\" | .paused_reason = \"adherence_blocked\""
            _append_event "$id" "adherence_reviewed" \
                "$(jq -nc --arg verdict "fail" --arg notes "$notes" --argjson attempts "$new_attempts" --arg status "$adherence_status" \
                    '{verdict: $verdict, notes: $notes, attempts: $attempts, status: $status}')"
            _append_event "$id" "awaiting_input" \
                "$(jq -nc --arg notes "$notes" '{paused_reason: "adherence_blocked", notes: $notes}')"
            echo "$id: adherence review: FAIL (second attempt) — transitioning to awaiting (adherence_blocked)"
            return 1
        fi
    fi
}

# ---------- await ----------
#
# Worker-facing primitive. An agent inside a running job calls this when it
# needs the operator's input to make progress. The CLI:
#   - validates the job is in `running` state
#   - records the question, paused_at, and clears any stale pending_answer
#   - transitions state to `awaiting`
#   - emits an `awaiting_input` event
#   - prints guidance the agent will see in its tool-use stdout
#
# The agent's job is then to end its session cleanly; mother-run-job notices
# the awaiting state when claude exits and refrains from a normal terminal
# transition. The job sits in `awaiting` until the operator runs
# `mother resume <id> "<answer>"`, which kicks a fresh worker that picks up
# from the same worktree with the answer prepended to the original plan.
#
# Job id may be passed as a positional arg or via $MOTHER_JOB_ID — the
# wrapper exports the latter so agents can call this without bookkeeping.

cmd_await() {
    local id="${MOTHER_JOB_ID:-}" question=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --question)   question="$2"; shift 2 ;;
            --question=*) question="${1#*=}"; shift ;;
            --) shift; break ;;
            -*) _die "unknown flag for await: $1" ;;
            *)
                if [ -z "$id" ]; then id="$1"; shift
                else _die "unexpected positional arg: $1"
                fi ;;
        esac
    done
    [ -n "$id" ]       || _die "await: <id> required (or set MOTHER_JOB_ID)"
    [ -n "$question" ] || _die "await: --question required"
    _job_exists "$id"  || _die "no such job: $id"

    local state; state=$(jq -r .state "$(_job_path "$id")")
    [ "$state" = "running" ] || _die "await: job is in state $state, expected running"

    # Single atomic write: set question/paused_at/paused_reason/state and
    # clear any stale pending_answer or auto_resume_at (so a resume after
    # this pause must come from a fresh `mother resume` call, not a
    # leftover from a previous cycle or a system-pause that's been
    # superseded by an operator-initiated one).
    local job_file merged
    job_file=$(_job_path "$id")
    merged=$(jq --arg q "$question" --arg ts "$(_iso_now)" '
        .question = $q
        | .paused_at = $ts
        | .paused_reason = "user"
        | .pending_answer = null
        | .auto_resume_at = null
        | .state = "awaiting"
    ' "$job_file") || _die "await: jq update failed"
    _atomic_write "$job_file" "$merged"
    _append_event "$id" "awaiting_input" \
        "$(jq -nc --arg q "$question" '{question: $q, paused_reason: "user"}')"

    cat <<EOF
mother: question recorded for $id
state: running -> awaiting

The operator has been notified via the statusline. They will answer with:
  mother resume $id "<answer>"

A fresh worker will then be spawned in the same worktree (your in-progress
changes and commits are preserved), with the answer prepended to the
original plan. End your session now — emit a brief result event summarizing
where you paused so the resumed worker has continuity.
EOF
}

# ---------- resume ----------
#
# Operator-facing primitive. Provides an answer to an `awaiting` job and
# kicks the daemon to spawn a fresh worker. The pending_answer field is
# consumed by mother-run-job at spawn time, which constructs an augmented
# plan including the original plan, the previous question, and this answer.
#
# Answer can come from the command line, from a file (`--from-file`), or
# from stdin (`-`). All three flows write the same `pending_answer` field;
# choose whichever is convenient for the answer's length / shape.

cmd_resume() {
    local id="" answer="" from_file="" from_stdin=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --from-file)   from_file="$2"; shift 2 ;;
            --from-file=*) from_file="${1#*=}"; shift ;;
            -)             from_stdin=1; shift ;;
            --) shift; break ;;
            -*) _die "unknown flag for resume: $1" ;;
            *)
                if   [ -z "$id" ];     then id="$1"; shift
                elif [ -z "$answer" ]; then answer="$1"; shift
                else _die "unexpected positional arg: $1"
                fi ;;
        esac
    done
    [ -n "$id" ] || _die "resume: <id> required"
    _job_exists "$id" || _die "no such job: $id"

    if [ -n "$from_file" ]; then
        [ -f "$from_file" ] || _die "resume: --from-file not found: $from_file"
        answer=$(cat "$from_file")
    elif [ "$from_stdin" -eq 1 ]; then
        answer=$(cat)
    fi
    [ -n "$answer" ] || _die "resume: <answer> required (positional, --from-file, or '-' for stdin)"

    local state; state=$(jq -r .state "$(_job_path "$id")")
    [ "$state" = "awaiting" ] || _die "resume: job is in state $state, expected awaiting"

    # Single atomic write: stash the answer, mark resumed_at, bump
    # resume_count (defaulting from null on first resume), and transition
    # straight to `ready` so the daemon's next promotion tick spawns a
    # fresh worker without going through `queued`. Also clear the system-
    # pause fields if they were set — the operator's manual resume
    # supersedes any pending auto-resume.
    local job_file merged
    job_file=$(_job_path "$id")
    merged=$(jq --arg a "$answer" --arg ts "$(_iso_now)" '
        .pending_answer = $a
        | .resumed_at = $ts
        | .resume_count = ((.resume_count // 0) + 1)
        | .auto_resume_at = null
        | .paused_reason = null
        | .pause_requested = null
        | .activity = null
        | .state = "ready"
    ' "$job_file") || _die "resume: jq update failed"
    _atomic_write "$job_file" "$merged"
    _append_event "$id" "resumed" \
        "$(jq -nc --arg a "$answer" '{answer: $a}')"
    echo "$id: awaiting -> ready (worker will spawn on next daemon tick)"
}

# ---------- events (for the hook) ----------

cmd_events() {
    local session_id="" since_ts=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --since-cursor) session_id="$2"; shift 2 ;;
            --since)        since_ts="$2";   shift 2 ;;
            *) _die "unknown flag for events: $1" ;;
        esac
    done

    # If session cursor provided, load its last-seen ts.
    local cursor_file=""
    if [ -n "$session_id" ]; then
        cursor_file="$CURSORS_DIR/$session_id.json"
        if [ -f "$cursor_file" ] && [ -z "$since_ts" ]; then
            since_ts=$(jq -r '.last_seen // ""' "$cursor_file" 2>/dev/null || echo "")
        elif [ ! -f "$cursor_file" ] && [ -z "$since_ts" ]; then
            # Brand-new session: bootstrap cursor to now so we don't replay
            # the full event history on first call. Future calls will pick up
            # only events emitted after this session started.
            since_ts=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
            mkdir -p "$CURSORS_DIR"
            _atomic_write "$cursor_file" "$(jq -n --arg ts "$since_ts" '{last_seen: $ts}')"
        fi
    fi

    # Aggregate all events across jobs, keeping job id and title alongside
    local all
    all=$(find "$EVENTS_DIR" -maxdepth 1 -name '*.jsonl' -type f 2>/dev/null | while read -r f; do
        local jobid title
        jobid=$(basename "$f" .jsonl)
        # Skip derivative plan files (events ending in -plan are actually .md, not .jsonl — guard anyway)
        [[ "$jobid" == *-plan ]] && continue
        title=""
        [ -f "$(_job_path "$jobid")" ] && title=$(jq -r '.title // ""' "$(_job_path "$jobid")" 2>/dev/null || echo "")
        jq -c --arg jobid "$jobid" --arg title "$title" '. + {job_id: $jobid, title: $title}' "$f" 2>/dev/null
    done | jq -cs --arg since "$since_ts" '
        map(select(($since | length == 0) or (.ts > $since)))
        | sort_by(.ts)
    ')

    echo "$all"

    # Advance cursor to the newest event seen, if session_id given.
    if [ -n "$session_id" ] && [ "$(echo "$all" | jq 'length')" -gt 0 ]; then
        local max_ts
        max_ts=$(echo "$all" | jq -r 'map(.ts) | max')
        mkdir -p "$CURSORS_DIR"
        _atomic_write "$cursor_file" "$(jq -n --arg ts "$max_ts" '{last_seen: $ts}')"
    fi
}

# ---------- drafts ----------

cmd_drafts() {
    local sub="${1:-list}"; shift || true
    case "$sub" in
        list)
            find "$DRAFTS_DIR" -maxdepth 1 -name '*.md' -type f 2>/dev/null | sort | while read -r f; do
                local id title
                id=$(basename "$f" .md)
                title=$(head -1 "$f" | sed -E 's/^#+ *//')
                printf "%-28s  %s\n" "$id" "$title"
            done
            ;;
        save)
            local plan_file="" id
            while [ $# -gt 0 ]; do
                case "$1" in
                    --plan-file) plan_file="$2"; shift 2 ;;
                    *) _die "unknown flag for drafts save: $1" ;;
                esac
            done
            [ -f "$plan_file" ] || _die "drafts save: --plan-file required"
            id=$(_gen_id)
            cp "$plan_file" "$(_draft_path "$id")"
            echo "$id"
            ;;
        show)
            local id="${1:-}"; [ -n "$id" ] || _die "drafts show: <id> required"
            cat "$(_draft_path "$id")"
            ;;
        rm)
            local id="${1:-}"; [ -n "$id" ] || _die "drafts rm: <id> required"
            rm -f "$(_draft_path "$id")"
            ;;
        *) _die "unknown drafts subcommand: $sub (list|save|show|rm)" ;;
    esac
}

# ---------- run ----------

cmd_run() {
    local once=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --once) once=1; shift ;;
            *) _die "unknown flag for run: $1" ;;
        esac
    done
    [ "$once" -eq 1 ] || _die "run: only --once is supported in phase 1 (daemon comes in phase 2)"

    # Promote queued jobs whose deps are all in terminal state to ready.
    _promote_ready

    # Pick the oldest ready job.
    local next
    next=$(find "$JOBS_DIR" -maxdepth 1 -name '*.json' -type f | while read -r f; do
        jq -r 'select(.state == "ready") | .created_at + "\t" + .id' "$f"
    done | sort | head -1 | cut -f2)

    if [ -z "$next" ]; then
        echo "no ready jobs"
        return 0
    fi

    "$MOTHER_BIN_DIR/mother-run-job" "$next"
}

# ---------- daemon ----------

_daemon_pid_alive() {
    local pid
    [ -f "$RUNNER_DIR/runner.pid" ] || return 1
    pid=$(cat "$RUNNER_DIR/runner.pid" 2>/dev/null) || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null
}

_daemon_start() {
    local foreground=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --foreground|-f) foreground=1; shift ;;
            *) _die "unknown flag for daemon start: $1" ;;
        esac
    done

    if _daemon_pid_alive; then
        local pid; pid=$(cat "$RUNNER_DIR/runner.pid")
        echo "already running (pid $pid)"
        return 0
    fi

    # Clean up a stale pidfile if present.
    [ -f "$RUNNER_DIR/runner.pid" ] && rm -f "$RUNNER_DIR/runner.pid"

    if [ "$foreground" -eq 1 ]; then
        exec "$MOTHER_BIN_DIR/mother-runner"
    fi

    nohup "$MOTHER_BIN_DIR/mother-runner" >> "$RUNNER_DIR/runner.log" 2>&1 &
    disown 2>/dev/null || true

    # Wait up to ~2s for the pidfile to appear.
    local tries=0
    while [ ! -f "$RUNNER_DIR/runner.pid" ] && [ "$tries" -lt 20 ]; do
        sleep 0.1
        tries=$((tries + 1))
    done

    if [ ! -f "$RUNNER_DIR/runner.pid" ]; then
        _die "daemon failed to start (no pidfile after 2s; check $RUNNER_DIR/runner.log)"
    fi
    echo "started (pid $(cat "$RUNNER_DIR/runner.pid"))"
}

_daemon_stop() {
    local pidfile="$RUNNER_DIR/runner.pid"
    if [ ! -f "$pidfile" ]; then
        echo "not running"
        return 0
    fi
    local pid; pid=$(cat "$pidfile")
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "stale pidfile (pid $pid not alive) — removed"
        rm -f "$pidfile"
        return 0
    fi

    kill -TERM "$pid" 2>/dev/null || true
    local elapsed=0
    while kill -0 "$pid" 2>/dev/null && [ "$elapsed" -lt 30 ]; do
        sleep 0.5
        elapsed=$((elapsed + 1))
    done

    # Only remove the pidfile if it still names the pid we just stopped.
    # A launchd KeepAlive-supervised runner can respawn within milliseconds
    # of the old process dying and write its own (different) pid to this
    # same file; blindly rm-ing here would delete that live respawn's
    # pidfile instead, leaving it running untracked while `daemon start`
    # (seeing no pidfile) launches an unrelated second instance alongside
    # it. Reproduced live: this exact race produced two simultaneously
    # running mother-runner processes after a single stop-then-start.
    local still_ours; still_ours=$([ "$(cat "$pidfile" 2>/dev/null)" = "$pid" ] && echo 1 || echo 0)

    if kill -0 "$pid" 2>/dev/null; then
        echo "SIGTERM ignored after 15s — escalating to SIGKILL"
        kill -KILL "$pid" 2>/dev/null || true
        [ "$still_ours" = "1" ] && rm -f "$pidfile"
        echo "killed (pid $pid)"
    else
        # Daemon cleans up its own pidfile on graceful exit; this is a
        # belt-and-suspenders fallback for the case where it didn't (e.g.
        # SIGKILL below skipped that cleanup path).
        [ "$still_ours" = "1" ] && rm -f "$pidfile"
        echo "stopped (pid $pid)"
    fi
}

_daemon_status() {
    local pidfile="$RUNNER_DIR/runner.pid"
    if [ ! -f "$pidfile" ]; then
        echo "stopped"
        return 0
    fi
    local pid; pid=$(cat "$pidfile")
    if ! kill -0 "$pid" 2>/dev/null; then
        echo "stopped (stale pidfile)"
        rm -f "$pidfile"
        return 0
    fi
    local uptime
    uptime=$(ps -o etime= -p "$pid" 2>/dev/null | awk '{$1=$1; print}')
    echo "running (pid $pid, uptime ${uptime:-unknown})"
}

_daemon_install() {
    case "$(uname -s)" in
        Linux)
            echo "TODO: systemd --user unit not yet implemented; daemon start manually with: mother daemon start" >&2
            return 1
            ;;
    esac

    local plist_src plist_dst runner_path
    plist_src="$MOTHER_BIN_DIR/../launchd/com.thehammer.mother.plist"
    plist_dst="$HOME/Library/LaunchAgents/com.thehammer.mother.plist"

    [ -f "$plist_src" ] || _die "daemon install: plist template not found at $plist_src"

    mkdir -p "$HOME/Library/LaunchAgents"
    mkdir -p "$MOTHER_ROOT/runner"

    # Resolve the runner path to an absolute, symlink-resolved path so the
    # plist works even if the plugin is installed via symlink.
    runner_path="$(cd "$MOTHER_BIN_DIR" && pwd -P)/mother-runner"

    # sed delimiter: use | since paths may contain /.
    sed \
        -e "s|__MOTHER_RUNNER_PATH__|$runner_path|g" \
        -e "s|__MOTHER_STATE_DIR__|$MOTHER_ROOT|g" \
        -e "s|__USER_HOME__|$HOME|g" \
        "$plist_src" > "$plist_dst"

    # If already loaded, unload first so the new plist takes effect.
    if launchctl list 2>/dev/null | grep -q 'com\.thehammer\.mother'; then
        launchctl unload "$plist_dst" 2>/dev/null || true
    fi
    launchctl load "$plist_dst"

    echo "installed launchd agent at $plist_dst"
}

_daemon_uninstall() {
    case "$(uname -s)" in
        Linux)
            echo "TODO: systemd --user unit not yet implemented; daemon stop manually with: mother daemon stop" >&2
            return 1
            ;;
    esac

    local plist="$HOME/Library/LaunchAgents/com.thehammer.mother.plist"
    if [ -f "$plist" ]; then
        launchctl unload "$plist" 2>/dev/null || true
        rm -f "$plist"
        echo "uninstalled"
    else
        echo "not installed"
    fi
}

# ---------- archive ----------

# Move a single terminal-state job from JOBS_DIR to archive/YYYY-MM/, taking
# its events jsonl, plan md, and log (gzipped) along. Shared by both the bulk
# sweep and the single-id form. Returns 0 if moved, 1 if skipped/not eligible.
_archive_one() {
    local id="$1" dry_run="${2:-0}"
    local job_file="$JOBS_DIR/$id.json"
    [ -f "$job_file" ] || { echo "archive: no such job: $id" >&2; return 1; }

    local state finished year_month dest_dir
    state=$(jq -r '.state // ""' "$job_file")
    case "$state" in
        succeeded|failed|cancelled) ;;
        *) echo "archive: $id is $state, not a terminal state — skipping" >&2; return 1 ;;
    esac

    finished=$(jq -r '.finished_at // ""' "$job_file")
    # If finished_at is missing (shouldn't normally happen), bucket under today.
    [ -z "$finished" ] && finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    year_month=$(printf '%s' "$finished" | cut -c1-7)
    dest_dir="$ARCHIVE_DIR/$year_month"

    if [ "$dry_run" -eq 1 ]; then
        echo "[dry-run] would archive $id (finished $finished) → $dest_dir"
        return 0
    fi

    mkdir -p "$dest_dir"
    mv "$job_file" "$dest_dir/$id.json" 2>/dev/null
    [ -f "$EVENTS_DIR/$id.jsonl" ]    && mv "$EVENTS_DIR/$id.jsonl"    "$dest_dir/$id.events.jsonl"
    [ -f "$EVENTS_DIR/$id-plan.md" ]  && mv "$EVENTS_DIR/$id-plan.md"  "$dest_dir/$id.plan.md"
    if [ -f "$LOGS_DIR/$id.log" ]; then
        gzip -c "$LOGS_DIR/$id.log" > "$dest_dir/$id.log.gz" && rm -f "$LOGS_DIR/$id.log"
    fi
    return 0
}

# Archive terminal-state jobs. Two modes:
#   mother archive <id>                    — archive one specific job now
#   mother archive [--older-than DAYS] [--dry-run]  — bulk sweep by age
#
# Single-id form intentionally ignores age — the user asked for it explicitly.
# Useful from the fzf switcher's ctrl-d binding to clean up a failed job
# without waiting 30 days.
cmd_archive() {
    # Detect single-id form: first arg is non-flag.
    if [ $# -ge 1 ] && [ "${1#-}" = "$1" ]; then
        local id="$1"; shift
        local dry_run=0
        while [ $# -gt 0 ]; do
            case "$1" in
                --dry-run) dry_run=1; shift ;;
                *) _die "unknown flag for archive <id>: $1" ;;
            esac
        done
        if _archive_one "$id" "$dry_run"; then
            [ "$dry_run" -eq 1 ] || echo "archived: $id"
        else
            return 1
        fi
        return 0
    fi

    # Bulk sweep by age.
    local older_than=30 dry_run=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --older-than) older_than="$2"; shift 2 ;;
            --dry-run)    dry_run=1; shift ;;
            *) _die "unknown flag for archive: $1" ;;
        esac
    done

    local cutoff_epoch cutoff_iso
    cutoff_epoch=$(( $(date +%s) - older_than * 86400 ))
    cutoff_iso=$(date -u -r "$cutoff_epoch" +%Y-%m-%dT%H:%M:%SZ)

    local moved=0 skipped=0
    local f state finished id
    for f in "$JOBS_DIR"/*.json; do
        [ -f "$f" ] || continue
        state=$(jq -r '.state // ""' "$f")
        case "$state" in succeeded|failed|cancelled) ;; *) skipped=$((skipped + 1)); continue ;; esac
        finished=$(jq -r '.finished_at // ""' "$f")
        [ -n "$finished" ] || { skipped=$((skipped + 1)); continue; }
        if [ "$finished" \> "$cutoff_iso" ]; then
            skipped=$((skipped + 1))
            continue
        fi
        id=$(jq -r '.id' "$f")
        if _archive_one "$id" "$dry_run"; then
            moved=$((moved + 1))
        else
            skipped=$((skipped + 1))
        fi
    done
    echo "archived: $moved, skipped: $skipped (cutoff: $cutoff_iso)"
}

cmd_daemon() {
    local sub="${1:-status}"
    shift 2>/dev/null || true
    case "$sub" in
        start)     _daemon_start "$@" ;;
        stop)      _daemon_stop "$@" ;;
        status)    _daemon_status "$@" ;;
        install)   _daemon_install "$@" ;;
        uninstall) _daemon_uninstall "$@" ;;
        *) _die "unknown daemon subcommand: $sub (start|stop|status|install|uninstall)" ;;
    esac
}

# ---------- broker ----------
#
# Read-only diagnostics for the IPC broker sidecar (supervised by the daemon).
# Reports the socket path and whether the broker process is alive. Does NOT
# start/stop the broker — that's the daemon's job (see mother-runner).

cmd_broker() {
    local sub="${1:-status}"
    shift 2>/dev/null || true
    local sock="${MOTHER_BROKER_SOCK:-$MOTHER_ROOT/broker.sock}"
    local pidfile="$RUNNER_DIR/broker.pid"
    case "$sub" in
        path)
            echo "$sock"
            ;;
        status)
            local p=""
            [ -f "$pidfile" ] && p=$(cat "$pidfile" 2>/dev/null)
            if [ -n "$p" ] && kill -0 "$p" 2>/dev/null; then
                echo "running (pid $p, socket $sock)"
                [ -S "$sock" ] || echo "  warning: socket not present at $sock" >&2
            else
                echo "stopped"
            fi
            ;;
        *) _die "unknown broker subcommand: $sub (status|path)" ;;
    esac
}

# ---------- help ----------

cmd_help() {
    cat <<'EOF'
mother — background work for Claude Code

Usage:
  mother add --plan-file PATH --repo NAME --branch BRANCH [options]
  mother list [--state STATE] [--repo REPO] [--project NAME] [--label LABEL] [--format json|table]
  mother status ID [--format json|text]
  mother logs ID [--follow]
  mother peek ID [--format json|text] [--tail N] [--watch]
  mother attach ID
  mother plan ID
  mother cancel ID
  mother force-start ID [--yes]              (force dispatch even when over quota cap)
  mother retry ID
  mother escalate ID                         (bump failed job to next model tier)
  mother adherence-review ID                 (check PR diff against original plan)
  mother review-phase ID --reviewer AGENT    (run one pipeline reviewer: ada|archie|perri)
  mother merge-findings ID                   (merge per-reviewer findings into one array; stdout only)
  mother await [ID] --question TEXT          (worker-side: pause for operator input)
  mother resume ID ANSWER | --from-file PATH | -    (operator-side: answer + resume)
  mother events [--since-cursor SESSION_ID] [--since ISO_TS]
  mother drafts list | save --plan-file PATH | show ID | rm ID
  mother daemon start [--foreground] | stop | status | install | uninstall
  mother broker status | path                (IPC broker diagnostics)
  mother archive [--older-than DAYS] [--dry-run]
  mother run --once

Add options:
  --repo-path PATH     (default: ~/Code/<repo>)
  --base REF           (default: origin/main)
  --isolation worktree|main-dir   (default: worktree)
  --executor local-tmux           (only option in phase 2)
  --max-cost USD
  --depends-on ID[,ID...]
  --title TEXT         (default: first heading of plan file)
  --format json|text   (default: text — prints job id only)
  --label TEXT         free-text origin label for this job
  --origin-project NAME  override auto-detected originating project name
  --origin-session ID    originating session id (default: \$MOTHER_ORIGIN_SESSION)

Plan file requirements:
  Every plan must include a ```yaml suggested_config: ... ``` block specifying
  model+effort for cody, redd, marty, perri (or skip: true). Valid models:
  haiku | sonnet | opus. Valid efforts: low | medium | high | xhigh | max.
  Downgrading below sonnet/medium requires "downgrade:" prefix in rationale.

Escalation tier ladder:
  tier_0: sonnet/medium  →  tier_1: sonnet/high  →  tier_2: sonnet/xhigh
  →  tier_3: opus/high   (cap: 2 escalations per job)

Daemon env vars:
  MOTHER_CONCURRENCY           (default: 2)    max parallel jobs
  MOTHER_POLL_INTERVAL         (default: 2)    seconds between ticks
  MOTHER_SHUTDOWN_GRACE        (default: 30)   seconds to wait for children on stop
  MOTHER_ESCALATION_ENABLED    (default: 1)    auto-escalate failed jobs (0 to disable)
  MOTHER_ADHERENCE_ENABLED     (default: 1)    auto-adherence-review succeeded jobs (0 to disable)
  MOTHER_BROKER_ENABLED        (default: 1)    supervise the IPC broker sidecar (0 to disable)

IPC broker env vars (the long-lived sidecar that pushes events to clients):
  MOTHER_BROKER_SOCK           (default: ~/.mother/broker.sock)  Unix socket path
  MOTHER_BROKER_PING_SEC       (default: 15)   heartbeat interval (seconds)
  MOTHER_BROKER_CLIENT_BUF     (default: 1024) per-client outbound buffer (messages)
  MOTHER_BROKER_ACTIVITY_SEC   (default: 1)    current_activity transcript poll interval
  MOTHER_CLAUDE_PROJECTS_DIR   (default: ~/.claude/projects)  transcript root for current_activity

Worker prompt env vars:
  MOTHER_PREAMBLE_PATH    path to a markdown file prepended to every
                          worker's prompt; teaches the agent how to
                          pause via `mother await`. Defaults to the
                          plugin's templates/preamble.md. Point at
                          /dev/null (or a missing path) to disable.
  MOTHER_DEFAULT_MODEL    (default: sonnet)   fallback model when not set by plan
  MOTHER_DEFAULT_EFFORT   (default: medium)   fallback effort when not set by plan

Quota gate env vars (require statusline integration — see segment.sh
`mother_capture_rate_limits`):
  MOTHER_RATE_LIMIT_CACHE  path the statusline writes rate_limits to
                           (default: ~/.mother/rate-limits.json).
  MOTHER_QUOTA_CAP_5H_PCT  refuse new dispatches when 5h window is at
                           or over this percentage (default: 90).
  MOTHER_QUOTA_CAP_7D_PCT  same for 7d window (default: 90).
                           Lower these to leave more headroom for
                           interactive use; e.g. cap=70 reserves the
                           top 30% for non-Mother work.

State flows:
  queued -> ready -> running -> succeeded | failed | cancelled
  running -> awaiting -> ready -> running     (worker calls `await`, operator
                                               runs `resume`; OR daemon's
                                               quota gate pauses + auto-
                                               resumes when window resets)
  failed    -> ready     (via mother escalate — bumps tier and re-queues)
  succeeded -> ready     (Archie flags drift on first review; Cody re-runs
                          with activity=cody_rework)
  succeeded -> awaiting  (Archie flags drift on second review; job sits in
                          awaiting with activity=adherence_blocked until
                          operator runs `mother resume` or `mother cancel`)

Activity sub-states (visible in `mother list`, indicate what a job is doing
within its current state):
  running/ready [continuation]   — re-queued after idle_timeout (auto-continuation)
  running       [cody_rework]    — second Cody attempt after adherence fail
  awaiting      [adherence_blocked] — needs human to review PR; resume or cancel
  awaiting      (no activity)    — Cody asked a question; answer with `resume`

Metrics:
  ~/.mother/metrics/runs.jsonl — one JSON line per terminal transition
  (succeeded/failed) with model, effort, tier, wall_time, pr_url, etc.

See docs/design.md for the full design.
EOF
}

# ---------- dispatch ----------

main() {
    local sub="${1:-help}"
    shift || true
    case "$sub" in
        add)               cmd_add "$@" ;;
        list)              cmd_list "$@" ;;
        status)            cmd_status "$@" ;;
        logs)              cmd_logs "$@" ;;
        peek)              cmd_peek "$@" ;;
        attach)            cmd_attach "$@" ;;
        plan)              cmd_plan "$@" ;;
        cancel)            cmd_cancel "$@" ;;
        force-start)       cmd_force_start "$@" ;;
        retry)             cmd_retry "$@" ;;
        escalate)          cmd_escalate "$@" ;;
        adherence-review)  cmd_adherence_review "$@" ;;
        review-phase)      cmd_review_phase "$@" ;;
        merge-findings)    _merge_reviewer_findings "${1:-}" ;;
        await)             cmd_await "$@" ;;
        resume)            cmd_resume "$@" ;;
        events)            cmd_events "$@" ;;
        drafts)            cmd_drafts "$@" ;;
        daemon)            cmd_daemon "$@" ;;
        broker)            cmd_broker "$@" ;;
        archive)           cmd_archive "$@" ;;
        run)               cmd_run "$@" ;;
        help|-h|--help)    cmd_help ;;
        *) _die "unknown subcommand: $sub (try: mother help)" ;;
    esac
}

main "$@"
