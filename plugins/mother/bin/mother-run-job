#!/usr/bin/env bash

# --- mother plugin path resolver (prepended during port) ---
# Resolves symlinks so the plugin works when installed via `ln -s` into a bin dir.
_MOTHER_RAW="${BASH_SOURCE[0]}"
while [ -L "$_MOTHER_RAW" ]; do
    _link="$(readlink "$_MOTHER_RAW")"
    case "$_link" in
        /*) _MOTHER_RAW="$_link" ;;
        *)  _MOTHER_RAW="$(dirname "$_MOTHER_RAW")/$_link" ;;
    esac
done
_MOTHER_SELF="$(cd "$(dirname "$_MOTHER_RAW")" && pwd -P)"
: "${MOTHER_BIN_DIR:=$_MOTHER_SELF}"
: "${MOTHER_LIB_DIR:=$_MOTHER_SELF/../lib}"
# -----------------------------------------------------------

# mother-run-job — run a single queued job to completion.
#
# Invoked by `mother run --once` (phase 1). In phase 2 the daemon calls this
# the same way. Responsibilities:
#   - Resolve the target working directory (worktree or main dir).
#   - Acquire a workspace lock if isolation=main-dir.
#   - Spawn `claude --agent <worker_agent> -p` with the plan on stdin (never
#     argv), nohup'd in the background at that cwd, tee'd to the job log. The
#     worker agent defaults to the user's `cody` (else `mother:cody`); override: MOTHER_WORKER_AGENT.
#     The pid is recorded on the job as `worker_pid`.
#   - Poll a status-marker file; transition the job on exit.
#   - On cancellation: SIGTERM the worker, wait 10s, then SIGKILL.
#   - Parse the log for a PR URL and cost info (best-effort).
#
# Blocks until the job exits. Usage: mother-run-job <job-id>

set -u

MOTHER_ROOT="${MOTHER_ROOT:-${MOTHER_LIVE_ROOT:-$HOME/.mother}}"
JOBS_DIR="$MOTHER_ROOT/jobs"
EVENTS_DIR="$MOTHER_ROOT/events"
LOGS_DIR="$MOTHER_ROOT/logs"
RUNNER_DIR="$MOTHER_ROOT/runner"

# ---------------------------------------------------------------------------
# PR URL capture helpers — defined early so SOURCE_ONLY=1 sourcing works.
# ---------------------------------------------------------------------------

# Shared evidence-based PR detection helpers (prd_*). Guarded like the other
# optional libs below — sourced here (BEFORE the SOURCE_ONLY guard) so both
# bats' `SOURCE_ONLY=1 source mother-run-job` and _verify_artifact_or_fail
# (also defined pre-guard, see below) can reach them.
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/prdetect.sh" ] && source "$MOTHER_LIB_DIR/prdetect.sh"

# Degrade gracefully if prdetect.sh is somehow absent: fall back to
# equivalents that preserve today's behavior rather than crashing every call
# site that now depends on the prd_* helpers.
type prd_pr_for_branch  >/dev/null 2>&1 || prd_pr_for_branch()  { gh pr list --repo "$1" --head "$2" --state open --json url 2>/dev/null | jq -r 'if type=="array" then .[0].url // empty else .url // empty end' 2>/dev/null; }
type prd_detect_pr      >/dev/null 2>&1 || prd_detect_pr()      { echo ""; }
type prd_candidate_shas >/dev/null 2>&1 || prd_candidate_shas() { :; }
type prd_pr_contains_sha >/dev/null 2>&1 || prd_pr_contains_sha() { return 2; }
type prd_sha_on_origin  >/dev/null 2>&1 || prd_sha_on_origin()  { return 1; }
type prd_owner_repo_from_url >/dev/null 2>&1 || prd_owner_repo_from_url() {
    local url="${1:-}"; url="${url%.git}"
    echo "$url" | sed -n 's|.*github\.com[:/]\(.*\)|\1|p'
}

# Shared main-dir auto-stash restore (mother_autostash_restore). Sourced
# pre-SOURCE_ONLY-guard so _restore_auto_stash / _exit_cleanup_workspace are
# bats-callable. Degrades to "nothing to restore" if the lib is absent.
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/autostash.sh" ] && source "$MOTHER_LIB_DIR/autostash.sh"
type mother_autostash_restore >/dev/null 2>&1 || mother_autostash_restore() { echo '{"outcome":"none"}'; }
type mother_autostash_event_detail >/dev/null 2>&1 || mother_autostash_event_detail() { return 1; }

# Best-effort RWX sandbox lifecycle helpers (mother_rwx_gate / mother_rwx_sandbox).
# Sourced pre-SOURCE_ONLY-guard so _rwx_pre_spawn / _rwx_post_exit are
# bats-callable. A missing lib degrades to "gate says disabled".
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/rwx.sh" ] && source "$MOTHER_LIB_DIR/rwx.sh"
type mother_rwx_gate    >/dev/null 2>&1 || mother_rwx_gate()    { echo disabled; return 1; }
type mother_rwx_sandbox >/dev/null 2>&1 || mother_rwx_sandbox() { echo '{"outcome":"skipped","reason":"no_lib"}'; return 0; }

# Quality gates (mother_gates_run). Sourced pre-SOURCE_ONLY-guard so
# _run_gates_observe is bats-callable. A missing lib degrades to "no gates run".
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/gates.sh" ] && source "$MOTHER_LIB_DIR/gates.sh"

# PR-body blocks (mother_prbody_write_gates) for the enforce-mode gate loop.
# Pre-guard for bats; a missing lib means "no body edit".
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/prbody.sh" ] && source "$MOTHER_LIB_DIR/prbody.sh"
type mother_prbody_write_gates >/dev/null 2>&1 || mother_prbody_write_gates() { return 1; }
# Real definitions come from lib/state.sh / lib/decision.sh, sourced below the
# SOURCE_ONLY guard; these stubs only keep bats-sourced helpers callable.
type mother_job_attention_add  >/dev/null 2>&1 || mother_job_attention_add()  { :; }
type mother_job_attention_drop >/dev/null 2>&1 || mother_job_attention_drop() { :; }
type mother_decision_open     >/dev/null 2>&1 || mother_decision_open()     { return 1; }

# Best-effort preview-stack teardown (mother_preview_stop). Sourced
# pre-SOURCE_ONLY-guard so _preview_pre_spawn / _preview_post_exit are
# bats-callable. A missing lib degrades to "nothing to stop".
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/preview.sh" ] && source "$MOTHER_LIB_DIR/preview.sh"
type mother_preview_stop >/dev/null 2>&1 || mother_preview_stop() { return 0; }

# _restore_auto_stash — put the operator's main-dir working tree back and
# record what happened. No-op unless isolation is main-dir and a stash marker
# path is set. Idempotent: mother_autostash_restore removes the marker, so a
# second call reports outcome "none" and emits nothing.
#
# MUST run before lock_release "${repo}:workspace": releasing first would let
# another main-dir job acquire the lock, see a clean tree (our stash is still
# in the stash list), and have our pop dump the operator's changes into it.
_restore_auto_stash() {
    [ "${isolation:-}" = "main-dir" ] || return 0
    [ -n "${stash_marker:-}" ] || return 0
    local res out kind detail
    res=$(mother_autostash_restore "${work_dir:-}" "$stash_marker" 2>/dev/null) || return 0
    out=$(mother_autostash_event_detail "$res") || return 0
    kind="${out%%$'\t'*}"
    detail="${out#*$'\t'}"
    _append_event "$kind" "$detail"
    return 0
}

# _exit_cleanup_workspace — EXIT-trap cleanup for main-dir workspace state:
# restore the auto-stash (first!), then release the workspace lock iff THIS
# supervisor acquired it. Safe to call repeatedly and from any exit path.
_exit_cleanup_workspace() {
    _restore_auto_stash
    if [ "${_workspace_lock_held:-0}" = "1" ]; then
        lock_release "${repo:-}:workspace" >/dev/null 2>&1 || true
        _workspace_lock_held=0
    fi
    return 0
}

# Parse a git remote URL to "owner/repo". Thin delegation to the shared
# prdetect.sh implementation — kept under this name because pr_url_capture.bats
# (and possibly other callers) source this file with SOURCE_ONLY=1 and assert
# on it directly.
_job_owner_repo_from_url() {
    prd_owner_repo_from_url "$1"
}

# Echoes the job's origin repo as "owner/repo" by reading $work_dir's git
# remote, or empty if work_dir is unset/missing or remote isn't GitHub.
_job_owner_repo() {
    [ -d "${work_dir:-}" ] || { echo ""; return; }
    local url
    url=$(cd "$work_dir" && git remote get-url origin 2>/dev/null) || { echo ""; return; }
    _job_owner_repo_from_url "$url"
}

# Scrape a log file for pull-request URLs belonging to the given owner/repo,
# ignoring foreign-repo placeholders. Echoes every distinct matching URL, newest
# (last occurrence) first, one per line — or nothing. A raw scrape is NOT
# evidence the job opened the PR: any doc, plan, `gh pr list` or `git log`
# output the worker reads can mention one. Callers must pass each URL through
# _accept_scraped_pr_url before recording it.
# Usage: _scrape_pr_urls_filtered <log_file> <owner_repo> [offset_bytes]
# When offset_bytes > 0, only bytes past that offset are scanned (escalation
# safety — prior runs are written at the head of a shared log file).
_scrape_pr_urls_filtered() {
    local _log="$1" _or="$2" _offset="${3:-0}"
    [ -f "$_log" ] || return 0
    local matches
    if [ "${_offset:-0}" -gt 0 ]; then
        matches=$(tail -c "+$((_offset + 1))" "$_log" 2>/dev/null \
            | grep -Eo 'https://github\.com/[^/]+/[^/]+/pull/[0-9]+' || true)
    else
        matches=$(grep -Eo 'https://github\.com/[^/]+/[^/]+/pull/[0-9]+' "$_log" 2>/dev/null || true)
    fi
    [ -n "$matches" ] || return 0
    if [ -n "$_or" ]; then
        matches=$(echo "$matches" | grep -F "https://github.com/${_or}/pull/" || true)
    fi
    [ -n "$matches" ] || return 0
    echo "$matches" | awk '{a[NR]=$0} END{for(i=NR;i>=1;i--)print a[i]}' | awk '!seen[$0]++'
}

# Last (newest) matching URL only. Same contract as before; unvalidated.
# Usage: _scrape_pr_url_filtered <log_file> <owner_repo> [offset_bytes]
_scrape_pr_url_filtered() {
    _scrape_pr_urls_filtered "$@" | head -1
}

# URLs already rejected (and event-logged) by _accept_scraped_pr_url's callers
# during this spawn — newline-separated. Reset at each spawn. Lets the live
# poll loop skip a rejected URL without re-querying gh or re-emitting
# pr_url_rejected on every tick.
_pr_rejected_urls=""

_pr_url_was_rejected() {
    case "
${_pr_rejected_urls:-}
" in *"
$1
"*) return 0 ;; esac
    return 1
}

# Transient gate failures (gh/network trouble rather than evidence) are NOT
# remembered as rejections — the next poll tick retries. One line per failure,
# so a URL's failure count is its line count. Capped per URL per spawn so a
# persistently broken gh can't be hammered forever; finalization takes over.
_pr_transient_failures=""
_PR_TRANSIENT_RETRY_CAP="${MOTHER_PR_TRANSIENT_RETRY_CAP:-10}"

_pr_gate_reason_is_transient() {
    case "$1" in
        pr_unresolved|evidence_indeterminate|gh_unavailable) return 0 ;;
    esac
    return 1
}

_pr_transient_count() {
    local n
    n=$(printf '%s\n' "${_pr_transient_failures:-}" | grep -cxF -- "$1") || n=0
    echo "$n"
}

# True when the live loop should not evaluate this URL again this spawn:
# definitively rejected, or transient failures hit the retry cap.
_pr_url_skip_live() {
    _pr_url_was_rejected "$1" && return 0
    [ "$(_pr_transient_count "$1")" -ge "$_PR_TRANSIENT_RETRY_CAP" ]
}

# Records a rejection and emits pr_url_rejected, once per URL per spawn.
# Definitive reasons are remembered (never re-queried); transient reasons are
# only counted, and the event carries transient: true.
# Usage: _reject_scraped_pr_url <url> <reason>
_reject_scraped_pr_url() {
    local transient=false
    _pr_url_was_rejected "$1" && return 0
    if _pr_gate_reason_is_transient "$2"; then
        transient=true
        local n; n=$(_pr_transient_count "$1")
        _pr_transient_failures="${_pr_transient_failures:-}${_pr_transient_failures:+
}$1"
        [ "$n" -eq 0 ] || return 0
    else
        _pr_rejected_urls="${_pr_rejected_urls:-}${_pr_rejected_urls:+
}$1"
    fi
    _append_event "pr_url_rejected" "$(jq -nc --arg url "$1" --arg reason "$2" --argjson transient "$transient" \
        'if $transient then {url: $url, reason: $reason, transient: true} else {url: $url, reason: $reason} end')"
}

# Gate for any PR URL scraped out of the worker transcript. Accepts the URL
# only when GitHub-side evidence ties the PR to THIS job:
#   - the PR's head branch is the job's branch, or expect_branch_mismatch is set
#     on the job, or the PR contains one of the job's own commits
#     (prd_pr_contains_sha over commits ahead of base_ref);
#   - and a PR that is already MERGED/CLOSED is rejected while the job has no
#     commits of its own beyond base_ref (a stale PR picked up at minute zero).
# Return codes: 0 accepted; 1 rejected; 2 gh missing (cannot verify at all).
# On non-zero, _pr_gate_reason holds the reason: gh_unavailable,
# pr_unresolved, merged_before_job_commits, closed_before_job_commits,
# head_branch_mismatch, evidence_indeterminate.
# Reads job_file, work_dir, branch, base_ref at call time. Emits no events —
# callers decide how to report.
# Usage: _accept_scraped_pr_url <url>
_accept_scraped_pr_url() {
    local url="$1" pv pv_state pv_head ahead cands sha rc indeterminate expect_mismatch
    _pr_gate_reason=""

    if ! command -v gh >/dev/null 2>&1; then
        _pr_gate_reason="gh_unavailable"
        return 2
    fi

    pv=$(gh pr view "$url" --json state,headRefName --jq '(.state)+"\t"+(.headRefName)' 2>/dev/null || true)
    if [ -z "$pv" ]; then
        _pr_gate_reason="pr_unresolved"
        return 1
    fi
    pv_state=""; pv_head=""
    IFS=$'\t' read -r pv_state pv_head <<GATE_PV_EOF
$pv
GATE_PV_EOF

    ahead=""
    if [ -n "${work_dir:-}" ] && [ -d "$work_dir" ] && [ -n "${base_ref:-}" ]; then
        ahead=$(cd "$work_dir" && git rev-list --count "${base_ref}..HEAD" 2>/dev/null || true)
    fi
    case "$ahead" in ''|*[!0-9]*) ahead="" ;; esac

    if [ "$pv_state" != "OPEN" ] && [ "$ahead" = "0" ]; then
        case "$pv_state" in
            MERGED) _pr_gate_reason="merged_before_job_commits" ;;
            *)      _pr_gate_reason="closed_before_job_commits" ;;
        esac
        return 1
    fi

    [ "$pv_head" = "${branch:-}" ] && return 0

    expect_mismatch=$(jq -r '.expect_branch_mismatch // false' "$job_file" 2>/dev/null)
    [ "$expect_mismatch" = "true" ] && return 0

    # No commits of its own: nothing can be "contained", and HEAD is just the
    # base commit (which a recently merged PR may well contain).
    if [ "$ahead" = "0" ]; then
        _pr_gate_reason="head_branch_mismatch"
        return 1
    fi

    cands=$(prd_candidate_shas "${work_dir:-}" "${branch:-}" "${base_ref:-}" 2>/dev/null)
    indeterminate=0
    if [ -n "$cands" ]; then
        while IFS= read -r sha; do
            [ -n "$sha" ] || continue
            prd_pr_contains_sha "$url" "$sha"
            rc=$?
            if [ "$rc" -eq 0 ]; then
                return 0
            elif [ "$rc" -eq 2 ]; then
                indeterminate=1
            fi
        done <<GATE_CAND_EOF
$cands
GATE_CAND_EOF
    fi

    if [ "$indeterminate" -eq 1 ]; then
        _pr_gate_reason="evidence_indeterminate"
    else
        _pr_gate_reason="head_branch_mismatch"
    fi
    return 1
}

# Live capture: called from the poll loop while the worker runs. Records the
# newest scraped URL that passes _accept_scraped_pr_url (job file .pr_url +
# one pr_opened event); every other URL is rejected once (pr_url_rejected) and
# never re-queried this spawn. Without gh nothing is recorded — a raw scrape
# is never trusted live; the post-run _finalize_pr_url covers that case.
_live_capture_pr_url() {
    local urls url
    urls=$(_scrape_pr_urls_filtered "$log_path" "$(_job_owner_repo)" "${log_offset_at_spawn:-0}")
    [ -n "$urls" ] || return 0
    while IFS= read -r url; do
        [ -n "$url" ] || continue
        _pr_url_skip_live "$url" && continue
        if _accept_scraped_pr_url "$url"; then
            _job_update ".pr_url = \"$url\""
            _append_event "pr_opened" "$(jq -nc --arg url "$url" '{url: $url}')"
            pr_url="$url" _gates_ensure_draft
            return 0
        fi
        _reject_scraped_pr_url "$url" "$_pr_gate_reason"
    done <<LIVE_URLS_EOF
$urls
LIVE_URLS_EOF
    return 0
}

# Finalization fallback: echoes the newest scraped URL that passes the gate, or
# nothing. With gh missing the gate cannot run, so — to keep today's offline
# behavior — the newest scraped URL is returned as-is, flagged by a
# pr_url_unverified event.
# Usage: _finalize_scrape_pr_url
_finalize_scrape_pr_url() {
    local urls url rc
    urls=$(_scrape_pr_urls_filtered "$log_path" "$(_job_owner_repo)" "${log_offset_at_spawn:-0}")
    [ -n "$urls" ] || return 0
    while IFS= read -r url; do
        [ -n "$url" ] || continue
        rc=0
        _accept_scraped_pr_url "$url" || rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "$url"
            return 0
        fi
        if [ "$rc" -eq 2 ]; then
            url=$(echo "$urls" | head -1)
            _append_event "pr_url_unverified" "$(jq -nc --arg url "$url" --arg reason "$_pr_gate_reason" \
                '{url: $url, reason: $reason, note: "gh unavailable; scraped PR URL recorded without verification"}')"
            echo "$url"
            return 0
        fi
        _reject_scraped_pr_url "$url" "$_pr_gate_reason"
    done <<FIN_URLS_EOF
$urls
FIN_URLS_EOF
    return 0
}

# Authoritative: ask GitHub which open PR has the given branch as head in the
# given repo. Echoes the URL or empty. Never reads the transcript. Thin
# delegation to prdetect.sh — kept under this name for the same reason as
# _job_owner_repo_from_url above.
# Usage: _derive_pr_url_from_branch <owner_repo> <branch>
_derive_pr_url_from_branch() {
    prd_pr_for_branch "$1" "$2"
}

# Validate the pr_url stored on a job file. Runs gh pr view to check the URL
# resolves and its headRefName matches the expected branch. Clears pr_url in
# the job file when the URL is unresolvable or points to the wrong branch.
# Does NOT emit events — the call site handles event emission.
# Usage: _validate_and_clear_pr_url <job_id> <branch>
_validate_and_clear_pr_url() {
    local _jid="$1" _branch="$2"
    local _jf="${JOBS_DIR}/${_jid}.json"
    [ -f "$_jf" ] || return
    local _url; _url=$(jq -r '.pr_url // empty' "$_jf" 2>/dev/null)
    [ -n "$_url" ] || return
    local _head; _head=$(gh pr view "$_url" --json headRefName -q '.headRefName' 2>/dev/null || true)
    if [ -z "$_head" ] || [ "$_head" != "$_branch" ]; then
        local _merged _tmp
        _merged=$(jq '.pr_url = null' "$_jf" 2>/dev/null) || return
        _tmp="${_jf}.tmp.$$"
        printf '%s' "$_merged" > "$_tmp" && mv "$_tmp" "$_jf"
    fi
}

# Verify the artifact: when we're about to mark `succeeded` but didn't
# capture a pr_url during the run, sanity-check that the branch was at
# least pushed to origin. Worktree jobs are spun off on a fresh branch
# whose implicit contract is "the work is shipped to that branch on
# origin." Trusting the `result` event alone (even with subtype=success)
# is how we ended up calling jobs succeeded after the agent yielded
# mid-work — e.g. when an agent uses `Monitor` to wait for lint and ends
# its turn expecting a follow-up turn that `claude -p` never delivers.
#
# Defined here (before the SOURCE_ONLY guard) rather than down near its call
# site so bats can unit-test it directly via SOURCE_ONLY=1 sourcing — it only
# references globals (job_file, branch, base_ref, isolation, work_dir,
# pr_url, id) and helper functions (_transition, _append_event, _job_update)
# that are resolved at CALL time, not at definition time, so moving the
# definition earlier changes nothing about real (non-test) execution: those
# globals/helpers are all still set up before this function is actually
# invoked, near the end of the script.
#
# Returns 0 to allow the caller to transition to succeeded; returns 1
# after having transitioned to failed itself, in which case the caller
# must NOT also transition.

# _verify_no_pr_commits_or_fail — the no_pr:true counterpart to the push/PR
# checks in _verify_artifact_or_fail below. A no_pr job opts out of "the
# branch must be on origin", but must still prove it actually did something:
# at least one commit ahead of base_ref. The ref counted differs by
# isolation:
#   - worktree: HEAD is a dedicated workspace and reliably reflects this
#     job's own work, even across a branch rename (see
#     .claude/bugs/*/2026-06-15-worker-ignores-assigned-branch-name.md).
#     Same measure _verify_artifact_or_fail's no_pr_no_push path already
#     uses below.
#   - main-dir: HEAD is NOT reliable at verification time. The main-dir
#     teardown block (search this file for "auto-stash to the operator's
#     original branch") runs BEFORE both call sites of
#     _verify_artifact_or_fail, and when a stash marker exists it checks out
#     the operator's ORIGINAL branch — so by the time this runs, HEAD may no
#     longer point at this job's branch at all. refs/heads/$branch is the
#     only trustworthy handle in that isolation.
#
# The contract is cumulative commits on the branch, not commits made by this
# specific worker run — deliberately not attributed by author/timestamp. In
# a pipeline, earlier phases' commits are already on the branch by the time
# a later phase (e.g. marty finding nothing to refactor) runs; that phase
# must still pass.
#
# An indeterminate count (unresolvable base_ref, missing/non-git work_dir, or
# a main-dir branch ref that no longer exists) fails closed with
# commit_check_indeterminate — a false succeeded is worse than a false
# failed, which at least escalates. Mirrors the precedent set in
# lib/prdetect.sh's prd_sha_on_origin (see the comment there).
#
# Defined here, before _verify_artifact_or_fail (which calls it), for the
# same SOURCE_ONLY bats-visibility reason documented on that function below:
# it only references globals (job_file, branch, base_ref, isolation,
# work_dir, pr_url) and helpers (_transition, _append_event) resolved at
# CALL time.
#
# Returns 0 to allow the caller to report success; returns 1 after having
# transitioned to failed itself, in which case the caller must NOT also
# transition.
_verify_no_pr_commits_or_fail() {
    # A captured pr_url means the artifact is already real regardless of
    # commit count; nothing further to prove.
    [ -z "${pr_url:-}" ] || return 0

    local tip_ref=""
    if [ -n "${work_dir:-}" ] && [ -d "$work_dir" ] \
        && (cd "$work_dir" && git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
        if [ "$isolation" = "worktree" ]; then
            tip_ref="HEAD"
        elif (cd "$work_dir" && git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null 2>&1); then
            tip_ref="refs/heads/$branch"
        fi
    fi

    local commits_ahead=""
    if [ -n "$tip_ref" ]; then
        commits_ahead=$(cd "$work_dir" && git rev-list --count "$base_ref..$tip_ref" 2>/dev/null)
        case "${commits_ahead:-}" in ''|*[!0-9]*) commits_ahead="" ;; esac
    fi

    if [ -z "$commits_ahead" ]; then
        _transition failed "$(jq -nc \
            --arg b "$branch" \
            --arg base "$base_ref" \
            --arg iso "$isolation" \
            --arg tip "${tip_ref:-}" \
            '{
                reason: "commit_check_indeterminate",
                branch: $b,
                base_ref: $base,
                isolation: $iso,
                tip_ref: (if ($tip | length) > 0 then $tip else null end),
                note: "could not determine commits ahead of base_ref for a no_pr job; failing closed rather than guessing success"
            }')"
        return 1
    fi

    if [ "$commits_ahead" -eq 0 ]; then
        local uncommitted=0
        uncommitted=$(cd "$work_dir" && git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        _transition failed "$(jq -nc \
            --arg b "$branch" \
            --arg base "$base_ref" \
            --arg iso "$isolation" \
            --arg tip "$tip_ref" \
            --argjson uncommitted "${uncommitted:-0}" \
            '{
                reason: "no_commits_on_branch",
                branch: $b,
                base_ref: $base,
                isolation: $iso,
                tip_ref: $tip,
                commits_ahead: 0,
                uncommitted_files: $uncommitted,
                note: "no_pr job reported success but the branch has no commits ahead of base_ref"
            }')"
        return 1
    fi

    _append_event "no_pr_commits_verified" "$(jq -nc \
        --arg b "$branch" \
        --arg base "$base_ref" \
        --arg tip "$tip_ref" \
        --argjson commits "$commits_ahead" \
        '{branch: $b, base_ref: $base, tip_ref: $tip, commits_ahead: $commits}')"
    return 0
}

# ---------------------------------------------------------------------------
# Rework-advance check (a run that started with a shipped artifact must move it)
#
# _verify_artifact_or_fail used to return 0 as soon as ANY pr_url was set, and
# (worktree jobs) as soon as the branch merely existed on origin. Once an
# earlier run had opened a PR, a later rework/resume run that made only local
# edits — or nothing at all — sailed through both checks and was reported
# `succeeded`. _capture_run_baseline snapshots "what already existed" before
# the worker spawns; _verify_run_advanced_or_fail then demands this run moved
# it. Both are defined pre-SOURCE_ONLY-guard so bats can drive them.
# ---------------------------------------------------------------------------

# Current tip of the job's own branch in $work_dir: HEAD for worktree jobs,
# refs/heads/$branch for main-dir jobs (HEAD may have been restored to the
# operator's branch by then). Echoes empty when unresolvable.
_run_head_sha() {
    [ -n "${work_dir:-}" ] && [ -d "$work_dir" ] || { echo ""; return 0; }
    local ref="HEAD"
    [ "${isolation:-}" = "main-dir" ] && ref="refs/heads/${branch:-}"
    (cd "$work_dir" && git rev-parse --verify --quiet "$ref" 2>/dev/null) || echo ""
}

# Echoes "<sha>" of origin's refs/heads/<ref> (empty if absent) and returns 0,
# or returns 1 (echoing nothing) when ls-remote itself failed.
_run_remote_sha() {
    local ref="$1" out
    [ -n "$ref" ] && [ -n "${work_dir:-}" ] && [ -d "$work_dir" ] || return 1
    out=$(cd "$work_dir" && git ls-remote origin "refs/heads/$ref" 2>/dev/null) || return 1
    printf '%s\n' "$out" | awk 'NR==1 {print $1}'
    return 0
}

_capture_run_baseline() {
    run_pr_url_at_start=$(jq -r '.pr_url // empty' "$job_file" 2>/dev/null)
    run_head_sha_at_start=$(_run_head_sha)
    run_remote_ref=$(jq -r '.actual_branch // .branch // empty' "$job_file" 2>/dev/null)
    [ -n "$run_remote_ref" ] || run_remote_ref="${branch:-}"
    local pr_open=false pv pv_state pv_head
    if [ -n "$run_pr_url_at_start" ]; then
        pv=$(gh pr view "$run_pr_url_at_start" --json state,headRefName --jq '(.state)+"\t"+(.headRefName)' 2>/dev/null)
        if [ -n "$pv" ]; then
            IFS=$'\t' read -r pv_state pv_head <<BASELINE_PV_EOF
$pv
BASELINE_PV_EOF
            if [ "$pv_state" = "OPEN" ]; then
                pr_open=true
                [ -z "$pv_head" ] || run_remote_ref="$pv_head"
            fi
        fi
    fi
    run_remote_check_at_start=ok
    if ! run_remote_sha_at_start=$(_run_remote_sha "$run_remote_ref"); then
        run_remote_sha_at_start=""
        run_remote_check_at_start=indeterminate
    fi
    run_had_artifact_at_start=false
    if [ "$pr_open" = "true" ] || [ -n "$run_remote_sha_at_start" ]; then
        run_had_artifact_at_start=true
    fi
    return 0
}

# ---------------------------------------------------------------------------
# RWX sandbox lifecycle (best-effort; never changes a job's outcome).
#
# Repos that commit .rwx/sandbox.yml run tests in an RWX cloud sandbox. A
# sandbox's identity is (git branch, config path), so a retried job on the same
# branch/worktree reconnects to a stale one: reset at the start of each fresh
# attempt. Stop it when the worker exits so it stops billing. Only events are
# emitted here — never _transition. Defined pre-SOURCE_ONLY-guard for bats.
# ---------------------------------------------------------------------------
_rwx_active=0
_rwx_post_exit_done=0

# Resets the sandbox when this spawn starts a fresh attempt. The attempt key is
# "<escalation_count>:<retry_count>"; an unchanged key means resume,
# idle-timeout continuation, adherence rework or a later pipeline phase, which
# keep the sandbox. The key is stored even when the reset fails, so a broken
# RWX doesn't add the reset timeout to every resume.
_rwx_pre_spawn() {
    _rwx_active=0
    local gate; gate=$(mother_rwx_gate "${work_dir:-}") || true
    case "$gate" in
        ok) ;;
        disabled|no_cli)
            _append_event "rwx_sandbox_reset" \
                "$(jq -nc --arg r "$gate" '{outcome: "skipped", reason: $r}')" 2>/dev/null || true
            return 0 ;;
        *) return 0 ;;
    esac
    _rwx_active=1

    local key stored result outcome
    key=$(jq -r '"\(.escalation_count // 0):\(.retry_count // 0)"' "$job_file" 2>/dev/null) || key=""
    [ -n "$key" ] || key="0:0"
    stored=$(jq -r '.rwx_sandbox.reset_key // empty' "$job_file" 2>/dev/null) || stored=""
    [ "$key" != "$stored" ] || return 0

    result=$(mother_rwx_sandbox reset "$work_dir" 2>/dev/null) || result=""
    printf '%s' "$result" | jq -e 'type == "object"' >/dev/null 2>&1 \
        || result='{"action":"reset","outcome":"error","exit_code":1,"output_tail":"no result from mother_rwx_sandbox"}'
    outcome=$(printf '%s' "$result" | jq -r '.outcome // "error"')
    _append_event "rwx_sandbox_reset" "$result" 2>/dev/null || true
    _job_update ".rwx_sandbox = $(jq -nc --arg k "$key" --arg at "$(iso_now)" --arg o "$outcome" \
        '{reset_key: $k, reset_at: $at, last_reset_outcome: $o}')" 2>/dev/null || true
    return 0
}

# Known gap: this does not run if mother-run-job is SIGKILLed (OOM, `kill -9`,
# host crash); the sandbox then bills until its own --inactivity-timeout (10m in
# admin-portal's sandbox.yml). mother-runner's orphan reaper stops it for
# worktree jobs (event reason: "orphan"); a host crash is bounded by the timeout.
#
# Stops this run's sandbox. Idempotent (the EXIT trap calls it too). Must run
# while the job branch is still checked out and the workspace lock is held: the
# stop is cwd+branch-keyed, and a main-dir stash-restore or lock release would
# let it hit the operator's (or another job's) sandbox.
_rwx_post_exit() {
    [ "${_rwx_active:-0}" = "1" ] || return 0
    [ "${_rwx_post_exit_done:-0}" = "0" ] || return 0
    _rwx_post_exit_done=1

    local result
    # Stale-supervisor guard: a newer worker owns the worktree (and sandbox).
    # Only meaningful once this run spawned a worker of its own.
    if [ -n "${worker_pid:-}" ] && \
       [ "$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)" != "$worker_pid" ]; then
        _append_event "rwx_sandbox_stop" \
            '{"outcome":"skipped","reason":"newer_worker"}' 2>/dev/null || true
        return 0
    fi
    result=$(mother_rwx_sandbox stop "${work_dir:-}" 2>/dev/null) || result=""
    printf '%s' "$result" | jq -e 'type == "object"' >/dev/null 2>&1 \
        || result='{"action":"stop","outcome":"error","exit_code":1,"output_tail":"no result from mother_rwx_sandbox"}'
    _append_event "rwx_sandbox_stop" "$result" 2>/dev/null || true
    return 0
}

# ---------------------------------------------------------------------------
# Preview stacks (`mother preview`): a worker may launch an RWX preview stack
# of its pushed branch. No stack outlives the worker that launched it: it is
# stopped after EVERY worker exit (and before a fresh attempt, in case a
# previous supervisor died). Stops are best-effort and emit events only
# (preview_stop) — never _transition. See lib/preview.sh.
# ---------------------------------------------------------------------------
_preview_post_exit_done=0

# True when the job carries a .preview record that isn't stopped yet.
_preview_pending() {
    [ -n "$(jq -r 'select(.preview != null and .preview.status != "stopped") | .id' "$job_file" 2>/dev/null)" ]
}

# Before a fresh spawn: a previous worker (or its dead supervisor) left a
# stack up. Stop it first so the new worker starts clean.
_preview_pre_spawn() {
    _preview_post_exit_done=0
    _preview_pending || return 0
    mother_preview_stop "$id" attempt_start 2>/dev/null || true
    return 0
}

# Stops this run's stack. Idempotent (the EXIT trap calls it too). Needs
# neither the worktree nor the workspace lock.
_preview_post_exit() {
    [ "${_preview_post_exit_done:-0}" = "0" ] || return 0
    _preview_post_exit_done=1
    _preview_pending || return 0
    # Stale-supervisor guard: a newer worker owns the job (and its stack).
    if [ -n "${worker_pid:-}" ] && \
       [ "$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)" != "$worker_pid" ]; then
        _append_event "preview_stop" \
            '{"outcome":"skipped","reason":"newer_worker"}' 2>/dev/null || true
        return 0
    fi
    mother_preview_stop "$id" worker_exit 2>/dev/null || true
    return 0
}

# ---------------------------------------------------------------------------
# Quality gates (HC-06 observe, HC-08 enforce). After the worker exits and the
# PR url is settled, run the job's `.crew` gates against the head commit and
# record the outcome as `.gates` plus gates_started / gate_result /
# gates_completed events.
#
# Observe (HC-06) never changes state, failure_reason, the PR or any prompt.
# Enforce (HC-08, `.crew.gates.mode == "enforce"`, non-pipeline jobs) keeps the
# PR a draft, sends blocking failures back to the same worker session, and on
# exhaustion holds the job (`awaiting`/`gate_hold`) with a decision. It never
# touches current_tier, escalation_count or retry_count (G14).
#
# Must run before the main-dir restore / lock release (HEAD must still be the
# job branch). Runs only for a run heading for success, never for a cancelled,
# paused or superseded one. `.gates` carries ids, enums, counts and durations
# only: gate output stays in $MOTHER_ROOT/crew/<id>/gates/<attempt>/.
# ---------------------------------------------------------------------------
_gates_applicable() {
    [ "${MOTHER_GATES_ENABLED:-1}" != "0" ] || return 1
    type mother_gates_run >/dev/null 2>&1 || return 1
    jq -e '(.crew.gates.checks // []) | length > 0' "$job_file" >/dev/null 2>&1 || return 1
    [ "${cancel_requested:-0}" -eq 0 ] || return 1
    if [ -n "${reaped_reason:-}" ]; then
        [ "${final_result_epoch:-0}" -gt 0 ] || return 1
    else
        [ "${exit_code:-1}" = "0" ] || return 1
    fi
    [ "$(jq -r '.state // ""' "$job_file" 2>/dev/null)" != "awaiting" ] || return 1
    # Stale-supervisor guard: a newer worker owns the worktree.
    if [ -n "${worker_pid:-}" ] && \
       [ "$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)" != "$worker_pid" ]; then
        return 1
    fi
    return 0
}

# True when this job's gates are enforced: crew mode enforce, gates enabled,
# not a pipeline job (pipelines are gated in observe only until HC-15).
_gates_enforced() {
    [ "${MOTHER_GATES_ENABLED:-1}" != "0" ] || return 1
    jq -e '.crew.gates.mode == "enforce" and ((.crew.gates.checks // []) | length > 0)
           and (.kind // "") != "pipeline"' "$job_file" >/dev/null 2>&1
}

# Extra keys merged into `.gates` by enforce-mode attempts ('{}' for observe).
_gates_extra_json='{}'
# Status of the last _gates_run_attempt.
_gates_status=""

# _gates_run_attempt <attempt> <max> <effective_mode> <restore-activity-json> <posture>
# One gate pass: sets activity=gating, runs mother_gates_run (bounded by the
# budget), emits the gate events, writes `.gates` and restores the activity.
# Sets _gates_status.
_gates_run_attempt() {
    local attempt="$1" max_attempts="$2" effective_mode="$3" restore_activity="$4" posture="$5"
    local mode started_at head_sha crew_file out_dir
    _gates_status="incomplete"
    mode=$(jq -r '.crew.gates.mode // "observe"' "$job_file" 2>/dev/null) || mode=observe
    started_at=$(iso_now)
    head_sha=$(git -C "${work_dir:-.}" rev-parse HEAD 2>/dev/null) || head_sha=""

    crew_file=$(mktemp "${TMPDIR:-/tmp}/mother-crew.XXXXXX" 2>/dev/null) || return 0
    jq -c '.crew' "$job_file" >"$crew_file" 2>/dev/null || { rm -f "$crew_file"; return 0; }
    out_dir="$MOTHER_ROOT/crew/$id/gates/$attempt"
    mkdir -p "$out_dir" 2>/dev/null && rm -f "${out_dir:?}"/*.log "${out_dir:?}"/*.excerpt

    _job_update ".activity = \"gating\"" 2>/dev/null || true
    _append_event "gates_started" "$(jq -nc \
        --argjson attempt "$attempt" --argjson max "$max_attempts" --arg head "$head_sha" \
        --arg mode "$mode" --arg posture "$posture" --slurpfile crew "$crew_file" \
        '{attempt: $attempt, max_attempts: $max, head_sha: $head, mode: $mode, posture: $posture,
          gates: [$crew[0].gates.checks[].name]}')" 2>/dev/null || true

    # Only a no_pr job may be gated on an unpushed head. A PR job must have
    # pushed what it is being gated on, or results would be recorded against a
    # commit CI never sees.
    local -a unpushed_flag=()
    ! _gates_job_no_pr || unpushed_flag=(--allow-unpushed)

    # Bound the whole gate run (not just each check): a main-dir job holds the
    # repo's workspace lock while it gates. Overrunning the budget kills the run
    # and records it as incomplete, never passed.
    local budget_min budget_s
    budget_min=$(jq -r '.crew.gates.budget_minutes // 15' "$job_file" 2>/dev/null) || budget_min=15
    case "$budget_min" in ''|*[!0-9]*) budget_min=15 ;; esac
    budget_s="${MOTHER_GATES_TOTAL_TIMEOUT_S:-$((budget_min * 60))}"
    _GATES_RESULT_FILE="$out_dir/.result.json"
    rm -f "$_GATES_RESULT_FILE"
    _gates_run_to_file() { mother_gates_run "$@" >"$_GATES_RESULT_FILE" 2>/dev/null; }

    local result=""
    mother_watchdog_run "$budget_s" "$out_dir/.total" "${work_dir:-.}" _gates_run_to_file \
        "${work_dir:-}" "$crew_file" "$base_ref" "$out_dir" \
        --posture "$posture" --attempt "$attempt" ${unpushed_flag[@]+"${unpushed_flag[@]}"}
    if [ "${MOTHER_WD_OUTCOME:-}" = "done" ] && [ -s "$_GATES_RESULT_FILE" ]; then
        result=$(cat "$_GATES_RESULT_FILE" 2>/dev/null) || result=""
    elif [ "${MOTHER_WD_OUTCOME:-}" = "timeout" ]; then
        echo "mother-run-job: $id: gates exceeded the total budget of ${budget_s}s; run cut off and recorded as incomplete" >&2
    fi
    rm -f "$_GATES_RESULT_FILE"
    # No result (budget overrun, crash): every check is unavailable, so the
    # run is incomplete and names exactly what did not run. Never passed.
    if ! printf '%s' "$result" | jq -e 'type == "object" and (.results | type == "array")' >/dev/null 2>&1; then
        local why=gates_error
        [ "${MOTHER_WD_OUTCOME:-}" = "timeout" ] && why=gates_timeout
        result=$(jq -nc --arg head "$head_sha" --arg posture "$posture" --argjson attempt "$attempt" \
            --arg why "$why" --slurpfile crew "$crew_file" '
            [$crew[0].gates.checks[] | {name, result: "unavailable", blocking: (.blocking != false),
              duration_s: 0, exit_code: null, unavailable_reason: $why, skip_reason: null}] as $r
            | {status: "incomplete", head_sha: $head, posture: $posture, results: $r,
               not_run: [$r[].name], attempt: $attempt}')
    fi
    rm -f "$crew_file"

    local finished_at gates_json
    finished_at=$(iso_now)
    gates_json=$(printf '%s' "$result" | jq -c \
        --arg mode "$mode" --arg eff "$effective_mode" --argjson max "$max_attempts" --argjson attempt "$attempt" \
        --arg started "$started_at" --arg finished "$finished_at" --argjson extra "$_gates_extra_json" '
        {mode: $mode, effective_mode: $eff, posture: .posture, status: .status,
         attempt: $attempt, max_attempts: $max, head_sha: .head_sha,
         started_at: $started, finished_at: $finished,
         results: [.results[] | {name, result, blocking, duration_s, exit_code, unavailable_reason, skip_reason}],
         not_run: .not_run} + $extra')

    local ev
    while IFS= read -r ev; do
        [ -n "$ev" ] || continue
        _append_event "gate_result" "$ev" 2>/dev/null || true
    done < <(printf '%s' "$gates_json" | jq -c --argjson attempt "$attempt" \
        '.results[] | {attempt: $attempt, name, result, blocking, duration_s, exit_code}')
    _append_event "gates_completed" "$(printf '%s' "$gates_json" | jq -c '
        {attempt, status,
         passed: ([.results[] | select(.result == "passed")] | length),
         failed: ([.results[] | select(.result == "failed")] | length),
         unavailable: ([.results[] | select(.result == "unavailable")] | length),
         not_run}')" 2>/dev/null || true

    _job_update ".gates = $gates_json | .activity = $restore_activity" 2>/dev/null || true
    _gates_status=$(printf '%s' "$gates_json" | jq -r '.status // "incomplete"')
    return 0
}

_run_gates_observe() {
    _gates_applicable || return 0
    local max_attempts posture prev_activity
    max_attempts=$(jq -r '.crew.gates.max_attempts // 3' "$job_file" 2>/dev/null) || max_attempts=3
    prev_activity=$(jq -c '.activity // null' "$job_file" 2>/dev/null) || prev_activity=null
    posture=$(_resolve_posture 2>/dev/null) || posture=normal
    [ -n "$posture" ] || posture=normal
    _gates_extra_json='{}'
    _gates_run_attempt 1 "$max_attempts" observe "$prev_activity" "$posture"
    return 0
}

# _run_gates — the post-run gate step: enforce loop or observe pass.
_run_gates() {
    _gates_applicable || return 0
    if _gates_enforced; then
        _run_gates_enforce
    else
        _run_gates_observe
    fi
}

# True when the job is a no_pr job (no push or PR calls are made for it).
_gates_job_no_pr() {
    [ "$(jq -r '.no_pr // false' "$job_file" 2>/dev/null)" = "true" ]
}

# The job's PR url: the captured global, else the stored one.
_gates_pr_url() {
    local url="${pr_url:-}"
    [ -n "$url" ] || url=$(jq -r '.pr_url // empty' "$job_file" 2>/dev/null)
    printf '%s' "$url"
}

# First attempt number for this run. A continuation resumes the attempt count
# of the run it continues (a fix run that idled out); every other run starts
# a fresh budget.
_gates_start_attempt() {
    local max="$1" prev n=1
    if [ "${run_activity_at_start:-}" = "continuation" ]; then
        prev=$(jq -r 'if .gates.effective_mode == "enforce" and .gates.status == "failed"
                      then (.gates.attempt // 0) else 0 end' "$job_file" 2>/dev/null) || prev=0
        case "$prev" in ''|*[!0-9]*) prev=0 ;; esac
        n=$((prev + 1))
        [ "$n" -le "$max" ] || n="$max"
    fi
    echo "$n"
}

# Draft discipline (B3): an enforce-mode PR stays a draft until Mother marks it
# ready. Converts a non-draft PR back to draft; checked once per URL per worker
# turn (_gates_fix clears the memo after every fix turn).
_pr_draft_ok_url=""
_gates_ensure_draft() {
    local url is_draft
    url=$(_gates_pr_url)
    [ -n "$url" ] || return 0
    [ "$url" != "$_pr_draft_ok_url" ] || return 0
    _gates_enforced || return 0
    ! _gates_job_no_pr || return 0
    is_draft=$(gh pr view "$url" --json isDraft --jq '.isDraft' 2>/dev/null) || is_draft=""
    case "$is_draft" in
        true) _pr_draft_ok_url="$url" ;;
        false)
            if gh pr ready "$url" --undo >/dev/null 2>&1; then
                _pr_draft_ok_url="$url"
                _append_event "pr_marked_draft" "$(jq -nc --arg url "$url" '{reason: "gates_pending", pr_url: $url}')"
            else
                _append_event "pr_draft_unverified" "$(jq -nc --arg url "$url" '{pr_url: $url, action: "undo_ready"}')"
            fi ;;
        *)
            _append_event "pr_draft_unverified" "$(jq -nc --arg url "$url" '{pr_url: $url, action: "view"}')" ;;
    esac
    return 0
}

# _gates_write_fix_prompt <attempt> <max> <file> — the gate-fix turn sent to
# the worker: each red blocking gate with its excerpt (read from the side
# file; it goes to the worker, never on the wire) and hint.
_gates_write_fix_prompt() {
    local n="$1" max="$2" file="$3" name excerpt_file hint exit_c head
    head=$(jq -r '(.gates.head_sha // "") | .[0:12]' "$job_file" 2>/dev/null)
    {
        printf '# Quality gates failed: attempt %s/%s\n\n' "$n" "$max"
        printf 'Mother ran the quality gates on your head commit `%s` and these blocking gates failed.\n\n' "$head"
        for name in $(mother_gates_red_json "$job_file" | jq -r '.[]'); do
            exit_c=$(jq -r --arg n "$name" '.gates.results[] | select(.name == $n) | .exit_code // "?"' "$job_file")
            case "$name" in
                clean_tree) hint="commit or discard your changes" ;;
                pushed)     hint="push your branch to origin" ;;
                *)          hint=$(jq -r --arg n "$name" '.crew.gates.checks[]? | select(.name == $n) | .hint // empty' "$job_file") ;;
            esac
            printf '## Gate `%s` (exit %s)\n\n' "$name" "$exit_c"
            excerpt_file="$MOTHER_ROOT/crew/$id/gates/$n/$name.excerpt"
            if [ -s "$excerpt_file" ]; then
                printf 'Output excerpt (last lines):\n\n````\n'
                cat "$excerpt_file"
                printf '\n````\n\n'
            else
                printf '(no output captured)\n\n'
            fi
            [ -n "$hint" ] && printf 'Hint: %s\n\n' "$hint"
        done
        printf -- '---\n\n'
        printf 'Fix the cause of each failure above, then commit and push to the same branch (`%s`).\n' "$branch"
        printf 'Do not open a second PR. Never suppress a check, add a baseline or ignore entry, or skip a test\n'
        printf 'to turn a gate green, unless the plan says to. Once you have pushed, stop: Mother re-runs the\n'
        printf 'gates. This was attempt %s of %s.\n' "$n" "$max"
    } >"$file" 2>/dev/null
}

# _gates_spawn_failed_immediately <spawned 0|1> — after a resume spawn: true
# when it never started, exited non-zero or produced no result event (session
# not found and the like). Cancel, pause and reaps go their normal ways.
_gates_spawn_failed_immediately() {
    [ "${1:-0}" = "1" ] || return 0
    [ "${cancel_requested:-0}" -eq 0 ] || return 1
    [ "$(jq -r '.state // ""' "$job_file" 2>/dev/null)" != "awaiting" ] || return 1
    [ -z "${reaped_reason:-}" ] || return 1
    [ "${exit_code:-1}" = "0" ] || return 0
    tail -c "+$((${log_offset_at_spawn:-0} + 1))" "$log_path" 2>/dev/null \
        | grep -Eq '"type"[[:space:]]*:[[:space:]]*"result"' && return 1
    return 0
}

# _new_session_id — a fresh lower-case uuid (or empty).
_new_session_id() {
    local sid
    sid=$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z')
    if [ -z "$sid" ] && [ -r /proc/sys/kernel/random/uuid ]; then
        sid=$(cat /proc/sys/kernel/random/uuid)
    fi
    printf '%s' "$sid"
}

# _gates_fix <attempt> <max> <restore-activity-json> — one gate-fix turn in the
# job's existing session (fresh fallback if that can't start). Returns 0 when
# the fix run completed and the gates should run again; 1 when the run stopped
# (cancel, await, pause, idle reap, failure, superseded) and the normal
# post-exit path takes over; 2 when no fix turn could be started (the caller
# holds the job rather than letting red gates through).
_gates_fix() {
    local n="$1" max="$2" restore="$3" fixfile red sid spawned=0
    fixfile="$RUNNER_DIR/$id.gatefix.$n.md"
    red=$(mother_gates_red_json "$job_file")
    _gates_write_fix_prompt "$n" "$max" "$fixfile" || return 2

    # The run that produced this head is over: record its usage before the
    # next spawn moves the log offset, and refresh actual_cost_usd so the
    # fix run's --max-cost check counts it.
    _record_run_usage_for_last_spawn "gates_failed" "${last_run_kind:-worker}"
    mother_recompute_job_cost "$id" 2>/dev/null || true

    _job_update '.activity = "gate_fix"'
    sid=$(jq -r '.session_id // ""' "$job_file" 2>/dev/null)
    _append_event "gate_fix_started" "$(jq -nc --argjson a "$n" --argjson m "$max" --arg s "$sid" --argjson red "$red" \
        '{attempt: $a, max_attempts: $m, session_id: $s, red: $red, mode: "resume"}')"
    _spawn_and_wait resume "$fixfile" && spawned=1
    last_run_kind=gate_fix

    if _gates_spawn_failed_immediately "$spawned"; then
        if [ "$spawned" = "1" ]; then
            _record_run_usage_for_last_spawn "failed" gate_fix '{"resume_failed": true}'
            mother_recompute_job_cost "$id" 2>/dev/null || true
        fi
        next_session_id=$(_new_session_id)
        _append_event "gate_fix_started" "$(jq -nc --argjson a "$n" --argjson m "$max" --arg s "$next_session_id" --argjson red "$red" \
            '{attempt: $a, max_attempts: $m, session_id: $s, red: $red, mode: "fresh_fallback"}')"
        spawn_prompt_prefix_file="$fixfile"
        _spawn_and_wait fresh
        spawn_prompt_prefix_file=""
        next_session_id=""
    fi
    rm -f "$fixfile"
    # The fix turn could have marked the PR ready itself: re-check draft state.
    _pr_draft_ok_url=""

    # A superseded supervisor must not touch the job again.
    if [ -n "${worker_pid:-}" ] && \
       [ "$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)" != "$worker_pid" ]; then
        return 1
    fi
    _job_update ".activity = $restore"
    _gates_applicable
}

# _gates_present <passed|incomplete> — present the PR for human review: gates
# block in the body, mark ready. Incomplete adds `gates_incomplete` attention.
# no_pr jobs (and jobs without a PR url) make no PR calls (G19).
_gates_present() {
    local status="$1" url reason="gates_passed"
    [ "$status" = "incomplete" ] && reason="gates_incomplete"
    url=$(_gates_pr_url)
    if ! _gates_job_no_pr && [ -n "$url" ]; then
        mother_prbody_write_gates "$url" "$(jq -c '.gates' "$job_file")" \
            || echo "mother-run-job: $id: could not write the gates block into $url" >&2
        if gh pr ready "$url" >/dev/null 2>&1; then
            _append_event "pr_marked_ready" "$(jq -nc --arg r "$reason" --arg url "$url" '{reason: $r, pr_url: $url}')"
        else
            _append_event "pr_draft_unverified" "$(jq -nc --arg url "$url" --arg r "$reason" '{pr_url: $url, action: "ready", reason: $r}')"
        fi
    fi
    if [ "$status" = "incomplete" ]; then
        mother_job_attention_add "$id" gates_incomplete
    else
        mother_job_attention_drop "$id" gates_incomplete
    fi
    return 0
}

# _gates_hold <attempts> — the attempt budget is spent and blocking gates are
# still red: make sure the branch is on origin (never force), then hold the job
# for the operator with a gate_hold decision. Never succeeded, failed or
# escalated. `.question` is Mother-written and carries no gate output.
_gates_hold() {
    local n="$1" red red_csv push_ref head remote="" pushed=false location q
    red=$(mother_gates_red_json "$job_file")
    red_csv=$(printf '%s' "$red" | jq -r 'join(", ")')
    push_ref=$(jq -r '.actual_branch // .branch // empty' "$job_file" 2>/dev/null)
    [ -n "$push_ref" ] || push_ref="$branch"
    head=$(git -C "${work_dir:-.}" rev-parse HEAD 2>/dev/null) || head=""

    if _gates_job_no_pr; then
        location="not pushed: no_pr job; local branch $branch in $work_dir at ${head:0:12}"
    else
        remote=$(_run_remote_sha "$push_ref" 2>/dev/null) || remote=""
        if [ -n "$head" ] && [ "$remote" = "$head" ]; then
            pushed=true
        elif [ -n "$head" ] && (cd "$work_dir" && GIT_TERMINAL_PROMPT=0 git push -q origin "HEAD:refs/heads/$push_ref" >/dev/null 2>&1); then
            pushed=true
        fi
        if [ "$pushed" = "true" ]; then
            location="pushed to origin/$push_ref at ${head:0:12}"
        else
            location="not pushed: git push of HEAD to origin/$push_ref failed or was rejected; local branch $branch in $work_dir at ${head:0:12}"
        fi
    fi

    _append_event "gates_exhausted" "$(jq -nc --argjson a "$n" --argjson red "$red" --arg h "$head" --argjson p "$pushed" \
        '{attempts: $a, red: $red, head_sha: $h, pushed: $p}')"

    q=$(printf '%s\n' \
        "Quality gates are still failing after $n/$n attempt(s): $red_csv." \
        "Branch: $location." \
        "Gate output and hints: mother status $id" \
        "Choose one:" \
        "  mother resume $id \"<guidance>\"            resume this worker session with your guidance" \
        "  mother resume $id --option escalate       re-run one model tier higher" \
        "  mother resume $id --option override_open  open the PR for review anyway (override recorded)" \
        "  mother resume $id --option cancel         cancel the job; the branch is left in place")

    local merged
    merged=$(jq --arg q "$q" --arg ts "$(iso_now)" '
        .state = "awaiting" | .activity = "gate_hold" | .paused_reason = "gate_hold"
        | .paused_at = $ts | .question = $q' "$job_file") && _atomic_write "$job_file" "$merged"
    mother_decision_open "$id" gate_hold '["resume_with_guidance","escalate","override_open","cancel"]' >/dev/null \
        || echo "mother-run-job: $id: could not open the gate_hold decision" >&2
    mother_job_attention_add "$id" decision_awaiting
    _append_event "awaiting_input" "$(jq -nc --arg q "$q" '{question: $q, paused_reason: "gate_hold"}')"
    return 0
}

# _gates_still_ours — false (after setting cancel_requested for the post-exit
# path) when the job was cancelled while the gates ran, or false when a newer
# supervisor owns it. Gate runs can take budget_minutes; the spawn poll loop
# is the only other place that notices either.
_gates_still_ours() {
    if [ "$(jq -r '.cancel_requested // false' "$job_file" 2>/dev/null)" = "true" ]; then
        cancel_requested=1
        return 1
    fi
    if [ -n "${worker_pid:-}" ] && \
       [ "$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)" != "$worker_pid" ]; then
        return 1
    fi
    return 0
}

# _run_gates_enforce — the enforce gate loop (HC-08). See the section header.
_run_gates_enforce() {
    local max posture orig_activity n
    posture=$(_resolve_posture 2>/dev/null) || posture=normal
    [ -n "$posture" ] || posture=normal
    max=$(jq -r '.crew.gates.max_attempts // 3' "$job_file" 2>/dev/null) || max=3
    case "$max" in ''|*[!0-9]*|0) max=3 ;; esac
    [ "$posture" = "conservative" ] && max=1
    orig_activity=$(jq -c '.activity // null' "$job_file" 2>/dev/null) || orig_activity=null
    case "$orig_activity" in '"gating"'|'"gate_fix"'|'"gate_hold"') orig_activity=null ;; esac
    n=$(_gates_start_attempt "$max")
    _gates_extra_json=$(jq -nc --arg r "${gates_budget_reset_by:-}" \
        'if $r != "" then {budget_reset_by: $r} else {} end')

    # The worker may have marked its PR ready after live capture checked it.
    _pr_draft_ok_url=""
    _gates_ensure_draft
    local rc
    while :; do
        _gates_run_attempt "$n" "$max" enforce "$orig_activity" "$posture"
        # A cancel or a newer supervisor that arrived while the gates ran wins.
        _gates_still_ours || break
        case "$_gates_status" in
            passed|incomplete) _gates_present "$_gates_status"; break ;;
        esac
        if [ "$n" -ge "$max" ]; then
            _gates_hold "$n"
            break
        fi
        rc=0
        _gates_fix "$n" "$max" "$orig_activity" || rc=$?
        if [ "$rc" -eq 2 ]; then
            _gates_hold "$n"
            break
        fi
        [ "$rc" -eq 0 ] || break
        _finalize_pr_url
        _gates_ensure_draft
        n=$((n + 1))
    done
    _gates_extra_json='{}'
    return 0
}

# _emit_rework_advance_verified <ref> <sha_at_start> <sha_at_end> [via]
_emit_rework_advance_verified() {
    _append_event "rework_advance_verified" "$(jq -nc \
        --arg ref "$1" --arg s "$2" --arg e "$3" --arg via "${4:-}" \
        '{remote_ref: $ref, remote_sha_at_start: $s, remote_sha_at_end: $e}
         + (if $via != "" then {via: $via} else {} end)')"
}

# Returns 0 when the run may proceed to the ordinary artifact checks; returns 1
# after having transitioned to failed (rework_no_new_commit) itself.
_verify_run_advanced_or_fail() {
    [ "${MOTHER_REWORK_ADVANCE_CHECK_ENABLED:-1}" != "0" ] || return 0
    # Pipeline phases legitimately make no commits (e.g. marty finding nothing
    # to refactor); the pipeline driver owns that contract.
    [ "$(jq -r '.kind // empty' "$job_file" 2>/dev/null)" != "pipeline" ] || return 0
    # Without a pre-existing artifact the ordinary no_pr_no_push logic below
    # already catches a run that shipped nothing.
    [ "${run_had_artifact_at_start:-false}" = "true" ] || return 0
    # Operator guidance on a gate hold may need no new commit (e.g. "re-run,
    # it was flaky"): green gates on the pushed head are the proof of work.
    if [ "${gates_budget_reset_by:-}" = "resume" ] \
       && [ "$(jq -r '.gates.effective_mode == "enforce" and (.gates.status == "passed" or .gates.status == "incomplete")' "$job_file" 2>/dev/null)" = "true" ]; then
        return 0
    fi

    local ref="${run_remote_ref:-}" start_sha="${run_remote_sha_at_start:-}"
    local end_sha="" origin_check=ok

    if ! end_sha=$(_run_remote_sha "$ref"); then
        end_sha=""
        origin_check=indeterminate
    fi

    if [ "$origin_check" = "ok" ]; then
        if [ -n "${pr_url:-}" ] && [ "${pr_url:-}" != "${run_pr_url_at_start:-}" ]; then
            _emit_rework_advance_verified "$ref" "$start_sha" "$end_sha" new_pr
            return 0
        fi
        if [ -n "$end_sha" ] && [ "$end_sha" != "$start_sha" ]; then
            _emit_rework_advance_verified "$ref" "$start_sha" "$end_sha"
            return 0
        fi
    fi

    local head_end uncommitted=0 local_advanced=false
    head_end=$(_run_head_sha)
    if [ -n "$head_end" ] && [ "$head_end" != "${run_head_sha_at_start:-}" ]; then
        local_advanced=true
    fi
    if [ -n "${work_dir:-}" ] && [ -d "$work_dir" ]; then
        uncommitted=$(cd "$work_dir" && git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    fi

    _transition failed "$(jq -nc \
        --arg pr "${pr_url:-${run_pr_url_at_start:-}}" \
        --arg ref "$ref" --arg rs "$start_sha" --arg re "$end_sha" \
        --arg hs "${run_head_sha_at_start:-}" --arg he "$head_end" \
        --argjson la "$local_advanced" \
        --argjson unc "${uncommitted:-0}" \
        --arg oc "$origin_check" \
        '{
            reason: "rework_no_new_commit",
            pr_url: $pr,
            remote_ref: $ref,
            remote_sha_at_start: $rs,
            remote_sha_at_end: $re,
            head_sha_at_start: $hs,
            head_sha_at_end: $he,
            local_advanced: $la,
            uncommitted_files: $unc,
            origin_check: $oc,
            note: "run started with an existing PR/pushed branch and ended without pushing anything new to it"
        }')"
    return 1
}

_verify_artifact_or_fail() {
    # Plans with no_pr:true opt out of the push/PR contract below, but the
    # commits-on-branch contract is enforced, not skipped — see
    # _verify_no_pr_commits_or_fail above.
    local job_no_pr; job_no_pr=$(jq -r '.no_pr // false' "$job_file" 2>/dev/null)
    if [ "$job_no_pr" = "true" ]; then
        _verify_no_pr_commits_or_fail
        return $?
    fi

    # A run that began with a shipped artifact must have advanced it.
    _verify_run_advanced_or_fail || return 1

    # If a pr_url was captured (live or post-loop), the artifact is real.
    [ -z "${pr_url:-}" ] || return 0
    # Only worktree jobs carry the "branch must be on origin" contract.
    # main-dir jobs share a workspace and can't be verified this way.
    [ "$isolation" = "worktree" ] || return 0
    [ -d "$work_dir" ] || return 0  # worktree gone — don't fail spuriously

    if (cd "$work_dir" && git ls-remote --exit-code origin "$branch" >/dev/null 2>&1); then
        # Branch on origin — work shipped to remote, just no PR opened.
        # Probably still a success (some workflows push without opening
        # a PR; some PR-opening tools fail silently after the push). Note
        # it on the events trail so an operator can decide whether to open
        # the PR by hand.
        _append_event "no_pr_url_but_branch_pushed" \
            "$(jq -nc --arg b "$branch" '{branch: $b}')"
        return 0
    fi

    # The assigned branch isn't on origin — but the worker's HEAD commit may
    # still have shipped under a DIFFERENT branch name (it renamed the
    # branch, or deliberately/accidentally pushed to an existing PR's
    # branch). That is still real, shipped work; only the branch-naming
    # contract was missed, not the actual delivery. See
    # .claude/bugs/*/2026-06-15-worker-ignores-assigned-branch-name.md.
    if prd_sha_on_origin "$work_dir" "$base_ref"; then
        local origin_refs
        origin_refs=$(cd "$work_dir" && git branch -r --contains HEAD 2>/dev/null \
            | sed 's/^[* ]*//' | tr '\n' ',' | sed 's/,$//')
        _append_event "pushed_to_other_branch" \
            "$(jq -nc --arg b "$branch" --arg refs "$origin_refs" \
                '{job_branch: $b, origin_refs: $refs}')"
        return 0
    fi

    # Branch is NOT on origin → nothing was pushed → work didn't ship,
    # regardless of what the result event claimed. Gather context that'll
    # help the operator decide whether to retry or hand-finish.
    local commits_ahead=0 uncommitted=0
    commits_ahead=$(cd "$work_dir" && git rev-list --count "$base_ref..HEAD" 2>/dev/null || echo 0)
    uncommitted=$(cd "$work_dir" && git status --porcelain 2>/dev/null | wc -l | tr -d ' ')

    _transition failed "$(jq -nc \
        --arg b "$branch" \
        --arg base "$base_ref" \
        --argjson commits "${commits_ahead:-0}" \
        --argjson uncommitted "${uncommitted:-0}" \
        '{
            reason: "no_pr_no_push",
            branch: $b,
            base_ref: $base,
            local_commits_ahead_of_base: $commits,
            uncommitted_files: $uncommitted,
            note: "agent emitted result event but never pushed the branch; work is not on origin"
        }')"
    return 1
}

# Parses a "<url>\t<kind>\t<sha>" triple (prd_detect_pr's output shape) into
# the caller's hit_url/hit_kind/hit_sha variables — used by _finalize_pr_url,
# which declares those three `local` before calling this. Clears all three
# first, so an empty/no-hit input leaves them empty rather than stale from a
# previous call.
#
# Defined here (before the SOURCE_ONLY guard), same rationale as
# _verify_artifact_or_fail above: bats needs to reach it via
# SOURCE_ONLY=1 sourcing, and it only touches globals/helpers resolved at
# call time, so moving the definition earlier changes nothing about real
# execution.
_split_pr_hit() {
    hit_url=""; hit_kind=""; hit_sha=""
    [ -n "${1:-}" ] || return 0
    IFS=$'\t' read -r hit_url hit_kind hit_sha <<PRHIT_EOF
$1
PRHIT_EOF
}

# Emits the pr_opened event, but only on first capture — re-emitting it for a
# pr_url that was already recorded (stale re-derivation, branch-mismatch
# acceptance of an already-stored URL) would double-count in the events
# trail. Reads first_capture/pr_url from _finalize_pr_url's local scope.
_maybe_emit_pr_opened() {
    [ "$first_capture" -eq 1 ] || return 0
    _append_event "pr_opened" "$(jq -nc --arg url "$pr_url" '{url: $url}')"
}

# _finalize_pr_url — authoritative post-run PR URL capture, stale-URL
# re-derivation, and branch-mismatch validation. Sets the global `pr_url`
# (read by _verify_artifact_or_fail and the terminal-transition detail blobs
# below). Evidence-based: uses lib/prdetect.sh to match on commit content, not
# just branch name, so a worker that pushed to a differently-named branch (or
# landed on top of an existing open PR) is still recognised — see
# .claude/bugs/*/2026-06-15-worker-ignores-assigned-branch-name.md and
# .claude/bugs/*/2026-08-14-review-phase-silently-reviews-wrong-repo-*.md.
#
# Resolution order:
#   1. A stored pr_url that's still OPEN is trusted as-is (cheap, common case).
#   2. A stored pr_url that's NOT open gets re-derived via prd_detect_pr; a
#      different, better URL replaces it (pr_url_updated).
#   3. No stored pr_url: prd_detect_pr (branch match, then commit match),
#      falling back to the repo-filtered log scrape as a last resort.
#   4. Whatever pr_url survives #1-3 gets branch-mismatch validation: an exact
#      branch match is accepted outright; a mismatch is accepted when
#      expect_branch_mismatch is set on the job, or when one of the job's
#      candidate commits is confirmed present on the PR (pr_branch_mismatch_
#      accepted, recording .actual_branch); a confirmed miss clears pr_url
#      (pr_url_branch_mismatch, unchanged from before); an indeterminate gh
#      failure during the commit check leaves the URL untouched
#      (pr_branch_mismatch_unverified) — never destroy a pointer because the
#      network wobbled.
#
# Defined here (before the SOURCE_ONLY guard) for the same reason as
# _verify_artifact_or_fail and the two helpers above: it only references
# globals (job_file, work_dir, branch, base_ref, log_path,
# log_offset_at_spawn, pr_url) and helper functions (_append_event,
# _job_update, _job_owner_repo, _scrape_pr_url_filtered, and the prd_*
# functions) that are resolved at CALL time, so bats can source and invoke it
# directly with SOURCE_ONLY=1, with those globals/helpers stubbed or set up
# by the test itself.
_finalize_pr_url() {
    local stored_url pv pv_state pv_head hit hit_url hit_kind hit_sha
    local first_capture=0 expect_mismatch cands sha rc accepted indeterminate matched_sha

    expect_mismatch=$(jq -r '.expect_branch_mismatch // false' "$job_file" 2>/dev/null)
    stored_url=$(jq -r '.pr_url // empty' "$job_file" 2>/dev/null)
    pr_url="$stored_url"
    pv_head=""

    # --- stale-URL re-derivation (only when a pr_url is already stored) ---
    if [ -n "$pr_url" ]; then
        pv=$(gh pr view "$pr_url" --json state,headRefName --jq '(.state)+"\t"+(.headRefName)' 2>/dev/null)
        pv_state=""; pv_head=""
        if [ -n "$pv" ]; then
            IFS=$'\t' read -r pv_state pv_head <<PV_EOF
$pv
PV_EOF
        fi

        if [ -n "$pv_state" ] && [ "$pv_state" != "OPEN" ]; then
            hit=$(prd_detect_pr "$work_dir" "$branch" "$base_ref" 2>/dev/null)
            _split_pr_hit "$hit"
            if [ -n "$hit_url" ] && [ "$hit_url" != "$pr_url" ]; then
                _append_event "pr_url_updated" "$(jq -nc \
                    --arg prev "$pr_url" --arg url "$hit_url" --arg pstate "$pv_state" \
                    --arg mk "$hit_kind" --arg msha "${hit_sha:-}" \
                    '{previous_url: $prev, url: $url, previous_state: $pstate, reason: "stale_pr_replaced",
                      match_kind: $mk, matched_sha: (if ($msha|length) > 0 then $msha else null end)}')"
                _job_update ".pr_url = \"$hit_url\""
                pr_url="$hit_url"
                if [ "$hit_kind" = "branch" ]; then
                    pv_head="$branch"
                else
                    pv_head=$(gh pr view "$pr_url" --json headRefName -q '.headRefName' 2>/dev/null || true)
                fi
            fi
        fi
    fi

    # --- first capture (nothing usable was stored) ---
    if [ -z "$pr_url" ]; then
        hit=$(prd_detect_pr "$work_dir" "$branch" "$base_ref" 2>/dev/null)
        _split_pr_hit "$hit"
        if [ -z "$hit_url" ] && [ -f "$log_path" ]; then
            hit_url=$(_finalize_scrape_pr_url)
            hit_kind="scrape"
        fi
        if [ -n "$hit_url" ]; then
            pr_url="$hit_url"
            first_capture=1
            if [ "$hit_kind" = "branch" ]; then
                pv_head="$branch"
            elif [ "$hit_kind" = "commit" ]; then
                pv_head=$(gh pr view "$pr_url" --json headRefName -q '.headRefName' 2>/dev/null || true)
            fi
        fi
    fi

    [ -n "${pr_url:-}" ] || return 0

    if [ -z "$pv_head" ]; then
        pv_head=$(gh pr view "$pr_url" --json headRefName -q '.headRefName' 2>/dev/null || true)
    fi

    if [ "$first_capture" -eq 1 ]; then
        _job_update ".pr_url = \"$pr_url\""
    fi

    if [ -z "$pv_head" ]; then
        # URL did not resolve (wrong repo, nonexistent PR, network error, etc.)
        _append_event "pr_url_unresolved" \
            "$(jq -nc --arg url "$pr_url" --arg job_branch "$branch" \
                '{note: "pr_url could not be resolved by gh pr view; clearing",
                  pr_url: $url, job_branch: $job_branch}')"
        _job_update ".pr_url = null"
        pr_url=""
        return 0
    fi

    if [ "$pv_head" = "$branch" ]; then
        _maybe_emit_pr_opened
        return 0
    fi

    # --- branch mismatch ---
    if [ "$expect_mismatch" = "true" ]; then
        _job_update ".actual_branch = \"$pv_head\""
        _append_event "pr_branch_mismatch_accepted" \
            "$(jq -nc --arg url "$pr_url" --arg prb "$pv_head" --arg jb "$branch" \
                '{pr_url: $url, pr_branch: $prb, job_branch: $jb, matched_sha: null, expected: true}')"
        _maybe_emit_pr_opened
        return 0
    fi

    cands=$(prd_candidate_shas "$work_dir" "$branch" "$base_ref" 2>/dev/null)
    accepted=0; indeterminate=0; matched_sha=""
    if [ -n "$cands" ]; then
        while IFS= read -r sha; do
            [ -n "$sha" ] || continue
            prd_pr_contains_sha "$pr_url" "$sha"
            rc=$?
            if [ "$rc" -eq 0 ]; then
                accepted=1; matched_sha="$sha"; break
            elif [ "$rc" -eq 2 ]; then
                indeterminate=1
            fi
        done <<CAND_EOF
$cands
CAND_EOF
    fi

    if [ "$accepted" -eq 1 ]; then
        _job_update ".actual_branch = \"$pv_head\""
        _append_event "pr_branch_mismatch_accepted" \
            "$(jq -nc --arg url "$pr_url" --arg prb "$pv_head" --arg jb "$branch" --arg sha "$matched_sha" \
                '{pr_url: $url, pr_branch: $prb, job_branch: $jb, matched_sha: $sha}')"
        _maybe_emit_pr_opened
        return 0
    fi

    if [ "$indeterminate" -eq 1 ]; then
        _append_event "pr_branch_mismatch_unverified" \
            "$(jq -nc --arg url "$pr_url" --arg prb "$pv_head" --arg jb "$branch" \
                '{pr_url: $url, pr_branch: $prb, job_branch: $jb}')"
        _maybe_emit_pr_opened
        return 0
    fi

    # Confirmed miss: no candidate commit is on this PR at all.
    _append_event "pr_url_branch_mismatch" \
        "$(jq -nc --arg url "$pr_url" --arg pr_branch "$pv_head" --arg job_branch "$branch" \
            '{note: "pr_url headRefName does not match job branch; clearing stale URL",
              pr_url: $url, pr_branch: $pr_branch, job_branch: $job_branch}')"
    _job_update ".pr_url = null"
    pr_url=""
    # One more authoritative re-derivation attempt before giving up — the
    # worker may have opened the (correct) PR moments before we checked.
    hit_url=$(prd_pr_for_branch "$(_job_owner_repo)" "$branch" 2>/dev/null)
    if [ -n "$hit_url" ]; then
        _job_update ".pr_url = \"$hit_url\""
        pr_url="$hit_url"
    fi
    return 0
}

# _install_core_job_helpers — (re)defines iso_now/_atomic_write/_with_lock/
# _append_line/_append_event/_job_update/_transition as a single source of
# truth for their bodies. Bash function definitions written inside another
# function's body still install plain, script-global functions when that
# outer function runs (function names aren't block-scoped in bash) — so
# calling this once here (before the SOURCE_ONLY guard, for bats) and once
# again below (after sourcing lib/state.sh, for real execution) reinstalls
# byte-identical definitions both times without hand-copying the function
# bodies in two places that could silently drift apart. See the second call
# site below for why a second call is required at all.
#
# Delegates to _iso_now (sourced from state.sh) so worker-written timestamps
# match the millisecond RFC 3339 format used everywhere else in job JSON.
_install_core_job_helpers() {
    iso_now() { _iso_now; }
    _atomic_write() {
        # NB: `path` collides with zsh's special array for PATH — use _target.
        local _target="$1" content="$2" tmp="${1}.tmp.$$"
        printf '%s' "$content" > "$tmp" && mv "$tmp" "$_target"
    }
    _with_lock() {
        local target="$1"; shift
        local lockdir="${target}.lockdir"
        local tries=0
        while ! mkdir "$lockdir" 2>/dev/null; do
            sleep 0.05
            tries=$((tries + 1))
            [ "$tries" -gt 200 ] && { echo "mother-run-job: could not acquire lock for $target after 10s" >&2; return 1; }
        done
        "$@"
        local rc=$?
        rmdir "$lockdir" 2>/dev/null || true
        return $rc
    }
    _append_line() { printf '%s\n' "$2" >> "$1"; }
    _append_event() {
        local kind="$1" detail="${2:-}"
        [ -z "$detail" ] && detail='{}'
        local ev _eventpath
        ev=$(jq -nc --arg ts "$(iso_now)" --arg kind "$kind" --argjson detail "$detail" \
            '{ts: $ts, kind: $kind, detail: $detail}')
        _eventpath="$EVENTS_DIR/$id.jsonl"
        _with_lock "$_eventpath" _append_line "$_eventpath" "$ev"
    }
    _job_update() {
        local filter="$1"
        local merged; merged=$(jq "$filter" "$job_file") || return 1
        _atomic_write "$job_file" "$merged"
    }
    _transition() {
        local new="$1" detail="${2:-}"
        [ -z "$detail" ] && detail='{}'
        # D2 guard: a `failed` transition must always carry a .reason. A caller
        # that omitted one gets "unspecified" plus a failure_reason_missing
        # event naming the caller, so "no bare failed events" holds structurally
        # even for call sites this feature didn't audit.
        if [ "$new" = "failed" ]; then
            local _has_reason
            _has_reason=$(printf '%s' "$detail" | jq -r 'has("reason")' 2>/dev/null)
            if [ "$_has_reason" != "true" ]; then
                detail=$(printf '%s' "$detail" | jq -c '. + {reason: "unspecified"}' 2>/dev/null) || detail='{"reason":"unspecified"}'
                _append_event "failure_reason_missing" \
                    "$(jq -nc --arg caller "${FUNCNAME[1]:-unknown}" '{caller: $caller}')"
            fi
        fi
        _job_update ".state = \"$new\""
        # Persist the failure reason on the job JSON so the runner can route on
        # it without replaying the events log. A new `failed` clears any prior
        # routing verdict; `succeeded` clears a stale reason.
        case "$new" in
            failed)
                local _reason_lit
                _reason_lit=$(_failure_reason_literal "$detail") || _reason_lit='"unspecified"'
                _job_update ".failure_reason = $_reason_lit | .failure_routed = null" ;;
            succeeded)
                _job_update ".failure_reason = null" ;;
        esac
        case "$new" in
            running)    _job_update ".started_at = \"$(iso_now)\"" ;;
            succeeded|failed|cancelled)
                        _job_update ".finished_at = \"$(iso_now)\""
                        _job_update ".force_start = null | .force_ignore_deps = null"
                        type mother_recompute_job_cost >/dev/null 2>&1 && mother_recompute_job_cost "$id" ;;
        esac
        _append_event "$new" "$detail"
    }
}
_install_core_job_helpers

# _failure_reason_literal's canonical definition lives in lib/state.sh (see
# there — it's shared with _job_transition so the "missing/blank reason
# becomes unspecified" rule can't drift between the two copies). state.sh
# isn't sourced yet at this point (real execution sources it further down;
# SOURCE_ONLY=1 bats sourcing returns before ever reaching that source line),
# so install a byte-identical fallback now for _transition (called above the
# guard, both for real dry-run-free execution before re-sourcing and for
# SOURCE_ONLY=1 tests) to call. Real execution re-sources state.sh below,
# which overwrites this with the canonical definition; keep this in sync
# with lib/state.sh's version if that normalization rule ever changes.
type _failure_reason_literal >/dev/null 2>&1 || _failure_reason_literal() {
    printf '%s' "$1" | jq -c '(.reason // "") | tostring | if . == "" then "unspecified" else . end' 2>/dev/null || echo '"unspecified"'
}

# _terminate_worker: SIGTERM the wrapper + its direct children, wait up to
# 10s for them to exit, then SIGKILL stragglers. We hit the children
# explicitly because the cancel/reap path has historically just SIGTERM'd
# the wrapper, which would leave a hung claude orphaned (the failure mode
# this bug fix is closing). With the wrapper's signal trap in place, the
# direct kill is mostly belt-and-suspenders, but it's also what saves us
# if the wrapper itself has somehow died.
_terminate_worker() {
    local kids
    kids=$(pgrep -P "$worker_pid" 2>/dev/null || true)
    [ -n "$kids" ] && kill -TERM $kids 2>/dev/null || true
    kill -TERM "$worker_pid" 2>/dev/null || true
    local waited=0
    while kill -0 "$worker_pid" 2>/dev/null && [ "$waited" -lt 10 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if kill -0 "$worker_pid" 2>/dev/null; then
        kids=$(pgrep -P "$worker_pid" 2>/dev/null || true)
        [ -n "$kids" ] && kill -KILL $kids 2>/dev/null || true
        kill -KILL "$worker_pid" 2>/dev/null || true
    fi
}

# _log_mtime: epoch seconds of the log file's last write, or 0 if missing.
# Wrapped because macOS uses `stat -f %m` and Linux uses `stat -c %Y`.
_log_mtime() {
    [ -f "$log_path" ] || { echo 0; return; }
    stat -f %m "$log_path" 2>/dev/null \
        || stat -c %Y "$log_path" 2>/dev/null \
        || echo 0
}

# _spawn_and_wait <mode> [prompt_file] — spawn one claude worker for this job
# and block until it exits (or is cancelled / paused / reaped). Everything it
# sets (worker_pid, log_offset_at_spawn, marker_file, exit_code, session_id,
# cancel_requested, reaped_reason, ...) is a script global: the post-exit path
# reads them. Defined before the SOURCE_ONLY guard so bats can drive it.
#
#   fresh   the normal path: new session (`--session-id`), plan/preamble prompt
#           built and any pending operator answer consumed.
#   resume  re-enter the job's existing `.session_id` (`--resume`) with the given
#           prompt file on stdin; used for quality-gate fix turns. Skips the
#           prompt build and pending_answer consumption.
#
# Each call has its own marker/wrapper files and its own log_offset_at_spawn,
# so a caller can record the finished run (`_record_run_usage_for_last_spawn`)
# before spawning the next one.
_spawn_and_wait() {
    local mode="${1:-}" resume_prompt="${2:-}"
    local session_flag stdin_prompt spawn_sfx
    case "$mode" in
        fresh) ;;
        resume)
            if [ ! -r "$resume_prompt" ]; then
                echo "_spawn_and_wait: resume needs a readable prompt file (got: '$resume_prompt')" >&2
                return 1
            fi
            ;;
        *)
            echo "_spawn_and_wait: unknown mode '$mode' (expected fresh|resume)" >&2
            return 2
            ;;
    esac

    if [ "$mode" = "resume" ]; then
        # Resume: re-enter the job's existing claude session (same session id,
        # prompt cache intact). No plan/preamble build and no pending_answer
        # consumption: the caller supplies the whole prompt in $resume_prompt.
        session_id=$(jq -r '.session_id // empty' "$job_file" 2>/dev/null)
        stdin_prompt="$resume_prompt"
        session_flag="--resume"
        if [ -z "$session_id" ]; then
            echo "_spawn_and_wait: cannot resume - job $id has no .session_id" >&2
            return 1
        fi
    else
        session_flag="--session-id"
        # Generate a deterministic session ID and pass it to claude via --session-id
        # so the transcript filename is predictable. Without this, main-dir jobs
        # sharing a work_dir all land in the same ~/.claude/projects/<slug>/ and
        # `mother peek` can't tell them apart — it falls back to newest-mtime,
        # which conflates sibling workers and any user's foreground Claude session
        # in the same directory.
        # (A caller may preset next_session_id, e.g. to name the session in an
        # event before the spawn.)
        session_id="${next_session_id:-}"
        [ -n "$session_id" ] || session_id=$(_new_session_id)
        if [ -n "$session_id" ]; then
            _job_update ".session_id = \"$session_id\""
        fi

        # Compose the spawn-time prompt. The on-disk plan file stays the user's
        # authored content; everything Mother adds (the await/resume capability
        # preamble, plus any resume context from a previous pause cycle) is
        # layered in at spawn time and written to a single $RUNNER_DIR/$id.prompt.md
        # that becomes the prompt claude actually receives.
        #
        #   [preamble]              ← from $MOTHER_PREAMBLE_PATH or the shipped
        #                             template; tells the agent how to call
        #                             `mother await`. Empty / disabled by pointing
        #                             MOTHER_PREAMBLE_PATH at /dev/null or a
        #                             missing file.
        #   [resume context]        ← only on resume cycles: previous question,
        #                             operator's answer, worktree-state heads-up.
        #   [user's plan]           ← exact contents of $plan_path, untouched.
        #
        # Continuation, operator resume and adherence rework still start a fresh
        # session: the augmented prompt + the worktree itself (which still carries
        # the in-progress changes from before the pause) preserve continuity. Resume
        # mode (`_spawn_and_wait resume <prompt_file>`, i.e. `claude -p --resume
        # <session-id>`) re-enters the SAME session and is used for quality-gate
        # fix turns, which supply their own prompt file.

        spawn_prompt="$RUNNER_DIR/$id.prompt.md"
        preamble_path="${MOTHER_PREAMBLE_PATH:-$MOTHER_LIB_DIR/../templates/preamble.md}"
        gates_enforce_path="$MOTHER_LIB_DIR/../templates/gates-enforce.md"
        pending_answer=$(jq -r '.pending_answer // empty' "$job_file" 2>/dev/null || echo "")
        prev_question=$(jq -r '.question // empty'       "$job_file" 2>/dev/null || echo "")

        {
            if [ -r "$preamble_path" ] && [ -s "$preamble_path" ]; then
                cat "$preamble_path"
                printf '\n---\n\n'
            fi

            # Enforce-mode gates (HC-08): draft PRs, same-session gate fixes.
            if _gates_enforced && [ -r "$gates_enforce_path" ]; then
                cat "$gates_enforce_path"
                printf '\n---\n\n'
            fi

            # Routing context stanza: insert after preamble, before plan (or resume context).
            # Tells the worker agent which model/effort it's running at and how to configure sub-agents.
            printf '%s\n\n' "$routing_context"

            # A gate-fix turn that could not resume its session (fresh
            # fallback) carries the gate-fix text ahead of the plan.
            if [ -n "${spawn_prompt_prefix_file:-}" ] && [ -r "$spawn_prompt_prefix_file" ]; then
                cat "$spawn_prompt_prefix_file"
                printf '\n---\n\n'
            fi

            if [ "$kind" = "pipeline" ] && [ -n "$phase_agent" ]; then
                # ---- Pipeline phase prompt: request-type-driven ----
                # Renders a header identifying the request type and one titled section
                # per input key declared by rt_inputs, in declaration order (D1/D2).
                # The resume/continuation path is legacy-only in W2 — pipeline jobs do
                # not use mother await for phases yet (that is W4's concern).
                _contract=$(rt_contract "$phase_agent" "$phase_request_type" 2>/dev/null \
                    || echo "(no contract description)")
                printf '# Request type: %s:%s\n\n' "$phase_agent" "$phase_request_type"
                printf '%s\n\n' "$_contract"
                printf '---\n\n'
                # Collect the declared input keys. Using a variable + <<< (here-string)
                # keeps the while-loop body in the current shell scope (bash 3.2-safe),
                # unlike a pipe or heredoc which may fork a subshell and lose variable
                # assignments in the loop body.
                _inputs_list=$(rt_inputs "$phase_agent" "$phase_request_type" 2>/dev/null || echo "")
                # Pre-check whether 'plan' is declared; always include it as the spine
                # even if a future request type somehow omits it from rt_inputs.
                _declared_plan=$(printf '%s\n' "$_inputs_list" | grep -c '^plan$' 2>/dev/null || echo 0)
                while IFS= read -r _input_key; do
                    [ -z "$_input_key" ] && continue
                    phase_render_input "$_input_key" "$work_dir" "$plan_path" \
                        "${prd_path:-}" "${base_ref:-}" "$job_file" "$phase_agent"
                done <<< "$_inputs_list"
                if [ "${_declared_plan:-0}" -eq 0 ]; then
                    phase_render_input "plan" "$work_dir" "$plan_path" \
                        "${prd_path:-}" "${base_ref:-}" "$job_file" "$phase_agent"
                fi
            else
                # ---- Legacy (non-pipeline) prompt: preamble + routing + plan ----
                # This path is byte-for-byte the pre-W2 behavior. No pipeline header.
                if [ -n "$pending_answer" ]; then
                    printf '# Resumed plan — operator answered your question\n\n'
                    printf 'A previous worker on this job paused itself with `mother await`.\n'
                    printf 'The operator has answered. Pick up from where the prior worker left off.\n\n'
                    printf '## The question you (or your predecessor) asked\n\n'
                    if [ -n "$prev_question" ]; then
                        printf '%s\n\n' "$prev_question"
                    else
                        printf '_(no question recorded — this should not happen; proceed with the answer below as guidance)_\n\n'
                    fi
                    printf "## The operator's answer\n\n"
                    printf '%s\n\n' "$pending_answer"
                    printf '## Worktree state at pause time\n\n'
                    printf 'Your work directory at `%s` retains all changes and commits from the\n' "$work_dir"
                    printf 'previous run — your branch is `%s`. Run `git status` and `git log --oneline`\n' "$branch"
                    printf 'before resuming so you orient yourself in the in-progress work.\n\n'
                    printf '## Original plan (for reference)\n\n'
                fi

                cat "$plan_path"
            fi
        } > "$spawn_prompt"
        resolved_plan_path="$spawn_prompt"

        if [ -n "$pending_answer" ]; then
            # Consume the answer + question so the next spawn (if any) starts clean.
            # Keep resumed_at / resume_count for the audit trail.
            merged=$(jq '.pending_answer = null | .question = null' "$job_file") \
                && _atomic_write "$job_file" "$merged"
            _append_event "resumed_from_input" \
                "$(jq -nc --arg q "$prev_question" --arg a "$pending_answer" --arg p "$spawn_prompt" \
                    '{question: $q, answer: $a, resume_prompt: $p}')"
        fi

        stdin_prompt="$resolved_plan_path"
    fi

    # Each call gets its own marker/wrapper files (the first keeps the historical
    # names; later calls get a `.<n>` suffix) so a second call never sees the
    # previous call's exit marker. The previous call's leftovers are removed here.
    if [ "${spawn_seq:-0}" -gt 0 ]; then
        rm -f "${marker_file:-}" "${wrapper:-}"
    fi
    spawn_seq=$(( ${spawn_seq:-0} + 1 ))
    spawn_sfx=""
    [ "$spawn_seq" -gt 1 ] && spawn_sfx=".$spawn_seq"

    marker_file="$RUNNER_DIR/$id.exit$spawn_sfx"
    wrapper="$RUNNER_DIR/$id.wrap$spawn_sfx"
    # Job-scoped Docker Compose project name (see mother_compose_project in
    # state.sh). Computed here, not inside the heredoc, so it interpolates at
    # generation time like $branch/$worker_agent below.
    compose_project=$(mother_compose_project "$id")
    # Job-scoped TMPDIR for the worker: temp files (build scratch, test
    # fixtures, tool sockets) land under $MOTHER_ROOT/tmp/<id> instead of the
    # shared system temp dir, so teardown / `mother gc` can remove exactly this
    # job's leftovers and nothing else. Empty (no TMPDIR export) if it can't be made.
    job_tmp="$MOTHER_ROOT/tmp/$id"
    mkdir -p "$job_tmp" 2>/dev/null || job_tmp=""
    job_tmp_export=""
    [ -n "$job_tmp" ] && job_tmp_export="export TMPDIR=$(printf '%q' "$job_tmp")"

    # --effort + MCP-scope args (lib/usage.sh). Rendered at generation time
    # (the wrapper is a plain generated script, not a live shell) with printf
    # '%q' so quoting stays sane regardless of what the args contain.
    mother_claude_extra_args "$worker_effort" worker
    extra_claude_args_quoted=""
    if [ "${#MOTHER_CLAUDE_ARGS[@]}" -gt 0 ]; then
        for _extra_arg in "${MOTHER_CLAUDE_ARGS[@]}"; do
            extra_claude_args_quoted="$extra_claude_args_quoted $(printf '%q' "$_extra_arg")"
        done
    fi

    # --max-cost enforcement (F3): only when the job has a cap. Writes a
    # job-scoped Claude settings file wiring the PreToolUse cost-gate hook, and
    # clears any stale cost-cap flag left over from a previous poll cycle.
    max_cost_usd=$(jq -r '.max_cost_usd // empty' "$job_file" 2>/dev/null)
    cost_cap_flag="$RUNNER_DIR/$id.cost-cap"
    rm -f "$cost_cap_flag"
    settings_args_quoted=""
    if [ -n "$max_cost_usd" ]; then
        settings_file="$RUNNER_DIR/$id.settings.json"
        cost_gate_hook="$MOTHER_LIB_DIR/../hooks/mother-cost-gate.sh"
        jq -n --arg cmd "$cost_gate_hook" \
            '{hooks: {PreToolUse: [{matcher: "*", hooks: [{type: "command", command: $cmd}]}]}}' \
            > "$settings_file" 2>/dev/null
        settings_args_quoted=" $(printf '%q' --settings) $(printf '%q' "$settings_file")"
    fi

    cat > "$wrapper" <<WRAP
#!/usr/bin/env bash
cd "$work_dir"
exec > >(tee -a "$log_path") 2>&1
# Export the job id so an in-worker agent can call \`mother await --question
# "..."\` without bookkeeping. Without this, the agent has no clean way to
# discover which job it belongs to.
export MOTHER_JOB_ID="$id"
# Workers get the live state path as MOTHER_LIVE_ROOT, never MOTHER_ROOT: a test
# or script run by the worker that inherited MOTHER_ROOT would treat the real
# tree as its own scratch space (2026-10-17: a killed bats run deleted it).
# Every Mother entry point falls back to MOTHER_LIVE_ROOT when MOTHER_ROOT is
# unset, so in-worker mother await / mother status still find the real tree.
# (This is an unquoted heredoc: no backticks or dollar signs in comments.)
export MOTHER_LIVE_ROOT="$MOTHER_ROOT"
# Drop any MOTHER_ROOT inherited from the daemon environment, too.
unset MOTHER_ROOT
# Docker Compose reads COMPOSE_PROJECT_NAME automatically, so any
# `docker compose up` the worker runs lands in a job-scoped project with
# zero convention-following required by the plan or the agent. Mother tears
# this project down once the job's PR is merged/closed (see lib/teardown.sh).
export COMPOSE_PROJECT_NAME="$compose_project"
# Job-scoped scratch dir (created above; removed at teardown / by \`mother gc\`).
$job_tmp_export
# Export effort for agents that honor MOTHER_EFFORT (e.g. to set thinking budgets).
export MOTHER_EFFORT="$worker_effort"
echo "=== mother job $id starting at \$(date) ==="
echo "=== working dir: \$PWD ==="
echo "=== branch:      $branch ==="
echo "=== agent:       $worker_agent ==="
echo "=== model:       $worker_model ==="
echo "=== effort:      $worker_effort ==="
echo "=== tier:        $current_tier ==="
echo "=== session-id:  $session_id ==="
echo "=== compose:     $compose_project ==="
echo "=== plan:        $stdin_prompt ==="
echo
# stream-json + verbose gives us a live per-event log (one JSON object per
# line). \`mother logs --follow\` pretty-prints these via mother-stream-pretty;
# the raw file stays authoritative and greppable.
#
# Run claude in the background so we can forward signals to it. Without this,
# a SIGTERM to the wrapper would kill bash and orphan claude — which is the
# failure mode mother's reaper needs to escape when claude refuses to exit
# after emitting its final 'result' event. With the trap in place, a SIGTERM
# to the wrapper unblocks claude (gracefully on a healthy session, after
# SIGKILL escalation from mother-run-job on a wedged one), 'wait' returns
# its real exit code, and the marker file is written normally.
# The prompt is fed on stdin from the plan file (never argv: argv is visible
# to \`ps\` and EDR command-line scanners). The explicit redirect matters:
# bash would otherwise give a backgrounded job /dev/null as stdin.
claude_pid=""
_forward_signal() {
    [ -n "\$claude_pid" ] && kill -TERM "\$claude_pid" 2>/dev/null || true
}
trap _forward_signal TERM INT
claude --dangerously-skip-permissions --agent "$worker_agent" --model "$worker_model"$extra_claude_args_quoted$settings_args_quoted $session_flag "$session_id" -p --output-format stream-json --verbose < "$stdin_prompt" &
claude_pid=\$!
# wait may be interrupted by the trap (signal raises EINTR and bash returns
# 128+sig); loop until claude is actually gone before recording its real
# exit code.
rc=0
while :; do
    wait "\$claude_pid" 2>/dev/null
    rc=\$?
    kill -0 "\$claude_pid" 2>/dev/null || break
done
echo "\$rc" > "$marker_file"
WRAP

    chmod +x "$wrapper"

    # Capture the log file's size BEFORE spawning (moved ahead of the nohup
    # below so `.current_run.log_offset` — used by orphan recovery to record a
    # usage row for a dead run — always reflects this run's true starting
    # offset, never a byte written by the process we're about to start). The
    # wrapper tees to $log_path with `-a`, so on resume cycles the file already
    # contains content from previous runs (one per pause/resume). The
    # result-event detector in the poll loop below uses this offset to ignore
    # content older than this run — without it, the resumed worker's poll loop
    # would see the previous run's `result` event (the one emitted around the
    # `mother await` call) and immediately start the post-result-grace timer,
    # reaping the worker 5 min later regardless of what it's actually doing.
    log_offset_at_spawn=0
    _pr_rejected_urls=""   # rejected-scrape memory is per spawn (see _reject_scraped_pr_url)
    _pr_transient_failures=""
    if [ -f "$log_path" ]; then
        log_offset_at_spawn=$(stat -f %z "$log_path" 2>/dev/null \
            || stat -c %s "$log_path" 2>/dev/null \
            || echo 0)
    fi

    nohup bash "$wrapper" >/dev/null 2>&1 &
    worker_pid=$!
    disown 2>/dev/null || true
    _job_update ".worker_pid = $worker_pid"
    _job_update ".current_run = $(jq -nc \
        --argjson lo "$log_offset_at_spawn" --arg at "$(iso_now)" --arg sid "$session_id" --arg md "$mode" \
        --arg hs "${run_head_sha_at_start:-}" --arg rr "${run_remote_ref:-}" \
        --arg rs "${run_remote_sha_at_start:-}" --arg pu "${run_pr_url_at_start:-}" \
        --argjson ha "${run_had_artifact_at_start:-false}" \
        '{log_offset: $lo, spawned_at: $at, session_id: $sid,
          head_sha_at_start: $hs, remote_ref: $rr, remote_sha_at_start: $rs,
          pr_url_at_start: $pu, had_artifact_at_start: $ha, mode: $md}')"
    _append_event "worker_spawned" "$(jq -nc --argjson pid "$worker_pid" --arg sid "$session_id" --arg md "$mode" '{pid: $pid, session_id: $sid, mode: $md}')"

    # Live usage checks (F1/F2/F3): baseline spend/tokens read once at spawn.
    usage_state_file="$RUNNER_DIR/$id.usage-state.json"
    rm -f "$usage_state_file"
    prior_spend=$(jq -r '.actual_cost_usd // 0' "$job_file" 2>/dev/null); : "${prior_spend:=0}"
    prior_tokens=$(jq -r '.actual_tokens // 0' "$job_file" 2>/dev/null); : "${prior_tokens:=0}"
    case "$prior_tokens" in ''|*[!0-9]*) prior_tokens=0 ;; esac
    last_usage_check_epoch=0
    cost_cap_breached=0
    usage_main_actor="${phase_agent:-cody}-main"

    # Reaper tunables. RESULT_GRACE_SECONDS is how long we let the worker linger
    # after we observe a top-level "result" event in the stream-json log before
    # forcing it down (Layer 1 in the bug report). IDLE_REAP_SECONDS is the
    # log-mtime watchdog (Layer 2): if the worker hasn't written a single byte
    # in that long, we treat it as wedged regardless of whether we ever saw a
    # result. Both knobs default conservatively — five minutes is plenty for
    # any sane post-result cleanup, and 30 minutes of total log silence is
    # already unusual even for long-running tool calls (claude emits periodic
    # system events while waiting on tools).
    RESULT_GRACE_SECONDS="${MOTHER_RESULT_GRACE_SECONDS:-300}"
    IDLE_REAP_SECONDS="${MOTHER_IDLE_REAP_SECONDS:-1800}"

    # Poll for the marker file.
    cancel_requested=0
    final_result_epoch=0
    reaped_reason=""
    while [ ! -f "$marker_file" ]; do
        sleep 2

        # Honor cancellation: TERM, grace period, then KILL (handled in the helper).
        if [ "$(jq -r '.cancel_requested // false' "$job_file" 2>/dev/null)" = "true" ]; then
            cancel_requested=1
            _terminate_worker
            break
        fi

        # Honor a system-initiated pause (daemon's quota gate). Same kill path
        # as cancel, but the state transitions to `awaiting` (not cancelled) so
        # the daemon's auto-resume can pick the job back up when the offending
        # window resets. We transition state BEFORE killing the worker so the
        # post-loop short-circuit at line ~470 (the `awaiting` exit path) finds
        # the right state and skips the terminal-transition logic.
        if [ "$(jq -r '.pause_requested // false' "$job_file" 2>/dev/null)" = "true" ]; then
            _pause_reason=$(jq -r '.paused_reason // "system"' "$job_file" 2>/dev/null)
            _pause_resume_at=$(jq -r '.auto_resume_at // 0'    "$job_file" 2>/dev/null)
            _job_update '.state = "awaiting"
                | .question = "Mother paused this job because the quota cap was reached. Auto-resumes when the blocking window resets."
                | .pause_requested = null'
            _append_event "paused_for_quota" \
                "$(jq -nc --arg r "$_pause_reason" --argjson ts "${_pause_resume_at:-0}" \
                    '{paused_reason: $r, auto_resume_at: $ts}')"
            _terminate_worker
            break
        fi

        # Live observability. Two things we want to know about *as they happen*,
        # not just after claude exits:
        #   1. The PR URL (so `mother status` reflects the artifact even while
        #      the wrapper is still running). Without this, the bug's
        #      "PR exists but mother shows pr_url: null" symptom persists for
        #      the entire post-result-hang window.
        #   2. The top-level `result` event in the stream-json output. Once we
        #      see it, the agent has emitted its canonical "I'm done" signal —
        #      from here on, mother is the timekeeper for how long the wrapper
        #      gets to gracefully wind down.
        if [ -f "$log_path" ]; then
            if [ -z "$(jq -r '.pr_url // empty' "$job_file" 2>/dev/null)" ]; then
                # Only scan log content written by THIS worker (past log_offset_at_spawn)
                # to avoid picking up PR URLs left by previous runs on the same log file
                # (e.g. escalation retries on the same job ID).
                _live_capture_pr_url
            fi

            if [ "$final_result_epoch" -eq 0 ]; then
                # stream-json emits one complete JSON event per line. The result
                # event has top-level "type":"result". The whitespace tolerance
                # is paranoia — claude's SDK currently emits compact JSON, but
                # stream formatters change. Crucially we only look at log content
                # newer than this worker's spawn (`log_offset_at_spawn`), not the
                # whole file: on resume cycles the file already contains a
                # previous run's `result` event, and scanning the whole thing
                # would set final_result_epoch instantly and trip the post-
                # result-grace reaper before this worker has done any new work.
                if tail -c "+$((log_offset_at_spawn + 1))" "$log_path" 2>/dev/null \
                    | grep -Eq '"type"[[:space:]]*:[[:space:]]*"result"' 2>/dev/null; then
                    final_result_epoch=$(date +%s)
                    _job_update ".final_result_at = \"$(iso_now)\""
                    _append_event "final_result_observed" "{}"
                fi
            fi
        fi

        # Live usage checks (F1-F3): token alert + --max-cost enforcement.
        # Runs at most once every MOTHER_USAGE_CHECK_INTERVAL seconds (default
        # 120), and only once the log file exists.
        _usage_check_interval="${MOTHER_USAGE_CHECK_INTERVAL:-120}"
        _now_epoch=$(date +%s)
        if [ -f "$log_path" ] && [ $((_now_epoch - last_usage_check_epoch)) -ge "$_usage_check_interval" ]; then
            last_usage_check_epoch=$_now_epoch
            read -r job_spend job_tokens _run_cost _run_tokens <<USAGE_EOF
$(mother_usage_check_live "$id" "$log_path" "$log_offset_at_spawn" "$usage_state_file" "$prior_spend" "$prior_tokens" "$usage_main_actor")
USAGE_EOF
            : "${job_spend:=$prior_spend}" "${job_tokens:=$prior_tokens}"
            _job_update ".live_cost_usd = ${job_spend:-0} | .live_tokens = ${job_tokens:-0}"

            _token_alert_threshold="${MOTHER_TOKEN_ALERT_THRESHOLD:-100000000}"
            if [ "${job_tokens:-0}" -gt "$_token_alert_threshold" ] \
                && [ -z "$(jq -r '.token_alert_at // empty' "$job_file" 2>/dev/null)" ]; then
                _job_update ".token_alert_at = \"$(iso_now)\""
                _append_event "token_alert" "$(jq -nc --argjson tokens "${job_tokens:-0}" --arg cost "${job_spend:-0}" --argjson threshold "$_token_alert_threshold" '{tokens: $tokens, cost_usd: ($cost | tonumber), threshold: $threshold}')"
                echo "job $id: TOKEN ALERT — ${job_tokens} tokens (threshold ${_token_alert_threshold}), cost \$${job_spend}"
            fi

            if [ -n "$max_cost_usd" ] && [ "$cost_cap_breached" -eq 0 ]; then
                _over_cap=$(awk -v s="${job_spend:-0}" -v m="$max_cost_usd" 'BEGIN { print (s+0 >= m+0) ? 1 : 0 }' 2>/dev/null)
                [ -n "$_over_cap" ] || _over_cap=0
                if [ "$_over_cap" = "1" ]; then
                    cost_cap_breached=1
                    cost_cap_breach_epoch=$_now_epoch
                    _cap_by_actor='{}'
                    _cap_by_model='{}'
                    if mother_usage_available; then
                        _cap_parsed=$(python3 "$MOTHER_USAGE_BIN" parse --log "$log_path" --offset "$log_offset_at_spawn" \
                            --state "$usage_state_file" --main-actor "$usage_main_actor" 2>/dev/null)
                        _cap_by_actor=$(printf '%s' "$_cap_parsed" | jq -c '.by_actor // {}' 2>/dev/null)
                        _cap_by_model=$(printf '%s' "$_cap_parsed" | jq -c '.by_model // {}' 2>/dev/null)
                        [ -n "$_cap_by_actor" ] || _cap_by_actor='{}'
                        [ -n "$_cap_by_model" ] || _cap_by_model='{}'
                    fi
                    _cap_summary="Mother cost cap reached on job $id: spent \$${job_spend} of the \$${max_cost_usd} cap across all runs. Per-actor breakdown: ${_cap_by_actor}. Per-model breakdown: ${_cap_by_model}. Total tokens: ${job_tokens}. To continue: mother resume $id --max-cost <usd> \"<instructions>\". To stop: mother cancel $id."
                    _cap_red=""
                    [ "$(jq -r '.gates.status // ""' "$job_file" 2>/dev/null)" = "failed" ] \
                        && _cap_red=$(mother_gates_red_json "$job_file" | jq -r 'join(", ")' 2>/dev/null)
                    [ -z "$_cap_red" ] || _cap_summary="$_cap_summary Gates red: $_cap_red."
                    printf '%s\n' "$_cap_summary" > "$cost_cap_flag"
                    _job_update ".cost_cap_breached_at = \"$(iso_now)\""
                    _append_event "cost_cap_breached" "$(jq -nc --argjson cap "$max_cost_usd" --arg spent "${job_spend:-0}" --argjson by_actor "$_cap_by_actor" --argjson by_model "$_cap_by_model" '{max_cost_usd: $cap, spent_usd: ($spent | tonumber), by_actor: $by_actor, by_model: $by_model}')"
                fi
            fi

            # Fallback: if the hook somehow didn't stop the worker, force a
            # pause MOTHER_COST_CAP_GRACE_SECONDS after the breach.
            if [ "$cost_cap_breached" -eq 1 ] && [ "$(jq -r '.state' "$job_file" 2>/dev/null)" = "running" ]; then
                _grace="${MOTHER_COST_CAP_GRACE_SECONDS:-300}"
                if [ $((_now_epoch - cost_cap_breach_epoch)) -ge "$_grace" ]; then
                    _cap_summary=$(cat "$cost_cap_flag" 2>/dev/null || echo "Mother cost cap reached on job $id.")
                    _cc_merged=$(jq --arg q "$_cap_summary" --arg ts "$(iso_now)" \
                        '.state = "awaiting" | .question = $q | .paused_at = $ts | .paused_reason = "cost_cap"' \
                        "$job_file") && _atomic_write "$job_file" "$_cc_merged"
                    _append_event "cost_cap_forced_pause" "$(jq -nc --argjson cap "$max_cost_usd" --arg spent "${job_spend:-0}" '{max_cost_usd: $cap, spent_usd: ($spent | tonumber)}')"
                    _append_event "awaiting_input" "$(jq -nc --arg q "$_cap_summary" '{question: $q, paused_reason: "cost_cap"}')"
                    _terminate_worker
                    break
                fi
            fi
        fi

        # Layer 1 — result observed + grace window expired. The worker has
        # signalled completion and then sat idle past the patience threshold;
        # force it down and treat the job as succeeded (with metadata noting
        # we had to reap).
        if [ "$final_result_epoch" -gt 0 ]; then
            _now_epoch=$(date +%s)
            if [ $((_now_epoch - final_result_epoch)) -ge "$RESULT_GRACE_SECONDS" ]; then
                # Stale-supervisor guard: a resume cycle may have spawned a new
                # mother-run-job for this job, updating worker_pid in the job
                # file. If our worker_pid no longer matches, we are the old
                # (stale) supervisor — break cleanly rather than killing the
                # wrong wrapper and writing a spurious exit code to the shared
                # marker file, which would cause the active run to fail.
                _live_wpid=$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)
                if [ "$_live_wpid" != "$worker_pid" ]; then
                    break
                fi
                reaped_reason="result_grace_expired"
                _append_event "reaping_after_result_grace" "$(jq -nc --argjson grace "$RESULT_GRACE_SECONDS" '{grace_seconds: $grace}')"
                _terminate_worker
                break
            fi
        fi

        # Layer 2 — log has been silent past the idle threshold. Catches the
        # "claude hung BEFORE emitting result" case that Layer 1 can't see.
        # Without a result event we don't know whether the work artifact
        # exists, so the final transition will mark this `failed`.
        _mtime=$(_log_mtime)
        if [ "$_mtime" -gt 0 ]; then
            _now_epoch=$(date +%s)
            if [ $((_now_epoch - _mtime)) -ge "$IDLE_REAP_SECONDS" ]; then
                # Same stale-supervisor guard as Layer 1.
                _live_wpid=$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)
                if [ "$_live_wpid" != "$worker_pid" ]; then
                    break
                fi
                reaped_reason="idle_timeout"
                _append_event "reaping_after_idle_timeout" "$(jq -nc --argjson seconds "$IDLE_REAP_SECONDS" --argjson last_activity "$_mtime" '{idle_seconds: $seconds, last_activity_epoch: $last_activity}')"
                _terminate_worker
                break
            fi
        fi
    done

    exit_code=0
    [ -f "$marker_file" ] && exit_code=$(cat "$marker_file")
    return 0
}

# _record_run_usage_for_last_spawn <outcome> <run_kind> [extra-detail-json] —
# append one runs.jsonl row for the most recent _spawn_and_wait call, scoped to
# its log range (log_offset_at_spawn..end). Call it before the next spawn.
# _append_metrics is the original worker-run spelling of this.
_record_run_usage_for_last_spawn() {
    local outcome="$1" run_kind="${2:-worker}" extra_detail="${3:-}"
    [ -z "$extra_detail" ] && extra_detail='{}'
    local now_epoch; now_epoch=$(date +%s)
    local started_epoch=0
    local started_at_raw; started_at_raw=$(jq -r '.started_at // empty' "$job_file" 2>/dev/null)
    if [ -n "$started_at_raw" ]; then
        local started_sec="${started_at_raw%%.*}"
        case "$started_sec" in *Z) ;; *) started_sec="${started_sec}Z" ;; esac
        started_epoch=$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$started_sec" +%s 2>/dev/null \
            || date -u -d "$started_sec" +%s 2>/dev/null || echo 0)
    fi
    local wall_time=0
    [ "$started_epoch" -gt 0 ] && wall_time=$(( now_epoch - started_epoch ))
    local log_size=0
    [ -f "$log_path" ] && log_size=$(stat -f %z "$log_path" 2>/dev/null \
        || stat -c %s "$log_path" 2>/dev/null || echo 0)
    local retry_count; retry_count=$(jq -r '.retry_count // 0' "$job_file" 2>/dev/null)
    local esc_count_val; esc_count_val=$(jq -r '.escalation_count // 0' "$job_file" 2>/dev/null)

    local extra
    extra=$(jq -nc \
        --arg model "$worker_model" \
        --arg effort "$worker_effort" \
        --arg tier "$current_tier" \
        --argjson retry_count "${retry_count:-0}" \
        --argjson escalation_count "${esc_count_val:-0}" \
        --argjson wall_time_seconds "$wall_time" \
        --argjson log_size_bytes "${log_size:-0}" \
        --arg pr_url "${pr_url:-}" \
        --arg posture_at_spawn "${posture_at_spawn:-normal}" \
        --arg posture_bias_applied "${posture_bias_applied:-none}" \
        --argjson extra_detail "$extra_detail" \
        '{
            model: $model, effort: $effort, tier: $tier,
            retry_count: $retry_count,
            escalation_count: $escalation_count,
            wall_time_seconds: $wall_time_seconds,
            log_size_bytes: $log_size_bytes,
            pr_url: $pr_url,
            posture_at_spawn: $posture_at_spawn,
            posture_bias_applied: $posture_bias_applied
        } + $extra_detail')

    mother_record_run_usage "$id" "$outcome" "$log_path" "$log_offset_at_spawn" "" \
        "${phase_agent:-cody}" "$usage_main_actor" "$run_kind" "$extra"
}

# last_run_kind: what the most recent spawn was (worker | gate_fix), so the
# final row of a run that ended in a gate-fix turn is recorded as one.
last_run_kind=worker
_append_metrics() {
    _record_run_usage_for_last_spawn "$1" "${last_run_kind:-worker}" "${2:-}"
}

# Allow sourcing helpers without running job logic (used by bats tests).
[ "${SOURCE_ONLY:-}" = "1" ] && return 0

# ---------------------------------------------------------------------------

id="${1:?usage: mother-run-job <id>}"
job_file="$JOBS_DIR/$id.json"
[ -f "$job_file" ] || { echo "mother-run-job: no such job: $id" >&2; exit 1; }

# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/state.sh"
# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/worktree.sh"
# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/decision.sh"
# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/locks.sh"
# shellcheck source=/dev/null
source "$MOTHER_LIB_DIR/request-types.sh"
# findings.sh (W3+) and phase-prompt.sh (W2) are optional guards — both must
# be present for pipeline phase prompts; guarded so W2 builds even if W3 hasn't
# extended findings.sh yet.
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/findings.sh" ]     && source "$MOTHER_LIB_DIR/findings.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/phase-prompt.sh" ] && source "$MOTHER_LIB_DIR/phase-prompt.sh"
# shellcheck source=/dev/null
[ -r "$MOTHER_LIB_DIR/usage.sh" ] && source "$MOTHER_LIB_DIR/usage.sh"
type mother_claude_extra_args >/dev/null 2>&1 || mother_claude_extra_args() { MOTHER_CLAUDE_ARGS=(); }
type mother_usage_available   >/dev/null 2>&1 || mother_usage_available()   { return 1; }
type mother_record_run_usage  >/dev/null 2>&1 || mother_record_run_usage() { :; }
type mother_recompute_job_cost >/dev/null 2>&1 || mother_recompute_job_cost() { :; }
type mother_usage_check_live  >/dev/null 2>&1 || mother_usage_check_live()  { echo "${5:-0} ${6:-0} 0 0"; }
type mother_maybe_token_alert >/dev/null 2>&1 || mother_maybe_token_alert() { :; }
type mother_classify_exit     >/dev/null 2>&1 || mother_classify_exit()     { jq -nc --argjson code "${3:-1}" '{reason: "claude_exit_nonzero", exit_code: $code}'; }

# Re-install iso_now/_atomic_write/_with_lock/_append_line/_append_event/
# _job_update/_transition AFTER sourcing lib/state.sh above, by calling
# _install_core_job_helpers (defined and first called before the
# SOURCE_ONLY guard, so bats can unit-test _transition's D2 guard via
# SOURCE_ONLY=1 sourcing without pulling in the rest of this script's
# job-execution logic). A second call is required here because state.sh
# defines its own same-named _job_update/_atomic_write (different signature:
# 2-arg, id-keyed) that would otherwise win by sourcing-order and silently
# break every single-arg `_job_update "<filter>"` call below. Re-running
# _install_core_job_helpers restores this script's 1-arg convention for real
# (non-SOURCE_ONLY) execution; the first call (before the guard) only ever
# matters for SOURCE_ONLY=1 test sourcing, since real execution always passes
# through the guard before reaching here.
_install_core_job_helpers

mother_cli="$MOTHER_BIN_DIR/mother"


# Safety net: if we die before reaching a clean terminal transition (lock
# acquisition failure under set -u, missing tool, killed by signal, etc.),
# mark the job `failed: runner_died_early` so it doesn't linger as a zombie.
# The trap is a no-op once the job has already been transitioned to a
# terminal state — it only fires if the state is still `running` at exit.
# Cleared explicitly at the end of a normal run.
_runner_died_trap() {
    local rc=$?
    local cur; cur=$(jq -r '.state // empty' "$job_file" 2>/dev/null)
    if [ "$cur" = "running" ]; then
        _transition failed "$(jq -nc --argjson rc "$rc" \
            '{reason: "runner_died_early", exit_code: $rc}')" 2>/dev/null || true
        # Died mid-gating or mid-fix: don't leave a terminal job looking like it is.
        _job_update 'if .activity == "gating" or .activity == "gate_fix" then .activity = null else . end' 2>/dev/null || true
    fi
    # Stop the RWX sandbox first (idempotent; best-effort) — before the
    # main-dir restore switches the checkout away from the job branch.
    _rwx_post_exit 2>/dev/null || true
    _preview_post_exit 2>/dev/null || true
    # Regardless of state: never leave the operator's main-dir changes in the
    # stash list or the workspace lock held (set -u crashes, later-added
    # `exit 1` paths, SIGTERM/SIGINT). Idempotent.
    _exit_cleanup_workspace
}
trap _runner_died_trap EXIT

# Accept ready (invoked by `mother run --once`) or running (daemon already
# pre-transitioned before forking us).
state=$(jq -r .state "$job_file")
case "$state" in
    ready|running) ;;
    *) echo "mother-run-job: job $id is $state, expected ready or running" >&2; exit 1 ;;
esac

isolation=$(jq -r .isolation  "$job_file")
branch=$(jq -r .branch        "$job_file")
repo_path=$(jq -r .repo_path  "$job_file")
plan_path=$(jq -r .plan_path  "$job_file")
log_path=$(jq -r .log_path    "$job_file")
base_ref=$(jq -r .base_ref    "$job_file")
repo=$(jq -r .repo            "$job_file")
prd_path=$(jq -r '.prd_path // empty' "$job_file" 2>/dev/null || echo "")

# ---- Pipeline phase resolution ----
# When kind == "pipeline", resolve phase_agent + phase_request_type via the
# request-types registry (W1). Non-spawnable phases (review/done/blocked) fail
# fast — the pipeline driver (W4) owns those; they must never reach spawn.
# Legacy jobs (kind absent) leave all three variables empty; the sentinel
# ("phase_agent is empty") preserves the legacy code path byte-for-byte.
kind=$(jq -r '.kind // empty' "$job_file" 2>/dev/null || echo "")
phase=""; phase_agent=""; phase_request_type=""
if [ "$kind" = "pipeline" ]; then
    phase=$(jq -r '.pipeline.phase // empty' "$job_file" 2>/dev/null || echo "")
    case "$phase" in
        redd|cody|marty)
            # rt_agent_for_phase echoes a colon-separated token, e.g. "redd:test".
            _rt=$(rt_agent_for_phase "$phase") \
                || { _transition failed \
                        "$(jq -nc --arg p "$phase" \
                            '{reason: "unknown_pipeline_phase", phase: $p}')"; exit 1; }
            phase_agent="${_rt%%:*}"
            phase_request_type="${_rt#*:}"
            ;;
        "")
            _transition failed \
                "$(jq -nc '{reason: "non_spawnable_phase", phase: "empty", note: "pipeline job is missing pipeline.phase"}')"
            exit 1
            ;;
        *)
            # review / done / blocked and anything else must not be spawned here.
            _transition failed \
                "$(jq -nc --arg p "$phase" \
                    '{reason: "non_spawnable_phase", phase: $p, note: "review/done/blocked are driver-owned, not spawnable by mother-run-job"}')"
            exit 1
            ;;
    esac
    _append_event "pipeline_phase_spawn" \
        "$(jq -nc --arg ph "$phase" --arg a "$phase_agent" --arg rt "$phase_request_type" \
            '{phase: $ph, agent: $a, request_type: $rt}')"
fi

# Resolve working directory.
work_dir=""
_workspace_lock_held=0
if [ "$isolation" = "worktree" ]; then
    (cd "$repo_path" && git fetch --quiet origin "${base_ref#origin/}" 2>/dev/null || true)
    # Create the branch + worktree from base_ref.
    wt_path=$(source "$MOTHER_LIB_DIR/worktree.sh" && worktree_path_for_repo "$repo_path" "$branch")
    if [ ! -d "$wt_path" ]; then
        # If the branch already exists (e.g. adherence rework re-run), add the
        # worktree pointing at it rather than trying to create a new branch with
        # -b, which would fail with "branch already exists".
        if (cd "$repo_path" && git rev-parse --verify "$branch" >/dev/null 2>&1); then
            (cd "$repo_path" && git worktree add "$wt_path" "$branch") \
                || { _transition failed "$(jq -nc --arg r "worktree_create_failed" '{reason: $r}')"; exit 1; }
        else
            (cd "$repo_path" && git worktree add -b "$branch" "$wt_path" "$base_ref") \
                || { _transition failed "$(jq -nc --arg r "worktree_create_failed" '{reason: $r}')"; exit 1; }
        fi
    fi
    work_dir="$wt_path"
else
    # main-dir: acquire workspace lock so concurrent main-dir jobs serialize.
    lock_name="${repo}:workspace"
    if ! lock_acquire "$lock_name" 0 >/dev/null 2>&1; then
        echo "mother-run-job: could not acquire lock $lock_name (another main-dir job is running)" >&2
        _transition failed "$(jq -nc --arg r "lock_busy" --arg lock "$lock_name" '{reason: $r, lock: $lock}')"
        exit 1
    fi
    _workspace_lock_held=1
    work_dir="$repo_path"

    # Workspace setup. main-dir jobs share the operator's checkout, so the
    # worker can land on any branch with any pile of pending edits if we
    # don't normalize before spawn. Two pieces:
    #
    #   1. Stash any pre-existing uncommitted/untracked changes under a
    #      job-ID-keyed message. The marker file at $RUNNER_DIR/<id>.stash
    #      records both the stash message and the branch the operator was
    #      on, so the teardown can return them to that branch before
    #      popping (otherwise a stash made on branch X would get popped
    #      onto whatever branch the worker left us on).
    #
    #   2. Ensure the target branch exists & is checked out. Existing
    #      branch → checkout. Missing branch → create from base_ref. We
    #      fetch first so base_ref is current.
    #
    # Both run on every spawn (including resumes) so the workspace contract
    # is symmetrical with lock acquire/release: each acquire pairs with a
    # release, and setup/teardown bracket every cycle.
    (cd "$work_dir" && git fetch --quiet origin "${base_ref#origin/}" 2>/dev/null) || true

    # Stash if dirty.
    stash_marker="$RUNNER_DIR/$id.stash"
    if [ -n "$(cd "$work_dir" && git status --porcelain 2>/dev/null)" ]; then
        stash_orig_branch=$(cd "$work_dir" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
        stash_msg="mother:auto-stash:$id"
        if (cd "$work_dir" && git stash push --include-untracked -m "$stash_msg" >/dev/null 2>&1); then
            # Marker stores both pieces, separated by a newline.
            printf '%s\n%s\n' "$stash_msg" "$stash_orig_branch" > "$stash_marker"
            _append_event "auto_stashed" \
                "$(jq -nc --arg m "$stash_msg" --arg b "$stash_orig_branch" \
                    '{stash_message: $m, original_branch: $b}')"
        else
            _append_event "auto_stash_failed" \
                "$(jq -nc --arg m "$stash_msg" '{stash_message: $m, note: "git stash push failed; checkout may still succeed if dirty files do not conflict"}')"
        fi
    fi

    # Ensure target branch is checked out (create from base_ref if missing).
    if (cd "$work_dir" && git rev-parse --verify "$branch" >/dev/null 2>&1); then
        if ! (cd "$work_dir" && git checkout --quiet "$branch" 2>/dev/null); then
            echo "mother-run-job: failed to checkout existing branch $branch" >&2
            _transition failed "$(jq -nc --arg b "$branch" '{reason: "checkout_failed", branch: $b}')"
            _restore_auto_stash
            lock_release "$lock_name" >/dev/null 2>&1 || true
            _workspace_lock_held=0
            exit 1
        fi
        _append_event "branch_checked_out" "$(jq -nc --arg b "$branch" '{branch: $b, created: false}')"
    else
        if ! (cd "$work_dir" && git checkout --quiet -b "$branch" "$base_ref" 2>/dev/null); then
            echo "mother-run-job: failed to create branch $branch from $base_ref" >&2
            _transition failed "$(jq -nc --arg b "$branch" --arg base "$base_ref" '{reason: "branch_create_failed", branch: $b, base: $base}')"
            _restore_auto_stash
            lock_release "$lock_name" >/dev/null 2>&1 || true
            _workspace_lock_held=0
            exit 1
        fi
        _append_event "branch_checked_out" "$(jq -nc --arg b "$branch" --arg base "$base_ref" '{branch: $b, created: true, base: $base}')"
    fi
fi

# Persist resolved work_dir on the job JSON so peek (and similar consumers)
# can read it without re-deriving from repo_path/branch/isolation.
_job_update ".work_dir = \"$work_dir\""

# Snapshot what already exists on origin / as a PR, so the terminal verify can
# tell "this run shipped something" from "an earlier run did".
_capture_run_baseline

# Reset the RWX sandbox if this is a fresh attempt (best-effort, bounded).
_rwx_pre_spawn

# Stop any preview stack a previous worker left behind (best-effort, bounded).
_preview_pre_spawn

# Record the resolved work_dir on the job. If we were started from `ready`
# (via `mother run --once`), also emit the running transition; if the daemon
# pre-transitioned us, just append a started event. The actual worker process
# is spawned further down, after the wrapper script is written; the
# `worker_pid` is recorded at that point.
if [ "$state" = "ready" ]; then
    _transition running "$(jq -nc --arg d "$work_dir" '{work_dir: $d}')"
else
    _append_event "started" "$(jq -nc --arg d "$work_dir" '{work_dir: $d}')"
fi

# Spawn claude in a headless background process. Use a wrapper script so we
# can capture exit status and keep quoting sane.
#
# Worker agent resolution, in priority order:
#   1. MOTHER_WORKER_AGENT, if set — honored absolutely. Permanent overrides
#      belong in the launchd plist's EnvironmentVariables block.
#   2. Plain <agent>, if the user has one in the project's
#      $work_dir/.claude/agents/<agent>.md or their global
#      ~/.claude/agents/<agent>.md — their personal customizations beat our
#      shipped defaults. For legacy (non-pipeline) jobs the agent is cody.
#      For pipeline phases, it is the phase_agent resolved above.
#   3. `mother:<agent>` — the plugin-shipped fallback that works out-of-the-box
#      on fresh installs. Claude Code namespaces plugin-shipped agents with
#      the plugin's name.
_agent_basename="${phase_agent:-cody}"
if [ -n "${MOTHER_WORKER_AGENT:-}" ]; then
    worker_agent="$MOTHER_WORKER_AGENT"
elif [ -f "$work_dir/.claude/agents/$_agent_basename.md" ] \
    || [ -f "$HOME/.claude/agents/$_agent_basename.md" ]; then
    worker_agent="$_agent_basename"
else
    worker_agent="mother:$_agent_basename"
fi

# ---- Tier / model / effort resolution ----
#
# Priority:
#   1. suggested_config.cody.model + suggested_config.cody.effort from the job
#      (Archie sets these at plan time; they encode the task-aware routing hint).
#   2. current_tier on the job (may have been bumped by escalation).
#   3. Env-level defaults (MOTHER_DEFAULT_MODEL / MOTHER_DEFAULT_EFFORT).
#
# Tier is also persisted on the job so escalation logic has a clear baseline.

# Helper: tier ladder functions (mirrors bin/mother — duplicated here to avoid
# sourcing the CLI bin into the worker context).
_tier_model() {
    case "$1" in
        tier_0) echo "sonnet" ;;
        tier_1) echo "sonnet" ;;
        tier_2) echo "sonnet" ;;
        tier_3) echo "opus"   ;;
        *)      echo "sonnet" ;;
    esac
}
_tier_effort() {
    case "$1" in
        tier_0) echo "medium" ;;
        tier_1) echo "high"   ;;
        tier_2) echo "xhigh"  ;;
        tier_3) echo "high"   ;;
        *)      echo "medium" ;;
    esac
}

MOTHER_DEFAULT_MODEL="${MOTHER_DEFAULT_MODEL:-sonnet}"
MOTHER_DEFAULT_EFFORT="${MOTHER_DEFAULT_EFFORT:-medium}"

current_tier=$(jq -r '.current_tier // "tier_0"' "$job_file")
escalation_count=$(jq -r '.escalation_count // 0' "$job_file")

# Resolve model/effort from suggested_config.<sc_key> where sc_key is the
# phase agent for pipeline jobs (redd/cody/marty) or "cody" for legacy jobs.
# The posture bias, tier_0 guard, and escalation interaction below are
# byte-identical to the pre-W2 code — only this key changes (D3).
sc_key="${phase_agent:-cody}"
sc_model=$(jq -r --arg k "$sc_key" '.suggested_config[$k].model // empty' "$job_file" 2>/dev/null || echo "")
sc_effort=$(jq -r --arg k "$sc_key" '.suggested_config[$k].effort // empty' "$job_file" 2>/dev/null || echo "")
sc_skip=$(jq -r --arg k "$sc_key" '.suggested_config[$k].skip // false' "$job_file" 2>/dev/null || echo "false")

if [ "$sc_skip" = "true" ]; then
    # skip:true means run at tier defaults rather than at a named model.
    worker_model=$(_tier_model "$current_tier")
    worker_effort=$(_tier_effort "$current_tier")
elif [ -n "$sc_model" ] && [ -n "$sc_effort" ]; then
    # Use Archie's suggestion if the tier hasn't been escalated above baseline.
    if [ "$current_tier" = "tier_0" ]; then
        worker_model="$sc_model"
        worker_effort="$sc_effort"
    else
        # Escalated — use the tier's model/effort (which is higher than the hint).
        worker_model=$(_tier_model "$current_tier")
        worker_effort=$(_tier_effort "$current_tier")
    fi
else
    # No suggested_config — fall back to env defaults (old plans).
    worker_model="${MOTHER_DEFAULT_MODEL}"
    worker_effort="${MOTHER_DEFAULT_EFFORT}"
fi

# ---- Posture bias (Bishop) ----
# Applied to the *initial* tier only. Failure escalation is applied by the
# escalation logic before this script runs (it bumps current_tier on the job).
# That means escalated jobs already have current_tier > tier_0 here, so the
# guard below ensures escalation dominates: posture bias is a no-op for them.
#
# force_start bypasses posture bias entirely: the operator has explicitly
# accepted the cost and quota impact, so we observe posture for the metrics
# record but do not clamp or adjust the tier.
posture_at_spawn="normal"
posture_bias_applied="none"
force_start=$(jq -r '.force_start // false' "$job_file" 2>/dev/null)
if [ "$force_start" = "true" ]; then
    posture_at_spawn=$(_resolve_posture)
    posture_bias_applied="forced"
    _append_event "posture_bias_applied" \
        "$(jq -nc --arg p "$posture_at_spawn" --arg a "forced" \
            --arg t "$current_tier" --arg m "$worker_model" --arg e "$worker_effort" \
            '{posture: $p, action: $a, new_tier: $t, model: $m, effort: $e}')"
elif [ "$current_tier" = "tier_0" ]; then
    posture_at_spawn=$(_resolve_posture)
    # Inline the bias case rather than delegating to _apply_posture_bias via
    # command substitution — a subshell can't propagate variables back to the
    # parent, so any side-effecting variable set inside $() is lost.
    _idx=$(_tier_index "$current_tier")
    case "$posture_at_spawn" in
        conservative)
            posture_bias_applied="clamp"
            current_tier="tier_0"
            ;;
        elevated)
            _new=$(( _idx + 1 )); [ "$_new" -gt 2 ] && _new=2
            _biased=$(_tier_from_index "$_new")
            if [ "$_biased" != "$current_tier" ]; then
                posture_bias_applied="up1"
                current_tier="$_biased"
            fi
            ;;
        flush)
            _new=$(( _idx + 1 )); [ "$_new" -gt 3 ] && _new=3
            _biased=$(_tier_from_index "$_new")
            if [ "$_biased" != "$current_tier" ]; then
                posture_bias_applied="up1"
                current_tier="$_biased"
            fi
            ;;
        normal|*)
            posture_bias_applied="none"
            ;;
    esac
    if [ "$posture_bias_applied" != "none" ]; then
        worker_model=$(_tier_model "$current_tier")
        worker_effort=$(_tier_effort "$current_tier")
        _append_event "posture_bias_applied" \
            "$(jq -nc --arg p "$posture_at_spawn" --arg a "$posture_bias_applied" \
                --arg t "$current_tier" --arg m "$worker_model" --arg e "$worker_effort" \
                '{posture: $p, action: $a, new_tier: $t, model: $m, effort: $e}')"
    fi
fi

# Persist current_tier on the job (first run sets it; escalations bump it externally).
_job_update ".current_tier = \"$current_tier\""

# Build sub-agent routing lines from suggested_config.
_routing_line() {
    local agent="$1"
    local skip_val model_val effort_val
    skip_val=$(jq -r --arg a "$agent" '.suggested_config[$a].skip // false' "$job_file" 2>/dev/null || echo "false")
    if [ "$skip_val" = "true" ]; then
        printf '  %s: skip: true\n' "$agent"
    else
        model_val=$(jq -r --arg a "$agent" '.suggested_config[$a].model // "sonnet"' "$job_file" 2>/dev/null || echo "sonnet")
        effort_val=$(jq -r --arg a "$agent" '.suggested_config[$a].effort // "medium"' "$job_file" 2>/dev/null || echo "medium")
        printf '  %s: model=%s, effort=%s\n' "$agent" "$model_val" "$effort_val"
    fi
}

routing_redd=$(_routing_line redd)
routing_marty=$(_routing_line marty)
routing_perri=$(_routing_line perri)

routing_context="# Mother routing context

You are running at: model=$worker_model, effort=$worker_effort, tier=$current_tier.
This is escalation attempt $escalation_count of 2.
When delegating to Redd / Marty / Perri via the Task tool, use:
$routing_redd
$routing_marty
$routing_perri

Your assigned branch is \`$branch\`. Push your work there unless the plan
explicitly directs you to target a different existing branch (e.g. landing
on top of someone else's open PR). Mother verifies PRs by commit content as
well as branch name, but staying on the assigned branch avoids extra
detection work and operator confusion.

---"

# An operator who answered a gate hold with guidance resumes the held session
# (decision.sh sets .resume_session_id): the answer goes to the same session as
# its next turn. If that session can't be resumed, fall back to a fresh spawn
# that carries the answer the usual way.
run_activity_at_start=$(jq -r '.activity // ""' "$job_file" 2>/dev/null)
gates_budget_reset_by=""
if [ "$(jq -r '(.gates.attempt // -1) == 0 and (.gates.budget_reset_by // "") == "escalate"' "$job_file" 2>/dev/null)" = "true" ]; then
    gates_budget_reset_by="escalate"
fi
resume_sid=$(jq -r '.resume_session_id // empty' "$job_file" 2>/dev/null)
resume_answer=$(jq -r '.pending_answer // empty' "$job_file" 2>/dev/null)
if [ -n "$resume_sid" ] && [ -n "$resume_answer" ] && [ "$kind" != "pipeline" ]; then
    gates_budget_reset_by="resume"
    resume_question=$(jq -r '.question // empty' "$job_file" 2>/dev/null)
    resume_prompt_file="$RUNNER_DIR/$id.resume.md"
    {
        printf '# The operator answered your gate hold\n\n'
        printf 'Mother held this job because quality gates stayed red. The operator replied:\n\n'
        printf '%s\n\n' "$resume_answer"
        printf -- '---\n\n'
        printf 'Act on that guidance, then commit and push to the same branch (`%s`). Do not open a second PR.\n' "$branch"
        printf 'Once you have pushed, stop: Mother re-runs the gates with a fresh attempt budget.\n'
    } >"$resume_prompt_file"
    _resume_merged=$(jq --arg s "$resume_sid" \
        '.session_id = $s | .resume_session_id = null | .pending_answer = null | .question = null' "$job_file") \
        && _atomic_write "$job_file" "$_resume_merged"
    _append_event "resumed_from_input" "$(jq -nc --arg q "$resume_question" --arg a "$resume_answer" \
        --arg p "$resume_prompt_file" '{question: $q, answer: $a, resume_prompt: $p, mode: "resume"}')"
    _resume_spawned=0
    _spawn_and_wait resume "$resume_prompt_file" && _resume_spawned=1
    rm -f "$resume_prompt_file"
    if _gates_spawn_failed_immediately "$_resume_spawned"; then
        [ "$_resume_spawned" = "1" ] && _record_run_usage_for_last_spawn "failed" worker '{"resume_failed": true}'
        _resume_merged=$(jq --arg a "$resume_answer" --arg q "$resume_question" \
            '.pending_answer = $a | .question = (if $q == "" then null else $q end)' "$job_file") \
            && _atomic_write "$job_file" "$_resume_merged"
        _spawn_and_wait fresh
    fi
else
    [ -z "$resume_sid" ] || _job_update '.resume_session_id = null'
    _spawn_and_wait fresh
fi

# _split_pr_hit, _maybe_emit_pr_opened, and _finalize_pr_url are defined up
# near _verify_artifact_or_fail (before the SOURCE_ONLY guard) so bats can
# unit-test them directly via SOURCE_ONLY=1 sourcing. See the comment there.

# Authoritative PR URL capture + re-derivation + branch-mismatch validation.
# See _finalize_pr_url's definition (above the SOURCE_ONLY guard) for the
# full contract. Sets the global `pr_url`.
_finalize_pr_url

# Quality gates: observe records only; enforce keeps the PR a draft, runs
# same-session fix turns and holds on exhaustion (state awaiting, handled by
# the paused exit below). Before the sandbox stop (sandbox gates reuse the
# sandbox) and before the main-dir restore (HEAD must still be the job branch).
_run_gates

# Stop the RWX sandbox now: before the main-dir stash-restore below switches the
# checkout back to the operator's branch, and before the lock release lets
# another main-dir job check out a different one. Covers every post-exit path
# (awaiting, continuation, succeeded, failed, cancelled). Best-effort.
_rwx_post_exit

# Stop the worker's preview stack, if it launched one. Every worker exit.
_preview_post_exit

# Release main-dir lock if we took one. Before releasing, restore any
# auto-stash to the operator's original branch so their pre-job working
# state isn't lost (and isn't accidentally applied to whatever branch the
# worker left us on). The marker file's two-line format is:
#   line 1: stash message
#   line 2: original branch name (may be empty if HEAD was detached)
# If `git stash pop` fails (conflict, etc.), we leave the stash in place
# and emit an event — operator can resolve manually rather than us silently
# discarding their work.
if [ "$isolation" = "main-dir" ]; then
    _restore_auto_stash
    lock_release "${repo}:workspace" >/dev/null 2>&1 || true
    _workspace_lock_held=0
fi

# If the worker called `mother await` and transitioned the job to
# `awaiting` before exiting, respect that. The job is paused (not done) and
# `mother resume` will spawn a fresh worker later — we just need to release
# our own resources cleanly without touching state. The main-dir workspace
# lock was already released above, so the resumed worker can re-acquire it.
current_state=$(jq -r '.state' "$job_file" 2>/dev/null)
if [ "$current_state" = "awaiting" ]; then
    _append_event "worker_exited_paused" \
        "$(jq -nc --arg pr "${pr_url:-}" '{pr_url: $pr}')"
    _paused_reason=$(jq -r '.paused_reason // "user"' "$job_file" 2>/dev/null)
    mother_record_run_usage "$id" "paused" "$log_path" "$log_offset_at_spawn" "" \
        "${phase_agent:-cody}" "$usage_main_actor" "${last_run_kind:-worker}" \
        "$(jq -nc --arg model "$worker_model" --arg effort "$worker_effort" --arg tier "$current_tier" \
            --argjson retry_count "$(jq -r '.retry_count // 0' "$job_file" 2>/dev/null)" \
            --argjson escalation_count "${escalation_count:-0}" \
            --arg pr_url "${pr_url:-}" --arg paused_reason "$_paused_reason" \
            '{model: $model, effort: $effort, tier: $tier, retry_count: $retry_count, escalation_count: $escalation_count, pr_url: $pr_url, paused_reason: $paused_reason}')"
    rm -f "$marker_file" "$wrapper" "${spawn_prompt:-}" "$usage_state_file"
    # The runner_died_early trap only fires while state == "running"; awaiting
    # is safe by virtue of that, but disarm anyway for clarity.
    trap - EXIT
    echo "job $id paused (awaiting input)"
    exit 0
fi

# ---------- auto-continuation ----------
#
# When a job is reaped due to idle_timeout (stream died mid-work, no result
# event observed), rather than failing immediately we attempt a continuation:
# a fresh Cody spawn on the same worktree, given the original plan plus a
# preamble summarising what commits are already on the branch.
#
# Capped at MOTHER_MAX_CONTINUATIONS (default 3). Kill switch:
# MOTHER_CONTINUATIONS_ENABLED=0. Only triggers when no result event was
# observed (final_result_epoch == 0) — if the agent already finished, we
# let _verify_artifact_or_fail decide.

_attempt_continuation() {
    local reason="$1"
    [ "${MOTHER_CONTINUATIONS_ENABLED:-1}" = "1" ] || return 1

    local max_cont="${MOTHER_MAX_CONTINUATIONS:-3}"
    local cont_count; cont_count=$(jq -r '.continuation_count // 0' "$job_file" 2>/dev/null)
    [ "$cont_count" -lt "$max_cont" ] || return 1

    local new_count=$(( cont_count + 1 ))

    # Summarise what's already committed so the resumed worker doesn't redo it.
    local git_log_summary=""
    if [ -d "${work_dir:-}" ]; then
        git_log_summary=$(cd "$work_dir" && git log --oneline "${base_ref}..HEAD" 2>/dev/null || true)
    fi
    [ -z "$git_log_summary" ] && git_log_summary="(no commits ahead of base yet)"

    # Detect "operator resumed, but no commit postdates the resume" — a
    # strong signal the previous worker ran out of time before acting on
    # the operator's answer. See lib/state.sh's resume-continuity section.
    local not_acted=0
    local last_commit_epoch=0 last_commit_sha=""
    local _rnyao_out
    if _rnyao_out=$(_resume_not_yet_acted_on "$id" "${work_dir:-}"); then
        not_acted=1
        last_commit_epoch="${_rnyao_out%% *}"
        last_commit_sha="${_rnyao_out#* }"
    fi
    case "$last_commit_epoch" in ''|*[!0-9]*) last_commit_epoch=0 ;; esac

    local resumed_at; resumed_at=$(jq -r '.resumed_at // empty' "$job_file" 2>/dev/null)

    local preamble
    preamble=$(_continuation_preamble "$id" "$new_count" "$max_cont" "$reason" "$git_log_summary" "$not_acted")

    # Sticky: never write false over an existing true.
    local was_flagged; was_flagged=$(jq -r '.resume_not_yet_acted_on // false' "$job_file" 2>/dev/null)

    local merged
    merged=$(jq --arg pa "$preamble" --argjson c "$new_count" --argjson notacted "$([ "$not_acted" = "1" ] && echo true || echo false)" '
        .pending_answer = $pa
        | .continuation_count = $c
        | .resume_not_yet_acted_on = ((.resume_not_yet_acted_on == true) or $notacted)
        | .state = "ready"
        | .finished_at = null
        | .worker_pid = null
        | .cancel_requested = null
        | .pause_requested = null
        | .final_result_at = null
        | .activity = "continuation"
    ' "$job_file") && _atomic_write "$job_file" "$merged"

    _append_event "continuation_queued" \
        "$(jq -nc --arg reason "$reason" --argjson count "$new_count" --argjson max "$max_cont" \
            '{reason: $reason, continuation_count: $count, max_continuations: $max}')"

    if [ "$not_acted" = "1" ] && [ "$was_flagged" != "true" ]; then
        _append_event "resume_not_yet_acted_on" \
            "$(jq -nc --arg resumed_at "${resumed_at:-}" \
                      --argjson last_commit_epoch "$last_commit_epoch" \
                      --arg last_commit_sha "$last_commit_sha" \
                      --argjson continuation_count "$new_count" \
                      '{resumed_at: $resumed_at, last_commit_epoch: $last_commit_epoch,
                        last_commit_sha: $last_commit_sha,
                        continuation_count: $continuation_count,
                        note: "operator answer may not have been implemented; carried into continuation prompt"}')"
    fi

    local _extra_log_note=""
    [ "$not_acted" = "1" ] && _extra_log_note=" (resume answer may be unapplied)"
    echo "job $id: idle_timeout — queuing continuation ${new_count}/${max_cont}${_extra_log_note}"
    return 0
}

# _verify_artifact_or_fail is now defined earlier (before the SOURCE_ONLY
# guard, alongside the other PR-detection helpers) so bats can unit-test it
# via SOURCE_ONLY=1 sourcing. See that definition for the full contract.

# Metrics log: append a schema-2 row to ~/.mother/metrics/runs.jsonl on every
# terminal transition (and on the paused/awaiting exit path above). One row
# per worker run — see lib/usage.sh's mother_record_run_usage for the schema.
METRICS_DIR="$MOTHER_ROOT/metrics"
mkdir -p "$METRICS_DIR"


# Stale-supervisor guard: if a resume cycle updated worker_pid in the job
# file to a different wrapper, we are no longer the active supervisor. Exit
# cleanly without making any state transition — the active run will handle
# its own terminal transition. We do NOT delete the marker file here because
# it may already belong to the active run.
_final_wpid=$(jq -r '.worker_pid // 0' "$job_file" 2>/dev/null)
if [ "$_final_wpid" != "$worker_pid" ]; then
    rm -f "$wrapper"
    trap - EXIT
    echo "job $id: stale supervisor exiting (active worker_pid=$_final_wpid, ours=$worker_pid)"
    exit 0
fi

# Final transition. Usage rows are recorded BEFORE the terminal _transition
# call so that _transition's cost recompute (see lib/usage.sh / _transition
# below) includes this run's row.
if [ "$cancel_requested" -eq 1 ]; then
    _append_metrics "cancelled" '{}'
    _transition cancelled "$(jq -nc '{reason: "user"}')"
elif [ -n "$reaped_reason" ]; then
    # We forced the worker down via one of the reap heuristics. If we'd
    # already observed the agent's final `result` event by then, the work
    # is complete and the worker just refused to exit — call it succeeded
    # with a note (subject to artifact verification). If we reaped without
    # ever seeing a result (idle timeout mid-work), attempt a continuation
    # first; fall back to failed if the continuation cap is reached.
    if [ "$final_result_epoch" -gt 0 ]; then
        if _verify_artifact_or_fail; then
            _append_metrics "succeeded" "$(jq -nc --arg reason "$reaped_reason" '{reaped: $reason}')"
            _transition succeeded "$(jq -nc --arg pr "$pr_url" --arg reason "$reaped_reason" '{pr_url: $pr, reaped: $reason}')"
        else
            _append_metrics "failed" "$(jq -nc --arg reason "$reaped_reason" '{reaped: $reason}')"
        fi
    elif [ "$reaped_reason" = "idle_timeout" ] && _attempt_continuation "$reaped_reason"; then
        # Continuation queued — don't transition to failed; the re-queued
        # worker will handle the terminal transition.
        _append_metrics "continuation" "$(jq -nc --arg reason "$reaped_reason" '{reaped: $reason}')"
    else
        _fail_detail=$(jq -nc --arg reason "$reaped_reason" '{reason: $reason}')
        _append_metrics "failed" "$_fail_detail"
        _transition failed "$_fail_detail"
    fi
elif [ "$exit_code" = "0" ]; then
    if _verify_artifact_or_fail; then
        _append_metrics "succeeded" '{}'
        _transition succeeded "$(jq -nc --arg pr "$pr_url" '{pr_url: $pr}')"
    else
        # _verify_artifact_or_fail already transitioned to failed.
        _append_metrics "failed" '{}'
    fi
else
    _classified=$(mother_classify_exit "$log_path" "$log_offset_at_spawn" "$exit_code" 2>/dev/null)
    [ -n "$_classified" ] || _classified=$(jq -nc --argjson code "$exit_code" '{reason: "claude_exit_nonzero", exit_code: $code}')
    _fail_detail2=$(printf '%s' "$_classified" | jq -c --argjson code "$exit_code" '. + {exit_code: $code}')
    _append_metrics "failed" "$_fail_detail2"
    _transition failed "$_fail_detail2"
fi

rm -f "$marker_file" "$wrapper" "$usage_state_file"
# Clean exit — disarm the runner_died_early safety net.
trap - EXIT
