#!/usr/bin/env bash
# mock_claude — records argv and exits with configurable status.
#
# Controlled by env vars:
#   MOCK_CLAUDE_EXIT           exit code (default 0)
#   MOCK_CLAUDE_ARGS_FILE      file to record args to (default: /tmp/mock-claude-args)
#   MOCK_CLAUDE_STDIN_FILE     if set, the mock's stdin (the prompt) is recorded here
#   MOCK_CLAUDE_STDOUT         text to print to stdout (optional)
#   MOCK_CLAUDE_STDOUT_FILE    file whose contents are printed to stdout (optional).
#                              Takes precedence over MOCK_CLAUDE_STDOUT when both are
#                              set, letting a test point the mock at a canned
#                              stream-json transcript fixture instead of an inline
#                              string. If both are unset, nothing is printed.
#   MOCK_CLAUDE_STDERR         text to print to stderr (optional)
#   MOCK_CLAUDE_SLEEP          seconds to sleep before exiting (optional, default 0).
#                              Lets a test keep the "worker" alive long enough for
#                              mother-run-job's poll loop to observe a few ticks
#                              (e.g. cost-cap breach detection) before it exits.
#   MOCK_CLAUDE_STDOUT_BY_AGENT_DIR
#                              optional directory of per-agent canned replies, for tests
#                              that drive several reviewers through one `claude` stand-in
#                              (the HC-14 review wave: archie adherence + perri-lens
#                              lenses). When set and argv contains `--agent <name>`:
#                                1. $DIR/<name>.<MOTHER_REVIEW_LENS>.jsonl is printed when
#                                   MOTHER_REVIEW_LENS is set and that file exists;
#                                2. else $DIR/<name>.jsonl is printed when it exists;
#                                3. else the mock falls through to MOCK_CLAUDE_STDOUT_FILE /
#                                   MOCK_CLAUDE_STDOUT exactly as before.
#                              `mother review-lens` exports MOTHER_REVIEW_LENS=<lens> into
#                              the claude invocation's environment so the lenses (all
#                              `--agent perri-lens`) can be told apart. Unset by default.
#   MOCK_CLAUDE_ENV_FILE       if set, the worker environment is recorded here as
#                              KEY=VALUE lines (TMPDIR, TMPDIR_EXISTS=yes|no — whether
#                              $TMPDIR is an existing directory at worker start —,
#                              MOTHER_JOB_ID, PWD). Opt-in; used by job_tmpdir.bats.

#   MOCK_CLAUDE_TURNS          opt-in turn mode (L4 boundary holds): the mock runs N scripted "turns".
#                              Before each turn it runs every PreToolUse hook command found in the
#                              `--settings` file (when argv has one) with a minimal JSON payload on
#                              stdin (with tool_use_id toolu_t<n>), as Claude Code would, and waits for it (a held hook parks the
#                              mock right there). A turn is then "in flight" for
#                              MOCK_CLAUDE_TURN_SLEEP seconds (default 1; fractions ok), during which
#                              the file MOCK_CLAUDE_TURN_MARKER (if set) exists. After the turn the
#                              PostToolUse hook commands of the settings file run for the same id. Unset or 0 = off.
#   MOCK_CLAUDE_PID_FILE       if set, the mock's pid is written here at start (proves "same process").
#   MOCK_CLAUDE_TURN_LOG       if set, one line per step is appended: "hook_start <n>", "hook_done <n>",
#                              "turn_start <n>", "turn_end <n>", "term in_turn=<yes|no>" (SIGTERM seen).

args_file="${MOCK_CLAUDE_ARGS_FILE:-/tmp/mock-claude-args}"
exit_code="${MOCK_CLAUDE_EXIT:-0}"

# Record stdin (the prompt) when asked. Only read it on request so a mock
# invoked without redirected stdin can never block on a terminal.
[ -n "${MOCK_CLAUDE_STDIN_FILE:-}" ] && cat > "$MOCK_CLAUDE_STDIN_FILE"

# Record selected environment on request (opt-in; never touches a test that
# does not set MOCK_CLAUDE_ENV_FILE).
if [ -n "${MOCK_CLAUDE_ENV_FILE:-}" ]; then
    {
        echo "TMPDIR=${TMPDIR-}"
        if [ -n "${TMPDIR-}" ] && [ -d "${TMPDIR-}" ]; then
            echo "TMPDIR_EXISTS=yes"
        else
            echo "TMPDIR_EXISTS=no"
        fi
        echo "MOTHER_JOB_ID=${MOTHER_JOB_ID-}"
        echo "PWD=$PWD"
    } > "$MOCK_CLAUDE_ENV_FILE"
fi

# Record the full argument list.
printf '%s\n' "$@" >> "$args_file"
echo "---" >> "$args_file"

# Turn mode (opt-in): see MOCK_CLAUDE_TURNS above.
_turn_log() { [ -n "${MOCK_CLAUDE_TURN_LOG:-}" ] && printf '%s\n' "$*" >> "$MOCK_CLAUDE_TURN_LOG"; return 0; }
[ -n "${MOCK_CLAUDE_PID_FILE:-}" ] && echo "$$" >> "$MOCK_CLAUDE_PID_FILE"
case "${MOCK_CLAUDE_TURNS:-0}" in ''|*[!0-9]*) MOCK_CLAUDE_TURNS=0 ;; esac
if [ "$MOCK_CLAUDE_TURNS" -gt 0 ]; then
    in_turn=no; hook_pid=""
    trap '[ -n "$hook_pid" ] && kill "$hook_pid" 2>/dev/null; _turn_log "term in_turn=$in_turn"; exit 143' TERM
    settings_file=""; prev_arg=""
    for arg in "$@"; do
        [ "$prev_arg" = "--settings" ] && settings_file="$arg"
        prev_arg="$arg"
    done
    hook_cmds=""
    if [ -n "$settings_file" ] && [ -f "$settings_file" ]; then
        hook_cmds=$(jq -r '(.hooks.PreToolUse // [])[] | .hooks[]? | select(.type == "command") | .command' "$settings_file" 2>/dev/null)
    fi
    t=1
    while [ "$t" -le "$MOCK_CLAUDE_TURNS" ]; do
        while IFS= read -r hook_cmd; do
            [ -n "$hook_cmd" ] || continue
            _turn_log "hook_start $t"
            printf '%s' "{\"tool_name\":\"Bash\",\"tool_use_id\":\"toolu_t$t\",\"tool_input\":{\"command\":\"true\"}}" | bash -c "$hook_cmd" >/dev/null 2>&1 &
            hook_pid=$!
            wait "$hook_pid" 2>/dev/null
            hook_pid=""
            _turn_log "hook_done $t"
        done <<HOOKS
$hook_cmds
HOOKS
        _turn_log "turn_start $t"
        in_turn=yes
        [ -n "${MOCK_CLAUDE_TURN_MARKER:-}" ] && echo "$t" > "$MOCK_CLAUDE_TURN_MARKER"
        sleep "${MOCK_CLAUDE_TURN_SLEEP:-1}" &
        sleep_pid=$!; hook_pid=$sleep_pid
        wait "$sleep_pid" 2>/dev/null
        hook_pid=""
        [ -n "${MOCK_CLAUDE_TURN_MARKER:-}" ] && rm -f "$MOCK_CLAUDE_TURN_MARKER"
        in_turn=no
        _turn_log "turn_end $t"
        post_cmds=""
        [ -n "$settings_file" ] && [ -f "$settings_file" ] && post_cmds=$(jq -r '(.hooks.PostToolUse // [])[] | .hooks[]? | select(.type == "command") | .command' "$settings_file" 2>/dev/null)
        while IFS= read -r hook_cmd; do
            [ -n "$hook_cmd" ] || continue
            printf '%s' "{\"tool_name\":\"Bash\",\"tool_use_id\":\"toolu_t$t\"}" | bash -c "$hook_cmd" >/dev/null 2>&1
        done <<POSTHOOKS
$post_cmds
POSTHOOKS
        t=$((t + 1))
    done
    trap - TERM
fi

# Per-agent canned reply (opt-in): see MOCK_CLAUDE_STDOUT_BY_AGENT_DIR above.
agent_reply=""
if [ -n "${MOCK_CLAUDE_STDOUT_BY_AGENT_DIR:-}" ]; then
    agent_name=""; prev_arg=""
    for arg in "$@"; do
        [ "$prev_arg" = "--agent" ] && { agent_name="$arg"; break; }
        prev_arg="$arg"
    done
    if [ -n "$agent_name" ]; then
        if [ -n "${MOTHER_REVIEW_LENS:-}" ] \
            && [ -f "$MOCK_CLAUDE_STDOUT_BY_AGENT_DIR/$agent_name.$MOTHER_REVIEW_LENS.jsonl" ]; then
            agent_reply="$MOCK_CLAUDE_STDOUT_BY_AGENT_DIR/$agent_name.$MOTHER_REVIEW_LENS.jsonl"
        elif [ -f "$MOCK_CLAUDE_STDOUT_BY_AGENT_DIR/$agent_name.jsonl" ]; then
            agent_reply="$MOCK_CLAUDE_STDOUT_BY_AGENT_DIR/$agent_name.jsonl"
        fi
    fi
fi

if [ -n "$agent_reply" ]; then
    cat "$agent_reply"
elif [ -n "${MOCK_CLAUDE_STDOUT_FILE:-}" ]; then
    cat "$MOCK_CLAUDE_STDOUT_FILE"
elif [ -n "${MOCK_CLAUDE_STDOUT:-}" ]; then
    printf '%s\n' "$MOCK_CLAUDE_STDOUT"
fi
[ -n "${MOCK_CLAUDE_STDERR:-}" ] && printf '%s\n' "$MOCK_CLAUDE_STDERR" >&2

if [ -n "${MOCK_CLAUDE_SLEEP:-}" ] && [ "${MOCK_CLAUDE_SLEEP:-0}" != "0" ]; then
    sleep "$MOCK_CLAUDE_SLEEP"
fi

exit "$exit_code"
